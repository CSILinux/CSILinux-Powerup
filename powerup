            result['reason']='release frontend path contains a symbolic link';return result
        parent=script.parent.lstat();info=script.lstat()
        result.update(script_uid=info.st_uid,script_mode=oct(stat.S_IMODE(info.st_mode)),
                      script_links=info.st_nlink,directory_uid=parent.st_uid,
                      directory_mode=oct(stat.S_IMODE(parent.st_mode)))
        if not stat.S_ISDIR(parent.st_mode) or parent.st_uid!=ROOT_UID or parent.st_mode&0o022:
            result['reason']='extraction directory is not root-owned and protected';return result
        if not stat.S_ISREG(info.st_mode) or info.st_mode&0o022 or info.st_nlink<1:
            result['reason']='release frontend is not a protected regular file';return result
        if info.st_nlink>1:
