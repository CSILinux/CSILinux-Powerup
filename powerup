final_package_recovery() {
    local original_status=$1 packages_ok=0 desktop_boot_ok=0
    (( original_status != 0 )) || return 0
    case $original_status in 130|137|143|129) return 0;; esac
    [[ ${FINAL_REPAIR_ACTIVE:-0} != 1 ]] || return 0
    if [[ ${PACKAGE_RECOVERY_REQUIRED:-0} != 1 && ! ( ${PACKAGE_WORK_ATTEMPTED:-0} == 1 && ${PACKAGE_COMMAND_FAILED:-0} == 1 ) ]]; then return 0; fi
    FINAL_REPAIR_ACTIVE=1
    # No second termination attempt during cleanup. A still-active updater and
    # its children retain control; their journal is checked on the next run.
    audit_step 'Check package availability before final recovery' package_wait_idle 0 || return $?
    [[ ${PACKAGE_BUSY:-0} != 1 ]] || return 76
    if [[ ${DESKTOP_ACTIVE:-0} != 1 ]]; then
        log 'Final package recovery deferred: the desktop backup is unavailable.'
        return 1
    fi
    if [[ ${BOOT_ACTIVE:-0} != 1 ]]; then
        audit_step 'Prepare boot backups before final package repair' boot_preflight || return 1
        audit_step 'Validate BIOS target before final package repair' boot_sync_bios_target || return 1
    fi
    log 'Attempting one final package recovery; the original maintenance result is retained'
    if audit_step 'Final configuration and dependency recovery' check_and_repair_packages; then packages_ok=1; fi
    [[ ${PACKAGE_BUSY:-0} != 1 ]] || return 76
    if audit_step 'Restore desktop settings and verify boot files after final recovery' finish_upgrade_safely; then desktop_boot_ok=1; fi
    if (( packages_ok && desktop_boot_ok )) && [[ ${BOOT_VERIFIED:-0} == 1 ]]; then
        FINAL_REPAIR_SUCCEEDED=1
        audit_event success '' 0 '' 'Final repair restored package health and passed boot-file checks; original work remains incomplete'
        printf 'POWERUP_RESULT=recovered-incomplete\n'
        return 0
    fi
    log 'Final recovery did not pass every required check; no completed-upgrade result or automatic reboot is permitted'
    return 1
}

