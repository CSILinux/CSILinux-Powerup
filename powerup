gui_stop_monitor_child() {
    local pid=${1:-} first_signal=${2:-USR1} signal attempt
    [[ $pid =~ ^[0-9]+$ && $pid != "$BASHPID" && $pid != "${GUI_JOB:-}" ]] || return 0
    # Only call this for our direct monitor children, never the maintenance job.
    # SIGUSR1 is YAD's successful-close signal. Hung displays have bounded
    # TERM/KILL fallbacks; no unbounded wait for a cosmetic progress window.
    for signal in "$first_signal" TERM KILL; do
        kill -0 "$pid" 2>/dev/null || break
        kill -s "$signal" "$pid" 2>/dev/null || true
        for (( attempt=0; attempt<10; attempt++ )); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.05
        done
    done
    if kill -0 "$pid" 2>/dev/null; then
        printf 'WARNING: Progress monitor %s did not exit; continuing without waiting for it.\n' "$pid" >&2
    else
        wait "$pid" 2>/dev/null || true
    fi
}

gui_progress_open() {
    local hold_fd
    local -a GUI_YAD_COMMAND=()
    gui_yad_command
    mkfifo "$GUI_DIR/progress.fifo" || return 1
    # A temporary read/write endpoint lets both real endpoints open without
    # blocking. It is explicitly closed in the child BEFORE exec'ing YAD.
    exec {hold_fd}<>"$GUI_DIR/progress.fifo"
    (
        exec 0<"$GUI_DIR/progress.fifo"
        exec {hold_fd}>&-
        exec "${GUI_YAD_COMMAND[@]}" "$@"
    ) >/dev/null 2>&1 &
    GUI_PROGRESS_PID=$!
    exec {GUI_PROGRESS_FD}>"$GUI_DIR/progress.fifo"
    exec {hold_fd}>&-
}

gui_progress_close() {
    if [[ -n ${GUI_PROGRESS_FD:-} ]]; then
        # Closing the writer delivers EOF. Do not write here: a stalled GTK
        # reader could fill the pipe and turn a completion write into a hang.
        exec {GUI_PROGRESS_FD}>&-
        GUI_PROGRESS_FD=''
    fi
    gui_stop_monitor_child "${GUI_PROGRESS_PID:-}"
    GUI_PROGRESS_PID=''
    gui_stop_monitor_child "${GUI_LOG_FEEDER:-}" TERM
    GUI_LOG_FEEDER=''
    [[ -z ${GUI_DIR:-} ]] || rm -f -- "$GUI_DIR/progress.fifo"
}

