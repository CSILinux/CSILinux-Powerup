assert_current_release_sources() {
    python3 - "$BASE_CODENAME" "${1:-/etc/apt}" <<'PY_CURRENT_SOURCES'
from pathlib import Path
import re, shlex, sys
base,root=sys.argv[1],Path(sys.argv[2])
known=set('precise trusty xenial bionic focal jammy kinetic lunar mantic noble oracular plucky questing resolute stonking devel'.split())
files=[root/'sources.list',*sorted((root/'sources.list.d').glob('*.list')),*sorted((root/'sources.list.d').glob('*.sources'))]
for path in files:
    if not path.exists():continue
    text=path.read_text()
    suites=[]
    if path.suffix=='.sources':
        for block in re.split(r'\n\s*\n',text):
            fields={};key=None
            for line in block.splitlines():
                if not line.strip() or line.lstrip().startswith('#'):continue
                if line[:1].isspace() and key:fields[key]+=' '+line.strip();continue
                if ':' not in line:raise SystemExit('ERROR: Malformed APT source: '+str(path))
                key,value=line.split(':',1);key=key.lower();fields[key]=value.strip()
            if fields.get('enabled','yes').lower()=='no':continue
            suites+=fields.get('suites','').split()
    else:
        for line in text.splitlines():
            tokens=shlex.split(line,comments=True)
            if not tokens or tokens[0] not in ('deb','deb-src'):continue
