        --command 'env -u DEBIAN_FRONTEND -u UCF_FORCE_CONFFNEW UCF_FORCE_CONFFOLD=1 do-release-upgrade -f DistUpgradeViewText' </dev/tty >/dev/tty 2>&1 || result=$?
