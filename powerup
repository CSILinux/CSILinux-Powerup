gui_build_plan() {
    CHECK_ONLY=0 TEST_PACKAGES=0 FULL_UPGRADE=0 REFRESH_TOOLS=0 CSI_TOOLS_ONLY=0 RELEASE_UI=text
    RELEASE_UPGRADE=0 RESUME_RELEASE=0 RECOVER_RELEASE=0 TOOL_ACTION='' TOOL_PACKAGES=() CATEGORY_ACTION='' PACKAGE_CATEGORIES=()
    REQUESTED=(os-update)
    case $GUI_PROFILE in
        csi-apps) CSI_TOOLS_ONLY=1; REQUESTED=() ;;
        preview) CHECK_ONLY=1 ;;
        test-packages) TEST_PACKAGES=1; REQUESTED=() ;;
        release) RELEASE_UI=gtk; RELEASE_UPGRADE=1 ;;
        recover) RELEASE_UI=gtk; RESUME_RELEASE=1; RECOVER_RELEASE=1; [[ $BASE_CODENAME != noble ]] || RELEASE_UPGRADE=1 ;;
        resume) RELEASE_UI=gtk; RESUME_RELEASE=1; [[ $BASE_CODENAME != noble ]] || RELEASE_UPGRADE=1 ;;
        categories-install) CATEGORY_ACTION=install; REQUESTED=("${GUI_CATEGORIES[@]}") ;;
        categories-remove) CATEGORY_ACTION=remove; REQUESTED=("${GUI_CATEGORIES[@]}") ;;
        full) FULL_UPGRADE=1 ;;
        refresh) REFRESH_TOOLS=1 ;;
        all) REQUESTED=(all) ;;
        selected) REQUESTED=(os-update "${GUI_CATEGORIES[@]}") ;;
        standard) ;;
        *) die 'Unknown wizard action.' ;;
    esac
    GUI_ARGS=()
    (( ! CSI_TOOLS_ONLY )) || GUI_ARGS+=(--update-csi-tools)
    (( ! TEST_PACKAGES )) || GUI_ARGS+=(--test-packages)
    [[ $CATEGORY_ACTION != install ]] || GUI_ARGS+=(--install-categories)
    [[ $CATEGORY_ACTION != remove ]] || GUI_ARGS+=(--remove-categories)
    (( ! CHECK_ONLY )) || GUI_ARGS+=(--check)
    (( ! FULL_UPGRADE )) || GUI_ARGS+=(--full-upgrade)
    (( ! REFRESH_TOOLS )) || GUI_ARGS+=(--refresh-tools)
    if (( RECOVER_RELEASE )); then GUI_ARGS+=(--recover-release)
    elif (( RESUME_RELEASE )); then GUI_ARGS+=(--resume-release)
    elif (( RELEASE_UPGRADE )); then GUI_ARGS+=(--release-upgrade); fi
    [[ $TOOL_ACTION != update ]] || GUI_ARGS+=(--update-tools)
    [[ $TOOL_ACTION != remove ]] || GUI_ARGS+=(--remove-tools)
    (( CHECK_ONLY || TEST_PACKAGES )) || GUI_ARGS+=(--boot-ui=gtk)
    [[ -z ${BIOS_TARGET:-} ]] || GUI_ARGS+=("--bios-target=$BIOS_TARGET")
    [[ $RELEASE_UI != gtk ]] || GUI_ARGS+=(--release-ui=gtk)
    GUI_ARGS+=("${REQUESTED[@]}")
}

