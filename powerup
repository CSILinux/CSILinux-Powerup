PY_CURRENT_SOURCES
}

write_tool_transaction_guard() {
    tool_package_data "$TOOL_ACTION" "$WORK/tool-policy.json" "${TOOL_PACKAGES[@]}" || return 1
    cat > "$WORK/tool-transaction-guard" <<'PY_TOOL_GUARD'
#!/usr/bin/python3
import fnmatch, json, os, sys
from pathlib import Path
root=Path(__file__).parent
def stop(message):
    (root/'tool-guard-blocked').write_text(message+'\n')
    raise SystemExit('ERROR: Tools-only transaction blocked: '+message)
try:
    policy=json.loads((root/'tool-policy.json').read_text())
    selected={tuple(item) for item in policy['selected']}
    fd=int(os.environ.get('APT_HOOK_INFO_FD','0'))
    with os.fdopen(os.dup(fd)) as stream: lines=stream.read().splitlines()
    if not lines or lines[0]!='VERSION 3':stop('Expected APT transaction protocol 3')
    if '' not in lines:stop('Incomplete APT transaction header')
    for line in lines[lines.index('')+1:]:
        fields=line.split()
        if len(fields)!=9:stop('Malformed APT package action')
        name,old,oldarch,oldmulti,direction,new,newarch,newmulti,action=fields
        if name in policy['protected'] or any(fnmatch.fnmatchcase(name,p) for p in policy['patterns']):
            stop('The solver would change a system/boot package: '+name)
        if direction=='>' and action!='**REMOVE**':stop('Package downgrades are not allowed: '+name)
        if action=='**REMOVE**':
            if policy['action']!='remove' or (name,oldarch) not in selected:
                stop('The solver would remove an unselected package: '+name+':'+oldarch)
        elif policy['action']=='remove':
            stop('Removal would also install/configure another package: '+name)
        elif action!='**CONFIGURE**' and not action.startswith('/'):
            stop('Unknown APT action for '+name)
except (OSError,ValueError,KeyError,TypeError) as error: stop(str(error))
PY_TOOL_GUARD
    chmod 700 "$WORK/tool-transaction-guard"
}

tool_repair_gate() {
    # A healthy tools-only run never installs GRUB or rebuilds the kernel.
    # Broken package state can include unfinished kernel work, so repair needs
    # the full boot safeguards before configuring any pending package.
    if package_state_clean && [[ ${PACKAGE_RECOVERY_REQUIRED:-0} != 1 ]] && ! boot_menu_needs_rebuild && [[ ! -e /var/lib/csi-powerup/grub-config-dirty && ! -e /var/lib/csi-powerup/plymouth-initramfs-dirty ]]; then return 0; fi
    if [[ ${BOOT_ACTIVE:-0} != 1 ]]; then
        boot_preflight || return 1
        boot_sync_bios_target || return 1
    fi
    check_and_repair_packages || return 1
    boot_ensure_ready baseline || return 1
    install_kernel_guard
}

maintain_tool_packages() {
    local attempt result=0 guard
    local -a args=()
    assert_current_release_sources || return 1
    tool_package_data "$TOOL_ACTION" "$WORK/tool-policy.json" "${TOOL_PACKAGES[@]}" || return 1
    tool_repair_gate || return 1
    if [[ ${CURRENT_SOURCES_READY:-0} != 1 ]]; then apt_refresh || return 1; fi
    if [[ $TOOL_ACTION == update ]]; then
        args=(install --only-upgrade --no-remove --no-install-recommends -y)
    else
        args=(remove --no-install-recommends -y -o APT::Get::AutomaticRemove=false)
    fi
    guard=$WORK/tool-transaction-guard
    for attempt in 1 2; do
        write_tool_transaction_guard || return 1
        rm -f -- "$WORK/tool-guard-blocked"
        log "Tool package $TOOL_ACTION on Ubuntu $BASE_CODENAME: ${TOOL_PACKAGES[*]}"
        if DEBIAN_FRONTEND=noninteractive package_command "Selected tool transaction, attempt $attempt" apt-get "${APT_OPTIONS[@]}" \
            -o "DPkg::Pre-Install-Pkgs::=$guard" -o "DPkg::Tools::options::$guard::Version=3" \
            "${args[@]}" "${TOOL_PACKAGES[@]}"; then result=0; break; else result=$?; fi
        (( result != 76 )) || return 76
        if [[ -e $WORK/tool-guard-blocked ]]; then
            cat "$WORK/tool-guard-blocked" >&2
            die 'The selected tools require other system/package changes. No unsafe transaction was permitted.'
        fi
        (( attempt != 2 )) || break
        tool_repair_gate || return 1
    done
    (( result == 0 )) || die "Tool package operation failed after bounded recovery (status $result)."
    tool_repair_gate || return 1
    if [[ ${BOOT_ACTIVE:-0} == 1 ]]; then boot_ensure_ready || return 1; fi
    audit_step 'Restore protected settings after tool maintenance' desktop_finish_upgrade || return 1
    log "Selected tool packages processed; Ubuntu $BASE_CODENAME retained. No release upgrade requested."
    POWERUP_FINAL_RESULT=tools-complete
}

