            enabled=FALSE; [[ $GUI_MODE == "$name" ]] && enabled=TRUE
            case $name in
                standard) rows+=("$enabled" "$name" 'Standard system update' 'Refresh repositories and upgrade packages without removing installed packages.') ;;
                full) rows+=("$enabled" "$name" 'Full package upgrade' 'Resolve dependency changes; package removals may be required.') ;;
                preview) rows+=("$enabled" "$name" 'Preview system and update plan' 'Read-only overview. No downloads, installation, or administrator access.') ;;
            esac
        done
    fi
    if [[ -n ${GUI_HEALTH_REPORT:-} ]]; then note+=$'\nAUTOMATIC REPAIR PENDING • Package configuration will be repaired first.'; fi
    while :; do
        gui_capture --text="$(gui_header 'Powerup control center' '01  PLAN     /     02  SCOPE     /     03  VERIFY     /     04  REVIEW' "$note")" \
            --list --radiolist --no-click --column='':RD --column='Key':HD --column='WORKFLOW' --column='WHAT TO EXPECT' \
            --print-column=2 --separator='' --expand-column=4 --wrap-cols=4 --wrap-width=460 \
            --button='Options and help:4' --button='About:6' --button='Close:1' --button='Continue:0' "${rows[@]}"
        case $GUI_CODE in
            0) selected=${GUI_RESPONSE//$'\n'/}; [[ -n $selected ]] || continue; GUI_MODE=$selected; return 0 ;;
            4) gui_help ;;
            6) gui_message 'About Powerup' "CSI Linux • csilinux.com • Jeremy Martin
Revision $POWERUP_REV
Bash updater with a native YAD interface.
Ubuntu 26.04 LTS / Resolute Raccoon" ;;
            *) return 1 ;;
        esac
    done
}

gui_scope() {
    local -a values=()
    local choices='System only!System + selected categories!System + all categories'
    case $GUI_SCOPE in selected) choices='System only!^System + selected categories!System + all categories';;
        all) choices='System only!System + selected categories!^System + all categories';; esac
    gui_capture --height=480 --text="$(gui_header 'Choose your scope' '01  PLAN     /     02  SCOPE     /     03  VERIFY     /     04  REVIEW' 'System and repository maintenance is included in every update run.')" \
        --form --separator=$'\x1f' --align=left \
        --field='Update scope:CB' "$choices" \
        --field='Refresh CSI tool archive:CHK' "$GUI_REFRESH" \
        --field='Choose all categories or a selected subset; these are separate routes.:LBL' '' \
        --field='Archive refresh backs up the current tool tree, then restores the CSI archive.:LBL' '' \
        --button='Cancel:1' --button='Back:2' --button='Continue:0'
    (( GUI_CODE == 0 )) || return "$GUI_CODE"
    IFS=$'\x1f' read -r -a values <<< "$GUI_RESPONSE"
    case ${values[0]} in
        'System only') GUI_SCOPE=os ;;
        'System + selected categories') GUI_SCOPE=selected ;;
        'System + all categories') GUI_SCOPE=all ;;
        *) return 2 ;;
    esac
    GUI_REFRESH=${values[1]:-FALSE}
    [[ $GUI_REFRESH == TRUE ]] || GUI_TOOLS_HASH=''
    if [[ $GUI_SCOPE == os ]]; then GUI_UPDATER='' GUI_UPDATER_HASH=''; fi
}

gui_categories() {
    local name checked
    local -a rows=()
    for name in "${CATEGORIES[@]}"; do
        [[ $name == os-update ]] && continue
        checked=FALSE
        [[ " ${GUI_CATEGORIES[*]} " == *" $name "* ]] && checked=TRUE
        rows+=("$checked" "$name")
    done
    while :; do
        gui_capture --text="$(gui_header 'Select tool categories' '02  SCOPE  /  SELECTED CATEGORIES' 'Choose one or more categories. OS maintenance runs first.')" \
            --list --checklist --column='':CHK --column='CSI TOOL CATEGORY' --print-column=2 --separator='|' \
            --button='Cancel:1' --button='Back:2' --button='Continue:0' "${rows[@]}"
        (( GUI_CODE == 0 )) || return "$GUI_CODE"
        local answer=${GUI_RESPONSE//|/ }
        answer=${answer//$'\n'/ }
        read -r -a GUI_CATEGORIES <<< "$answer"
        (( ${#GUI_CATEGORIES[@]} )) && return 0
        gui_message 'Select a category' 'Select at least one category, or go Back and choose System only.'
    done
}

gui_integrity() {
    local -a values=() fields=()
    local source='CSI GitHub updater!Local production updater'
    if [[ $GUI_SCOPE != os ]]; then
        [[ $GUI_SOURCE != local ]] || source='CSI GitHub updater!^Local production updater'
        gui_capture --height=420 --text="$(gui_header 'Choose updater source' '03  VERIFY  /  TOOL UPDATER' 'Use a production updater for your CSI tool categories.')" \
            --form --separator=$'\x1f' --field='Updater source:CB' "$source" \
            --field='The public file previously contained a placeholder; a production file may be required.:LBL' '' \
            --button='Cancel:1' --button='Back:2' --button='Continue:0'
        (( GUI_CODE == 0 )) || return "$GUI_CODE"
        IFS=$'\x1f' read -r -a values <<< "$GUI_RESPONSE"
        if [[ ${values[0]} == 'Local production updater' ]]; then GUI_SOURCE=local; else GUI_SOURCE=remote; GUI_UPDATER=''; fi
    fi
    [[ $GUI_SCOPE != os || $GUI_REFRESH == TRUE ]] || return 0
    while :; do
        fields=()
        if [[ $GUI_SCOPE != os ]]; then
            if [[ $GUI_SOURCE == local ]]; then fields+=(--field='Production updater file:FL' "$GUI_UPDATER"); fi
            fields+=(--field='Updater SHA-256 (optional)' "$GUI_UPDATER_HASH")
        fi
        if [[ $GUI_REFRESH == TRUE ]]; then fields+=(--field='Archive SHA-256 (optional)' "$GUI_TOOLS_HASH"); fi
        gui_capture --height=480 --text="$(gui_header 'Verify selected downloads' '03  VERIFY  /  INTEGRITY' 'Paste a trusted 64-character SHA-256, or leave it empty to use HTTPS transport trust.')" \
            --form --separator=$'\x1f' --align=left "${fields[@]}" \
            --button='Cancel:1' --button='Back:2' --button='Continue:0'
        (( GUI_CODE == 0 )) || return "$GUI_CODE"
        IFS=$'\x1f' read -r -a values <<< "$GUI_RESPONSE"
        local index=0
        if [[ $GUI_SCOPE != os ]]; then
            if [[ $GUI_SOURCE == local ]]; then GUI_UPDATER=${values[index]:-}; index=$((index+1)); fi
            GUI_UPDATER_HASH=${values[index]:-}; index=$((index+1))
        fi
        if [[ $GUI_REFRESH == TRUE ]]; then GUI_TOOLS_HASH=${values[index]:-}; fi
        if [[ $GUI_SCOPE != os && $GUI_SOURCE == local && -z $GUI_UPDATER ]]; then
            gui_message 'Select an updater' 'Choose your production csitoolsupdate.sh file, or go Back and choose the GitHub source.'
            continue
        fi
        gui_build_plan
        if validate_options; then return 0; fi
        gui_message 'Check your settings' "$PLAN_ERROR"
    done
}

gui_build_plan() {
    CHECK_ONLY=0 FULL_UPGRADE=0 REFRESH_TOOLS=0 RELEASE_UI=text
    TOOLS_SHA256=$GUI_TOOLS_HASH UPDATER_SHA256=$GUI_UPDATER_HASH UPDATER_FILE=$GUI_UPDATER
    REQUESTED=(os-update)
    case $GUI_MODE in
        preview) CHECK_ONLY=1; TOOLS_SHA256='' UPDATER_SHA256='' UPDATER_FILE='';;
        release) RELEASE_UI=gtk; TOOLS_SHA256='' UPDATER_SHA256='' UPDATER_FILE='';;
        standard|full)
            [[ $GUI_MODE != full ]] || FULL_UPGRADE=1
            [[ $GUI_REFRESH != TRUE ]] || REFRESH_TOOLS=1
            case $GUI_SCOPE in
                all) REQUESTED=(all) ;;
                selected) REQUESTED=(os-update "${GUI_CATEGORIES[@]}") ;;
            esac ;;
    esac
    GUI_ARGS=()
    (( ! CHECK_ONLY )) || GUI_ARGS+=(--check)
    (( ! FULL_UPGRADE )) || GUI_ARGS+=(--full-upgrade)
    (( ! REFRESH_TOOLS )) || GUI_ARGS+=(--refresh-tools)
    [[ -z $TOOLS_SHA256 ]] || GUI_ARGS+=(--tools-sha256 "$TOOLS_SHA256")
    [[ -z $UPDATER_FILE ]] || GUI_ARGS+=(--updater "$UPDATER_FILE")
    [[ -z $UPDATER_SHA256 ]] || GUI_ARGS+=(--updater-sha256 "$UPDATER_SHA256")
    [[ $RELEASE_UI != gtk ]] || GUI_ARGS+=(--release-ui=gtk)
    GUI_ARGS+=("${REQUESTED[@]}")
}

gui_write_plan() {
    {
        printf 'YOUR MAINTENANCE PLAN\n\nCurrent system: Ubuntu base %s (%s)\nTarget: Ubuntu 26.04 LTS / Resolute\n\n' "$BASE_CODENAME" "$ARCH"
        if (( GUI_DEMO )); then printf 'DEMONSTRATION — No system packages or repositories will change.\nDemo activity logs are saved.\n\n'; fi
        case $GUI_MODE in
            preview) printf 'READ-ONLY PREVIEW\nNo authentication. No downloads. No package or repository changes.\n\n' ;;
            release) printf 'RELEASE UPGRADE\nFully update Noble, then open the Ubuntu graphical release upgrader.\nThird-party repositories are backed up and disabled for the transition.\nUbuntu will ask about package removals and configuration changes.\n\nREBOOT & RESUME\nA reboot may be needed before and after the release upgrade.\nReopen Powerup after reboot to finish Resolute and Tor maintenance.\nTool-category updates are available once this transition is complete.\n' ;;
            *)
                if [[ $GUI_MODE == full ]]; then printf 'FULL PACKAGE UPGRADE\nMay remove packages to resolve dependency changes.\n';
                else printf 'STANDARD SYSTEM UPDATE\nUpgrade packages without removing installed packages.\n'; fi
                case $GUI_SCOPE in
                    os) printf '\nScope: System and repositories only\n';;
                    selected) printf '\nScope: System and selected CSI categories\n';;
                    all) printf '\nScope: System and all CSI categories\n';;
                esac
                [[ $GUI_SCOPE != selected ]] || printf 'Categories: %s\n' "${GUI_CATEGORIES[*]}"
                [[ $GUI_SCOPE != all ]] || printf 'All 11 CSI tool categories are included.\n'
                if [[ $GUI_REFRESH == TRUE ]]; then printf 'Refresh tool archive: Yes, with an existing-tree backup\n';
                else printf 'Refresh tool archive: No\n'; fi
                if [[ $GUI_SCOPE != os ]]; then
                    printf 'Updater source: %s\n' "$GUI_SOURCE"
                    [[ -z $GUI_UPDATER ]] || printf 'Updater file: %s\n' "$GUI_UPDATER"
                    printf 'Updater checksum: %s\n' "${GUI_UPDATER_HASH:-Not supplied — HTTPS/local file trust}"
                    printf 'Category success requires a functional production updater.\n'
                fi
                [[ $GUI_REFRESH != TRUE ]] || printf 'Archive checksum: %s\n' "${GUI_TOOLS_HASH:-Not supplied — HTTPS transport trust}"
                ;;
        esac
        printf '\nFINAL REPOSITORIES\nUbuntu: resolute, updates, security, backports\nComponents: main, restricted, universe, multiverse\nTor Project: stable Resolute repository with fingerprint-checked signing key\n'
        if (( CHECK_ONLY )); then printf '\nRECOVERY AVAILABLE DURING AN UPDATE (not run in Preview)\n'; else printf '\nAUTOMATIC RECOVERY\n'; fi
        printf 'Finish pending package configuration and repair broken dependencies.\nRetry a failed package operation once; retain modified configuration files.\nA failed clamav-milter restart can be deferred during repair, then retried.\nUnresolved service problems remain visible in the final result.\n'
        if [[ $GUI_MODE == standard ]]; then printf 'Automatic repair cannot remove packages in Standard mode.\n';
        elif [[ $GUI_MODE != preview ]]; then printf 'Dependency repair may remove packages in this selected upgrade mode.\n'; fi
        if [[ -n ${GUI_HEALTH_REPORT:-} ]]; then printf '\nPACKAGE HEALTH — AUTOMATIC REPAIR PENDING\n%s\n' "$GUI_HEALTH_REPORT"; fi
        if [[ $BASE_CODENAME == noble ]]; then printf '\nNoble repositories remain in use until Ubuntu performs the release upgrade.\n'; fi
        if (( ! CHECK_ONLY && ! GUI_DEMO )); then printf '\nBEFORE YOU START\nKeep power and network connected. Back up important data or take a VM snapshot.\nAdministrator authentication is requested only after Start.\n'; fi
    } > "$GUI_DIR/plan.txt"
}

gui_cleanup() {
    # A detached runner may still be finishing APT if this frontend is closed.
    # Never kill it, remove its files, or show a false completion status.
    if [[ -n ${GUI_JOB:-} && ! -f ${GUI_STATUS:-/nonexistent} ]]; then return; fi
    [[ -z ${GUI_DIR:-} ]] || rm -rf -- "$GUI_DIR"
}

gui_feed_log() {
    python3 -u - "$GUI_LOG" "$GUI_STATUS" "$GUI_JOB" <<'PY_GUI_LOG'
import os, sys, time
log, status, pid = sys.argv[1:]
def running():
    try:
        os.kill(int(pid), 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
try:
    with open(log, errors='replace') as stream:
        while True:
            line = stream.readline()
            if line:
                print('# ' + line.rstrip('\r\n'), flush=True)
            elif os.path.exists(status) or not running():
                print('100', flush=True)
                break
            else:
                time.sleep(0.15)
except BrokenPipeError:
    pass
PY_GUI_LOG
}

gui_run_plan() {
    local self=$1 state_dir exit_code outcome response
    local -a command=()
    state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/csi-linux/powerup
    install -d -m 700 "$state_dir"
    GUI_LOG=$(mktemp "$state_dir/powerup-$(date +%Y%m%d-%H%M%S).XXXXXX.log")
    GUI_STATUS=$GUI_DIR/worker.status
    cat > "$GUI_DIR/runner.sh" <<'RUNNER'
#!/bin/bash
set -u
trap '' HUP
status=$1; logfile=$2; shift 2
"$@" </dev/null > "$logfile" 2>&1
result=$?
printf '%s\n' "$result" > "$status.tmp"
mv -- "$status.tmp" "$status"
exit "$result"
RUNNER
    if (( GUI_DEMO )); then
        cat > "$GUI_DIR/demo.sh" <<'DEMO'
#!/bin/bash
printf 'DEMO — no system changes are being made.\n'
for step in 'Checking the selected plan' 'Simulating repository verification' 'Simulating package maintenance' 'Preparing the result'; do
    printf '%s…\n' "$step"
    sleep 1
done
printf 'POWERUP_RESULT=demo-complete\n'
DEMO
        command=(/bin/bash "$GUI_DIR/demo.sh")
    elif (( EUID == 0 )); then
        command=(/bin/bash "$self" --cli "${GUI_ARGS[@]}")
    else
        # Some X11 sessions omit XAUTHORITY and rely on the user's home file.
        if [[ -z ${XAUTHORITY:-} && -f $HOME/.Xauthority ]]; then export XAUTHORITY=$HOME/.Xauthority; fi
        {
            printf '#!/bin/bash\n'
            printf 'exec env GTK_THEME=Adwaita:dark XDG_CONFIG_HOME=%q %q --gtkrc=%q --window-icon=%q --entry --hide-text --center --on-top --width=460 --title=%q --text=%q --button=%q --button=%q\n' \
                "$GUI_DIR/config" "$(command -v yad)" "$GUI_DIR/style.css" "$GUI_DIR/icon.svg" 'CSI Linux — Authentication' \
                'Enter your administrator password to start the reviewed plan.' 'Cancel:1' 'Authenticate:0'
        } > "$GUI_DIR/askpass.sh"
        chmod 700 "$GUI_DIR/askpass.sh"
        command=(sudo -A '--preserve-env=DISPLAY,XAUTHORITY' -- /bin/bash "$self" --cli "${GUI_ARGS[@]}")
    fi
    SUDO_ASKPASS="$GUI_DIR/askpass.sh" setsid --wait /bin/bash "$GUI_DIR/runner.sh" "$GUI_STATUS" "$GUI_LOG" "${command[@]}" &
    GUI_JOB=$!
    gui_feed_log | gui_dialog --text="$(gui_header 'Maintenance in progress' 'EXECUTING YOUR REVIEWED PLAN' 'Live activity is shown below. Closing this monitor does not cancel package operations.')" \
        --progress --pulsate --progress-text='Working — duration depends on downloads and package changes' \
        --enable-log='Activity log' --log-expanded --log-height=300 --auto-close --no-buttons --no-escape >/dev/null || true
    wait "$GUI_JOB" || true
    if [[ -f $GUI_STATUS ]]; then read -r exit_code < "$GUI_STATUS"; else exit_code=125; fi
    outcome=$(sed -n 's/^POWERUP_RESULT=//p' "$GUI_LOG" | tail -n 1)
    local title detail
    if [[ $exit_code != 0 ]]; then
        title='Maintenance needs attention'
        detail="The operation stopped with status $exit_code. Some earlier steps may have completed. Review the log before retrying."
        local errors
        errors=$(python3 - "$GUI_LOG" <<'PY_GUI_ERRORS'
import re, sys
from pathlib import Path
lines = Path(sys.argv[1]).read_text(errors='replace').splitlines()
matches = [line for line in lines if re.search(r'^(ERROR:|E:|dpkg: error)|^Job for .*failed', line)]
print('\n'.join(dict.fromkeys(matches[-4:]))[:700])
PY_GUI_ERRORS
)
        [[ -z $errors ]] || detail+=$'\n\n'"$errors"
    else
        case $outcome in
            complete) title='Maintenance complete'; detail='The selected workflow completed. Review the activity log for any held or phased updates.' ;;
            reboot-required) title='Reboot required'; detail='A restart is needed. Save your work, reboot normally, then reopen Powerup to continue or verify the system.' ;;
            reboot-with-warnings) title='Reboot needed; service attention'; detail='Package work finished, but a deferred service restart did not recover. Review the log, save your work and reboot, then reopen Powerup. Mail filtering may be unavailable.' ;;
            service-attention) title='Packages updated; service attention'; detail='Package maintenance finished, but clamav-milter is not confirmed active after recovery. Mail filtering may be unavailable. Review the service details in the log.' ;;
            demo-complete) title='Demo complete'; detail='This was a simulated run. No system changes or authentication occurred.' ;;
            *) title='Review the operation log'; detail='The process exited, but no final completion marker was received. Check the log before starting another run.' ;;
        esac
    fi
    while :; do
        gui_capture --height=400 --text="$(gui_header "$title" 'RESULT' "$(gui_escape "$detail")")" \
            --form --field='Saved activity log:RO' "$GUI_LOG" --button='View log:2' --button='Save log as…:4' --button='Close:0'
        response=$GUI_CODE
        case $response in
            2) gui_dialog --text="$(gui_header 'Operation log' 'RESULT / DETAILS' 'This log is retained in your local state directory.')" --text-info --filename="$GUI_LOG" --fontname='Monospace 10' --wrap --button='Back:0' >/dev/null || true ;;
            4)
                gui_capture --file --save --confirm-overwrite --filename="$HOME/powerup-report.txt" --button='Cancel:1' --button='Save:0'
                if (( GUI_CODE == 0 )) && [[ -n $GUI_RESPONSE ]]; then cp -- "$GUI_LOG" "$GUI_RESPONSE" || gui_message 'Could not save log' 'Choose a writable destination.'; fi ;;
            *) break ;;
        esac
    done
}

gui_main() {
    local self code note
    self=$(readlink -f -- "${BASH_SOURCE[0]}")
    command -v yad >/dev/null || die 'YAD is required. Install it with: sudo apt install yad'
    [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] || die 'Open Powerup from a desktop session, or use --cli for terminal execution.'
    command -v setsid >/dev/null || die 'setsid (util-linux) is required for the update worker.'
    umask 077
    GUI_DIR=$(mktemp -d "${TMPDIR:-/tmp}/csi-powerup-gui.XXXXXXXX")
    GUI_JOB='' GUI_STATUS=''
    trap gui_cleanup EXIT
    gui_assets
    GUI_HEALTH_REPORT=''
    if (( GUI_DEMO )); then BASE_CODENAME=$GUI_DEMO_BASE; ARCH=amd64
    else
        # Platform errors are shown in a dialog; no privileged operation occurs.
        if ! note=$( (validate_platform) 2>&1); then gui_message 'System not supported' "$note"; return 1; fi
        validate_platform
        GUI_HEALTH_REPORT=$(dpkg --audit 2>&1) || GUI_HEALTH_REPORT="Could not inspect package state: $GUI_HEALTH_REPORT"
    fi
    if ! parse_options "$@"; then gui_message 'Check your options' "$PLAN_ERROR"; return 1; fi
    if ! validate_options; then gui_message 'Choose compatible options' "$PLAN_ERROR"; return 1; fi
    GUI_MODE=standard; (( ! FULL_UPGRADE )) || GUI_MODE=full
    [[ $BASE_CODENAME != noble ]] || GUI_MODE=release
    (( ! CHECK_ONLY )) || GUI_MODE=preview
    GUI_SCOPE=os GUI_REFRESH=FALSE GUI_SOURCE=remote
    GUI_UPDATER=$UPDATER_FILE GUI_UPDATER_HASH=$UPDATER_SHA256 GUI_TOOLS_HASH=$TOOLS_SHA256
    GUI_CATEGORIES=()
    (( ! REFRESH_TOOLS )) || GUI_REFRESH=TRUE
    [[ -z $GUI_UPDATER ]] || GUI_SOURCE=local
    for note in "${REQUESTED[@]}"; do
        if [[ $note == all ]]; then GUI_SCOPE=all
        elif [[ $note != os-update ]]; then GUI_SCOPE=selected; GUI_CATEGORIES+=("$note"); fi
    done
    while :; do
        if ! gui_dashboard; then return 0; fi
        if [[ $GUI_MODE != preview ]] && (( ! GUI_DEMO )); then
            GUI_HEALTH_REPORT=$(dpkg --audit 2>&1) || GUI_HEALTH_REPORT="Could not inspect package state: $GUI_HEALTH_REPORT"
        fi
        if [[ $GUI_MODE == standard || $GUI_MODE == full ]]; then
            if gui_scope; then :; else code=$?; if (( code == 2 )); then continue; else return 0; fi; fi
            if [[ $GUI_SCOPE == selected ]]; then
                if gui_categories; then :; else code=$?; if (( code == 2 )); then continue; else return 0; fi; fi
            fi
            if gui_integrity; then :; else code=$?; if (( code == 2 )); then continue; else return 0; fi; fi
        fi
        gui_build_plan
        if ! validate_options; then gui_message 'Check your settings' "$PLAN_ERROR"; continue; fi
        gui_write_plan
        if [[ $GUI_MODE == preview ]]; then
            gui_dialog --text="$(gui_header 'System preview' 'READ ONLY' 'No changes made. No administrator access requested.')" --text-info --filename="$GUI_DIR/plan.txt" \
                --fontname='Monospace 11' --wrap --button='Back to plans:0' >/dev/null || true
            continue
        fi
        gui_capture --height=700 --text="$(gui_header 'Review before starting' '04  REVIEW' 'Only the choices below will be executed.')" --text-info --filename="$GUI_DIR/plan.txt" \
            --fontname='Monospace 11' --wrap --button='Cancel:1' --button='Edit choices:2' --button='Start maintenance:0'
        case $GUI_CODE in 2) continue;; 0) gui_run_plan "$self"; return;; *) return 0;; esac
    done
}

main() {
    local cli=0 gui=0 arg
    local -a args=()
    GUI_DEMO=0 GUI_DEMO_BASE=resolute
    if (( $# == 1 )); then
        case $1 in --help|-h) usage; return;; --version) printf 'POWERUP_REV=%s\n' "$POWERUP_REV"; return;; esac
    fi
    for arg in "$@"; do
        case $arg in
            --cli) cli=1 ;;
            --gui) gui=1 ;;
            --demo|--demo=resolute) GUI_DEMO=1 ;;
            --demo=noble) GUI_DEMO=1; GUI_DEMO_BASE=noble ;;
            *) args+=("$arg") ;;
        esac
    done
    (( ! (cli && (gui || GUI_DEMO)) )) || die '--cli cannot be combined with --gui or --demo.'
    if (( cli )); then backend_main "${args[@]}"; else gui_main "${args[@]}"; fi
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
