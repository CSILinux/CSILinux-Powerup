            if [row for row in blockers() if row['pid']==pid]!=expected:
                print('PACKAGE_RECOVERY='+json.dumps(dict(action='skip-owner-changed',pid=pid)),flush=True);continue
            try:signal.pidfd_send_signal(handles[pid],signal.SIGTERM,None,0)
            except ProcessLookupError:continue
            print('PACKAGE_RECOVERY='+json.dumps(dict(action='SIGTERM',pid=pid,timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(),reason='lock held for '+str(TERM_AFTER)+' seconds',locks=expected)),flush=True)
        return state
    finally:
        for fd in handles.values():os.close(fd)

def active_recovery(state):
    if not state or state['phase']=='repaired':return []
    if state['boot_id']!=current_boot_id():return []
    active=[item for item in state['processes'] if live(item)]
    if active:
        observed=tree({item['pid'] for item in active})
        known={(item['pid'],item['start_ticks']) for item in state['processes']}
        additions=[item for item in observed if (item['pid'],item['start_ticks']) not in known]
        if additions:
            state['processes']+=additions
            if len(state['processes'])>512:raise RuntimeError('Recovery tree exceeds its bounded limit')
            save_state(state);active+=additions
    return active

def finish_recovery():
    state=read_state()
    if state and state['phase']!='repaired':
        if blockers() or active_recovery(state) or managers():
            print('Package activity resumed before recovery was verified.',flush=True);return 76
        state['phase']='repaired';state['repaired_at']=datetime.datetime.now(datetime.timezone.utc).isoformat();save_state(state)
    return 0

def wait_idle(timeout):
    start=time.monotonic();next_report=0;previous=None;previous_active=None;owner_key=None;owner_since=start
    state=read_state();stopped_at=start if state and state['phase']=='stopping' else None
    attempted=bool(state and state['phase']!='repaired');last_refusal=None;had_activity=False
    while True:
        owners=blockers();now=time.monotonic();elapsed=now-start
        active=active_recovery(state)
        if not owners and not active:
            if had_activity:
                print('Package manager became available after %.1f seconds; checking current package state next.'%elapsed,flush=True)
                lock_status('released',[],[],elapsed)
                print('PACKAGE_RECOVERY='+json.dumps(dict(action='activity-cleared',termination_requested=attempted,elapsed_seconds=round(elapsed,1),timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat())),flush=True)
            if state and state['phase']!='repaired':
                state['phase']='needs-repair';save_state(state);return 77
            return 0
        had_activity=True
        key=[]
        for row in owners:
            try:token=identity(row['pid'])['start_ticks'] if row['pid']>1 else -1
            except (FileNotFoundError,ProcessLookupError):token=-1
            key.append((row['path'],row['pid'],token))
        key=tuple(key)
        if key!=owner_key:owner_key=key;owner_since=now;last_refusal=None
        held=now-owner_since
        if elapsed>=next_report or owners!=previous or active!=previous_active:
            evidence(owners,elapsed);next_report=elapsed+REPORT_EVERY;previous=owners;previous_active=active
            if active:print('PACKAGE_RECOVERY_ACTIVE='+json.dumps(active),flush=True)
            lock_status('stopping' if attempted else 'deferred' if last_refusal else 'waiting',owners,active,elapsed,held,last_refusal)
        if owners and not attempted and held>=TERM_AFTER and timeout>=TERM_AFTER:
            if last_refusal is None:lock_status('attempt',owners,active,elapsed,held)
            try:
                state=request_stop(owners);attempted=True;stopped_at=time.monotonic()
                lock_status('stopping',owners,active_recovery(state),time.monotonic()-start,held)
            except (OSError,RuntimeError,ValueError) as error:
                reason=str(error)
                if reason!=last_refusal:
                    print('PACKAGE_RECOVERY_DEFERRED='+json.dumps(dict(reason=reason,timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat())),flush=True)
                    lock_status('deferred',owners,active,elapsed,held,reason);last_refusal=reason
