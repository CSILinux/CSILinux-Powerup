def identity(pid):
    raw=(PROC/str(pid)/'stat').read_text();end=raw.rfind(')');fields=raw[end+2:].split()
    return dict(pid=pid,start_ticks=int(fields[19]),ppid=int(fields[1]),state=fields[0])

def live(item):
    try:current=identity(item['pid'])
    except (FileNotFoundError,ProcessLookupError):return False
    return current['start_ticks']==item['start_ticks'] and current['state'] not in ('Z','X')

def tree(roots):
    records={}
    for path in PROC.iterdir():
        if not path.name.isdigit():continue
        try:row=identity(int(path.name))
        except (FileNotFoundError,ProcessLookupError):continue
        records[row['pid']]=row
    selected=set(roots)
    while True:
        more={pid for pid,row in records.items() if row['ppid'] in selected}
        if more<=selected:break
        selected|=more
        if len(selected)>512:raise RuntimeError('Package process tree is too large to recover automatically')
    return [records[pid] for pid in sorted(selected) if pid in records and records[pid]['state'] not in ('Z','X')]

