    wait "$GUI_JOB" || true
    gui_progress_close
    if [[ -f $GUI_STATUS ]]; then read -r exit_code < "$GUI_STATUS"; else exit_code=125; fi
    outcome=$(sed -n 's/^POWERUP_RESULT=//p' "$GUI_LOG" | tail -n 1)
    local title detail
    if [[ $exit_code == 75 ]]; then
