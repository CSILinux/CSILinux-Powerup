             'systemd-logind','sshd','dbus-daemon','dbus-broker'}

def executable_file(details):
    # /proc refers to the executable actually running, including an old inode
    # that has been replaced on disk during the distribution upgrade.
    info=(PROC/str(details['pid'])/'exe').stat()
    return stat.S_ISREG(info.st_mode) and info.st_uid==ROOT_UID and not info.st_mode&0o022

LINK_SCAN_MAX_ENTRIES=20000
LINK_SCAN_MAX_SECONDS=2.0
LINK_SCAN_MAX_DEPTH=32
LINK_SCAN_MAX_LINKS=128

def link_signature(info):
    return (info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_gid,
            info.st_nlink,info.st_size,info.st_mtime_ns,info.st_ctime_ns)

def descriptor_mount_id(fd):
    # A bind mount must not count the same directory entry twice or make an
    # outside alias appear to be confined to the extraction directory.
    for line in Path('/proc/self/fdinfo',str(fd)).read_text().splitlines():
        if line.startswith('mnt_id:'):return int(line.split(':',1)[1])
    raise RuntimeError('cannot verify the hard-link inventory mount')

def release_link_inventory(script,info,parent):
    result=dict(complete=False,expected_links=info.st_nlink,paths=[],entries_scanned=0)
    root_fd=None;started=time.monotonic();seen=set()
