boot_sync_bios_target() {
    [[ ${BOOT_MODE:-} == bios && ${BOOT_TARGET_REPAIR:-0} == 1 ]] || return 0
    local status response expected_disk=$BOOT_DISK
    boot_loader_target || return 1
    [[ $BOOT_DISK == "$expected_disk" ]] || { boot_fail 'The BIOS target changed during backup; no record was written.'; return 1; }
    (( BOOT_TARGET_REPAIR )) || return 0
    [[ $BOOT_DISK =~ ^/dev/[A-Za-z0-9_./:+-]+$ && -s $WORK/boot-target.json ]] || {
        boot_fail 'Validated BIOS target evidence is missing.'; return 1;
    }
    status=$(dpkg-query -W -f='${db:Status-Status}' grub-pc) || status=''
    case $status in installed|unpacked|half-configured) ;; *) boot_fail 'Cannot repair a BIOS target record without the installed grub-pc package.'; return 1;; esac
    cp -p "$WORK/boot-target.json" "$BACKUP/grub-target.before.json" || { boot_fail 'Could not back up the previous GRUB target record.'; return 1; }
    log "Repairing the stale/missing BIOS GRUB installation record: $BOOT_DISK"
    if ! printf 'grub-pc grub-pc/install_devices multiselect %s\ngrub-pc grub-pc/install_devices_empty boolean false\n' "$BOOT_DISK" | debconf-set-selections; then
        boot_fail 'Could not save the confirmed BIOS target in debconf.'; return 1
    fi
    if ! response=$(printf 'GET grub-pc/install_devices\n' | DEBIAN_FRONTEND=noninteractive debconf-communicate grub-pc); then
        boot_fail 'Could not read back the repaired BIOS target record.'; return 1
    fi
    [[ $response == "0 $BOOT_DISK" ]] || { boot_fail "BIOS target read-back does not match the confirmed disk: $response"; return 1; }
    BOOT_TARGET_REPAIR=0
    log 'The BIOS installation record now matches the confirmed current disk'
}

boot_loader_target() {
    local discovered fs abstraction status required_command
    BOOT_MODE=bios BOOT_DISK='' BOOT_TARGET_REPAIR=0
    log 'Checking the GRUB platform, boot filesystem and installation target'
    if [[ -d /sys/firmware/efi ]]; then
        BOOT_MODE=uefi
        case $ARCH in
            amd64) BOOT_EFI_SUFFIX=x64; BOOT_GRUB_TARGET=x86_64-efi ;;
            arm64) BOOT_EFI_SUFFIX=aa64; BOOT_GRUB_TARGET=arm64-efi ;;
            *) boot_fail 'Unsupported UEFI architecture.'; return 1 ;;
        esac
        [[ -d /boot/efi/EFI/ubuntu ]] || { boot_fail 'Ubuntu EFI loader directory is absent; an administrator must confirm the firmware boot path.'; return 1; }
    else
        [[ $ARCH == amd64 ]] || { boot_fail 'Only amd64 BIOS or amd64/arm64 UEFI GRUB is supported.'; return 1; }
        BOOT_GRUB_TARGET=i386-pc
        for required_command in debconf-communicate debconf-set-selections; do
            command -v "$required_command" >/dev/null || { boot_fail "Missing boot configuration tool: $required_command"; return 1; }
        done
    fi
    [[ -s /usr/lib/grub/$BOOT_GRUB_TARGET/normal.mod ]] || { boot_fail "Missing GRUB platform modules: $BOOT_GRUB_TARGET. Repair the installed GRUB package first."; return 1; }
    if fs=$(grub-probe --target=fs /boot); then :; else
        status=$?; boot_fail "grub-probe --target=fs /boot failed (status $status)."; return 1
    fi
    if abstraction=$(grub-probe --target=abstraction /boot); then :; else
        status=$?; boot_fail "grub-probe --target=abstraction /boot failed (status $status)."; return 1
    fi
    case $fs in ext2|xfs|fat) ;; *) boot_fail "Boot filesystem $fs needs a layout-specific review before an OS update."; return 1;; esac
    [[ -z $abstraction ]] || { boot_fail "Complex /boot layout ($abstraction) needs administrator review; no automatic bootloader replacement."; return 1; }
    if [[ $BOOT_MODE == bios ]]; then
        if discovered=$(boot_resolve_bios_target); then :; else
            status=$?
            if (( status == 78 )); then
                boot_confirm_bios_target || return 1
                discovered=$(boot_resolve_bios_target) || { boot_fail 'Confirmed BIOS disk failed revalidation.'; return 1; }
            else
            boot_fail 'BIOS target discovery failed; see the specific disk/probe diagnostic above.'; return 1
            fi
        fi
        IFS=$'\t' read -r BOOT_DISK BOOT_TARGET_REPAIR <<< "$discovered"
        [[ -n $BOOT_DISK && $BOOT_TARGET_REPAIR =~ ^[01]$ ]] || { boot_fail 'Invalid BIOS target discovery result.'; return 1; }
    fi
    log "Confirmed GRUB platform: $BOOT_GRUB_TARGET ${BOOT_DISK:+on $BOOT_DISK}"
}

boot_required_modules() {
    python3 - <<'PY_BOOT_MODULES'
from pathlib import Path
import subprocess
modules = set()
# Walk each current block device's driver ancestry, including its host controller.
for link in Path('/sys/class/block').glob('*'):
    device = link.resolve()
    while str(device).startswith('/sys/devices/'):
        module = device / 'driver/module'
        if module.exists(): modules.add(module.resolve().name)
        device = device.parent
fs = subprocess.check_output(['findmnt', '-n', '-o', 'FSTYPE', '/'], text=True).strip()
if fs not in ('ext2', 'ext3', 'ext4', 'xfs', 'btrfs'):
    raise SystemExit('Root filesystem needs a specific initramfs check: ' + fs)
modules.add('ext4' if fs in ('ext2', 'ext3') else fs)
print('\n'.join(sorted(modules)))
PY_BOOT_MODULES
}

boot_preflight() {
    BOOT_VERIFIED=0 BOOT_ACTIVE=0
    local command kernel required space
    for command in findmnt lsblk grub-probe grub-mkconfig grub-script-check grub-install \
        update-initramfs lsinitramfs depmod modprobe modinfo; do
        command -v "$command" >/dev/null || { boot_fail "Missing boot maintenance tool: $command. Repair boot packages before updating."; return 1; }
    done
    boot_mounts || { boot_fail 'Boot mount or free-space checks failed. No package changes started.'; return 1; }
    boot_loader_target || return 1
    [[ ! -L /boot/grub ]] || { boot_fail 'The GRUB directory is a symbolic link; automatic reconstruction is disabled.'; return 1; }
    if [[ ! -d /boot/grub ]]; then
        log 'The GRUB directory is missing; recreating it on the verified boot filesystem'
        install -d -m 755 /boot/grub || return 1
    fi
    if boot_menu_needs_rebuild; then log 'GRUB menu is empty, missing or invalid; automatic reconstruction is required'; fi
    kernel=$(uname -r) || { boot_fail 'Could not identify the running kernel.'; return 1; }
    [[ $kernel =~ ^[0-9][A-Za-z0-9.+_-]+$ && -s /boot/vmlinuz-$kernel && -d /lib/modules/$kernel ]] || {
        boot_fail 'The running kernel image or modules are missing. Restore that fallback before an upgrade.'; return 1;
    }
    BOOT_FALLBACK=$kernel
    boot_required_modules > "$WORK/boot-required-modules" || { boot_fail 'Could not discover required root/storage drivers.'; return 1; }
    # Keep an on-disk recovery copy of the running kernel, modules and GRUB files.
    # This is not a VM snapshot and cannot repair a disk or firmware failure.
    required=$(du -sb /lib/modules/"$kernel" /boot/grub /boot/vmlinuz-"$kernel" | awk '{n+=$1} END{printf "%.0f\n", n+536870912}') || { boot_fail 'Could not calculate fallback backup space.'; return 1; }
    space=$(df -B1 --output=avail "$BACKUP" | tail -n 1) || { boot_fail 'Could not read backup-filesystem free space.'; return 1; }
    (( space > required )) || { boot_fail 'Insufficient backup space for the running kernel and GRUB.'; return 1; }
    install -d -m 700 "$BACKUP/boot" "$BACKUP/modules" || { boot_fail 'Could not create boot backup directories.'; return 1; }
    cp -a --reflink=auto /boot/grub "$BACKUP/boot/" || { boot_fail 'Could not back up the GRUB directory.'; return 1; }
    cp -a --reflink=auto /lib/modules/"$kernel" "$BACKUP/modules/" || { boot_fail 'Could not back up the running kernel modules.'; return 1; }
    local file
    for file in /boot/vmlinuz-"$kernel" /boot/initrd.img-"$kernel" /boot/config-"$kernel" /boot/System.map-"$kernel"; do
        [[ ! -e $file ]] || cp -L --preserve=mode,timestamps --reflink=auto "$file" "$BACKUP/boot/" || { boot_fail "Could not back up $file."; return 1; }
    done
    [[ ! -e /etc/default/grub ]] || cp -a /etc/default/grub "$BACKUP/grub.defaults" || { boot_fail 'Could not back up GRUB defaults.'; return 1; }
    [[ ! -d /etc/default/grub.d ]] || cp -a /etc/default/grub.d "$BACKUP/grub.defaults.d" || { boot_fail 'Could not back up GRUB settings.'; return 1; }
    BOOT_ACTIVE=1
    log "Fallback kernel $kernel and GRUB files backed up to $BACKUP"
}

boot_kernel_versions() {
    local path package status
    {
        for path in /boot/vmlinuz-[0-9]*; do [[ ! -e $path ]] || printf '%s\n' "${path##*/vmlinuz-}"; done
        while IFS=$'\t' read -r status package; do
            [[ $status == installed ]] || continue
            package=${package%%:*}; package=${package#linux-image-}; package=${package#unsigned-}
            [[ $package =~ ^[0-9][A-Za-z0-9.+_-]+$ ]] && printf '%s\n' "$package"
        done < <(dpkg-query -W -f='${db:Status-Status}\t${binary:Package}\n' 'linux-image-[0-9]*' 'linux-image-unsigned-[0-9]*' || true)
    } | sort -Vu
}

boot_initrd_valid() {
    local kernel=$1 listing=$WORK/initrd-contents module path dependencies
    [[ -r $WORK/boot-required-modules ]] || { printf 'ERROR: Kernel %s: required-driver inventory is unavailable.\n' "$kernel" >&2; return 1; }
    [[ -s /boot/initrd.img-$kernel ]] || { printf 'ERROR: Kernel %s: /boot/initrd.img-%s is missing or empty.\n' "$kernel" "$kernel" >&2; return 1; }
    lsinitramfs /boot/initrd.img-"$kernel" > "$listing" || { printf 'ERROR: Kernel %s: startup image could not be read by lsinitramfs.\n' "$kernel" >&2; return 1; }
    grep -Eq '^(\./)?(usr/)?init$' "$listing" || { printf 'ERROR: Kernel %s: startup image has no init entry.\n' "$kernel" >&2; return 1; }
    while read -r module; do
        [[ -n $module ]] || continue
        dependencies=$(modprobe --show-depends --set-version "$kernel" "$module") || { printf 'ERROR: Kernel %s: cannot resolve required driver %s.\n' "$kernel" "$module" >&2; return 1; }
        while read -r path; do
            [[ -n $path ]] || continue
            [[ -s $path ]] || { printf 'ERROR: Kernel %s: required module file is missing: %s\n' "$kernel" "$path" >&2; return 1; }
            path=${path#/}; path=${path#usr/}
            # usrmerge paths are both accepted; module suffix compression retained.
            if ! grep -Fxq -- "$path" "$listing" && ! grep -Fxq -- "usr/$path" "$listing"; then
                printf 'ERROR: Kernel %s: startup image omits required module %s.\n' "$kernel" "$path" >&2; return 1
            fi
        done < <(awk '$1=="insmod"{print $2}' <<< "$dependencies")
    done < "$WORK/boot-required-modules"
    if [[ -e /dev/mapper/control ]]; then
        local root_source types
        root_source=$(findmnt -n -o SOURCE /) || { printf 'ERROR: Kernel %s: root-device lookup failed.\n' "$kernel" >&2; return 1; }
        types=$(lsblk -snr -o TYPE "$root_source") || { printf 'ERROR: Kernel %s: root-device layering lookup failed.\n' "$kernel" >&2; return 1; }
        if grep -Fxq crypt <<< "$types"; then
            grep -Eq '(^|/)(cryptroot|systemd-cryptsetup)(/|$)' "$listing" || { printf 'ERROR: Kernel %s: encrypted-root support is absent from the startup image.\n' "$kernel" >&2; return 1; }
        fi
        if grep -Fxq lvm <<< "$types"; then
            grep -Eq '(^|/)lvm$' "$listing" || { printf 'ERROR: Kernel %s: LVM support is absent from the startup image.\n' "$kernel" >&2; return 1; }
        fi
    fi
    return 0
}

boot_rebuild_startup_image() {
    # Standalone GRUB/APT hooks must never recursively invoke a package manager.
    # A missing image requires -c; update-initramfs -u -k all does not create it.
    local kernel=$1 mode=-u
    [[ $kernel =~ ^[0-9][A-Za-z0-9.+_-]+$ ]] || { printf 'ERROR: Invalid kernel version for startup-image repair.\n' >&2; return 1; }
    if [[ ! -s /boot/vmlinuz-$kernel || ! -s /lib/modules/$kernel/modules.builtin || ! -s /lib/modules/$kernel/modules.order ]]; then
        printf 'ERROR: Kernel %s: kernel image or module metadata is incomplete; package repair is required before GRUB finalization.\n' "$kernel" >&2
        return 1
    fi
    if boot_initrd_valid "$kernel"; then return 0; fi
    depmod -a "$kernel" || { printf 'ERROR: Kernel %s: rebuilding module dependencies failed.\n' "$kernel" >&2; return 1; }
    [[ -e /boot/initrd.img-$kernel ]] || mode=-c
    log "Repairing startup image for kernel $kernel ($mode); no package-manager recursion"
    update-initramfs "$mode" -k "$kernel" || { printf 'ERROR: Kernel %s: update-initramfs failed in mode %s.\n' "$kernel" "$mode" >&2; return 1; }
    boot_initrd_valid "$kernel" || { printf 'ERROR: Kernel %s: rebuilt startup image still failed validation.\n' "$kernel" >&2; return 1; }
    log "Validated repaired startup image for kernel $kernel"
}

boot_repair_kernel() {
    local kernel=$1 package status candidate mode=-u module modules_ok=1
    local -a reinstall=()
    [[ $kernel =~ ^[0-9][A-Za-z0-9.+_-]+$ ]] || return 1
    [[ -r $WORK/boot-required-modules ]] || return 1
    while read -r module; do
        [[ -z $module ]] || modinfo -k "$kernel" -n "$module" >/dev/null 2>&1 || modules_ok=0
    done < "$WORK/boot-required-modules"
    if (( ! modules_ok )) || [[ ! -s /boot/vmlinuz-$kernel || ! -s /lib/modules/$kernel/modules.builtin || ! -s /lib/modules/$kernel/modules.order ]]; then
        for package in "linux-image-$kernel" "linux-image-unsigned-$kernel" "linux-modules-$kernel" "linux-modules-extra-$kernel"; do
            status=$(dpkg-query -W -f='${db:Status-Status}' "$package") || status=''
            candidate=$(apt-cache policy "$package" | awk '/Candidate:/ {print $2}') || return 1
            if [[ -n $candidate && $candidate != '(none)' ]] && { [[ $status == installed || $package == linux-modules-* ]]; }; then reinstall+=("$package"); fi
        done
        (( ${#reinstall[@]} )) || { boot_fail "Kernel $kernel is incomplete and its installed packages are unavailable for repair."; return 1; }
        apt_run install --reinstall --no-remove -y "${reinstall[@]}" || return 1
    fi
    [[ -s /boot/vmlinuz-$kernel && -s /lib/modules/$kernel/modules.builtin && -s /lib/modules/$kernel/modules.order ]] || return 1
    depmod -a "$kernel" || return 1
    if [[ ! -e /var/lib/csi-powerup/plymouth-initramfs-dirty ]] && boot_initrd_valid "$kernel"; then return 0; fi
    [[ -e /boot/initrd.img-$kernel ]] || mode=-c
    log "Rebuilding the startup image for kernel $kernel ($mode)"
    audit_step "Build initramfs for $kernel" update-initramfs "$mode" -k "$kernel" || return 1
    boot_initrd_valid "$kernel" || { boot_fail "Startup image for $kernel is still incomplete after rebuilding."; return 1; }
}

boot_brand_menu() {
    local menu=$1 root_uuid
    root_uuid=$(findmnt -n -o UUID /) || return 1
    [[ -n $root_uuid ]] || return 1
    python3 - "$menu" "$root_uuid" <<'PY_BRAND_MENU'
import os,re,shlex,stat,sys,tempfile
from pathlib import Path
path=Path(sys.argv[1]);text=path.read_text();renames={}
pattern=re.compile(r'(?ms)^(\s*menuentry[ \t]+)([^\n]*\{[ \t]*\n)(.*?)(^\s*}[ \t]*$)')
def replace(match):
    prefix,header,body,end=match.groups()
    linux=re.search(r'(?m)^\s*linux(?:efi)?\s+\S*/vmlinuz-([^\s/]+)\s+([^\n]+)',body)
    if not linux:return match[0]
    args=linux[2].split()
    if [a for a in args if a.startswith('root=')]!=['root=UUID='+sys.argv[2]]:return match[0]
    kernel=linux[1]
    if not re.fullmatch(r'[0-9][A-Za-z0-9.+_-]+',kernel):raise ValueError('Invalid local kernel version in menu')
    quote=None;escaped=False;stop=None
    for i,c in enumerate(header):
        if escaped:escaped=False;continue
        if c=='\\' and quote!="'":escaped=True;continue
        if quote:
            if c==quote:quote=None
        elif c in "\"'":quote=c
        elif c.isspace():stop=i;break
    if stop is None or quote or escaped:raise ValueError('Unparseable GRUB title')
    old=shlex.split(header[:stop])
    if len(old)!=1:raise ValueError('Unparseable GRUB title token')
    recovery=any(a in ('recovery','single','1','systemd.unit=rescue.target','systemd.unit=emergency.target') for a in args)
    title='CSI Linux '+kernel+(' (recovery mode)' if recovery else '')
    if old[0]!=title:renames[old[0]]=title
    return prefix+shlex.quote(title)+header[stop:]+body+end
text=pattern.sub(replace,text)
# Keep title-based GRUB defaults working in the generated menu; stable entry IDs
# and on-disk administrator settings are unchanged. Numeric/default IDs pass through.
if renames:
    # GRUB also accepts parent-title>child-title defaults and saved selections.
    parents=[]
    for header in re.findall(r'(?m)^\s*submenu\s+([^\n]+)',text):
        parts=shlex.split(header)
        if parts:parents.append(parts[0])
    for old,new in list(renames.items()):
        for parent in parents:renames[parent+'>'+old]=parent+'>'+new
    mapping=[]
    for old,new in sorted(renames.items()):
        for variable in ('default','saved_entry','next_entry'):
            mapping.append('if [ "${'+variable+'}" = '+shlex.quote(old)+' ]; then set '+variable+'='+shlex.quote(new)+'; fi')
    first=re.search(r'(?m)^\s*(?:menuentry|submenu)\s+',text)
    if first:text=text[:first.start()]+'\n# CSI Linux title compatibility\n'+'\n'.join(mapping)+'\n'+text[first.start():]
info=path.stat()
fd,temp=tempfile.mkstemp(prefix='.csi-grub-titles-',dir=path.parent)
try:
    with os.fdopen(fd,'w') as out:
        out.write(text);out.flush();os.fsync(out.fileno());os.fchmod(out.fileno(),stat.S_IMODE(info.st_mode))
        if os.geteuid()==0:os.fchown(out.fileno(),info.st_uid,info.st_gid)
    os.replace(temp,path)
    directory=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY)
    try:os.fsync(directory)
    finally:os.close(directory)
finally:
    if os.path.exists(temp):os.unlink(temp)
print('Applied CSI Linux titles to local kernel menu entries')
PY_BRAND_MENU
}

boot_validate_menu() {
    local require_newest=1
    if [[ ${1:-} == --kernel-hook ]]; then require_newest=0; shift; fi
    local menu=$1; shift
    grub-script-check "$menu" || return 1
    local root_uuid
    root_uuid=$(findmnt -n -o UUID /) || return 1
    [[ -n $root_uuid ]] || return 1
    python3 - "$menu" "$root_uuid" "$require_newest" "$@" <<'PY_BOOT_MENU'
import re, sys
from pathlib import Path
text = Path(sys.argv[1]).read_text()
# Generated menu entries are blocks. Never borrow initrd commands after the
# entry's closing brace, from another entry, or from a sourced custom script.
entries = re.findall(r"(?ms)^\s*menuentry\s+[^\n]*\{[ \t]*\n(.*?)^\s*}[ \t]*$", text)
kernels = sys.argv[4:]
if not kernels: raise SystemExit('No bootable kernels were validated')
seen = {kernel:set() for kernel in kernels}
first = None
for index,entry in enumerate(entries):
    linux = re.search(r'(?m)^\s*linux(?:efi)?\s+(\S*/vmlinuz-([^\s/]+))\s+([^\n]+)', entry)
    if not linux: continue
    args=linux[3].split()
    roots=[arg for arg in args if arg.startswith('root=')]
    if roots != ['root=UUID='+sys.argv[2]]: continue
    kernel=linux[2]
    # The hook can run while other kernels are still being configured, but a
    # final menu must not advertise an unvalidated kernel for this root system.
    if kernel not in seen:
        if sys.argv[3]=='1': raise SystemExit('GRUB contains an unvalidated kernel for this root: '+kernel)
        continue
    initrd = re.search(r'(?m)^\s*initrd(?:efi)?\s+([^\n]+)', entry)
    if not initrd or not any(p.endswith('/initrd.img-'+kernel) for p in initrd[1].split()): continue
    recovery=any(arg in ('recovery','single','1','systemd.unit=rescue.target','systemd.unit=emergency.target') for arg in args)
    mode='recovery' if recovery else 'normal'
    seen[kernel].add(mode)
    if index==0:first=(kernel,mode)
for kernel,modes in seen.items():
    if modes != {'normal','recovery'}:
        raise SystemExit('Missing matching normal/recovery kernel + initrd + root entry in GRUB for '+kernel)
if sys.argv[3]=='1':
    # Check the actual first entry, not merely the first usable Linux stanza.
    if not entries or not re.search(r'(?m)^\s*linux(?:efi)?\s+\S*/vmlinuz-'+re.escape(kernels[-1])+r'\s+',entries[0]) or first!=(kernels[-1],'normal'):
        raise SystemExit('The first GRUB entry is not the newest validated Ubuntu kernel in normal mode')
print('GRUB contains normal and recovery entries for every validated kernel')
PY_BOOT_MENU
}

boot_menu_needs_rebuild() {
    [[ -s /boot/grub/grub.cfg ]] || return 0
    grep -Eq '^[[:space:]]*menuentry[[:space:]]' /boot/grub/grub.cfg || return 0
    grub-script-check /boot/grub/grub.cfg >/dev/null 2>&1 || return 0
    return 1
}

boot_verify_presentation() {
    python3 - "$1" <<'PY_GRUB_PRESENTATION'
import json,re,shlex,subprocess,sys
from pathlib import Path
baseline=Path('/var/lib/csi-powerup/desktop-original/manifest.json')
selector=baseline.parent.parent/'desktop-active.json'
if selector.exists():
    token=json.loads(selector.read_text()).get('snapshot','')
    if not re.fullmatch(r'[0-9a-f-]{36}',token):raise SystemExit('Invalid active desktop snapshot')
    baseline=baseline.parent.parent/'desktop-snapshots'/token/'manifest.json'
if not baseline.exists():raise SystemExit(0)
theme=json.loads(baseline.read_text()).get('grub',{}).get('theme','')
if not theme:raise SystemExit(0)
result=subprocess.run(['grub-mkrelpath',theme],text=True,capture_output=True)
relative=result.stdout.strip()
if result.returncode or not relative.startswith('/'):raise SystemExit('Cannot resolve original GRUB theme path')
for line in Path(sys.argv[1]).read_text().splitlines():
    if not re.match(r'^\s*set\s+theme=',line):continue
    try:parts=shlex.split(line)
    except ValueError:continue
    if len(parts)==2 and parts[1].split('=',1)[1].endswith(relative):raise SystemExit(0)
raise SystemExit('Generated GRUB menu does not load the saved original theme')
PY_GRUB_PRESENTATION
}

boot_write_defaults() {
    # Protected machines keep their saved settings, theme, graphics and timeout.
    # Legacy standalone recovery without a saved baseline only enables entries
    # required by the validator; it never clears an existing theme/graphics mode.
    [[ ! -f /var/lib/csi-powerup/desktop-original/manifest.json ]] || return 0
    install -d -m 755 /etc/default/grub.d || return 1
    cat > /etc/default/grub.d/99-csi-powerup-boot.cfg <<'GRUB_DEFAULTS'
# CSI Powerup legacy recovery: enable recoverable UUID-based kernel entries.
GRUB_DISABLE_RECOVERY=false
GRUB_DISABLE_LINUX_UUID=false
GRUB_DISABLE_LINUX_PARTUUID=true
GRUB_DEFAULTS
    chmod 644 /etc/default/grub.d/99-csi-powerup-boot.cfg
}

boot_write_rescue_menu() {
    local output=$1; shift
    python3 - "$output" "$@" <<'PY_RESCUE_MENU'
import os, re, shlex, subprocess, sys
from pathlib import Path

def run(*args):
    p=subprocess.run(args,capture_output=True,text=True,timeout=30,env=dict(os.environ,LC_ALL='C'))
    if p.returncode: raise ValueError(' '.join(args)+' failed: '+(p.stderr.strip() or str(p.returncode)))
    return p.stdout.strip()
def token(value,label,pattern=r'[A-Za-z0-9_./:=,@%+^-]+'):
    if not re.fullmatch(pattern,value):raise ValueError('Unsupported '+label+' in emergency menu: '+repr(value))
    return value
try:
    kernels=sys.argv[2:]
    if not kernels:raise ValueError('No validated Linux kernels for emergency menu')
    # A replacement must not silently discard GRUB authentication. Normal
    # grub-mkconfig remains the repair route for password-protected/custom setups.
    auth_paths=[Path('/boot/grub/grub.cfg'),Path('/boot/grub/grub.cfg.powerup-last-good'),Path('/boot/grub/user.cfg'),Path('/etc/default/grub')]
    auth_paths+=list(Path('/etc/grub.d').glob('[0-9]*'))
    auth_paths+=list(Path('/etc/default/grub.d').glob('*.cfg'))
    for path in auth_paths:
        if not path.is_file():continue
        for line in path.read_text(errors='replace').splitlines():
            if line.lstrip().startswith('#'):continue
            if re.search(r'\b(?:password(?:_pbkdf2)?|superusers|GRUB_[A-Z_]*PASSWORD)\b',line,re.I):
                raise ValueError('GRUB authentication settings found in '+str(path)+'; refusing an emergency menu that could bypass them')
    if run('grub-probe','--target=abstraction','/boot'):
        raise ValueError('Emergency menu requires a plain boot filesystem')
    fs=run('grub-probe','--target=fs','/boot')
    if fs not in ('ext2','xfs','fat'):raise ValueError('Unsupported emergency boot filesystem: '+fs)
    maps=run('grub-probe','--target=partmap','/boot').split()
    if not maps or any(m not in ('gpt','msdos') for m in maps):raise ValueError('Unsupported boot partition map')
    boot_uuid=token(run('grub-probe','--target=fs_uuid','/boot'),'boot UUID')
    root_uuid=token(run('findmnt','-n','-o','UUID','/'),'root UUID')
    # Preserve the running system's hardware/root-storage arguments. Exclude
    # stale kernel/root/default-mode choices; select the current UUID explicitly.
    extras=[]
    for arg in shlex.split(Path('/proc/cmdline').read_text()):
        if arg in ('ro','rw','quiet','splash','recovery','single','1','emergency','rescue','--'):continue
        if arg.startswith(('BOOT_IMAGE=','root=','init=','rdinit=','systemd.unit=','rd.systemd.unit=','vt.handoff=','rd.break')):continue
        extras.append(token(arg,'kernel argument'))
    lines=['# CSI Linux Powerup emergency menu: validated local kernels only.',
           '# Original menu and custom entries are retained in the run backup.',
           'set default=0','set timeout_style=menu','set timeout=10','terminal_output console']
    for partmap in dict.fromkeys(maps):lines.append('insmod part_'+partmap)
    lines+=['insmod '+fs,'insmod search_fs_uuid']
    for kernel in reversed(kernels):
        token(kernel,'kernel version',r'[0-9][A-Za-z0-9.+_-]+')
        image='/boot/vmlinuz-'+kernel;initrd='/boot/initrd.img-'+kernel
        paths=[]
        for name in (image,initrd):
            path=Path(name)
            if not path.is_file() or path.stat().st_size==0:raise ValueError('Missing boot file: '+name)
            if run('grub-probe','--target=fs_uuid',name)!=boot_uuid:raise ValueError('Boot files span different filesystems: '+name)
            relative=token(run('grub-mkrelpath',name),'GRUB file path')
            if not relative.startswith('/') or '..' in relative.split('/'):raise ValueError('Invalid GRUB file path')
            paths.append(relative)
        recovery=['recovery','nomodeset'] if os.access('/lib/recovery-mode/recovery-menu',os.X_OK) else ['single','nomodeset']
        for label,mode in (('normal',[]),('recovery',recovery)):
            lines += ["menuentry 'CSI Linux, Linux "+kernel+' ('+label+")' {",
                      '    search --no-floppy --fs-uuid --set=root '+boot_uuid,
                      '    linux '+paths[0]+' '+' '.join(['root=UUID='+root_uuid,'ro',*extras,*mode]),
                      '    initrd '+paths[1],'}']
    Path(sys.argv[1]).write_text('\n'.join(lines)+'\n')
except (OSError,ValueError,subprocess.TimeoutExpired) as error:
    print('ERROR: Emergency GRUB generation: '+str(error),file=sys.stderr);sys.exit(1)
PY_RESCUE_MENU
}

boot_build_menu() {
    local menu=$1; shift
    BOOT_MENU_FALLBACK=0
    if grub-mkconfig -o "$menu" && boot_brand_menu "$menu" && boot_validate_menu "$menu" "$@" && boot_verify_presentation "$menu"; then return 0; fi
    log 'Normal GRUB generation did not produce all required normal/recovery entries'
    # Retain a menu only when it still matches every currently validated kernel.
    local previous
    for previous in /boot/grub/grub.cfg /boot/grub/grub.cfg.powerup-last-good; do
        [[ -s $previous ]] || continue
        if boot_validate_menu "$previous" "$@"; then
            cp -p "$previous" "$menu" || return 1
            boot_brand_menu "$menu" || return 1
            BOOT_MENU_FALLBACK=1
            log "Recovering $previous after verifying every requested kernel and recovery entry"
            return 0
        fi
    done
    log 'Automatically generating a recovery menu from the validated local kernel/image pairs'
    boot_write_rescue_menu "$menu" "$@" || return 1
    boot_brand_menu "$menu" || return 1
    boot_validate_menu "$menu" "$@" || return 1
    BOOT_MENU_FALLBACK=1
    log 'Emergency GRUB menu passed syntax, kernel, root, initramfs and recovery checks'
}

boot_save_good_menu() {
    local saved
    saved=$(mktemp /boot/grub/.powerup-last-good.XXXXXXXX) || return 1
    if ! cp -p /boot/grub/grub.cfg "$saved" || ! mv -f "$saved" /boot/grub/grub.cfg.powerup-last-good; then
        rm -f -- "$saved"; return 1
    fi
    sync -f /boot/grub/grub.cfg.powerup-last-good
}

boot_update_loader() {
    if [[ $BOOT_MODE == bios ]]; then
        # BOOT_DISK came from debconf AND /boot ancestry. Never infer /dev/sda.
        audit_step 'Install BIOS GRUB on the confirmed disk' grub-install --target=i386-pc --recheck "$BOOT_DISK" || return 1
        [[ -s /boot/grub/i386-pc/normal.mod ]] || return 1
    else
        # Ubuntu's signed package scripts maintain shim and the signed EFI loader.
        # A generic grub-install may break Secure Boot, so do not substitute one.
        local package status
        for package in "grub-efi-$ARCH-signed" shim-signed; do
            status=$(dpkg-query -W -f='${db:Status-Status}' "$package") || return 1
            [[ $status == installed ]] || { boot_fail "Required signed EFI package is missing: $package"; return 1; }
        done
        DEBIAN_FRONTEND=noninteractive package_command 'Configure signed EFI GRUB' dpkg-reconfigure "grub-efi-$ARCH-signed" || return 1
        DEBIAN_FRONTEND=noninteractive package_command 'Configure signed EFI shim' dpkg-reconfigure shim-signed || return 1
        [[ -s /boot/efi/EFI/ubuntu/shim$BOOT_EFI_SUFFIX.efi && -s /boot/efi/EFI/ubuntu/grub$BOOT_EFI_SUFFIX.efi && -s /boot/efi/EFI/ubuntu/grub.cfg ]] || {
            boot_fail 'Ubuntu signed EFI loader or its GRUB configuration is missing.'; return 1;
        }
        local uuid
        uuid=$(grub-probe --target=fs_uuid /boot/grub) || return 1
        grep -Fq -- "$uuid" /boot/efi/EFI/ubuntu/grub.cfg || { boot_fail 'EFI GRUB configuration does not identify the current boot filesystem.'; return 1; }
    fi
}

boot_restore_validated_menu() {
    local restored
    [[ -s $WORK/grub.cfg.validated ]] || return 1
    restored=$(mktemp /boot/grub/.powerup-recovery.XXXXXXXX) || return 1
    if ! cp -p "$WORK/grub.cfg.validated" "$restored" || ! mv -f "$restored" /boot/grub/grub.cfg; then
        rm -f -- "$restored"; return 1
    fi
    sync -f /boot/grub/grub.cfg || return 1
    log 'Restored the menu that passed the current kernel checks; loader repair still needs attention'
}

boot_ensure_ready() {
    BOOT_VERIFIED=0
    desktop_restore || return 1
    log 'Checking installed kernels, startup images and GRUB before completion'
    boot_mounts || { boot_fail 'Boot filesystems are no longer ready.'; return 1; }
    boot_loader_target || return 1
    local kernel menu discovered phase=${1:-final}
    local -a kernels=() available=() failed=()
    if [[ ! -s /boot/vmlinuz-$BOOT_FALLBACK || ! -s /lib/modules/$BOOT_FALLBACK/modules.builtin || ! -s /lib/modules/$BOOT_FALLBACK/modules.order ]]; then
        log "Restoring the running fallback kernel $BOOT_FALLBACK from the private backup"
        if [[ -s $BACKUP/boot/vmlinuz-$BOOT_FALLBACK && -d $BACKUP/modules/$BOOT_FALLBACK ]]; then
            cp -a --reflink=auto "$BACKUP/modules/$BOOT_FALLBACK" /lib/modules/ || return 1
            local saved
            for saved in "$BACKUP/boot/"*-"$BOOT_FALLBACK"; do
                [[ ! -f $saved ]] || cp -a --reflink=auto "$saved" /boot/ || return 1
            done
        else
            log 'Fallback backup is incomplete; targeted installed-kernel package repair will be attempted'
        fi
    fi
    discovered=$(boot_kernel_versions) || { boot_fail 'Could not enumerate Linux kernels.'; return 1; }
    [[ -n $discovered ]] || { boot_fail 'No installed kernels found.'; return 1; }
    mapfile -t available <<< "$discovered"
    for kernel in "${available[@]}"; do
        if audit_step "Verify and repair kernel $kernel" boot_repair_kernel "$kernel"; then kernels+=("$kernel")
        else failed+=("$kernel"); log "Kernel $kernel could not be repaired; continuing recovery of the remaining kernels"; fi
    done
    (( ${#kernels[@]} )) || { boot_fail 'No usable kernel/initramfs pair could be prepared; the previous menu was not replaced.'; return 1; }
    boot_write_defaults || return 1
    menu=$(mktemp /boot/grub/.powerup-menu.XXXXXXXX) || return 1
    if ! audit_step 'Build and validate GRUB menu' boot_build_menu "$menu" "${kernels[@]}"; then
        rm -f -- "$menu"
        boot_fail 'Generated GRUB menu failed validation; it was not installed.'; return 1
    fi
    chmod 600 "$menu" || return 1
    cp -p -- "$menu" "$WORK/grub.cfg.validated" || return 1
    mv -f -- "$menu" /boot/grub/grub.cfg || return 1
    if [[ $phase != baseline ]]; then
        if ! boot_update_loader; then
            boot_restore_validated_menu || true
            boot_fail 'GRUB loader refresh failed. Keep the system running and review the log.'; return 1
        fi
    fi
    desktop_restore || return 1
    if [[ ${DESKTOP_ACTIVE:-0} == 1 ]] && [[ -e /var/lib/csi-powerup/grub-config-dirty || -e /var/lib/csi-powerup/plymouth-initramfs-dirty ]]; then
        audit_step 'Rebuild startup files using restored original settings' /usr/local/libexec/csi-powerup-desktop-guard finish || return 1
        for kernel in "${kernels[@]}"; do boot_initrd_valid "$kernel" || return 1; done
    fi
    boot_brand_menu /boot/grub/grub.cfg || return 1
    if ! boot_validate_menu /boot/grub/grub.cfg "${kernels[@]}"; then
        boot_restore_validated_menu || true
        boot_fail 'The loader changed the GRUB menu and its final validation failed.'; return 1
    fi
    sync -f /boot/grub/grub.cfg || return 1
    if [[ $BOOT_MODE == uefi && $phase != baseline ]]; then sync -f /boot/efi/EFI/ubuntu/grub.cfg || return 1; fi
    boot_save_good_menu || return 1
    if (( ${#failed[@]} )) || [[ " ${kernels[*]} " != *" $BOOT_FALLBACK "* ]]; then
        printf '%s\n' "${failed[@]}" > "$BACKUP/kernels-needing-repair.txt"
        boot_fail "A usable GRUB menu was restored, but some kernels/fallback still need repair: ${failed[*]} (running: $BOOT_FALLBACK). Their images were retained; no further maintenance will proceed."
        return 1
    fi
    rm -f /var/lib/csi-powerup/plymouth-initramfs-dirty || return 1
    if [[ -f /var/lib/csi-powerup/desktop-original/manifest.json && ${BOOT_MENU_FALLBACK:-0} == 1 ]]; then
        printf 'Original GRUB presentation still needs regeneration.\n' > /var/lib/csi-powerup/grub-config-dirty
        boot_fail 'A boot recovery menu was installed, but the original GRUB presentation could not be generated. No successful upgrade is reported.'
        return 1
    fi
    rm -f /var/lib/csi-powerup/grub-config-dirty || return 1
    boot_verify_preserved_kernels || return 1
    BOOT_VERIFIED=1
    if [[ $phase == baseline ]]; then
        cp -L --preserve=mode,timestamps --reflink=auto /boot/initrd.img-"$BOOT_FALLBACK" "$BACKUP/boot/" || return 1
        cp -au --reflink=auto /lib/modules/"$BOOT_FALLBACK" "$BACKUP/modules/" || return 1
        log 'Baseline kernel and menu checks passed; proceeding with maintenance'
    else
        log 'Installed boot-file checks passed. The actual firmware boot still requires verification after restart.'
    fi
}

install_kernel_guard() {
    local target=${1:-/etc/kernel/postinst.d/zzzz-csi-powerup-boot} staged=$WORK/kernel-guard
    [[ ! -L $target ]] || { boot_fail 'Kernel guard path is a symbolic link.'; return 1; }
    if [[ -e $target ]] && ! grep -Fq '# CSI Linux Powerup kernel boot guard' "$target"; then
        boot_fail 'An unrelated kernel hook occupies the Powerup guard path.'; return 1
    fi
    {
        printf '#!/bin/bash\n# CSI Linux Powerup kernel boot guard\n# Self-contained; never sources the user-owned CSI tools directory.\nset -Eeuo pipefail\nexport PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C\n'
        declare -f log boot_mounts boot_required_modules boot_initrd_valid boot_brand_menu boot_validate_menu boot_verify_presentation
        declare -f boot_kernel_versions boot_write_defaults boot_write_rescue_menu boot_build_menu boot_save_good_menu
        cat <<'KERNEL_GUARD'
(( EUID == 0 )) || exit 1
kernel=${1:-}
[[ $kernel =~ ^[0-9][A-Za-z0-9.+_-]+$ ]] || exit 1
umask 077
WORK=$(mktemp -d /var/tmp/csi-kernel-check.XXXXXXXX)
menu=''
trap 'status=$?; [[ -z $menu ]] || rm -f -- "$menu"; rm -rf -- "$WORK"; if (( status )); then printf "ERROR: CSI kernel boot guard failed for %s. Do not reboot until repaired.\n" "$kernel" >&2; fi; exit "$status"' EXIT
boot_mounts 0
if [[ -x /usr/local/libexec/csi-powerup-desktop-guard ]]; then /usr/local/libexec/csi-powerup-desktop-guard restore; fi
boot_required_modules > "$WORK/boot-required-modules"
kernel_failed=0
if [[ -s /boot/vmlinuz-$kernel && -s /lib/modules/$kernel/modules.builtin && -s /lib/modules/$kernel/modules.order ]] && depmod -a "$kernel"; then
    if [[ -e /var/lib/csi-powerup/plymouth-initramfs-dirty ]] || ! boot_initrd_valid "$kernel"; then
        mode=-u; [[ -e /boot/initrd.img-$kernel ]] || mode=-c
        update-initramfs "$mode" -k "$kernel" || kernel_failed=1
    fi
    boot_initrd_valid "$kernel" || kernel_failed=1
else
    kernel_failed=1
fi
boot_write_defaults
ready=()
while IFS= read -r found; do
    [[ -s /boot/vmlinuz-$found && -s /lib/modules/$found/modules.builtin && -s /lib/modules/$found/modules.order ]] || continue
    if boot_initrd_valid "$found"; then ready+=("$found"); fi
done < <(boot_kernel_versions)
(( ${#ready[@]} )) || exit 1
[[ " ${ready[*]} " == *" $kernel "* ]] || kernel_failed=1
menu=$(mktemp /boot/grub/.csi-kernel-menu.XXXXXXXX)
boot_build_menu "$menu" "${ready[@]}"
chmod 600 "$menu"
mv -f -- "$menu" /boot/grub/grub.cfg
menu=''
sync -f /boot/grub/grub.cfg
boot_save_good_menu
if [[ -f /var/lib/csi-powerup/desktop-original/manifest.json && ${BOOT_MENU_FALLBACK:-0} == 1 ]]; then
    printf 'Original GRUB presentation still needs regeneration.\n' > /var/lib/csi-powerup/grub-config-dirty
    printf 'Original GRUB presentation could not be regenerated; a recovery menu was installed.\n' >&2
    kernel_failed=1
fi
if (( kernel_failed )); then
    printf 'CSI kernel boot guard: restored entries for usable kernels; %s still needs repair.\n' "$kernel" >&2
    exit 1
fi
printf 'CSI kernel boot guard: %s startup image and GRUB menu checked.\n' "$kernel"
KERNEL_GUARD
    } > "$staged" || return 1
    bash -n "$staged" || return 1
    if ! cmp -s "$staged" "$target"; then
        [[ ! -e $target ]] || cp -a "$target" "$BACKUP/kernel-guard.before" || return 1
        install -o root -g root -m 755 "$staged" "$target" || return 1
    fi
    log 'Kernel installation guard is active; kernel setup cannot succeed with a missing startup image'
}

boot_id() { cat /proc/sys/kernel/random/boot_id; }
reboot_required() { [[ -f /var/run/reboot-required ]]; }

release_job_store() {
    # Root-authored data only: no shell sourcing, commands, paths or credentials
    # from the state file are executed. The desktop helper uses this same code.
    python3 - "$@" <<'PY_RELEASE_JOB'
import datetime, fcntl, json, os, pwd, stat, subprocess, sys, tempfile, uuid
from pathlib import Path
STATE=Path('/var/lib/csi-powerup-release')
RUNNER=Path('/usr/local/libexec/csi-powerup-release-runner')
OWNER=0
command=sys.argv[1]
account=pwd.getpwuid(os.getuid())
if os.geteuid()==0 and os.environ.get('SUDO_UID'):
    account=pwd.getpwuid(int(os.environ['SUDO_UID']))
    if account.pw_name!=os.environ.get('SUDO_USER'):raise SystemExit('Invalid resume account')
actor=account.pw_uid
def boot():return Path('/proc/sys/kernel/random/boot_id').read_text().strip()
def trusted(path,directory=False):
    info=path.lstat()
    if (info.st_uid!=OWNER or info.st_mode&0o022 or
        (not stat.S_ISDIR(info.st_mode) if directory else not stat.S_ISREG(info.st_mode) or info.st_nlink!=1)):
        raise ValueError('Untrusted release-job path: '+str(path))
def read():
    if not STATE.exists():return None
    trusted(STATE.parent,True)
    trusted(STATE,True)
    p=STATE/'job.json'
    if not p.exists():return None
    trusted(p)
    with p.open() as stream:
        raw=stream.read(65537)
    if len(raw)>65536:raise ValueError('Oversized release-job state')
    job=json.loads(raw)
    if (not isinstance(job,dict) or job.get('schema')!=1 or job.get('target')!='resolute'
        or job.get('source')!='noble' or job.get('arch') not in ('amd64','arm64')
        or type(job.get('uid')) is not int or job['uid']<0
        or job.get('stage') not in ('preparing','upgrading','waiting-noble-reboot',
             'waiting-resolute-reboot','finalizing','paused','complete')):
        raise ValueError('Invalid release-job state')
    if any(not isinstance(job.get(key),str) or str(uuid.UUID(job[key]))!=job[key] for key in ('id','boot_id')):
        raise ValueError('Invalid release-job identifiers')
    return job
def publish_access(job):
    # Called only as root while holding the state lock, after ownership and
    # JSON validation. chmod is explicit: mkdir's mode is masked by umask 077.
    # This metadata contains no credentials; only root retains write access.
    directory=os.open(STATE,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
    try:
        if job is not None:
            fd=os.open('job.json',os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=directory)
            try:
                info=os.fstat(fd)
                if info.st_uid!=OWNER or not stat.S_ISREG(info.st_mode) or info.st_nlink!=1 or info.st_mode&0o022:
                    raise ValueError('Unsafe release-job file; permissions were not repaired')
                os.fchmod(fd,0o644);os.fsync(fd)
            finally:os.close(fd)
        os.fchmod(directory,0o755);os.fsync(directory)
    finally:os.close(directory)
def owned(job):return job is not None and job['uid']==actor
def deferred(job):
    return owned(job) and (Path(account.pw_dir)/'.csi-cms/powerup-resume'/(job['id']+'.paused')).exists()
def route(job):
    if not job:return 'new'
    if not owned(job):return 'other-account'
    if deferred(job):return 'deferred'
    if job['stage'] in ('waiting-noble-reboot','waiting-resolute-reboot'):
        return 'wait' if job['boot_id']==boot() else 'resume'
    return job['stage']
def ready(job):return route(job)=='resume'
def recoverable(job):return owned(job) and job['stage'] in ('preparing','upgrading','finalizing','paused')
def clear_defer(job):
    # The fixed user marker is removed only with that user's credentials.
    code='import os,sys; from pathlib import Path; p=Path(sys.argv[1])/".csi-cms/powerup-resume"/(sys.argv[2]+".paused"); p.unlink(missing_ok=True)'
    credentials=dict(user=actor,group=account.pw_gid,extra_groups=os.getgrouplist(account.pw_name,account.pw_gid)) if os.geteuid()==0 else {}
    subprocess.run([sys.executable,'-I','-c',code,str(Path(account.pw_dir)),job['id']],check=True,**credentials)
def diagnostics(job):
    data=dict(current_boot_id=boot(),route=route(job),job=job if owned(job) else None,
              running_kernel=os.uname().release,uid=actor,
              xdg_config_dirs=os.environ.get('XDG_CONFIG_DIRS','/etc/xdg'))
    for name in ('/proc/uptime','/run/reboot-required','/run/reboot-required.pkgs'):
        path=Path(name)
        try:
            info=path.stat()
            data[name]=dict(content=path.read_text()[:8192],mtime=info.st_mtime,uid=info.st_uid)
        except OSError as error:data[name]=dict(available=False,reason=str(error))
    # A user's XDG override can intentionally disable a system autostart file.
    override=Path(os.environ.get('XDG_CONFIG_HOME',str(Path(account.pw_dir)/'.config')))/'autostart/csi-powerup-resume.desktop'
    try:data['user_autostart_override']=dict(path=str(override),content=override.read_text()[:8192])
    except OSError:data['user_autostart_override']=None
    return data
def save(job):
    job['updated_at']=datetime.datetime.now(datetime.timezone.utc).isoformat()
    fd,name=tempfile.mkstemp(prefix='.job-',dir=STATE)
    try:
        with os.fdopen(fd,'w') as stream:
            json.dump(job,stream,indent=2);stream.write('\n');stream.flush();os.fsync(stream.fileno())
        os.chmod(name,0o644);os.replace(name,STATE/'job.json')
        fd=os.open(STATE,os.O_RDONLY|os.O_DIRECTORY)
        try:os.fsync(fd)
        finally:os.close(fd)
    finally:
        if os.path.exists(name):os.unlink(name)
    print('Release job '+job['id']+': '+job['stage'],flush=True)
def user_folder():
    if os.geteuid()==0 and actor!=0:
        os.initgroups(account.pw_name,account.pw_gid);os.setgid(account.pw_gid);os.setuid(actor)
    home=Path(account.pw_dir)
    for folder in (home/'.csi-cms',home/'.csi-cms/powerup-resume'):
        if folder.is_symlink():raise ValueError('Resume directory is a symlink')
        folder.mkdir(mode=0o700,exist_ok=True)
        info=folder.stat()
        if info.st_uid!=actor or info.st_mode&0o022:raise ValueError('Untrusted user resume directory')
    return folder
try:
    if command=='defer':
        job=read()
        if not owned(job):sys.exit(0)
        path=user_folder()/(job['id']+'.paused')
        try:fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
        except FileExistsError:
            if path.is_symlink() or not path.is_file():raise ValueError('Invalid defer marker')
        else:os.close(fd)
        print('Automatic continuation deferred by the user');sys.exit(0)
    if command=='launch':
        folder=user_folder()
        fd=os.open(folder/'autostart.log',os.O_WRONLY|os.O_CREAT|os.O_APPEND|os.O_NOFOLLOW,0o600)
        info=os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid!=actor or info.st_nlink!=1:
            os.close(fd);raise ValueError('Invalid autostart log')
        os.dup2(fd,1);os.dup2(fd,2);os.close(fd)
        print(datetime.datetime.now(datetime.timezone.utc).isoformat()+' Checking approved release continuation',flush=True)
    if command in ('status','ready','recoverable','route','explain','launch'):
        job=read()
        if command=='status':print(json.dumps(job if owned(job) else None));sys.exit(0)
        if command=='route':print(route(job));sys.exit(0)
        if command=='recoverable':
            if not recoverable(job):sys.exit(1)
            print(job['arch']);sys.exit(0)
        if command=='explain':print(json.dumps(diagnostics(job),indent=2));sys.exit(0)
        if command=='launch':print(json.dumps(diagnostics(job),indent=2),flush=True)
        review=command=='launch' and recoverable(job) and not deferred(job)
        if not ready(job) and not review:sys.exit(1 if command=='ready' else 0)
        if command=='ready':print(job['arch']);sys.exit(0)
        trusted(RUNNER.parent,True);trusted(RUNNER)
        folder=user_folder()
        launch_lock=os.open(folder/'launcher.lock',os.O_RDWR|os.O_CREAT|os.O_NOFOLLOW,0o600)
        if not stat.S_ISREG(os.fstat(launch_lock).st_mode):raise ValueError('Invalid launcher lock')
        try:fcntl.flock(launch_lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:print('Continuation launcher is already active',flush=True);sys.exit(0)
        # Recheck after taking the lock. It stays in this parent, never the child.
        current=read()
        if not (recoverable(current) if review else ready(current)) or current['id']!=job['id']:sys.exit(0)
        marker=folder/(job['id']+'-'+boot()+('-review' if review else '')+'.started')
        if marker.exists():print('This job already returned or was cancelled on this boot',flush=True);sys.exit(0)
        attempts=folder/(job['id']+'-'+boot()+'.attempts')
        fd=os.open(attempts,os.O_RDWR|os.O_CREAT|os.O_NOFOLLOW,0o600)
        with os.fdopen(fd,'r+') as stream:
            info=os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid!=actor or info.st_nlink!=1:raise ValueError('Invalid attempt counter')
            count=int(stream.read() or '0')
            if not 0<=count<3:print('Automatic startup attempt limit reached; review the saved logs',flush=True);sys.exit(0)
            count+=1;stream.seek(0);stream.write(str(count));stream.truncate();stream.flush();os.fsync(stream.fileno())
        print('Starting continuation attempt '+str(count),flush=True)
        result=subprocess.run(['/bin/bash',str(RUNNER)]+([] if review else ['--resume-release']),check=False).returncode
        after=read()
        unchanged=ready(after) and after['id']==job['id'] and after['stage']==job['stage']
        if result!=0 and unchanged:
            # A failed launch/version check did not claim the job. Permit a
            # later desktop-login retry (at most three per boot), not APT replay.
            print('Startup returned '+str(result)+' before claiming the job; another login may retry',flush=True)
            sys.exit(1)
        fd=os.open(marker,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
        with os.fdopen(fd,'w') as stream:stream.write('Completed launcher attempt; status='+str(result)+'\n')
        print('Continuation returned '+str(result)+'; route='+route(after),flush=True)
        sys.exit(0 if result==0 else 1)
    if os.geteuid()!=OWNER:raise ValueError('Release-job changes require administrator access')
    if command in ('pause-owned','repair-access') and not STATE.exists() and not STATE.is_symlink():
        if command=='repair-access':print('No saved release job requires access repair')
        sys.exit(0)
    if STATE.is_symlink():raise ValueError('Release-job directory is a symlink')
    trusted(STATE.parent,True)
    STATE.mkdir(mode=0o755,exist_ok=True);trusted(STATE,True)
    lock=os.open(STATE/'lock',os.O_RDWR|os.O_CREAT|os.O_NOFOLLOW,0o600)
    info=os.fstat(lock)
    if info.st_uid!=OWNER or not stat.S_ISREG(info.st_mode) or info.st_nlink!=1 or info.st_mode&0o022:
        os.close(lock);raise ValueError('Unsafe release-job lock')
    with os.fdopen(lock,'w') as locked:
        fcntl.flock(locked,fcntl.LOCK_EX)
        job=read()
        publish_access(job)
        if command=='repair-access':
            print('Saved release-job access verified: directory 0755, job 0644; progress unchanged')
        elif command=='begin':
            arch=sys.argv[2]
            if arch not in ('amd64','arm64'):raise ValueError('Unsupported release-job architecture')
            if job and job['stage']!='complete' and not owned(job):raise ValueError('Another account owns the pending release upgrade')
            if owned(job) and route(job) in ('wait','resume'):raise ValueError('An approved job already exists; wait for reboot or resume it instead of replacing it')
            if owned(job) and job['stage']=='paused' and not deferred(job):
                if job['arch']!=arch:raise ValueError('Paused release job has a different architecture')
                # Explicitly retry the same approved upgrade. Keep its identity so
                # desktop_prepare reuses the pre-upgrade snapshot after a failure.
                job['stage']='preparing';job['boot_id']=boot()
                print('Retrying paused release job; retained pre-upgrade snapshot identity')
            else:
                job=dict(schema=1,id=str(uuid.uuid4()),uid=actor,source='noble',target='resolute',arch=arch,stage='preparing',boot_id=boot())
            save(job)
        elif command=='claim-recovery':
            if not recoverable(job) or job['arch']!=sys.argv[2] or sys.argv[3] not in ('noble','resolute'):
                raise ValueError('No interrupted approved upgrade matches this account/platform')
            clear_defer(job)
            job['resumed_from']=job['stage']
            job['stage']='preparing' if sys.argv[3]=='noble' else 'finalizing'
            job['boot_id']=boot();save(job)
        elif command=='claim':
            if not ready(job) or job['arch']!=sys.argv[2]:raise ValueError('Release job is not ready for this account/architecture/boot')
            expected='noble' if job['stage']=='waiting-noble-reboot' else 'resolute'
            if sys.argv[3]!=expected:raise ValueError('Installed release disagrees with the saved upgrade stage')
            job['stage']='preparing' if expected=='noble' else 'finalizing';job['boot_id']=boot();save(job)
        elif command=='pause-owned':
            if owned(job) and job['stage']!='complete':job['stage']='paused';save(job)
        elif command=='stage':
            if not owned(job):raise ValueError('No release job for this account')
            stage=sys.argv[2]
            allowed={'preparing':{'upgrading','waiting-noble-reboot','paused'},
                     'upgrading':{'waiting-resolute-reboot','paused'},
                     'finalizing':{'complete','waiting-resolute-reboot','paused'},'complete':{'paused'},
                     'waiting-noble-reboot':{'paused'},'waiting-resolute-reboot':{'paused'},'paused':{'paused'}}
            if stage not in allowed.get(job['stage'],set()):raise ValueError('Invalid release-job transition')
            if stage=='complete' and sys.argv[3:]!=['resolute']:raise ValueError('Completion requires verified Resolute')
            job['stage']=stage;job['boot_id']=boot();save(job)
        else:raise ValueError('Unknown release-job operation')
except PermissionError as error:
    print('ERROR: Release resume access requires administrator repair: '+str(error),file=sys.stderr);sys.exit(77)
except (OSError,ValueError,KeyError,TypeError,subprocess.CalledProcessError) as error:
    print('ERROR: Release resume state: '+str(error),file=sys.stderr);sys.exit(1)
PY_RELEASE_JOB
}


release_install_resume_file() {
    # Readers must see the old complete file or the new complete file, including
    # when a desktop login races with helper refresh. Never install in-place.
    local source=$1 target=$2 mode=$3 staged
    staged=$(mktemp "${target%/*}/.csi-resume.XXXXXXXX") || return 1
    if ! install -m "$mode" "$source" "$staged" || ! mv -fT -- "$staged" "$target"; then
        rm -f -- "$staged"
        return 1
    fi
    sync -f "$target" && sync -f "${target%/*}"
}

