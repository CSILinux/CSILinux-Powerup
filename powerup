            raise RuntimeError('hard-link inventory reached its bounded scan limit')
    def directory_signature(value):
        return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_gid,value.st_mtime_ns,value.st_ctime_ns)
