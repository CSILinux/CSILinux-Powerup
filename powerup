(( EUID == 0 )) || exit 1
umask 077
WORK=$(mktemp -d /var/tmp/csi-grub-preservation.XXXXXXXX)
menu=''
stage='check boot mounts';kernel=''
trap 'result=$?; printf "ERROR: GRUB preservation: stage=%s kernel=%s line=%s status=%s\n" "$stage" "${kernel:-none}" "$LINENO" "$result" >&2; exit "$result"' ERR
trap 'status=$?; [[ -z $menu ]] || rm -f -- "$menu"; rm -rf -- "$WORK"; exit "$status"' EXIT
boot_mounts 0
if [[ ${1:-} == --check-mounts ]]; then exit 0; fi
