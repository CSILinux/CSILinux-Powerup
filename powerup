    # keystrokes/password input. The separate transcript is copied into the
    # main log even when the Ubuntu frontend returns an error.
    local transcript=$WORK/release-terminal.log result=0
    command -v script >/dev/null || die 'util-linux script is required for release-upgrade output capture.'
