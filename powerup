read_platform() {
    local release_file=${1:-/etc/os-release}
    local ID='' ID_LIKE='' VERSION_ID='' VERSION_CODENAME='' UBUNTU_CODENAME=''
    [[ -r $release_file ]] || die "$release_file is missing."
    # shellcheck disable=SC1090
    . "$release_file"
    BASE_CODENAME=${UBUNTU_CODENAME:-${VERSION_CODENAME:-}}
    case $BASE_CODENAME in
        noble|resolute) ;;
        *) die "Supported bases: noble (upgrade to 26.04 LTS), resolute (maintain). Detected '${BASE_CODENAME:-unknown}'." ;;
    esac
    [[ $ID == ubuntu || " $ID_LIKE " == *' ubuntu '* || -n $UBUNTU_CODENAME ]] ||
        die 'Cannot verify an Ubuntu base.'
    if [[ $ID == ubuntu ]]; then
        [[ $BASE_CODENAME:$VERSION_ID == noble:24.04 || $BASE_CODENAME:$VERSION_ID == resolute:26.04 ]] ||
            die "Inconsistent Ubuntu version: $VERSION_ID / $BASE_CODENAME."
    fi
}

validate_platform() {
    read_platform
    ARCH=$(dpkg --print-architecture)
    case $ARCH in
        amd64|arm64|armhf|riscv64) ;;
        i386) die 'Detected native i386 userspace. Ubuntu 26.04 has no i386 kernel/installer; install a supported native Ubuntu base. An amd64 host with foreign i386 packages is supported.' ;;
        *) die "Detected unsupported package architecture '$ARCH'; no repository or boot changes were made." ;;
    esac
    command -v python3 >/dev/null || die 'python3 is required (normally included with CSI Linux).'
    [[ -s /usr/share/keyrings/ubuntu-archive-keyring.gpg ]] || die 'Ubuntu archive keyring is missing; repair ubuntu-keyring first.'
}

platform_report() {
    # Package ABI and kernel architecture are different facts (including in
    # chroots and with multiarch). Never use uname alone to choose packages.
    python3 - <<'PY_PLATFORM_REPORT'
import json, pathlib, subprocess
def query(*args):
    result=subprocess.run(args,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
    if result.returncode: raise SystemExit(result.stderr)
    return result.stdout.strip()
arch=query('dpkg','--print-architecture')
labels={'i386':'32-bit x86 (supplementary Ubuntu packages only)','amd64':'64-bit x86 / x64',
        'armhf':'32-bit ARM hard-float','arm64':'64-bit ARM / AArch64','riscv64':'64-bit RISC-V'}
efi=pathlib.Path('/sys/firmware/efi').is_dir()
report=dict(package_architecture=arch,architecture_name=labels.get(arch,'Unsupported'),
            kernel_architecture=query('uname','-m'),foreign_package_architectures=query('dpkg','--print-foreign-architectures').split(),
            firmware='UEFI' if efi else 'non-UEFI; BIOS or board firmware requires inspection',
            ubuntu_archive='archive.ubuntu.com' if arch in ('amd64','i386') else 'ports.ubuntu.com',
            tor_project_repository=arch in ('amd64','arm64'),
            powerup_boot_route_supported=arch=='amd64' or (arch=='arm64' and efi),
            complete_csi_install_certified=False,
            notes=['i386 is not a complete Ubuntu 26.04 OS target.',
                   'RISC-V 26.04 requires RVA23S64 hardware; a riscv64 label alone does not establish compatibility.',
                   'ARM board firmware/U-Boot and RISC-V require a board-specific boot workflow.',
                   'The published CSI updater and archive must support the native package ABI.'])
print(json.dumps(report,indent=2))
PY_PLATFORM_REPORT
}

normalize_categories() {
    local requested category found all_requested=0
    SELECTED=()
    for requested in "${REQUESTED[@]}"; do
        if [[ $requested == all ]]; then all_requested=1; continue; fi
        found=0
        for category in "${CATEGORIES[@]}"; do
            if [[ $requested == "$category" ]]; then found=1; break; fi
        done
        (( found )) || { PLAN_ERROR="Unknown category: $requested"; return 1; }
        if [[ " ${SELECTED[*]} " != *" $requested "* ]]; then SELECTED+=("$requested"); fi
    done
    if (( all_requested )); then
        (( ${#REQUESTED[@]} == 1 )) || { PLAN_ERROR="Choose all OR individual categories; these choices cannot be combined."; return 1; }
        SELECTED=("${CATEGORIES[@]}")
    fi
}

validate_options() {
    PLAN_ERROR=''
    if (( ${CSI_TOOLS_ONLY:-0} )); then
        if (( CHECK_ONLY || TEST_PACKAGES || FULL_UPGRADE || REFRESH_TOOLS || RELEASE_UPGRADE || ${RESUME_RELEASE:-0} || ${#REQUESTED[@]} )) ||
            [[ -n ${TOOL_ACTION:-}${CATEGORY_ACTION:-} ]]; then
            PLAN_ERROR='Choose Update CSI tools by itself, or Full system update which already includes it.'; return 1
        fi
        SELECTED=();return 0
    fi
    if (( ${TEST_PACKAGES:-0} )); then
        if [[ -n ${TOOL_ACTION:-}${CATEGORY_ACTION:-} ]] || (( CHECK_ONLY || FULL_UPGRADE || REFRESH_TOOLS || RELEASE_UPGRADE || ${RESUME_RELEASE:-0} || ${#REQUESTED[@]} )); then
            PLAN_ERROR='Test packages is a separate read-only action.'; return 1
        fi
        SELECTED=();return 0
    fi
    if [[ -n ${CATEGORY_ACTION:-} ]]; then
        if [[ -n ${TOOL_ACTION:-} ]] || (( CHECK_ONLY || FULL_UPGRADE || REFRESH_TOOLS || RELEASE_UPGRADE || ${RESUME_RELEASE:-0} )); then
            PLAN_ERROR='Choose one category action without other update modes.'; return 1
        fi
        if ! category_data validate "${REQUESTED[@]}"; then PLAN_ERROR='Select one or more CSI package categories.'; return 1; fi
        PACKAGE_CATEGORIES=("${REQUESTED[@]}");SELECTED=();return 0
    fi
    if [[ -n ${TOOL_ACTION:-} ]]; then
        if (( CHECK_ONLY || FULL_UPGRADE || REFRESH_TOOLS || RELEASE_UPGRADE || ${RESUME_RELEASE:-0} )); then
            PLAN_ERROR='Choose tool updates OR tool removal, without system or release-upgrade options.'; return 1
        fi
        (( ${#REQUESTED[@]} )) || { PLAN_ERROR='Select at least one installed tool package.'; return 1; }
        local package
        for package in "${REQUESTED[@]}"; do
            [[ $package =~ ^[a-z0-9][a-z0-9.+-]+(:[a-z0-9]+)?$ ]] || { PLAN_ERROR='Invalid tool package name.'; return 1; }
        done
        SELECTED=(); TOOL_PACKAGES=("${REQUESTED[@]}")
        return 0
    fi
    normalize_categories || return 1
    local category tool_count=0
    for category in "${SELECTED[@]}"; do [[ $category == os-update ]] || tool_count=$((tool_count+1)); done
    if (( ${RESUME_RELEASE:-0} && (CHECK_ONLY || FULL_UPGRADE || REFRESH_TOOLS || tool_count) )); then
        PLAN_ERROR='A saved release upgrade cannot be combined with other actions.'; return 1
    fi
    if (( ${RELEASE_UPGRADE:-0} )) && { [[ $BASE_CODENAME != noble ]] || (( CHECK_ONLY || FULL_UPGRADE || REFRESH_TOOLS || tool_count )); }; then
        PLAN_ERROR='Release upgrade is a separate action for Ubuntu 24.04 only.'; return 1
    fi
    if (( CHECK_ONLY && (FULL_UPGRADE || REFRESH_TOOLS || tool_count) )); then
        PLAN_ERROR='Preview is read-only. Choose it without update or tool options.'; return 1
    fi
    if [[ $BASE_CODENAME == noble ]] && (( FULL_UPGRADE || tool_count )); then
        PLAN_ERROR='Use Update CSI tools or package groups to stay on Ubuntu 24.04. Legacy category scripts and full package removals require Resolute.'; return 1
    fi
    # One operation profile: an archive restore is not a category update.
    if (( REFRESH_TOOLS && (FULL_UPGRADE || tool_count) )) || (( FULL_UPGRADE && tool_count )); then
        PLAN_ERROR='Choose one profile: system update, full package upgrade, tool categories, or archive restore.'; return 1
    fi
}

make_auth_helper() {
    local directory=$1 prompt=$2
    {
        printf '#!/bin/bash\nset +x\n'
        printf 'auth_dir=%q\nprompt=%q\n' "$directory" "$prompt"
        declare -f powerup_dialog_error
        cat <<'ASKPASS_BODY'
[[ ! -e $auth_dir/auth.cancel ]] || exit 1
if [[ -e $auth_dir/auth.tried ]]; then
    prompt='Authentication was not accepted. Re-enter your administrator password, or Cancel to close Powerup.'
fi
: > "$auth_dir/auth.tried"
: > "$auth_dir/auth.prompted"
ASKPASS_BODY
        if command -v yad >/dev/null; then
            # shellcheck disable=SC2016
            printf 'env LC_ALL=C.UTF-8 LANG=C.UTF-8 LANGUAGE=C GTK_THEME=Adwaita:dark XDG_CONFIG_HOME=%q %q --entry --hide-text --center --on-top --width=500 --title=%q --text="$prompt" --button=%q --button=%q 2>"$auth_dir/auth.dialog-errors"\n' \
                "$directory/config" "$(command -v yad)" 'CSI Linux — Authentication' 'Cancel:1' 'Authenticate:0'
        else
            # shellcheck disable=SC2016
            printf 'env LC_ALL=C.UTF-8 LANG=C.UTF-8 LANGUAGE=C %q --password --title=%q --text="$prompt" 2>"$auth_dir/auth.dialog-errors"\n' "$(command -v zenity)" 'CSI Linux — Authentication'
        fi
        # shellcheck disable=SC2016
        cat <<'ASKPASS_RESULT'
status=$?
cat "$auth_dir/auth.dialog-errors" >&2
if (( status != 0 )); then
    if { (( status == 1 || status == 252 )); } && ! powerup_dialog_error "$auth_dir/auth.dialog-errors"; then
        : > "$auth_dir/auth.cancel"
    else
        : > "$auth_dir/auth.error"
        printf 'ERROR: Authentication dialog failed to open or complete (status %s).\n' "$status" >&2
    fi
    exit 1
fi
ASKPASS_RESULT
    } > "$directory/askpass.sh"
    chmod 700 "$directory/askpass.sh"
}

authenticated_run() {
    local directory=$1 status attempt=0; shift
    [[ -n ${AUDIT_CONTEXT:-} ]] || AUDIT_CONTEXT=authentication
    while :; do
        attempt=$((attempt+1))
        audit_event authentication '' '' '' "Administrator authentication attempt $attempt"
        rm -f -- "$directory/auth.prompted"
        status=0
        # Reserve 200 for child status 1, so a failed maintenance command is
        # never mistaken for sudo authentication failure and run a second time.
        # Passwords go directly from askpass to sudo, never to this process.
        SUDO_ASKPASS="$directory/askpass.sh" sudo -A --preserve-env=DISPLAY,XAUTHORITY -- \
            /bin/bash -c '"$@"; result=$?; if (( result == 1 )); then exit 200; fi; exit "$result"' powerup-auth "$@" || status=$?
        [[ ! -e $directory/auth.error ]] || { audit_event failure '' 70 '' 'Authentication dialog failed'; return 70; }
        [[ ! -e $directory/auth.cancel ]] || { audit_event cancelled '' 130 '' 'Administrator cancelled authentication'; return 130; }
        (( status != 200 )) || { audit_event command-return '' 1 '' 'Authenticated command returned a failure'; return 1; }
        (( status == 1 )) || { audit_event command-return '' "$status" '' 'Administrator command returned'; return "$status"; }
        # A policy/tool error that never opened askpass is not a bad password.
        [[ -e $directory/auth.prompted ]] || { audit_event failure '' 1 '' 'Sudo policy or launch failure before prompting'; return 1; }
        audit_event retry '' 1 '' 'Authentication rejected; prompt will reopen'
        printf 'Authentication was not accepted; retry or Cancel to close Powerup.\n' >&2
    done
}

elevate() {
    local self=$1; shift
    local askdir status
    powerup_log_arguments
    if [[ -t 0 ]]; then
        exec sudo -- /bin/bash "$self" "${POWERUP_LOG_ARGS[@]}" "$@"
    elif command -v zenity >/dev/null && [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
        # sudo obtains the password directly from askpass. No password variable,
        # command-line argument, log entry, or long-running credential keepalive.
        askdir=$(mktemp -d "${TMPDIR:-/tmp}/powerup-askpass.XXXXXXXX")
        chmod 700 "$askdir"
        make_auth_helper "$askdir" 'Enter your administrator password, or Cancel to close Powerup.'
        status=0
        authenticated_run "$askdir" /bin/bash "$self" "${POWERUP_LOG_ARGS[@]}" "$@" || status=$?
        rm -rf -- "$askdir"
        exit "$status"
    elif command -v pkexec >/dev/null; then
        exec pkexec /bin/bash "$self" "${POWERUP_LOG_ARGS[@]}" "$@"
    else
        die 'Open a terminal and run this script with sudo.'
    fi
}

# Parse both APT formats. Touch only identified Ubuntu/Tor sources, preserving
# unrelated repositories and comments. A transaction manifest supports rollback.
repository_config() {
    python3 - "$@" <<'PY_REPOSITORIES'
import json, os, re, shlex, shutil, sys, tempfile
from pathlib import Path
from urllib.parse import urlsplit

mode, root_s, backup_s, tor_enabled, arch = sys.argv[1:6]
repair_current = mode == 'repair-current'
release_prep = mode == 'prepare-release'
series = sys.argv[6] if repair_current and len(sys.argv)>6 else ('noble' if release_prep else 'resolute')
if series not in ('noble','resolute'): raise SystemExit('Unrecognized installed Ubuntu series')
if arch not in ('amd64','arm64','armhf','riscv64','i386'): raise SystemExit('Unrecognized package architecture')
if tor_enabled == '1' and arch not in ('amd64','arm64'): raise SystemExit('Tor Project repository does not publish this architecture')
root, backup = Path(root_s), Path(backup_s)
manifest = backup / 'manifest.json'
ubuntu_target = root / 'sources.list.d/csi-powerup-ubuntu.sources'
tor_target = root / 'sources.list.d/csi-powerup-tor.sources'

def atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    fd, temp = tempfile.mkstemp(prefix='.powerup-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(text)
        os.chmod(temp, 0o644)
        os.replace(temp, path)
    finally:
        if os.path.exists(temp): os.unlink(temp)

if mode == 'rollback':
    if manifest.exists():
        for relative, existed in json.loads(manifest.read_text()).items():
            path = root / relative
            if existed:
                shutil.copy2(backup / 'files' / relative, path)
            else:
                path.unlink(missing_ok=True)
        print('Restored APT source files from', backup)
    sys.exit(0)
if mode not in ('configure', 'prepare-release', 'verify', 'repair-current'): raise SystemExit('Unknown repository operation')

def kind(uri, signed=''):
    host = (urlsplit(uri).hostname or '').lower()
    if host == 'deb.torproject.org': return 'tor'
    if (host in ('archive.ubuntu.com', 'security.ubuntu.com', 'ports.ubuntu.com',
                 'old-releases.ubuntu.com') or host.endswith('.archive.ubuntu.com')
            or 'ubuntu-archive-keyring.gpg' in signed): return 'ubuntu'
    return 'other'

# Do not rewrite a PPA's distribution. Refuse recognizable mismatched Ubuntu
# release suites rather than quietly leave a mixed-release package source active.
old_series = set('precise trusty xenial bionic focal jammy kinetic lunar mantic noble oracular plucky questing resolute stonking devel'.split()) - {series}
def mismatched(suites): return any(s.split('-')[0] in old_series for s in suites)
def check_other(suites, path):
    for suite in suites:
        if suite.split('-')[0] in old_series:
            raise ValueError(f'{path}: unrelated repository uses {suite}; disable it or verify its Resolute support first')

def stanza_fields(block):
    fields, last = {}, None
    for line in block.splitlines():
        if not line.strip() or line.lstrip().startswith('#'): continue
        if line[:1].isspace() and last:
            fields[last] += ' ' + line.strip()
        else:
            key, sep, value = line.partition(':')
            if not sep: raise ValueError('Malformed deb822 line: ' + line)
            last = key.lower()
            if last in fields: raise ValueError('Duplicate deb822 field: ' + key)
            fields[last] = value.strip()
    return fields

changes = {}
paths = sorted(set([root / 'sources.list', *root.glob('sources.list.d/*.list'),
                    *root.glob('sources.list.d/*.sources')]))
for path in paths:
    if not path.exists(): continue
    if path.is_symlink(): raise ValueError(f'{path}: symlinked source files require manual review')
    original = path.read_text()
    pieces = []
    has_other = False
    if path.suffix == '.sources':
        for block in re.split(r'\n[ \t]*\n', original):
            fields = stanza_fields(block)
            if not fields or fields.get('enabled', 'yes').lower() == 'no':
                pieces.append(block); continue
            uris = fields.get('uris', '').split()
            if not uris: raise ValueError(f'{path}: active stanza has no URIs')
            kinds = {kind(u, fields.get('signed-by', '')) for u in uris}
            if not release_prep and 'other' in kinds and len(kinds) > 1:
                raise ValueError(f'{path}: mixed Ubuntu/Tor and unrelated URIs in one stanza')
            if repair_current and kinds == {'tor'} and not mismatched(fields.get('suites','').split()) and arch in ('amd64','arm64'):
                pieces.append(block)
            elif repair_current and 'other' in kinds and mismatched(fields.get('suites','').split()):
                pieces.append('# Disabled incompatible third-party suite; original retained in Powerup backup.')
            elif release_prep or kinds <= {'ubuntu', 'tor'}:
                reason = 'Disabled for Ubuntu release upgrade; original in Powerup backup.' if release_prep else 'Source replaced by CSI Powerup managed deb822 sources.'
                pieces.append('# ' + reason)
            else:
                has_other = True
                check_other(fields.get('suites', '').split(), path)
                pieces.append(block)
        updated = '\n\n'.join(pieces).rstrip() + '\n'
    else:
        for line in original.splitlines(keepends=True):
            if not re.match(r'^\s*deb(?:-src)?\s', line): pieces.append(line); continue
            tokens = shlex.split(line, comments=True)
            i, options = 1, []
            if tokens[i].startswith('['):
                while i < len(tokens):
                    options.append(tokens[i]); i += 1
                    if options[-1].endswith(']'): break
            if len(tokens) <= i + 1: raise ValueError(f'{path}: malformed deb source')
            uri, suite = tokens[i:i+2]
            source_kind = kind(uri, ' '.join(options))
            if repair_current and source_kind == 'tor' and not mismatched([suite]) and arch in ('amd64','arm64'):
                pieces.append(line)
            elif repair_current and source_kind == 'other' and mismatched([suite]):
                pieces.append('# Disabled incompatible suite by CSI Powerup: ' + line.lstrip())
            elif release_prep or source_kind != 'other':
                pieces.append('# Disabled by CSI Powerup: ' + line.lstrip())
            else:
                has_other = True; check_other([suite], path); pieces.append(line)
        updated = ''.join(pieces)
    if path == tor_target and repair_current:
        if updated != original: changes[path] = updated
        continue
    if path in (ubuntu_target, tor_target):
        if has_other: raise ValueError(f'{path}: managed filename contains unrelated sources')
        continue
    if updated != original: changes[path] = updated

# Signed HTTP is used only for dependency bootstrap, allowing CA certificates
# themselves to be installed. Final configuration always uses HTTPS.
scheme = 'https' if tor_enabled == '1' else 'http'
archive = f'{scheme}://archive.ubuntu.com/ubuntu' if arch in ('amd64','i386') else f'{scheme}://ports.ubuntu.com/ubuntu-ports'
security = f'{scheme}://security.ubuntu.com/ubuntu' if arch in ('amd64','i386') else archive
changes[ubuntu_target] = f'''# Managed by CSI Linux Powerup. Original sources are backed up.
Types: deb
URIs: {archive}
Suites: {series} {series}-updates {series}-backports
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: {security}
Suites: {series}-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
'''
if not repair_current: changes[tor_target] = f'''# Managed by CSI Linux Powerup. Stable Tor packages only.
Types: deb
URIs: https://deb.torproject.org/torproject.org/
Suites: {series}
Components: main
Architectures: {arch}
Signed-By: /etc/apt/keyrings/csi-torproject.gpg
''' if tor_enabled == '1' else '# Tor repository temporarily disabled during dependency bootstrap.\n'
changes = {p: data for p, data in changes.items() if not p.exists() or p.read_text() != data}
if mode == 'verify':
    print('Repository configuration matches.' if not changes else 'Repository configuration needs maintenance.')
    sys.exit(1 if changes else 0)
backup.mkdir(parents=True, exist_ok=True, mode=0o700)
entries = json.loads(manifest.read_text()) if manifest.exists() else {}
# Save the complete rollback manifest before the first mutation.
for path in changes:
    relative = str(path.relative_to(root))
    if relative not in entries:
        entries[relative] = path.exists()
        if path.exists():
            dest = backup / 'files' / relative
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, dest)
atomic(manifest, json.dumps(entries, indent=2) + '\n')
for path, data in changes.items():
    atomic(path, data)
    print('Configured', path)
if not changes: print('APT source files already match the requested configuration.')
print(f'Ubuntu suites: {series} {series}-updates {series}-security {series}-backports')
print('Ubuntu components: main restricted universe multiverse')
if release_prep: print('Third-party sources disabled for the release upgrade; original files retained in backup.')
if tor_enabled == '1':
    print(f'Tor repository: https://deb.torproject.org/torproject.org/ resolute main ({arch})')
PY_REPOSITORIES
}

reconcile_current_repositories() {
    # Transactional, current-release-only repair. Unknown third-party sources
    # are never retargeted. Incompatible known Ubuntu suites are backed up and
    # disabled; only official Ubuntu sources are consolidated.
    local saved=$BACKUP/current-repositories
    audit_step 'Reconcile repositories with the installed Ubuntu release' repository_config repair-current /etc/apt "$saved" 0 "$ARCH" "$BASE_CODENAME" || return 1
    if apt_refresh; then
        assert_current_release_sources || return 1
        CURRENT_SOURCES_READY=1
    else
        if [[ ${PACKAGE_BUSY:-0} == 1 ]]; then
            log "Source rollback deferred while another package task is active; original sources are retained in $saved"
            return 76
        fi
        audit_step 'Restore source files after unsuccessful index refresh' repository_config rollback /etc/apt "$saved" 0 "$ARCH" || return 1
        return 1
    fi
}

# Observe real kernel locks, not the mere existence of apt/dpkg lock files.
# A Powerup flock cannot serialize external apt/dpkg/unattended-upgrade jobs.
package_lock_monitor() {
    python3 - "${1:--1}" <<'PY_PACKAGE_LOCKS'
import datetime,json,math,os,pwd,re,signal,stat,sys,tempfile,time
from pathlib import Path
LOCK_PATHS=('/var/lib/dpkg/lock-frontend','/var/lib/dpkg/lock',
            '/var/lib/apt/lists/lock','/var/cache/apt/archives/lock')
PROC=Path('/proc')

def blockers():
    targets={}
    for name in LOCK_PATHS:
        path=Path(name)
        try:info=path.lstat()
        except FileNotFoundError:
            if not path.parent.is_dir():raise RuntimeError('Missing package lock directory: '+str(path.parent))
            continue
        if not stat.S_ISREG(info.st_mode):raise RuntimeError('Package lock is not a regular file: '+name)
        targets[(os.major(info.st_dev),os.minor(info.st_dev),info.st_ino)]=name
    found=[]
    for line in (PROC/'locks').read_text().splitlines():
        fields=line.split()
        if len(fields)<8 or fields[1]=='->':continue  # queued waiter, not owner
        try:
            dev=fields[5].split(':');key=(int(dev[0],16),int(dev[1],16),int(dev[2]))
            pid=int(fields[4])
        except (ValueError,IndexError):raise RuntimeError('Unrecognized kernel lock record')
        if key in targets:found.append(dict(path=targets[key],pid=pid,kind=fields[1],access=fields[3]))
    return sorted(found,key=lambda row:(row['path'],row['pid']))

def process(pid):
    info=dict(pid=pid)
    if pid<=0:return info
    root=PROC/str(pid)
    try:
        raw=(root/'stat').read_text();end=raw.rfind(')');fields=raw[end+2:].split()
        info.update(name=raw[raw.find('(')+1:end],state=fields[0],ppid=int(fields[1]),tty=int(fields[4]),
            elapsed_seconds=round(float((PROC/'uptime').read_text().split()[0])-int(fields[19])/os.sysconf('SC_CLK_TCK'),1),
            cpu_ticks=int(fields[11])+int(fields[12]),wait_channel=(root/'wchan').read_text().strip())
        info['stdin']=os.readlink(root/'fd/0')
        info['uid']=root.stat().st_uid
        try:info['user']=pwd.getpwuid(info['uid']).pw_name
        except KeyError:info['user']=str(info['uid'])
        # Report only recognized package operands, never complete command lines.
        args=(root/'cmdline').read_bytes()[:65536].split(b'\0')
        args=[part.decode(errors='replace') for part in args if part]
        info['packages']=package_operands(args)
    except (OSError,ValueError,IndexError) as error:info['observation_error']=str(error)
    return info

def package_operands(args):
    if len(args)<3:return []
    name=Path(args[0]).name
    actions={'dpkg':{'--configure','--remove','--purge'},'apt':{'install','remove','purge','reinstall'},'apt-get':{'install','remove','purge','reinstall'}}
    if args[1] not in actions.get(name,set()):return []
    values=args[2:]
    if values and all(re.fullmatch(r'[a-z0-9][a-z0-9+.-]+(?::[a-z0-9]+)?',v) for v in values):return values[:12]
    return []

def lock_status(phase,owners,active,elapsed,held=0,reason=None):
    pids=sorted({row['pid'] for row in owners+active})
    details=[process(pid) for pid in pids]
    def clean(value):return re.sub(r'[^A-Za-z0-9_.:+-]','_',str(value))[:80]
    owner_text='; '.join(clean(row.get('name','unknown'))+' (PID '+str(row['pid'])+', user '+clean(row.get('user','unknown'))+')' for row in details)
    packages=sorted({name for row in details for name in row.get('packages',[])})
    label=('Locked: '+', '.join(sorted({row['path'] for row in owners}))+'. Owner: ' if owners else 'Remaining package processes: ')+owner_text
    if packages:label+='; package(s): '+', '.join(packages)
    countdown=max(0,math.ceil(TERM_AFTER-held))
    if phase=='waiting':message=label+'. Please wait — '+str(int(elapsed))+'s elapsed; automatic recovery check in '+str(countdown)+'s without observed progress.'
    elif phase=='stopping':message=label+'. Please wait — termination requested; waiting for package processes to exit ('+str(int(elapsed))+'s elapsed).'
    elif phase=='attempt':message='Checking automatic lock recovery after '+str(int(held))+'s. '+label+'. Please wait.'
    elif phase=='deferred':message=label+'. Automatic recovery is deferred while package activity is protected or cannot be verified. Please wait — '+str(int(elapsed))+'s elapsed.'
    elif phase=='released':message='Package locks and tracked processes are clear after '+str(int(elapsed))+'s. Checking package health before continuing.'
    elif phase=='busy':message=label+'. Package activity remains; progress is saved. Further installation waits for it to finish.'
    else:raise ValueError('Invalid package lock display phase')
    print('POWERUP_LOCK_STATUS='+json.dumps(dict(schema=1,phase=phase,timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(),elapsed_seconds=round(elapsed,1),owner_seconds=round(held,1),recovery_after_seconds=TERM_AFTER,countdown_seconds=countdown,locks=owners,processes=details,reason=reason,message=message),sort_keys=True),flush=True)

def evidence(owners,elapsed):
    processes=[];seen=set()
    for owner in owners:
        pid=owner['pid']
        for _ in range(6):
            if pid<=0 or pid in seen:break
            seen.add(pid);info=process(pid);processes.append(info);pid=info.get('ppid',0)
    activity=[]
    for name in ('/var/log/dpkg.log','/var/log/apt/term.log','/var/log/dist-upgrade/main.log'):
        try:
            info=Path(name).stat();activity.append(dict(path=name,size=info.st_size,mtime=info.st_mtime))
        except OSError:pass
    print('PACKAGE_LOCK_WAIT='+json.dumps(dict(timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(),
          elapsed_seconds=round(elapsed,1),locks=owners,processes=processes,log_activity=activity),sort_keys=True),flush=True)

# Persist the processes we observed before a termination request. The journal
# prevents a later run from overlooking children left behind without a lock.
STATE=Path('/var/lib/csi-powerup/package-recovery/state.json')
ROOT_UID=0
TERM_AFTER=300
TERM_GRACE=60
POLL=5
REPORT_EVERY=10
TRUSTED_BINARIES={'/usr/bin/apt','/usr/bin/apt-get','/usr/bin/dpkg','/usr/bin/aptitude'}
TRUSTED_SCRIPTS={'/usr/bin/unattended-upgrade','/usr/bin/do-release-upgrade'}
BOOT_NAMES={'update-initramfs','mkinitramfs','dracut','update-grub','update-grub2',
 'grub-install','grub-mkconfig','grub-probe','flash-kernel','kernel-install','depmod','dkms'}

def current_boot_id():
    value=(PROC/'sys/kernel/random/boot_id').read_text().strip()
    if not re.fullmatch(r'[0-9a-f-]{36}',value):raise RuntimeError('Cannot verify the current boot identity')
    return value

def read_state():
    try:
        st=STATE.lstat()
    except FileNotFoundError:return None
    if not stat.S_ISREG(st.st_mode) or st.st_uid!=ROOT_UID or st.st_mode&0o077 or st.st_nlink!=1:
        raise RuntimeError('Untrusted package recovery journal')
    parent=STATE.parent.lstat()
    if not stat.S_ISDIR(parent.st_mode) or parent.st_uid!=ROOT_UID or parent.st_mode&0o077:
        raise RuntimeError('Untrusted package recovery directory')
    state=json.loads(STATE.read_text())
    if not isinstance(state,dict) or state.get('schema')!=1 or state.get('phase') not in ('stopping','needs-repair','repaired'):
        raise RuntimeError('Invalid package recovery journal')
    if not isinstance(state.get('boot_id'),str) or not re.fullmatch(r'[0-9a-f-]{36}',state['boot_id']):raise RuntimeError('Invalid recovery boot identity')
    if not isinstance(state.get('processes'),list) or len(state['processes'])>512:raise RuntimeError('Invalid recovery process list')
    if state.get('takeover_stage','') not in ('','coordinator-term','children-term','kill'):
        raise RuntimeError('Invalid package takeover stage')
    if 'signal_complete' in state and type(state['signal_complete']) is not bool:
        raise RuntimeError('Invalid package signal checkpoint')
    if state.get('takeover_previous_stage','') not in ('','coordinator-term','children-term','kill'):
        raise RuntimeError('Invalid previous package takeover stage')
    for item in state['processes']:
        if not isinstance(item,dict) or type(item.get('pid')) is not int or item['pid']<=1 or type(item.get('start_ticks')) is not int:
            raise RuntimeError('Invalid recovery process identity')
