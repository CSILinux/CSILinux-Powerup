            reboot-with-warnings) title='Reboot needed; service attention'; detail='Package work finished, but a deferred service restart did not recover. Review the log, save your work and reboot, then reopen Powerup. Mail filtering may be unavailable.' ;;
            service-attention) title='Packages updated; service attention'; detail='Package maintenance finished, but clamav-milter is not confirmed active after recovery. Mail filtering may be unavailable. Review the service details in the log.' ;;
            demo-complete) title='Demo complete'; detail='This was a simulated run. No system changes or authentication occurred.' ;;
            *) title='Review the operation log'; detail='The process exited, but no final completion marker was received. Check the log before starting another run.' ;;
        esac
    fi
    while :; do
        gui_capture --height=400 --text="$(gui_header "$title" 'RESULT' "$(gui_escape "$detail")")" \
            --form --field='Saved activity log:RO' "$GUI_LOG" --button='View log:2' --button='Save log as…:4' --button='Close:0'
        response=$GUI_CODE
        case $response in
            2) gui_dialog --text="$(gui_header 'Operation log' 'RESULT / DETAILS' 'This log is retained in your local state directory.')" --text-info --filename="$GUI_LOG" --fontname='Monospace 10' --wrap --button='Back:0' >/dev/null || true ;;
            4)
