release_upgrade_diagnostics() {
    local phase=$1 status=${2:-0} folder
    [[ -n ${LOG_FILE:-} ]] || { log 'Release diagnostic destination is unavailable.'; return 1; }
    folder=${LOG_FILE%.log}.diagnostics
    install -d -m 700 "$folder" || return 1
    python3 - "$folder" "$phase" "$status" <<'PY_RELEASE_DIAGNOSTICS'
import datetime,json,os,re,stat,sys
from pathlib import Path
folder=Path(sys.argv[1]);phase=sys.argv[2];status=int(sys.argv[3])
if phase not in ('before','after'):raise SystemExit('Invalid release diagnostic phase')
source=Path('/var/log/dist-upgrade')
if source.is_symlink():raise SystemExit('Refusing symlinked release log directory')
metadata=folder/('release-'+phase+'.json')
before={}
if phase=='after':
    before=json.loads((folder/'release-before.json').read_text())['files']
files={};failures=[]
required={'main.log','apt.log','term.log','apt-term.log'}
if source.exists():required.update(p.name for p in source.glob('*.log') if re.fullmatch(r'[A-Za-z0-9_.-]+\.log',p.name))
def output(text):print(text,flush=True)
def regular(path):
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    info=os.fstat(fd)
    if not stat.S_ISREG(info.st_mode):os.close(fd);raise ValueError('not a regular file')
    return fd,info
def is_prefix(previous,current,size):
    with previous.open('rb') as old,current.open('rb') as new:
        remaining=size
        while remaining:
            block=old.read(min(65536,remaining))
            if not block or new.read(len(block))!=block:return False
            remaining-=len(block)
    return True
output('UBUNTU RELEASE DIAGNOSTICS '+phase.upper()+': upgrader_exit='+str(status))
for name in sorted(required):
    original=source/name
    saved=folder/('release-'+phase+'-'+name+'.txt')
    try:
        fd,info=regular(original)
    except (OSError,ValueError) as error:
        files[name]=dict(available=False,reason=str(error))
        output('UNAVAILABLE '+str(original)+': '+str(error));continue
    try:
        with os.fdopen(fd,'rb') as incoming,saved.open('xb') as target:
            os.chmod(saved,0o600)
            remaining=info.st_size
            while remaining:
                block=incoming.read(min(65536,remaining))
                if not block:raise OSError('Release log changed or truncated during capture')
                target.write(block);remaining-=len(block)
            target.flush();os.fsync(target.fileno())
        files[name]=dict(available=True,snapshot=saved.name,size=info.st_size,mtime_ns=info.st_mtime_ns,device=info.st_dev,inode=info.st_ino)
        if phase=='before':
            output('SAVED prior upgrade log: '+str(original)+' ('+str(info.st_size)+' bytes)');continue
        old=before.get(name,{})
        offset=0;kind='new-or-replaced'
        if old.get('available') and (old.get('device'),old.get('inode'))==(info.st_dev,info.st_ino) and old.get('size',0)<=info.st_size:
            prior=folder/('release-before-'+name+'.txt')
            if is_prefix(prior,saved,old['size']):
                offset=old['size'];kind='appended' if offset<info.st_size else 'unchanged'
        files[name]['change']=kind;files[name]['current_attempt_offset']=offset
        if kind=='unchanged':
            output('UNCHANGED '+str(original)+': retained snapshot belongs to earlier activity; no new diagnostic bytes from this attempt.');continue
        output('BEGIN UBUNTU UPGRADE LOG '+str(original)+' ['+kind+']')
        with saved.open('rb') as content:
            content.seek(offset)
            # Stream the complete new output into the parent session/worker log.
            # Use binary writes so invalid UTF-8 never discards diagnostic bytes.
            while block:=content.read(65536):sys.stdout.buffer.write(block)
        sys.stdout.buffer.flush()
        output('\nEND UBUNTU UPGRADE LOG '+str(original))
    except (OSError,ValueError,KeyError,TypeError) as error:
        files[name]=dict(available=False,reason=str(error));failures.append(name+': '+str(error));output('DIAGNOSTIC CAPTURE FAILED '+failures[-1])
record=dict(schema=1,phase=phase,timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(),upgrader_status=status,files=files,failures=failures)
with metadata.open('x') as stream:
    os.chmod(metadata,0o600);json.dump(record,stream,indent=2);stream.write('\n');stream.flush();os.fsync(stream.fileno())
if phase=='after':
    changed=[name for name,item in files.items() if item.get('available') and item.get('change')!='unchanged']
    if status and not changed:
        output('The Ubuntu frontend returned a failure without new readable upgrade logs. Its exit status alone cannot distinguish cancellation, download/authentication failure or a frontend error.')
    output('Saved release diagnostics: '+str(folder))
if failures:raise SystemExit(1)
PY_RELEASE_DIAGNOSTICS
}

run_release_upgrader() {
    check_and_repair_packages || return 1
    audit_step 'Save previous Ubuntu upgrade diagnostics before launch' release_upgrade_diagnostics before 0 || return 1
    log 'Choose Restart Later at the Ubuntu final prompt. Powerup must finish boot checks before you reboot.'
    BOOT_VERIFIED=0 PACKAGE_WORK_ATTEMPTED=1
    local result=0
    if [[ ${RELEASE_UI:-text} == gtk ]]; then
        audit_step 'Run Ubuntu graphical release upgrader' env -u DEBIAN_FRONTEND -u UCF_FORCE_CONFFNEW UCF_FORCE_CONFFOLD=1 LC_ALL=C.UTF-8 LANG=C.UTF-8 LANGUAGE=C GDK_BACKEND=x11 do-release-upgrade -f DistUpgradeViewGtk3 || result=$?
    else
        # Keep Ubuntu's text frontend attached to its controlling terminal.
        audit_step 'Run Ubuntu text release upgrader' release_text_upgrader || result=$?
    fi
    # Capture Ubuntu's own error details before repair/cleanup can add unrelated
    # package output. Capture errors must not mask the upgrader's original status.
    if audit_step 'Include Ubuntu upgrade diagnostics in the support log' release_upgrade_diagnostics after "$result"; then :
    else
