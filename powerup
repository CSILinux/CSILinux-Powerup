                if (( GUI_CODE == 0 )) && [[ -n $GUI_RESPONSE ]]; then cp -- "$GUI_LOG" "$GUI_RESPONSE" || gui_message 'Could not save log' 'Choose a writable destination.'; fi ;;
            *) break ;;
        esac
    done
}

