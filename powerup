                elif [[ $pending_route == resume ]]; then
                    printf 'CONTINUE THE APPROVED UBUNTU 26.04 UPGRADE\nA restart has been detected. Start continues the saved job;\nit does not replace its progress with a new request.\n'
                else
                    printf 'UPGRADE TO UBUNTU 26.04 LTS\nPrepare Noble and open the Ubuntu supported upgrade assistant.\nExisting local configurations are retained. Ubuntu may ask about package removals.\n\nChoose “Restart Later” at the Ubuntu final prompt so Powerup can\nfinish its boot checks. Keep the existing kernel when offered cleanup.\nPowerup continues automatically at the next desktop login after reboot.\n'
                fi ;;

