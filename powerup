            refresh) printf 'RESTORE CSI TOOL FILES\nUpdate the system, back up /opt/csitools, then restore its CSI archive.\n' ;;
            all) printf 'SYSTEM + ALL CSI TOOLS\nUpdate the system and all 11 CSI tool categories.\n' ;;
            *)
                if [[ $BASE_CODENAME == noble ]]; then
                    printf 'FULL SYSTEM UPDATE — OS + CSI TOOLS\nKeep Ubuntu 24.04 and maintain its repositories.\nRepair dependencies; run apt update and apt upgrade -y.\nBack up /opt/csitools and refresh CSI-created applications.\nNo release upgrade is requested.\n'
                else
