    try:allowed.add(pwd.getpwnam('_apt').pw_uid)
    except KeyError:pass
    if details['uid'] not in allowed or not executable_file(details):
        raise RuntimeError('Package child executable or account could not be verified')

def takeover_signal(owners,state,rows,sig,stage):
    """Signal only an unchanged, verified tree through pinned process handles."""
    if os.geteuid()!=ROOT_UID:raise RuntimeError('Package recovery requires root')
    if not hasattr(os,'pidfd_open') or not hasattr(signal,'pidfd_send_signal'):
        raise RuntimeError('Safe process signaling is unavailable')
    excluded=ancestors();pids={r['pid'] for r in rows}
    if not pids or any(pid<=1 for pid in pids) or pids&excluded:raise RuntimeError('Unknown target or Powerup ancestor')
    if any(row['pid']<=1 for row in owners):raise RuntimeError('Unknown lock ownership')
    known={(r['pid'],r['start_ticks']) for r in active_recovery(state)}
    root_pids={r['pid'] for r in rows if r['ppid'] not in pids}
    newly_verified={r['pid'] for r in rows if r['pid'] in root_pids and (r['pid'],r['start_ticks']) not in known}
