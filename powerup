                if link_signature(os.stat(parts[-1],dir_fd=fd,follow_symlinks=False))!=wanted:
                    raise RuntimeError('hard-link path changed after inventory')
            finally:os.close(fd)
        if link_signature(script.lstat())!=wanted or directory_signature(script.parent.lstat())!=directory_signature(parent):
            raise RuntimeError('release frontend or directory changed after hard-link inventory')
        result['complete']=True;result['reason']='every hard link is inside the protected extraction directory'
    except (OSError,ValueError,RuntimeError) as error:result['reason']=str(error)
    finally:
        if root_fd is not None:os.close(root_fd)
    result['paths'].sort()
    return result

def release_frontend_check(script_name):
    result=dict(accepted=False,reason='not a supported extracted release frontend')
    if not isinstance(script_name,str) or not re.fullmatch(r'/(?:var/)?tmp/ubuntu-release-upgrader-[A-Za-z0-9._-]+/(?:noble|resolute)',script_name):return result
    script=Path(script_name)
