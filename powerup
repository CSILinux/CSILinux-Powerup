                    if screen_policy=='success' and kind=='success' and event.get('status')==0 and event['label'] not in seen_success:
                        seen_success.add(event['label'])
                        try: print('Completed: '+''.join(c for c in event['label'] if c.isprintable()),flush=True)
                        except OSError: pass
                elif screen_policy=='success' and line.startswith('POWERUP_RESULT='):
                    result=line.partition('=')[2].strip()
                    message={'complete':'Maintenance complete.', 'tools-complete':'Tool maintenance complete.',
                             'release-reboot-pending':'Upgrade remains saved. Restart and log in to continue; no new package work was started.',
                             'noble-reboot-pending':'Existing startup files verified. Restart and log in. Powerup will continue the approved upgrade automatically.',
                             'noble-prepared-reboot':'Ubuntu 24.04 preparation complete. Restart and log in. Powerup will continue the approved upgrade automatically.',
                             'resolute-installed-reboot':'Ubuntu 26.04 packages installed. Restart and log in. Powerup will finish setup automatically.',
                             'reboot-required':'Verified package work completed. A restart is required.',
                             'recovered-incomplete':'Package health and boot-file checks restored. Reopen Powerup to finish the requested maintenance.',
                             'packages-tested':'Package availability test complete. Missing package names are saved in missingpackages.txt.',
                             'category-partial':'Available category packages processed. Remaining items are recorded in the support log.',
                             'package-busy':'Package work is still active. Let it finish, then reopen Powerup; diagnostic details are saved.',
                             'boot-attention':'Not completed. Keep this system running; diagnostic logs are saved.',
                             'service-attention':'Package work completed. Additional service review is needed.',
                             'reboot-with-warnings':'Package work completed. Review the saved service report before restarting.'}.get(result)
                    stopping=result in ('boot-attention','package-busy','recovered-incomplete','category-partial')
                    if message and result not in seen_results and not (stopping and stop_notice):
                        seen_results.add(result)
                        if stopping:stop_notice=True
                        try: print(message,flush=True)
                        except OSError: pass
            with os.fdopen(fd,'wb',buffering=0) as output, os.fdopen(3,'rb',buffering=0) as incoming:
                raw_pending=b''
                def append(block):
                    if not block:return
                    fcntl.flock(output,fcntl.LOCK_EX)
                    try:
                        view=memoryview(block)
                        while view:view=view[os.write(output.fileno(),view):]
                    finally:fcntl.flock(output,fcntl.LOCK_UN)
                while True:
                    if completed is not None:
                        if completed.exists() and drain_until is None:drain_until=time.monotonic()+1
                        if drain_until is not None and time.monotonic()>=drain_until:break
                        if not select.select([incoming],[],[],0.2)[0]:
                            if drain_until is not None:break
                            continue
                    block=incoming.read(65536)
                    if not block:break
                    if not failed:
                        try:
                            raw_pending+=block
                            boundary=raw_pending.rfind(b'\n')+1
                            if boundary or len(raw_pending)>1048576:
                                boundary=boundary or len(raw_pending)
                                append(raw_pending[:boundary]);raw_pending=raw_pending[boundary:]
                            pending+=decoder.decode(block)
                            while '\n' in pending:
                                line,pending=pending.split('\n',1);consume(line)
                            # Keep enormous unterminated output bounded in RAM;
                            # raw bytes remain intact in the ordinary .log file.
                            if len(pending)>1048576:consume(pending,True);pending=''
                        except OSError as error:
                            failed=True;print('ERROR: Could not continue saving Powerup log: '+str(error),file=sys.stderr)
                    if mirror and screen_policy=='raw':
                        try:
                            view=memoryview(block)
                            while view:view=view[os.write(1,view):]
                        except OSError:mirror=False
                if not failed:
                    try:
                        append(raw_pending)
                        pending+=decoder.decode(b'',final=True)
                        if pending:consume(pending,True)
                        os.fsync(output.fileno())
                    except OSError:failed=True
            if failed:sys.exit(74)
    else:raise ValueError('Unknown logging operation')
except (OSError,ValueError,KeyError,zipfile.BadZipFile) as error:
    print('ERROR: Powerup log storage: '+str(error),file=sys.stderr);sys.exit(74)
finally:
    for stream,_,_ in opened:stream.close()
PY_POWERUP_LOGS
}

# Repair only fixed directory metadata, never case contents or existing logs.
# Descriptor-relative operations reject symlinks at every path component.
powerup_log_storage_prepare() {
    python3 - <<'PY_LOG_STORAGE'
import datetime,json,os,pwd,stat,sys
from pathlib import Path
ROOT_UID=0
class NeedsAdministrator(Exception):pass
class UnsafeStorage(Exception):pass
FLAGS=os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_NONBLOCK

def open_home(home,uid):
    if not home.is_absolute() or '..' in home.parts:raise UnsafeStorage('Invalid account home directory')
    fd=os.open('/',FLAGS)
    try:
        for part in home.parts[1:]:
            child=os.open(part,FLAGS,dir_fd=fd);os.close(fd);fd=child
        info=os.fstat(fd)
        if info.st_uid not in (ROOT_UID,uid):raise UnsafeStorage('Account home has an unexpected owner')
        return fd
    except BaseException:
        os.close(fd);raise

def owned_directory(info,label,uid):
    if not stat.S_ISDIR(info.st_mode):raise UnsafeStorage('Storage path is not a real directory: '+label)
    if info.st_uid not in (ROOT_UID,uid):raise UnsafeStorage('Storage directory belongs to another account: '+label)

def inspect(homefd,parts,uid,admin):
    fd=os.dup(homefd)
    try:
        for part in parts:
            try:info=os.stat(part,dir_fd=fd,follow_symlinks=False)
            except FileNotFoundError:return False
            owned_directory(info,'/'.join(parts),uid)
            if info.st_uid!=uid and not admin:raise NeedsAdministrator('Root-owned Powerup storage needs administrator access')
            child=os.open(part,FLAGS,dir_fd=fd);os.close(fd);fd=child
        return True
    finally:os.close(fd)

def prepare(home,uid,gid,admin):
    homefd=open_home(home,uid)
    targets=[(('.csi-cms',),False),(('.csi-cms','powerup'),True)]
    optional=('.csi-cms','powerup-resume')
    try:
        # Complete the ownership/type review before changing existing metadata.
        for parts,_ in targets:inspect(homefd,parts,uid,admin)
        if inspect(homefd,optional,uid,admin):targets.append((optional,True))
        for parts,private in targets:
            fd=os.dup(homefd);created=False
            try:
                for index,part in enumerate(parts):
                    try:os.mkdir(part,0o700,dir_fd=fd);created=index==len(parts)-1
                    except FileExistsError:pass
                    info=os.stat(part,dir_fd=fd,follow_symlinks=False)
                    owned_directory(info,'/'.join(parts),uid)
                    child=os.open(part,FLAGS,dir_fd=fd);os.close(fd);fd=child
                before=os.fstat(fd)
                owned_directory(before,'/'.join(parts),uid)
                wanted=0o700 if private else (stat.S_IMODE(before.st_mode)|0o700)&~0o022
                if before.st_uid!=uid:
                    if not admin:raise NeedsAdministrator('Storage ownership needs administrator access')
                    os.fchown(fd,uid,gid)
                if stat.S_IMODE(os.fstat(fd).st_mode)!=wanted:os.fchmod(fd,wanted)
                after=os.fstat(fd)
                if after.st_uid!=uid or stat.S_IMODE(after.st_mode)!=wanted:
                    raise UnsafeStorage('Could not verify repaired directory metadata')
                os.fsync(fd)
                if created or (before.st_uid,before.st_gid,stat.S_IMODE(before.st_mode))!=(after.st_uid,after.st_gid,stat.S_IMODE(after.st_mode)):
                    print('POWERUP_STORAGE_REPAIR='+json.dumps(dict(
                        timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(),path=str(home.joinpath(*parts)),
                        created=created,before=dict(uid=before.st_uid,gid=before.st_gid,mode=oct(stat.S_IMODE(before.st_mode))),
                        after=dict(uid=after.st_uid,gid=after.st_gid,mode=oct(stat.S_IMODE(after.st_mode))))),flush=True)
            finally:os.close(fd)
    finally:os.close(homefd)

try:
    account=pwd.getpwuid(os.getuid())
    if os.geteuid()==0 and os.environ.get('SUDO_UID'):
        account=pwd.getpwuid(int(os.environ['SUDO_UID']))
        if os.environ.get('SUDO_USER')!=account.pw_name:raise UnsafeStorage('Cannot identify the sudo user for log repair')
    elif os.geteuid()==0 and os.environ.get('PKEXEC_UID'):
        account=pwd.getpwuid(int(os.environ['PKEXEC_UID']))
    home=Path(account.pw_dir)
    prepare(home,account.pw_uid,account.pw_gid,os.geteuid()==0)
except NeedsAdministrator as error:
    print('Powerup log storage needs administrator access: '+str(error),file=sys.stderr);raise SystemExit(77)
except PermissionError as error:
    print('Powerup log storage permission check: '+str(error),file=sys.stderr);raise SystemExit(77 if os.geteuid()!=0 else 74)
except (OSError,ValueError,KeyError,UnsafeStorage) as error:
    print('ERROR: Powerup log storage preparation: '+str(error),file=sys.stderr);raise SystemExit(74)
PY_LOG_STORAGE
}

powerup_initialize_logs() {
    local self=$1 status=0 init_status=0; shift
    POWERUP_BOOTSTRAP_DIR=$(mktemp -d /tmp/powerup-log-bootstrap.XXXXXXXX) || return 74
    chmod 700 "$POWERUP_BOOTSTRAP_DIR" || return 74
    POWERUP_BOOTSTRAP_LOG=$POWERUP_BOOTSTRAP_DIR/bootstrap.log
    (umask 077; : > "$POWERUP_BOOTSTRAP_LOG") || return 74
    if POWERUP_SESSION_DIR=$(powerup_log_files init 2>"$POWERUP_BOOTSTRAP_LOG"); then return 0; fi
    powerup_log_storage_prepare >>"$POWERUP_BOOTSTRAP_LOG" 2>&1 || status=$?
    if (( status == 77 && EUID != 0 )); then
        status=0
        if [[ ${POWERUP_GUI_SESSION:-0} == 1 && -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] &&
                { command -v yad >/dev/null || command -v zenity >/dev/null; }; then
            make_auth_helper "$POWERUP_BOOTSTRAP_DIR" 'Powerup needs to repair access to its log folders. Enter your administrator password, or Cancel to close Powerup.' >>"$POWERUP_BOOTSTRAP_LOG" 2>&1 || return $?
            authenticated_run "$POWERUP_BOOTSTRAP_DIR" /bin/bash "$self" --internal-repair-log-storage >>"$POWERUP_BOOTSTRAP_LOG" 2>&1 || status=$?
        else
            # The terminal prompt remains visible; credentials are read by sudo.
            # The invoking user owns the bootstrap log; only the helper is root.
            # shellcheck disable=SC2024
            sudo -- /bin/bash "$self" --internal-repair-log-storage >>"$POWERUP_BOOTSTRAP_LOG" 2>&1 || status=$?
        fi
    fi
    (( status == 0 )) || return "$status"
    POWERUP_SESSION_DIR=$(powerup_log_files init 2>>"$POWERUP_BOOTSTRAP_LOG") || init_status=$?
    (( init_status == 0 )) || return "$init_status"
    return 0
}

powerup_bootstrap_log_finish() {
    local destination=${1:-stderr}
    if [[ -n ${POWERUP_BOOTSTRAP_LOG:-} && -f $POWERUP_BOOTSTRAP_LOG ]]; then
        if [[ $destination == stream ]]; then cat -- "$POWERUP_BOOTSTRAP_LOG"
        elif [[ $destination != discard ]]; then cat -- "$POWERUP_BOOTSTRAP_LOG" >&2; fi
    fi
    [[ -z ${POWERUP_BOOTSTRAP_DIR:-} ]] || rm -rf -- "$POWERUP_BOOTSTRAP_DIR"
    POWERUP_BOOTSTRAP_LOG='' POWERUP_BOOTSTRAP_DIR=''
}

powerup_show_failure() {
    local message=$1
    printf '%s\n' "$message" >&2
    if [[ -n ${POWERUP_SESSION_LOG:-} && -f $POWERUP_SESSION_LOG ]]; then
        message="Powerup did not complete. Diagnostic details have been saved.
Logs: ${POWERUP_SESSION_DIR:-not available}
If package work started, keep this system running until its status is reviewed."
    else
        message='Powerup could not prepare its log storage. No maintenance was started.
Check the terminal details for the affected path. Existing case data has not been modified.'
    fi
    [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] || return 0
    if command -v yad >/dev/null && LC_ALL=C.UTF-8 LANG=C.UTF-8 LANGUAGE=C yad --center --width=700 --height=330 --title='CSI Linux Powerup — stopped' \
        --image=dialog-error --text="$(gui_escape "$message")" --button='Close:0' >/dev/null; then return 0; fi
    if command -v zenity >/dev/null; then
        LC_ALL=C.UTF-8 LANG=C.UTF-8 LANGUAGE=C zenity --error --width=650 --title='CSI Linux Powerup — stopped' --text="$message" >/dev/null || true
    fi
    return 0
}

powerup_dialog_error() {
    grep -Eiq 'cannot open display|[Uu]nable to parse command line|[Ii]nvalid byte sequence|[Uu]nknown option|[Uu]nrecognized option|[Ff]ailed to (initialize|open|load)|[Ee]rror (opening|loading)|Gtk-ERROR|GLib-ERROR|Segmentation fault' "$1"
}

powerup_launch_exit() {
    local status=$? attempt
    trap - EXIT ERR INT TERM HUP
    set +e
    audit_close_pending "$status"
    if (( status != 0 && status != 130 )) && [[ ${POWERUP_GUI_SESSION:-0} == 1 ]]; then
        powerup_show_failure "Powerup stopped during ${POWERUP_PHASE:-startup} (status $status).

${POWERUP_LAST_ERROR:-Review the saved log for the error.}
Logs: ${POWERUP_SESSION_DIR:-not available}

If a package worker is still active, let it finish before opening another run."
    fi
    [[ -z ${GUI_DIR:-} ]] || gui_cleanup
    audit_event run-end '' "$status" '' 'Launcher finished'
    printf '\nPowerup launcher exit status: %s\nLogs saved: %s\n' "$status" "${POWERUP_SESSION_DIR:-not available}"
    if [[ -n ${POWERUP_ORIGINAL_OUT:-} ]]; then
        exec 1>&"$POWERUP_ORIGINAL_OUT" 2>&"$POWERUP_ORIGINAL_ERR"
        exec {POWERUP_ORIGINAL_OUT}>&- {POWERUP_ORIGINAL_ERR}>&-
    fi
    # A detached worker may still be writing. Never terminate it or block its
    # progress just because the frontend has ended; its own log keeps streaming.
    if [[ ${POWERUP_OWNS_LOGGER:-0} == 1 && ( -z ${GUI_JOB:-} || -f ${GUI_STATUS:-/nonexistent} ) ]]; then
        for ((attempt=0;attempt<40;attempt++)); do
            kill -0 "${POWERUP_LOGGER_PID:-0}" 2>/dev/null || break
            sleep 0.05
        done
        if ! kill -0 "${POWERUP_LOGGER_PID:-0}" 2>/dev/null; then
            wait "${POWERUP_LOGGER_PID:-0}" || { printf 'ERROR: Log writer failed.\n' >&2; (( status )) || status=74; }
        fi
    fi
    exit "$status"
}

powerup_log_arguments() {
    POWERUP_LOG_ARGS=()
    [[ -z ${POWERUP_SESSION_NAME:-} ]] || POWERUP_LOG_ARGS=("--internal-log-session=$POWERUP_SESSION_NAME")
}

powerup_launch() {
    # Only an explicit, validated session name joins an existing run. Ignore
    # inherited user paths; root helpers drop privileges before log writes.
    local joined='' option storage_status=0 storage_self
    if [[ ${1:-} == --internal-log-session=* ]]; then joined=${1#*=}; shift; fi
    POWERUP_SESSION_DIR='' POWERUP_SESSION_LOG='' POWERUP_LOGGED=1 POWERUP_OWNS_LOGGER=0
    POWERUP_AUDIT_ENABLED=1; export POWERUP_AUDIT_ENABLED
    POWERUP_GUI_SESSION=1 POWERUP_PHASE=startup POWERUP_LAST_ERROR=''
    for option in "$@"; do [[ $option != --cli ]] || POWERUP_GUI_SESSION=0; done
    if [[ -n $joined ]]; then
        POWERUP_SESSION_DIR=$(powerup_log_files join "$joined") || exit 74
    else
        storage_self=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 74
        powerup_initialize_logs "$storage_self" || storage_status=$?
        if (( storage_status == 130 )); then powerup_bootstrap_log_finish discard; exit 0; fi
        if (( storage_status != 0 )); then
            powerup_bootstrap_log_finish stderr
            powerup_show_failure 'Powerup cannot create logs under ~/.csi-cms/powerup after checking directory ownership and permissions. No maintenance was started.'
            exit "$storage_status"
        fi
    fi
    POWERUP_SESSION_NAME=${POWERUP_SESSION_DIR##*/}
    POWERUP_SESSION_LOG=$POWERUP_SESSION_DIR/session.log
    export POWERUP_SESSION_NAME POWERUP_SESSION_DIR POWERUP_SESSION_LOG
    if [[ -n $joined ]]; then
        powerup_log_files validate "$POWERUP_SESSION_LOG" || exit 74
    else
        powerup_log_files create "$POWERUP_SESSION_LOG" || { powerup_bootstrap_log_finish stderr; exit 74; }
        exec {POWERUP_ORIGINAL_OUT}>&1 {POWERUP_ORIGINAL_ERR}>&2
        local screen_policy=success
        for option in "$@"; do
            case $option in --internal-self-update-revision=*|--check|--platform-report) screen_policy=raw ;; esac
        done
        exec > >(powerup_log_files stream "$POWERUP_SESSION_LOG" '' "$screen_policy") 2>&1
        POWERUP_LOGGER_PID=$! POWERUP_OWNS_LOGGER=1
        powerup_bootstrap_log_finish stream
    fi
    trap powerup_launch_exit EXIT
    trap 'audit_error "$?" "$LINENO" "${FUNCNAME[0]:-main}"' ERR
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    printf 'POWERUP_REV=%s\nPowerup session log: %s\n' "$POWERUP_REV" "$POWERUP_SESSION_LOG"
    audit_init launcher
    main "$@"
}

