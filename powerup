audit_event() {
    [[ ${POWERUP_AUDIT_ENABLED:-0} == 1 ]] || return 0
    local kind=$1 operation=$2 status=$3 elapsed=$4 label=$5; shift 5
    AUDIT_SEQUENCE=$((${AUDIT_SEQUENCE:-0}+1))
    python3 - "${POWERUP_AUDIT_RUN_ID:-process-$BASHPID}" "$BASHPID" "$AUDIT_SEQUENCE" \
        "${AUDIT_CONTEXT:-unknown}" "$kind" "$operation" "$status" "$elapsed" "$label" "$@" <<'PY_AUDIT_EVENT' >&2
import datetime,json,re,sys
def scrub(value):
    value=re.sub(r'([a-zA-Z][a-zA-Z0-9+.-]*://)[^\s/@]+@',r'\1<redacted>@',value)
    value=re.sub(r'(https?://[^\s?]+)\?[^\s]+',r'\1?<redacted>',value)
    value=re.sub(r'(?i)((?:password|passwd|token|secret|authorization|api[_-]?key)[=:]\s*)\S+',r'\1<redacted>',value)
    return value
run,pid,seq,context,kind,operation,status,elapsed,label,*args=sys.argv[1:]
clean=[]; hide=False
for value in args:
    clean.append('<redacted>' if hide else scrub(value))
    hide=bool(re.fullmatch(r'(?i)--?(?:password|passwd|token|secret|authorization|api[_-]?key)',value))
record=dict(schema=1,event_id=f'{run}:{pid}:{seq}',run_id=run,pid=int(pid),context=context,
    timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='milliseconds'),
    kind=kind,operation_id=operation or None,status=int(status) if status else None,
    duration_seconds=float(elapsed) if elapsed else None,label=scrub(label),argv=clean)
print('AUDIT '+record['timestamp']+' '+kind.upper()+' '+record['label']+
      ((' [exit '+status+']') if status else '')+((' ['+elapsed+'s]') if elapsed else ''))
print('POWERUP_EVENT='+json.dumps(record,ensure_ascii=True,separators=(',',':')))
PY_AUDIT_EVENT
}

audit_init() {
    [[ ${POWERUP_AUDIT_ENABLED:-0} == 1 ]] || return 0
    AUDIT_CONTEXT=$1
    POWERUP_AUDIT_RUN_ID=$(date -u +%Y%m%dT%H%M%S)-$BASHPID-$RANDOM
    AUDIT_SEQUENCE=0 AUDIT_OPERATION_SEQUENCE=0
    AUDIT_IDS=() AUDIT_LABELS=() AUDIT_STARTS=()
    audit_event run-start '' '' '' "$AUDIT_CONTEXT started" "revision=$POWERUP_REV" "bash=$BASH_VERSION" "euid=$EUID"
}

audit_begin() {
    [[ ${POWERUP_AUDIT_ENABLED:-0} == 1 ]] || return 0
    local label=$1; shift
    AUDIT_OPERATION_SEQUENCE=$((${AUDIT_OPERATION_SEQUENCE:-0}+1))
    AUDIT_IDS+=("${POWERUP_AUDIT_RUN_ID:-unset}:$BASHPID:op-$AUDIT_OPERATION_SEQUENCE")
    AUDIT_LABELS+=("$label") AUDIT_STARTS+=("$EPOCHREALTIME")
    audit_event start "${AUDIT_IDS[-1]}" '' '' "$label" "$@"
}

audit_end() {
    [[ ${POWERUP_AUDIT_ENABLED:-0} == 1 && ${#AUDIT_IDS[@]} -gt 0 ]] || return 0
    local status=$1 kind=${2:-} elapsed now=$EPOCHREALTIME start=${AUDIT_STARTS[-1]}
    [[ -n $kind ]] || { if (( status == 0 )); then kind=success; else kind=failure; fi; }
    elapsed=$(awk -v now="$now" -v start="$start" 'BEGIN{printf "%.3f", now-start}')
    audit_event "$kind" "${AUDIT_IDS[-1]}" "$status" "$elapsed" "${AUDIT_LABELS[-1]}"
    unset 'AUDIT_IDS[-1]' 'AUDIT_LABELS[-1]' 'AUDIT_STARTS[-1]'
}

audit_step() {
    local label=$1 result; shift
    if [[ ${POWERUP_AUDIT_ENABLED:-0} != 1 ]]; then "$@"; return $?; fi
    audit_begin "$label" "$@"
    # Deliberately not an if/|| invocation: preserve the caller's errexit
    # behavior. Cleanup closes pending steps after an unhandled error or exit.
    "$@"
    result=$?
    audit_end "$result"
    return "$result"
}

audit_close_pending() {
    [[ ${POWERUP_AUDIT_ENABLED:-0} == 1 ]] || return 0
    local status=$1 kind=failure
    (( status != 0 )) || status=125
    if (( status == 130 || status == 143 || status == 129 )); then kind=interrupted; fi
    while (( ${#AUDIT_IDS[@]} )); do audit_end "$status" "$kind" || break; done
}

audit_error() {
    local status=$1 line=$2 function=$3
    POWERUP_LAST_ERROR="Command failed at line $line (status $status) in $function."
    printf 'ERROR: %s\n' "$POWERUP_LAST_ERROR" >&2
    # Do not dump BASH_COMMAND, environment variables or password-bearing input.
    audit_event error '' "$status" '' "$POWERUP_LAST_ERROR" || true
    return 0
}

