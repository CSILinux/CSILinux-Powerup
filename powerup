            # Accept that metadata only behind a root-owned 0700 directory; no
            # other account can traverse it. Never chown or chmod the source,
            # trust a particular numeric UID, or allow an unaccounted hard link.
            if stat.S_IMODE(parent.st_mode)!=0o700:
                result['reason']='non-root archive owner requires a root-private 0700 extraction directory';return result
            result['reason']='archive-owned file isolated by root-private extraction directory'
        else:result['reason']='root-owned protected release frontend'
        result['accepted']=True
    except (OSError,RuntimeError) as error:result['reason']='release frontend metadata unavailable: '+str(error)
    return result

def verified_manager(details):
    if details['uid']!=ROOT_UID or not executable_file(details):return False
    exe=details['exe'].removesuffix(' (deleted)')
    if exe in TRUSTED_BINARIES:return True
    if not re.fullmatch(r'/usr/bin/python3(?:\.[0-9]+)?',exe):return False
    script_name=python_script(details['args'])
    if script_name is None:return False
    script=Path(script_name)
    if str(script) in TRUSTED_SCRIPTS:
        info=script.stat()
        return stat.S_ISREG(info.st_mode) and info.st_uid==ROOT_UID and not info.st_mode&0o022
    return release_frontend_check(script_name)['accepted']

def managers():
    # Find verified coordinators even after their dpkg child released its lock.
    # Never adopt the current Powerup process or any of its ancestors.
    excluded=ancestors();result=[]
    for path in PROC.iterdir():
        if not path.name.isdigit() or int(path.name)<=1 or int(path.name) in excluded:continue
        try:
            exe=os.readlink(path/'exe').removesuffix(' (deleted)')
            if exe not in TRUSTED_BINARIES and not re.fullmatch(r'/usr/bin/python3(?:\.[0-9]+)?',exe):continue
            row=identity(int(path.name))
            if row['state'] in ('Z','X'):continue
            details=process_details(row)
            if verified_manager(details):result.append(row)
        except (FileNotFoundError,ProcessLookupError):continue
        except (PermissionError,RuntimeError):
            # A hidden process cannot be claimed as a trusted package manager.
            # Actual lock holders are still checked explicitly before takeover.
            continue
    if len(result)>512:raise RuntimeError('Too many package coordinators')
    return result

def recovery_rows(owners,state):
    known=active_recovery(state)
    roots={row['pid'] for row in owners if row['pid']>1}
    roots.update(row['pid'] for row in known)
    roots.update(row['pid'] for row in managers())
    return tree(roots) if roots else []

def progress_stamp(rows):
    values=[]
    for row in rows:
        try:
            root=PROC/str(row['pid']);raw=(root/'stat').read_text()
            fields=raw[raw.rfind(')')+2:].split()
            if int(fields[19])!=row['start_ticks']:continue
            io={}
            for line in (root/'io').read_text().splitlines():
                name,_,number=line.partition(':');io[name]=int(number)
            values.append((row['pid'],row['start_ticks'],int(fields[11])+int(fields[12]),
                           *(io.get(key,0) for key in ('rchar','wchar','read_bytes','write_bytes'))))
        except (FileNotFoundError,ProcessLookupError):continue
    for name in PROGRESS_LOGS:
        try:
            info=Path(name).stat();values.append((name,info.st_ino,info.st_size,info.st_mtime_ns))
        except FileNotFoundError:continue
    return tuple(sorted(values,key=repr))

def safe_member(details):
    if protected(details):raise RuntimeError('Protected package activity: '+protected(details))
    if Path(details['exe'].removesuffix(' (deleted)')).name in LOGIN_NAMES:
        raise RuntimeError('A live login or system service is in the package tree')
