                   takeover_stage=stage,takeover_previous_stage=completed_stage(state),
                   signal_complete=False,requested_at=datetime.datetime.now(datetime.timezone.utc).isoformat())
        save_state(saved)  # Durable provenance before the first termination.
        targets=root_pids if stage=='coordinator-term' else pids
        # Coordinators first; no process-group or unscoped name-based killing.
        ordered=sorted(targets,key=lambda pid:(pid not in root_pids,pid))
        for pid in ordered:
            row=next(r for r in rows if r['pid']==pid)
            if not live(row):continue
            detail=process_details(row);safe_member(detail)
            if (detail['exe'],detail['args'],detail['uid'])!=(details_by_pid[pid]['exe'],details_by_pid[pid]['args'],details_by_pid[pid]['uid']):
                raise RuntimeError('Package executable changed at signal dispatch')
            if pid in newly_verified and not verified_manager(detail):
                raise RuntimeError('Package manager source metadata changed at signal dispatch')
            try:signal.pidfd_send_signal(handles[pid],sig,None,0)
            except ProcessLookupError:continue
            print('PACKAGE_RECOVERY='+json.dumps(dict(action=signal.Signals(sig).name,pid=pid,
                  start_ticks=row['start_ticks'],stage=stage,
                  timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat())),flush=True)
        saved['signal_complete']=True;save_state(saved)
        return saved
    finally:
        for handle in handles.values():os.close(handle)

def completed_stage(state):
    if not state or state['phase']!='stopping':return ''
    if state.get('signal_complete') is False:return state.get('takeover_previous_stage','')
    return state.get('takeover_stage','coordinator-term')

def restart_diagnostics():
    # Evidence only. An inhibitor's advertised name is never permission to kill
    # its PID. Include rejected release frontends so a removed/stale script or
    # changed permissions cannot disappear silently from the support log.
    for path in PROC.iterdir():
        if not path.name.isdigit() or int(path.name)<=1:continue
        try:
            detail=process_details(identity(int(path.name)))
            exe=detail['exe'].removesuffix(' (deleted)')
            script_name=python_script(detail['args']) if re.fullmatch(r'/usr/bin/python3(?:\.[0-9]+)?',exe) else None
            if exe not in TRUSTED_BINARIES and script_name not in TRUSTED_SCRIPTS and not (script_name and re.fullmatch(r'/(?:var/)?tmp/ubuntu-release-upgrader-[A-Za-z0-9._-]+/(?:noble|resolute)',script_name)):continue
            record={k:detail[k] for k in ('pid','ppid','start_ticks','state','uid','exe')}
            record['script']=script_name
            if script_name:record['release_frontend_check']=release_frontend_check(script_name)
            try:record['verified_manager']=verified_manager(detail)
            except (OSError,RuntimeError) as error:
                record['verified_manager']=False;record['verification_error']=str(error)
            record['protected_reason']=protected(detail)
            for name in ('wchan','status'):
                try:record[name]=(path/name).read_text()[:8192]
                except OSError as error:record[name]=str(error)
            record['stdio']={}
            for fd in ('0','1','2'):
                try:record['stdio'][fd]=os.readlink(path/'fd'/fd)
                except OSError as error:record['stdio'][fd]=str(error)
            if script_name:
                record['script_metadata']=[]
                for target in (Path(script_name),Path(script_name).parent):
                    item=dict(path=str(target))
                    try:
                        info=target.lstat();item.update(uid=info.st_uid,mode=oct(info.st_mode),resolved=str(target.resolve(strict=True)))
                    except OSError as error:item['error']=str(error)
                    record['script_metadata'].append(item)
            print('POWERUP_RESTART_PROCESS='+json.dumps(record,ensure_ascii=True),flush=True)
        except (OSError,RuntimeError) as error:
            if not isinstance(error,(FileNotFoundError,ProcessLookupError,PermissionError)):
                print('Restart process inspection: '+str(error),file=sys.stderr)

def supervise_idle(restart_check=False):
    start=time.monotonic();last_progress=start;last_stamp=None;next_report=0
    state=read_state();had_activity=False;last_refusal=None;next_signal=start
    ever_signaled=bool(state and state["phase"]!="repaired")
    # A restarted monitor gives already-recorded survivors a fresh grace period.
    stage=completed_stage(state) if active_recovery(state) else ''
    if stage:next_signal=start+TERM_GRACE
    while True:
        owners=blockers();rows=recovery_rows(owners,state);now=time.monotonic()
        if stage and not active_recovery(state):
            # A different updater may arrive after the old tree exited. Give
            # that work its own progress window, never inherit escalation.
            stage='';last_progress=now;last_stamp=None;next_signal=now
        if not owners and not rows:
            if had_activity:
                lock_status('released',[],[],now-start)
                print('PACKAGE_RECOVERY='+json.dumps(dict(action='activity-cleared',
                      termination_requested=ever_signaled,elapsed_seconds=round(now-start,1))),flush=True)
            if state and state['phase']!='repaired':
                state['phase']='needs-repair';save_state(state);return 77
            return 78 if restart_check and had_activity else 0
        had_activity=True
        stamp=progress_stamp(rows)
        if stamp!=last_stamp:
            last_stamp=stamp;last_progress=now
        idle=now-last_progress
        phase='deferred' if last_refusal else 'stopping' if stage else 'waiting'
        if now>=next_report:
            evidence(owners,now-start)
            lock_status(phase,owners,rows,now-start,idle,last_refusal)
            print('PACKAGE_PROGRESS='+json.dumps(dict(idle_seconds=round(idle,1),
                  elapsed_seconds=round(now-start,1),stage=stage or 'monitoring')),flush=True)
            next_report=now+REPORT_EVERY
        initial=not stage and idle>=TERM_AFTER
        escalate=bool(stage and stage!='kill' and now>=next_signal and idle>=TERM_GRACE)
        if (initial or escalate) and now>=next_signal:
            target_stage='coordinator-term' if initial else 'children-term' if stage=='coordinator-term' else 'kill'
            sig=signal.SIGKILL if target_stage=='kill' else signal.SIGTERM
            lock_status('attempt',owners,rows,now-start,idle)
            try:
                state=takeover_signal(owners,state,rows,sig,target_stage)
                stage=target_stage;ever_signaled=True;last_refusal=None;last_progress=time.monotonic()
                next_signal=last_progress+TERM_GRACE
                lock_status('stopping',owners,rows,time.monotonic()-start,idle)
            except (OSError,RuntimeError,ValueError) as error:
                reason=str(error)
                if reason!=last_refusal:
                    print('PACKAGE_RECOVERY_DEFERRED='+json.dumps(dict(reason=reason,
                          timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat())),flush=True)
                    lock_status('deferred',owners,rows,now-start,idle,reason)
                last_refusal=reason;next_signal=now+REPORT_EVERY
                # If interrupted after journaling/signaling, retain that provenance.
                state=read_state()
                if state and state['phase']=='stopping':
                    stage=completed_stage(state);next_signal=now+TERM_GRACE
        # Protected tasks, active I/O and stubborn survivors remain monitored.
        # Do not return 76 merely because an elapsed-time/grace limit was reached.
        time.sleep(POLL)


if __name__=='__main__':
    try:
        if sys.argv[1]=='diagnostics':restart_diagnostics();raise SystemExit(0)
        if sys.argv[1]=='restart':raise SystemExit(supervise_idle(restart_check=True))
        if sys.argv[1]=='repaired':raise SystemExit(finish_recovery())
        seconds=int(sys.argv[1])
        if not -1<=seconds<=86400:raise ValueError('Invalid package wait duration')
        raise SystemExit(supervise_idle() if seconds==-1 else wait_idle(seconds))
    except (OSError,ValueError,RuntimeError) as error:
        print('ERROR: Cannot verify package-manager availability: '+str(error),file=sys.stderr);raise SystemExit(1)
PY_PACKAGE_LOCKS
}

package_wait_idle() {
    local status=0
    package_lock_monitor "${1:--1}" || status=$?
    if (( status == 77 )); then
        PACKAGE_BUSY=0 PACKAGE_RECOVERY_REQUIRED=1
        audit_event recovery '' 0 '' 'Package owner exited; configuration and dependency recovery is required'
        return 0
    fi
    if (( status == 0 )); then PACKAGE_BUSY=0; fi
    if (( status == 76 )); then
        PACKAGE_BUSY=1
        audit_event deferred '' 76 '' 'Package work is still active; Powerup will not overlap it'
    fi
    return "$status"
}

package_command() {
    # Also handle a new owner appearing between the idle check and exec.
    # Capture only to classify lock errors; all output still streams to the log.
    local label=$1 attempt status output output_fd output_pid mirror_status token mutable=0; shift
    for token in "$@"; do
        case $token in install|upgrade|dist-upgrade|full-upgrade|remove|purge|--configure|--unpack|dpkg-reconfigure) mutable=1;; esac
    done
    attempt=0
    while :; do
        attempt=$((attempt+1))
        package_wait_idle || return $?
        if (( mutable )) && [[ ${PACKAGE_RECOVERY_REQUIRED:-0} == 1 && ${REPAIR_ACTIVE:-0} != 1 ]]; then
            if [[ -n ${TOOL_ACTION:-} ]]; then tool_repair_gate || return $?; else check_and_repair_packages || return $?; fi
        fi
        if (( mutable )); then PACKAGE_WORK_ATTEMPTED=1; fi
        output=$(mktemp "${TMPDIR:-/tmp}/powerup-package.XXXXXXXX") || return 1
        exec {output_fd}> >(tee "$output") || { rm -f -- "$output"; return 1; }
        output_pid=$!
        status=0
        audit_step "$label" "$@" >&"$output_fd" 2>&1 || status=$?
        exec {output_fd}>&-
        mirror_status=0; wait "$output_pid" || mirror_status=$?
        if (( mirror_status )); then rm -f -- "$output"; return 74; fi
        if (( status == 0 )); then rm -f -- "$output"; return 0; fi
        if (( mutable )); then PACKAGE_COMMAND_FAILED=1; fi
        if grep -Eq '^E: (Could not get lock |Unable to (acquire|lock).*(lock|directory)|Could not open lock file .*Resource temporarily unavailable)|^dpkg: error: .*lock.*(locked by|another process|Resource temporarily unavailable)' "$output"; then
            rm -f -- "$output"
            audit_event retry '' "$status" '' 'Another package process acquired the lock; wait before retrying this command' "attempt=$attempt"
            (( attempt < 3 )) || sleep 2
            continue
        fi
        rm -f -- "$output"
        return "$status"
    done
}

apt_execute() {
    local result token mutable=0
    for token in "$@"; do
        case $token in install|upgrade|dist-upgrade|full-upgrade|remove) mutable=1;; esac
    done
    if (( mutable )); then BOOT_VERIFIED=0; fi
    if (( mutable )) && [[ ${REPAIR_ACTIVE:-0} != 1 ]]; then
        check_and_repair_packages || { result=$?; if (( result == 76 )); then return 76; fi; return 100; }
    fi
    if DEBIAN_FRONTEND=noninteractive package_command 'APT transaction, attempt 1' "$@"; then return 0; else result=$?; fi
    (( result != 76 )) || return 76
    # Do not retry signature/source errors, diagnostics, or recursively repair.
    if (( ! mutable )) || [[ -z ${WORK:-} || ${REPAIR_ACTIVE:-0} == 1 ]]; then return "$result"; fi
    log "Package operation failed ($result); attempting one automatic repair"
    audit_event retry '' "$result" '' 'Repair packages before retrying the failed transaction'
    audit_step 'Repair failed package transaction' repair_packages || { if [[ ${PACKAGE_BUSY:-0} == 1 ]]; then return 76; fi; return "$result"; }
    package_state_clean || {
        if [[ ${PACKAGE_BUSY:-0} == 1 ]]; then return 76; fi
        log 'ERROR: Dependency checks still fail after repair; the package operation will not be retried.'
        return "$result"
    }
    log 'Retrying the original package operation once'
    DEBIAN_FRONTEND=noninteractive package_command 'APT transaction, attempt 2' "$@"
}

apt_run() { apt_execute apt-get "${APT_OPTIONS[@]}" "$@"; }
# Use the specifically requested apt commands for routine OS maintenance.
# Retain apt-get for dependency installation and explicit full-upgrade mode.
apt_maintenance() { apt_execute apt "${APT_OPTIONS[@]}" "$@"; }

restore_service_policy() {
    local path=${1:-/usr/sbin/policy-rc.d}
    if [[ ${LOGIN_MILTER_DEFERRED:-0} == 1 ]]; then
        login_guard_program allow-milter || return 1
        LOGIN_MILTER_DEFERRED=0
    fi
    if [[ ${SERVICE_POLICY_ACTIVE:-0} == 1 ]]; then
        if cmp -s -- "$path" "$WORK/repair-policy.sh"; then
            rm -- "$path" || return 1
            if [[ $path == /usr/sbin/policy-rc.d ]]; then rm -f /var/lib/csi-powerup/temporary-service-policy; fi
            SERVICE_POLICY_ACTIVE=0
        else
            log 'ERROR: Temporary service policy changed externally; manual review is required.'
            return 1
        fi
    fi
}

restore_interrupted_policy() {
    local path=${1:-/usr/sbin/policy-rc.d} saved=${2:-/var/lib/csi-powerup/temporary-service-policy}
    [[ -f $saved ]] || return 0
    if [[ ! -e $path && ! -L $path ]]; then rm -- "$saved"; return; fi
    if cmp -s -- "$path" "$saved"; then
        rm -- "$path" "$saved" || return 1
        log 'Removed the temporary service policy left by an interrupted Powerup run'
    else
        die 'Service policy changed since an interrupted repair; review /usr/sbin/policy-rc.d before proceeding.'
    fi
}

defer_failed_milter() {
    local status path=${1:-/usr/sbin/policy-rc.d}
    status=$(dpkg-query -W -f='${db:Status-Status}' clamav-milter) || return 0
    [[ $status == half-configured || $status == unpacked ]] || return 0
    systemctl is-failed --quiet clamav-milter.service || return 0
    if [[ ${LOGIN_GUARD_ACTIVE:-0} == 1 ]]; then
        login_guard_program defer-milter || return 1
        LOGIN_MILTER_DEFERRED=1 MILTER_DEFERRED=1
        log 'Temporarily deferring clamav-milter inside the protected login policy'
        return 0
    fi
    # Preserve administrator service policies. Never overwrite an existing file.
    if [[ -e $path || -L $path ]]; then
        log 'Existing service policy retained; no temporary milter deferral installed.'
        return 0
    fi
    cat > "$WORK/repair-policy.sh" <<'POLICY'
#!/bin/sh
# CSI Powerup: temporary deferral of a failed milter restart during dpkg repair.
service=${1##*/}
service=${service%.service}
case "$service:${2:-}" in
    clamav-milter:start|clamav-milter:restart|clamav-milter:try-restart|clamav-milter:force-reload) exit 101 ;;
esac
exit 0
POLICY
    if [[ $path == /usr/sbin/policy-rc.d ]]; then
        install -d -m 700 /var/lib/csi-powerup || return 1
        cp -- "$WORK/repair-policy.sh" /var/lib/csi-powerup/temporary-service-policy || return 1
    fi
    # Noclobber uses exclusive creation, including protection from symlinks.
    (set -C; cat "$WORK/repair-policy.sh" > "$path") || return 1
    SERVICE_POLICY_ACTIVE=1
    chmod 755 "$path" || return 1
    MILTER_DEFERRED=1
    log 'Temporarily deferring the failed clamav-milter restart while package configuration is repaired'
}

retry_deferred_service() {
    [[ ${MILTER_DEFERRED:-0} == 1 ]] || return 0
    MILTER_DEFERRED=0
    log 'Retrying clamav-milter after package repair; service configuration is preserved'
    systemctl reset-failed clamav-milter.service || true
    if audit_step 'Restart deferred clamav-milter service' timeout 90 systemctl restart clamav-milter.service && systemctl is-active --quiet clamav-milter.service; then
        log 'clamav-milter restarted successfully'
    else
        SERVICE_WARNINGS=1
        log 'WARNING: Package configuration was repaired, but clamav-milter is not confirmed active. Mail filtering needs attention.'
        systemctl status clamav-milter.service --no-pager -l || true
        journalctl -u clamav-milter.service -n 40 --no-pager || true
    fi
}

repair_packages() {
    local repaired=0 audit result=0
    package_wait_idle || return $?
    local package flag
    local -a removal_guard=(--no-remove)
    local -a reinstall=()
    [[ ${FULL_UPGRADE:-0} == 1 || ${RELEASE_UPGRADE:-0} == 1 || ${RECOVER_RELEASE:-0} == 1 ]] && removal_guard=()
    REPAIR_ACTIVE=1 BOOT_VERIFIED=0
    log 'Automatic repair: configure pending packages, fix dependencies, verify package state'
    if [[ ! -e $BACKUP/dpkg-status.before-repair ]]; then
        cp -a /var/lib/dpkg/status "$BACKUP/dpkg-status.before-repair" || { REPAIR_ACTIVE=0; return 1; }
    fi
    if ! defer_failed_milter; then
        restore_service_policy || true
        REPAIR_ACTIVE=0; return 1
    fi
    if DEBIAN_FRONTEND=noninteractive package_command 'Configure pending packages, initial repair' dpkg --no-force-confnew --no-force-confdef --force-confold --configure -a; then :; else
        result=$?
        if (( result == 76 )); then restore_service_policy || true; REPAIR_ACTIVE=0; return 76; fi
        log 'Pending configuration still needs dependencies or service recovery'
        if ! defer_failed_milter; then restore_service_policy || true; REPAIR_ACTIVE=0; return 1; fi
    fi
    while IFS=$'\t' read -r package flag; do
        if [[ $flag == reinstreq && $package =~ ^[a-z0-9][a-z0-9.+:-]+$ ]]; then reinstall+=("$package"); fi
    done < <(dpkg-query -W -f='${binary:Package}\t${db:Status-Eflag}\n')
    if (( ${#reinstall[@]} )); then
        log "Reinstalling packages marked as requiring reinstallation: ${reinstall[*]}"
        DEBIAN_FRONTEND=noninteractive package_command 'Reinstall damaged package records' apt-get "${APT_OPTIONS[@]}" install --reinstall --no-remove -y "${reinstall[@]}" ||
            { result=$?; if (( result == 76 )); then restore_service_policy || true; REPAIR_ACTIVE=0; return 76; fi; log 'Targeted reinstall failed; continuing to the bounded dependency-repair attempt'; }
    fi
    if DEBIAN_FRONTEND=noninteractive package_command 'Resolve broken dependencies' apt-get "${APT_OPTIONS[@]}" --fix-broken install -y "${removal_guard[@]}" &&
       DEBIAN_FRONTEND=noninteractive package_command 'Configure packages after dependency repair' dpkg --no-force-confnew --no-force-confdef --force-confold --configure -a &&
       DEBIAN_FRONTEND=noninteractive package_command 'Verify repaired package dependencies' apt-get "${APT_OPTIONS[@]}" check; then
        audit=$(dpkg --audit) || audit='Package audit failed'
        if [[ -z $audit ]]; then repaired=1; else printf '%s\n' "$audit"; fi
    else
        result=$?
        if (( result == 76 )); then restore_service_policy || true; REPAIR_ACTIVE=0; return 76; fi
    fi
    restore_service_policy || { REPAIR_ACTIVE=0; return 1; }
    retry_deferred_service
    REPAIR_ACTIVE=0
    if (( repaired )); then log 'Automatic package repair completed'; return 0; fi
    log 'ERROR: Automatic repair could not produce a consistent package state. See the operation log.'
    return 1
}

package_state_clean() {
    local audit bad=0 result=0
    package_wait_idle || return $?
    audit=$(dpkg --audit) || { audit="Package audit failed: $audit"; bad=1; }
    if [[ -n $audit ]]; then printf '%s\n' "$audit"; bad=1; fi
    # Invoke the diagnostic directly; routing through apt_execute would risk
    # recursive checks. Check both configuration AND dependency consistency.
    DEBIAN_FRONTEND=noninteractive package_command 'Check package dependencies' apt-get "${APT_OPTIONS[@]}" check || { result=$?; (( result != 76 )) || return 76; bad=1; }
    return "$bad"
}

check_and_repair_packages() {
    log 'Checking package configuration and dependencies before proceeding'
    local result=0
    while :; do
        result=0
        if package_state_clean; then
            if [[ ${PACKAGE_RECOVERY_REQUIRED:-0} != 1 ]]; then return 0; fi
            log 'A package owner was stopped; complete pending configuration even if the current audit is clean'
        else result=$?; fi
        (( result != 76 )) || return 76
        log 'Repair phase only: ordinary installations and upgrades are blocked'
        if repair_packages; then :; else
            result=$?
            (( result != 76 )) || return 76
            log 'ERROR: Dependency repair failed. No further installations or upgrades will start.'
            return 1
        fi
        # Independently verify the result rather than trusting the repair exit code.
        if package_state_clean; then :; else
            result=$?
            (( result != 76 )) || return 76
            log 'ERROR: Package state is still inconsistent after repair. Installation remains blocked.'
            return 1
        fi
        if [[ ${PACKAGE_RECOVERY_REQUIRED:-0} == 1 ]]; then
        result=0
            package_lock_monitor repaired || result=$?
            if (( result == 76 )); then
                audit_event retry '' 76 '' 'Package activity resumed during repair verification; keep waiting and recheck'
                package_wait_idle || return $?
                continue
            fi
            (( result == 0 )) || return "$result"
            PACKAGE_RECOVERY_REQUIRED=0
        fi
        log 'Package configuration and dependency checks passed; normal work may proceed'
        return 0
    done
}

apt_refresh() {
    log 'Running apt update (signature checks enabled; repository errors are fatal)'
    apt_maintenance update
    log 'apt update completed successfully'
}

download() {
    local url=$1 destination=$2
    audit_step 'Download published resource' curl --fail --show-error --location --proto '=https' --proto-redir '=https' \
        --connect-timeout 20 --retry 3 --retry-delay 2 --speed-limit 1024 --speed-time 60 \
        --output "$destination" "$url"
}

install_tor_key() {
    log 'Validating the Tor Project repository signing key'
    # Refresh the certificate so renewed expiry/subkey data is not hidden by a
    # stale local copy. Verify the primary fingerprint before trusting its bytes.
    download "https://deb.torproject.org/torproject.org/$TOR_FINGERPRINT.asc" "$WORK/tor.asc"
    mkdir -m 700 "$WORK/gnupg"
    local listing fingerprint
    listing=$(gpg --homedir "$WORK/gnupg" --batch --with-colons --show-keys "$WORK/tor.asc")
    fingerprint=$(awk -F: '$1=="pub"{p=1;next} p && $1=="fpr"{print $10;p=0}' <<< "$listing")
    [[ $fingerprint == "$TOR_FINGERPRINT" ]] || die 'Downloaded Tor key has an unexpected primary fingerprint.'
    gpg --homedir "$WORK/gnupg" --batch --yes --dearmor --output "$WORK/tor.gpg" "$WORK/tor.asc"
    install -d -m 755 /etc/apt/keyrings
    if ! cmp -s "$WORK/tor.gpg" /etc/apt/keyrings/csi-torproject.gpg; then
        [[ ! -e /etc/apt/keyrings/csi-torproject.gpg ]] ||
            cp -p /etc/apt/keyrings/csi-torproject.gpg "$BACKUP/previous-tor-key.gpg"
        install -m 644 "$WORK/tor.gpg" /etc/apt/keyrings/.csi-torproject.gpg.new
        mv -f /etc/apt/keyrings/.csi-torproject.gpg.new /etc/apt/keyrings/csi-torproject.gpg
    fi
}

prepare_repositories() {
    local package status
    local -a missing=()
    for package in ca-certificates curl gnupg; do
        status=$(dpkg-query -W -f='${db:Status-Status}' "$package") || status=''
        [[ $status == installed ]] || missing+=("$package")
    done
    SOURCES_PENDING=1
    if (( ${#missing[@]} )); then
        log "Bootstrapping dependencies in one transaction: ${missing[*]}"
        repository_config configure /etc/apt "$BACKUP" 0 "$ARCH"
        apt_refresh
        apt_run install --no-install-recommends -y "${missing[@]}"
    fi
    if [[ $ARCH == amd64 || $ARCH == arm64 ]]; then
        install_tor_key
        repository_config configure /etc/apt "$BACKUP" 1 "$ARCH"
    else
        log "Tor Project does not publish $ARCH packages; retaining Ubuntu's native Tor package source"
        repository_config configure /etc/apt "$BACKUP" 0 "$ARCH"
    fi
    apt_refresh
    SOURCES_PENDING=0
}

update_os() {
    local policy
    local -a packages=(tor)
    # OS maintenance is independent of the starter-program list, bootstrap flag,
    # and optional CSI category updater. Never gate this on missing packages.
    if (( FULL_UPGRADE )); then
        log 'Running apt-get dist-upgrade -y (explicit --full-upgrade selection)'
        apt_run dist-upgrade -y
        log 'Full package upgrade completed successfully'
    else
        log 'Running apt upgrade -y'
        apt_maintenance upgrade -y
        log 'apt upgrade -y completed successfully'
    fi
    # Some Resolute repository snapshots have lacked this optional rollover
    # package. Do not fail the entire update, or substitute a different suite.
    policy=$(apt-cache policy deb.torproject.org-keyring)
    if awk '/Candidate:/ {if ($2 != "(none)") found=1} END {exit !found}' <<< "$policy"; then
        packages+=(deb.torproject.org-keyring)
    else
        log 'Tor rollover keyring package unavailable; using the fingerprint-verified local key. It is refreshed each run.'
    fi
    log 'Installing/updating Tor'
    apt_run install --no-install-recommends --no-remove -y "${packages[@]}"
    apt_run check
    log 'Held packages (if any)'
    apt-mark showhold
    log 'Remaining upgrades, including held or phased packages (if any)'
    apt list --upgradable
    if reboot_required; then log 'Packages requested a reboot. Boot checks must finish first.'; fi
}

maintain_system() {
    log 'Mandatory phase 1/2: configure Ubuntu Resolute and Tor repositories; run apt update'
    prepare_repositories
    log 'Mandatory phase 2/2: upgrade installed packages'
    update_os
}

set_lts_prompt() {
    python3 - "${1:-/etc/update-manager/release-upgrades}" "$BACKUP" <<'PY_LTS'
import configparser, io, os, shutil, sys, tempfile
from pathlib import Path
path, backup = Path(sys.argv[1]), Path(sys.argv[2])
if path.is_symlink(): raise ValueError('release-upgrades must not be a symlink')
config = configparser.ConfigParser()
