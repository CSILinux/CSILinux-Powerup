    for line in text.splitlines(keepends=True):
        candidate=re.sub(r'^\s*#\s*(?:Disabled by CSI Powerup:\s*)?', '',line)
        if not re.match(r'^\s*deb(?:-src)?\s',candidate):output.append(line);continue
        tokens=shlex.split(candidate,comments=True);i=1;options=[]
        if tokens[i].startswith('['):
            while i<len(tokens):
                options.append(tokens[i]);i+=1
                if options[-1].endswith(']'):break
        if len(tokens)<=i+1:raise ValueError('Malformed source line')
        uri,suite=tokens[i:i+2]
        if ubuntu(uri,' '.join(options)) and suite.split('-')[0] in old:continue
        output.append(line)
    return ''.join(output)
def clean_sources(text):
    output=[]
    for block in re.split(r'\n[ \t]*\n',text):
        f=fields(block);uris=f.get('uris','').split();suites=f.get('suites','').split()
        if uris and all(ubuntu(u,f.get('signed-by','')) for u in uris):
            remaining=[v for v in suites if v.split('-')[0] not in old]
            if remaining!=suites:
                if not remaining:continue
                block=re.sub(r'(?im)^Suites:[^\n]*(?:\n[ \t]+[^\n]*)*','Suites: '+' '.join(remaining),block)
        output.append(block)
    return '\n\n'.join(output).rstrip()+'\n'
changes={}
for path in sorted(set([root/'sources.list',*root.glob('sources.list.*'),*root.glob('sources.list.d/*')])):
    if not re.search(r'(?:sources\.list|\.(?:list|sources))(?:\.(?:save|distUpgrade|disabled|bak))?$',path.name):continue
    if path.is_symlink():raise ValueError('Refusing symlinked source file: '+str(path))
    if not path.is_file():continue
    original=path.read_text()
    updated=clean_sources(original) if re.search(r'\.sources(?:\.|$)',path.name) else clean_list(original)
    if updated!=original:changes[path]=updated
if not changes:print('No obsolete Ubuntu source entries remain');raise SystemExit(0)
backup.mkdir(parents=True,exist_ok=False,mode=0o700)
for path in changes:
    dest=backup/path.relative_to(root);dest.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(path,dest)
(backup/'cleanup-manifest.json').write_text(json.dumps([str(p.relative_to(root)) for p in changes],indent=2)+'\n')
try:
    for path,text in changes.items():
        if path!=root/'sources.list' and not any(v.strip() and not v.lstrip().startswith('#') for v in text.splitlines()):
            path.unlink();print('Removed obsolete Ubuntu source file:',path);continue
        fd,temp=tempfile.mkstemp(prefix='.powerup-',dir=path.parent)
        try:
            with os.fdopen(fd,'w') as out:out.write(text);out.flush();os.fsync(out.fileno())
            os.chmod(temp,0o644);os.replace(temp,path)
        finally:
            if os.path.exists(temp):os.unlink(temp)
        print('Removed obsolete Ubuntu entries; retained other sources:',path)
except Exception:
    for path in changes:shutil.copy2(backup/path.relative_to(root),path)
    raise
print('Old Ubuntu repositories archived after successful Resolute maintenance:',backup)
PY_PRUNE_UBUNTU
}

cleanup() {
    local status=$?
    trap - EXIT ERR
    set +e
    audit_close_pending "$status"
    final_package_recovery "$status" || audit_event recovery-incomplete '' 1 '' 'Final recovery deferred or incomplete; original exit status retained'
    if [[ ${PACKAGE_BUSY:-0} == 1 ]]; then
        printf 'POWERUP_RESULT=package-busy\n'
        printf 'Presentation restoration is deferred while another package task is active; saved snapshots are retained.\n'
    fi
    if [[ ${DESKTOP_ACTIVE:-0} == 1 && ${PACKAGE_BUSY:-0} != 1 ]]; then
        if audit_step 'Restore and verify protected presentation before closing' presentation_recover_pending; then :
        else
            printf 'ERROR: Presentation recovery remains pending; the saved snapshot will be retried when package activity is idle.\nPOWERUP_RESULT=boot-attention\n' >&2
            (( status != 0 )) || status=1
        fi
    fi
    restore_service_policy || printf 'ERROR: Review /usr/sbin/policy-rc.d before another update.\n' >&2
    if ! login_session_finish; then
        printf 'ERROR: Login-session policy cleanup remains pending; original policy is backed up.\n' >&2
        (( status != 0 )) || status=1
    fi
    if (( SOURCES_PENDING )) && [[ ${PACKAGE_BUSY:-0} == 1 ]]; then
        printf 'Source rollback deferred until package work is idle; originals retained in %s.\n' "$BACKUP" >&2
    elif (( SOURCES_PENDING )); then
        printf '\nRepository setup failed; restoring previous source files.\n' >&2
        audit_step 'Roll back incomplete repository configuration' repository_config rollback /etc/apt "$BACKUP" 0 "$ARCH" ||
            printf 'Automatic source rollback failed. Backup: %s\n' "$BACKUP" >&2
        if [[ -f $BACKUP/previous-tor-key.gpg ]]; then
            install -m 644 "$BACKUP/previous-tor-key.gpg" /etc/apt/keyrings/csi-torproject.gpg || true
        fi
    fi
    if (( status != 0 )) && [[ ${PACKAGE_BUSY:-0} != 1 && ${BOOT_ACTIVE:-0} == 1 && ${BOOT_VERIFIED:-0} != 1 ]]; then
        printf "ERROR: Boot readiness has not been confirmed. Keep this system running and review the log before reboot.\nPOWERUP_RESULT=boot-attention\n" >&2
    fi
    if (( status == 0 )) && [[ ${BASE_CODENAME:-} == resolute && ${BOOT_VERIFIED:-0} == 1 ]]; then
        audit_step 'Archive older Ubuntu repositories after successful upgrade checks' cleanup_obsolete_ubuntu_sources || status=1
    fi
    if (( status != 0 )); then
        release_job_checkpoint paused || printf 'ERROR: Could not pause the saved upgrade job.\n' >&2
    fi
    audit_step 'Capture final system and package state' audit_context_snapshot after ||
        audit_event failure '' 1 '' 'Final diagnostic snapshot could not be completed'
    if (( status == 0 )) && [[ -n ${POWERUP_FINAL_RESULT:-} ]]; then printf 'POWERUP_RESULT=%s\n' "$POWERUP_FINAL_RESULT"; fi
    audit_event run-end '' "$status" '' 'Backend finished' "boot_verified=${BOOT_VERIFIED:-0}" "final_repair_succeeded=${FINAL_REPAIR_SUCCEEDED:-0}" "backup=$BACKUP" "root_log=$LOG_FILE"
    [[ -z ${WORK:-} ]] || rm -rf -- "$WORK"
    printf '\nPowerup exit status: %s\nLog: %s\nBackup: %s\n' "$status" "$LOG_FILE" "$BACKUP"
    powerup_log_files snapshot "$LOG_FILE" "${RELEASE_UPGRADE:-0}" "${POWERUP_SESSION_NAME:-}" ||
        printf 'WARNING: Some system log snapshots could not be saved to ~/.csi-cms/powerup. The worker activity log is retained.\n' >&2
    exit "$status"
}

parse_options() {
    FORWARD=()
    CHECK_ONLY=0 TEST_PACKAGES=0 RELEASE_UI=text
    FULL_UPGRADE=0 REFRESH_TOOLS=0 CSI_TOOLS_ONLY=0
    RELEASE_UPGRADE=0 RESUME_RELEASE=0 RECOVER_RELEASE=0 TOOL_ACTION='' TOOL_PACKAGES=() CATEGORY_ACTION='' PACKAGE_CATEGORIES=() BIOS_TARGET='' BOOT_UI=text
    REQUESTED=() SELECTED=()
    while (( $# )); do
        case $1 in
            --check) CHECK_ONLY=1 ;;
            --test-packages) TEST_PACKAGES=1; FORWARD+=("$1") ;;
            --release-ui=gtk) RELEASE_UI=gtk; FORWARD+=("$1") ;;
            --release-upgrade) RELEASE_UPGRADE=1; FORWARD+=("$1") ;;
            --resume-release) if (( RECOVER_RELEASE )); then PLAN_ERROR='Choose one saved-upgrade action.'; return 1; fi; RESUME_RELEASE=1; FORWARD+=("$1") ;;
            --recover-release) if (( RESUME_RELEASE )); then PLAN_ERROR='Choose one saved-upgrade action.'; return 1; fi; RESUME_RELEASE=1; RECOVER_RELEASE=1; FORWARD+=("$1") ;;
            --boot-ui=gtk) BOOT_UI=gtk; FORWARD+=("$1") ;;
            --bios-target=*)
                BIOS_TARGET=${1#*=}
                [[ $BIOS_TARGET =~ ^/dev/[A-Za-z0-9_./:+-]+$ ]] || { PLAN_ERROR='Supply a whole BIOS disk path.'; return 1; }
                FORWARD+=("$1") ;;
            --install-categories|--remove-categories)
                [[ -z $CATEGORY_ACTION ]] || { PLAN_ERROR='Category install and removal cannot be combined.'; return 1; }
                if [[ $1 == --install-categories ]]; then CATEGORY_ACTION=install; else CATEGORY_ACTION=remove; fi
                FORWARD+=("$1") ;;
            --update-tools|--remove-tools)
                [[ -z $TOOL_ACTION ]] || { PLAN_ERROR='Tool update and removal are mutually exclusive.'; return 1; }
                if [[ $1 == --update-tools ]]; then TOOL_ACTION=update; else TOOL_ACTION=remove; fi
                FORWARD+=("$1") ;;
            --full-upgrade) FULL_UPGRADE=1; FORWARD+=("$1") ;;
            --update-csi-tools) CSI_TOOLS_ONLY=1; FORWARD+=("$1") ;;
            --refresh-tools) REFRESH_TOOLS=1; FORWARD+=("$1") ;;
            --tools-sha256|--updater-sha256|--updater)
                PLAN_ERROR='Custom updater and checksum options were removed. Powerup uses the configured CSI resources automatically.'; return 1 ;;
            --*) PLAN_ERROR="Unknown or incompatible option: $1"; return 1 ;;
            *) REQUESTED+=("$1") ;;
        esac
        shift
    done
    if (( ! ${#REQUESTED[@]} && ! CSI_TOOLS_ONLY )) && [[ -z $TOOL_ACTION && -z $CATEGORY_ACTION && $TEST_PACKAGES == 0 ]]; then REQUESTED=(os-update); fi
    if (( RESUME_RELEASE && RELEASE_UPGRADE )); then PLAN_ERROR='Choose a new release upgrade or resume the saved one.'; return 1; fi
    return 0
}

powerup_lock_busy() {
    printf 'ERROR: The Powerup lock is still held; no second update was started.\n' >&2
    python3 - "$1" <<'PY_LOCK_HOLDERS' >&2
import os, sys
from pathlib import Path
try:
    target = os.stat(sys.argv[1])
    found = False
    for process in Path('/proc').iterdir():
        if not process.name.isdigit():
            continue
        try:
            for fd in (process / 'fd').iterdir():
                info = fd.stat()
                if (info.st_dev, info.st_ino) == (target.st_dev, target.st_ino):
                    # Do not expose command-line arguments or credentials.
                    name = (process / 'comm').read_text().strip()
                    print('Lock holder: PID ' + process.name + ' (' + name + ')')
                    found = True
                    break
        except (OSError, PermissionError):
            continue
    if not found:
        print('The lock changed during inspection; retry after the earlier run finishes.')
except OSError as error:
    print('Could not inspect lock holders: ' + str(error))
PY_LOCK_HOLDERS
    printf 'Use the existing Powerup window or inspect the listed processes. Closing a monitor does not stop its worker.\nDo not delete the lock file while an update may still be running.\n' >&2
}

powerup_locked_call() {
    local self=$1 entry=$2 lock_file=$3 status=0 checked
    shift 3
    case $entry in backend_main|self_update_root_install|resume_access_root_repair|restart_root_request|restart_repair_backend) ;; *) die 'Invalid internal lock operation.';; esac
    checked=$(self_revision "$self") || return 1
    [[ -z $SELF_CHECKED_REV || $checked == "$SELF_CHECKED_REV" ]] || die 'Powerup changed since review. Reopen it.'
    # flock owns the descriptor in its waiting parent. --close removes it from
    # the worker and ALL descendants (including tee, package scripts and daemons).
    # Keep the same lock inode/protocol so older Powerup runs still exclude us.
    # Variables in this program belong to the fresh Bash worker.
    # shellcheck disable=SC2016
    flock --nonblock --conflict-exit-code 75 --close "$lock_file" /bin/bash -c '
        locked_source=$1; locked_revision=$2; locked_entry=$3; shift 3
        source "$locked_source"
        [[ $POWERUP_REV == "$locked_revision" ]] || exit 1
        SELF_CHECKED_REV=$locked_revision
        POWERUP_LOCK_HELD=1
        "$locked_entry" "$@"
    ' powerup-locked "$self" "$checked" "$entry" "$@" || status=$?
    if (( status == 75 )); then powerup_lock_busy "$lock_file"; fi
    return "$status"
}

backend_main() {
    local self option
    local -a tool_categories=()
    parse_options "$@" || die "$PLAN_ERROR"
    if (( TEST_PACKAGES )); then validate_options || die "$PLAN_ERROR"; test_package_categories; return; fi
    validate_platform
    release_apply_resume_plan
    validate_options || die "$PLAN_ERROR"
    if (( CHECK_ONLY )); then
        printf 'POWERUP_REV=%s\n' "$POWERUP_REV"
        printf 'Platform: Ubuntu base %s (%s)\n' "$BASE_CODENAME" "$ARCH"
        printf 'Release upgrade: opt-in with --release-upgrade; never implied by os-update.\n'
        printf 'Full system updates also back up and refresh CSI-created apps in /opt/csitools.\n'
        if [[ $BASE_CODENAME == noble ]]; then
            printf 'Default plan: retain Ubuntu 24.04, run apt update and apt upgrade -y.\n'
        else
            printf 'Ubuntu: resolute, resolute-updates, resolute-security, resolute-backports\n'
        fi
        printf 'Components: main restricted universe multiverse\nTor: stable resolute / %s\n' "$ARCH"
        printf 'Categories: %s\nFull upgrade: %s\nNo changes made.\n' "${SELECTED[*]}" "$FULL_UPGRADE"
        return
    fi
    # Detect unsupported board boot routes before modifying sources/packages or
    # generating preservation hooks. Architecture detection is not certification.
    if [[ $ARCH != amd64 && ! ( $ARCH == arm64 && -d /sys/firmware/efi ) ]]; then
        die "Detected $ARCH with a boot route requiring board-specific support. Use --platform-report; no package or boot changes were started."
    fi
    if (( EUID != 0 )); then
        self=$(readlink -f -- "${BASH_SOURCE[0]}")
        elevate "$self" "--internal-self-update-revision=$SELF_CHECKED_REV" --cli "${FORWARD[@]}" "${REQUESTED[@]}"
    fi
    export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
    umask 077
    install -d -m 700 /run/csi-powerup
    if (( ! POWERUP_LOCK_HELD )); then
        self=$(readlink -f -- "${BASH_SOURCE[0]}")
        powerup_locked_call "$self" backend_main /run/csi-powerup/lock "$@"
        return $?
    fi
    install -d -m 700 /var/log/csi-powerup /var/backups/csi-powerup
    local run_id
    run_id=$(date '+%Y%m%d-%H%M%S')-$$
    LOG_FILE=/var/log/csi-powerup/powerup-$run_id.log
    BACKUP=/var/backups/csi-powerup/$run_id
    install -d -m 700 "$BACKUP"
    WORK=$(mktemp -d /var/tmp/csi-powerup.XXXXXXXX)
    RELEASE_STATE_DIR=/var/lib/csi-powerup
    POWERUP_FINAL_RESULT=''
    PACKAGE_BUSY=0 PACKAGE_RECOVERY_REQUIRED=0 PACKAGE_WORK_ATTEMPTED=0 PACKAGE_COMMAND_FAILED=0 FINAL_REPAIR_ACTIVE=0 FINAL_REPAIR_SUCCEEDED=0
    DESKTOP_ACTIVE=0 BOOT_ACTIVE=0 BOOT_VERIFIED=0
    SOURCES_PENDING=0 SERVICE_POLICY_ACTIVE=0 LOGIN_GUARD_ACTIVE=0 LOGIN_MILTER_DEFERRED=0 MILTER_DEFERRED=0 SERVICE_WARNINGS=0 REPAIR_ACTIVE=0 RELEASE_JOB_ACTIVE=0
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    trap 'audit_error "$?" "$LINENO" "${FUNCNAME[0]:-backend}"' ERR
    exec > >(tee -a "$LOG_FILE") 2>&1
    printf '\n========================================\nPOWERUP_REV=%s\n========================================\n' "$POWERUP_REV"
    printf 'Running powerup script: %s\n' "$(readlink -f -- "${BASH_SOURCE[0]}")"
    log "CSI Linux Powerup — current base $BASE_CODENAME / $ARCH; release-upgrade selected: $RELEASE_UPGRADE"
    if (( ${CSI_TOOLS_ONLY:-0} )); then log 'Selected: Update CSI tools (applications only)'; else log "Selected: ${SELECTED[*]}"; fi
    audit_init backend
    audit_step 'Record starting positions for package logs' powerup_log_files checkpoint "$LOG_FILE"
    audit_event plan '' '' '' 'Validated maintenance plan' "release_upgrade=$RELEASE_UPGRADE" "resume_release=$RESUME_RELEASE" "full_upgrade=$FULL_UPGRADE" "refresh_tools=$REFRESH_TOOLS" "csi_apps_only=${CSI_TOOLS_ONLY:-0}" "tool_action=$TOOL_ACTION" "${SELECTED[@]}" "${TOOL_PACKAGES[@]}"
    audit_step 'Wait for other package work to finish' package_wait_idle
    audit_step 'Refresh installed platform after package recovery' validate_platform
    if (( RELEASE_UPGRADE && ! RESUME_RELEASE )) && [[ $BASE_CODENAME == resolute ]]; then
        if release_job_store recoverable >/dev/null; then
            RESUME_RELEASE=1 RECOVER_RELEASE=1
            audit_event resume '' 0 '' 'Continue the saved upgrade now that the installed release is Resolute'
        else
            RELEASE_UPGRADE=0 FULL_UPGRADE=1
            audit_event recovery '' 0 '' 'The approved release transition reached Resolute; finish dependency changes on this release'
        fi
    fi
    audit_step 'Verify readable saved upgrade metadata' release_job_store repair-access
    audit_step 'Record release job and reboot evidence' release_job_store explain
    if (( RELEASE_UPGRADE && ! RESUME_RELEASE )); then
        local existing_route
        existing_route=$(release_job_store route)
        case $existing_route in
            resume)
                RESUME_RELEASE=1
                audit_event resume '' 0 '' 'Reuse the pending upgrade instead of creating another job'
                ;;
            wait)
                audit_step 'Refresh automatic upgrade continuation' release_install_resume
                log 'The approved upgrade is still waiting for this boot to end. Its job and progress are retained.'
                log 'No package operations or repeated boot rebuilding were started. Restart and log into the same account.'
                printf 'POWERUP_RESULT=release-reboot-pending\n'
                return ;;
        esac
    fi
    if (( RESUME_RELEASE )); then
        if (( RECOVER_RELEASE )); then
            # Never retarget a half-migrated source set back to the old release.
            # Current Resolute installations continue on Resolute; Noble retries
            # use Ubuntu's native release upgrader only with Noble sources.
            audit_step 'Verify installed-release sources before interrupted recovery' assert_current_release_sources
            audit_step 'Claim interrupted upgrade without replacing its backups' release_job_store claim-recovery "$ARCH" "$BASE_CODENAME"
        else
            audit_step 'Claim the previously approved release upgrade' release_job_store claim "$ARCH" "$BASE_CODENAME"
        fi
        RELEASE_JOB_ACTIVE=1
        audit_step 'Refresh automatic upgrade continuation' release_install_resume
    elif (( RELEASE_UPGRADE )); then
        audit_step 'Install automatic upgrade continuation' release_install_resume
        audit_step 'Remember the approved Ubuntu 26.04 upgrade' release_job_store begin "$ARCH"
        RELEASE_JOB_ACTIVE=1
    elif (( ! ${RESTART_REPAIR_ONLY:-0} )); then
        audit_step 'Keep this action separate from any pending release upgrade' release_job_store pause-owned
    fi
    audit_step 'Capture initial system and package state' audit_context_snapshot before
    audit_step 'Recover interrupted service policy' restore_interrupted_policy
    # desktop_prepare adopts any pending original snapshot and restores settings
    # without demanding a fully configured kernel. Full regeneration runs after
    # package repair and again during cleanup; a failure cannot become success.
    audit_step 'Protect pre-upgrade GRUB, XFCE, Plymouth and SLiM setup' desktop_prepare
    audit_step 'Protect the active SLiM login during package work' login_session_prepare
    audit_step 'Enforce keep-local package configuration policy' configuration_preservation_prepare
    audit_step 'Validate current-release package sources before repairs' reconcile_current_repositories
    if [[ -n $TOOL_ACTION ]]; then
        audit_step 'Maintain selected installed tools' maintain_tool_packages
        return
    fi
    audit_step 'Check boot prerequisites and back up fallback files' boot_preflight
    audit_step 'Validate and save BIOS installation target' boot_sync_bios_target
    audit_step 'Check and repair package health' check_and_repair_packages
    audit_step 'Retain pre-upgrade kernel packages' boot_retain_preupgrade_kernel
    audit_step 'Verify baseline kernel and GRUB readiness' boot_ensure_ready baseline
    audit_step 'Install kernel boot guard' install_kernel_guard
    if (( ${RESTART_REPAIR_ONLY:-0} )); then
        audit_step 'Restore protected settings and verify boot before restarting' finish_upgrade_safely
        POWERUP_FINAL_RESULT=reboot-required
        return
    fi
    if [[ -n ${CATEGORY_ACTION:-} ]]; then
        audit_step 'Maintain selected CSI package categories' maintain_package_categories
        return
    fi
    if (( ${CSI_TOOLS_ONLY:-0} )); then
        audit_step 'Update CSI applications from the published archive' update_csi_applications
        audit_step 'Check and repair package health' check_and_repair_packages
        audit_step 'Finalize desktop restoration and boot verification' finish_upgrade_safely
        if (( SERVICE_WARNINGS )); then
            if reboot_required; then POWERUP_FINAL_RESULT=reboot-with-warnings; else POWERUP_FINAL_RESULT=service-attention; fi
        elif reboot_required; then POWERUP_FINAL_RESULT=reboot-required; else POWERUP_FINAL_RESULT=complete; fi
        return
    fi
    STOP_AFTER_RELEASE=0
    if (( RECOVER_RELEASE )) && [[ $BASE_CODENAME == resolute ]]; then
        audit_step 'Finish interrupted Ubuntu 26.04 package configuration' check_and_repair_packages
        audit_step 'Finish dependency changes from the approved release upgrade' apt_run dist-upgrade -y
        audit_step 'Verify recovered Ubuntu package health' check_and_repair_packages
        boot_id > "$RELEASE_STATE_DIR/upgrade-boot-id"
        log 'Interrupted Resolute package work repaired. Boot verification and a restart checkpoint follow.'
    fi
    if (( RELEASE_UPGRADE )) || [[ $BASE_CODENAME == resolute ]]; then audit_step 'Check or perform requested Ubuntu release upgrade' upgrade_release_if_needed; else audit_event skipped '' 0 '' 'Ubuntu release upgrade was not selected'; fi
    if (( STOP_AFTER_RELEASE )); then
        audit_step 'Check and repair package health' check_and_repair_packages
        audit_step 'Finalize desktop restoration and boot verification' finish_upgrade_safely
        if (( SERVICE_WARNINGS )); then release_job_checkpoint paused
        elif [[ $BASE_CODENAME == noble ]]; then release_job_checkpoint waiting-noble-reboot
        else release_job_checkpoint waiting-resolute-reboot; fi
        if (( SERVICE_WARNINGS )); then POWERUP_FINAL_RESULT=reboot-with-warnings
        elif [[ $BASE_CODENAME == noble ]]; then POWERUP_FINAL_RESULT=${RELEASE_REBOOT_STAGE:-noble-reboot-pending}
        else POWERUP_FINAL_RESULT=resolute-installed-reboot; fi
        return
    fi
    if [[ $BASE_CODENAME == noble ]]; then audit_step 'Update packages on the current Ubuntu release' maintain_current_release; else audit_step 'Maintain Resolute repositories and packages' maintain_system; fi
    audit_step 'Check and repair package health' check_and_repair_packages
    for option in "${SELECTED[@]}"; do
        [[ $option == os-update ]] || tool_categories+=("$option")
    done
    if (( ${#tool_categories[@]} )); then audit_step 'Prepare the published CSI category updater' prepare_updater; fi
    audit_step 'Update CSI applications from the published archive' update_csi_applications
    if (( ${#tool_categories[@]} )); then
        BOOT_VERIFIED=0
        audit_step 'Update selected CSI categories' run_category_updater "${tool_categories[@]}"
    fi
    audit_step 'Check and repair package health' check_and_repair_packages
    audit_step 'Finalize desktop restoration and boot verification' finish_upgrade_safely
    if [[ ${RELEASE_JOB_ACTIVE:-0} == 1 && $BASE_CODENAME == resolute ]]; then
        if (( SERVICE_WARNINGS )); then release_job_checkpoint paused
        else release_job_checkpoint complete resolute; fi
    fi
    rm -f -- "$RELEASE_STATE_DIR/upgrade-boot-id"
    log 'Requested maintenance completed. Review remaining upgrades and reboot status above.'
    if (( SERVICE_WARNINGS )); then
        if reboot_required; then POWERUP_FINAL_RESULT=reboot-with-warnings; else POWERUP_FINAL_RESULT=service-attention; fi
    elif reboot_required; then POWERUP_FINAL_RESULT=reboot-required; else POWERUP_FINAL_RESULT=complete; fi
}

