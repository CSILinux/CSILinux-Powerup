        printf '#!/bin/bash\n# CSI Powerup: recover saved presentation after interrupted maintenance.\nset -Eeuo pipefail\nexport PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C\n'
        declare -f package_lock_monitor powerup_log_files
        cat <<'PRESENTATION_RECOVERY'
(( EUID == 0 )) || exit 1
[[ -f /var/lib/csi-powerup/presentation-pending.json ]] || exit 0
install -d -m 700 /run/csi-powerup
if [[ ${1:-} != --locked ]]; then
    exec flock --nonblock --conflict-exit-code 76 --close /run/csi-powerup/lock "$0" --locked
fi
identity=$(/usr/local/libexec/csi-powerup-desktop-guard pending)
[[ -n $identity ]] || exit 0
IFS=$'\t' read -r SUDO_UID SUDO_USER saved_session <<< "$identity"
export SUDO_UID SUDO_USER
recovery_style=recovery-append
if [[ ${2:-} == --inline ]]; then recovery_style=recovery-inline
else POWERUP_SESSION_NAME=$saved_session; fi
# Start the root recovery transcript before accessing the user's home. A deleted
# log folder or unavailable home must never prevent protected settings recovery.
install -d -m 700 /var/log/csi-powerup
recovery_log=/var/log/csi-powerup/powerup-presentation-$(date '+%Y%m%d-%H%M%S')-$$.log
umask 077
exec 3>&1 4>&2
exec > >(tee -a "$recovery_log") 2>&1
recovery_tee=$!
recovery_session_ready=0
recovery_exit() {
    local result=$?
    trap - EXIT
    printf 'Presentation recovery exit status: %s\n' "$result"
    exec 1>&3 2>&4
    wait "$recovery_tee" || true
    if (( recovery_session_ready )); then
        powerup_log_files snapshot "$recovery_log" 0 "$POWERUP_SESSION_NAME" "$recovery_style" || true
    fi
    exit "$result"
}
trap recovery_exit EXIT
printf 'Presentation recovery started: %s\n' "$(date --iso-8601=seconds)"
if [[ -n ${POWERUP_SESSION_NAME:-} ]]; then
    if POWERUP_SESSION_DIR=$(powerup_log_files join "$POWERUP_SESSION_NAME"); then recovery_session_ready=1; fi
elif POWERUP_SESSION_DIR=$(powerup_log_files init); then
    POWERUP_SESSION_NAME=${POWERUP_SESSION_DIR##*/}
    recovery_session_ready=1
fi
if (( recovery_session_ready )); then
    export POWERUP_SESSION_NAME POWERUP_SESSION_DIR
if ! python3 - "$POWERUP_SESSION_NAME" <<'PY_RECOVERY_SESSION'
import json,os,re,stat,sys,tempfile
from pathlib import Path
name=sys.argv[1]
if not re.fullmatch(r'run-[0-9]{8}-[0-9]{6}-[a-z0-9_]{8}',name):raise SystemExit('Invalid recovery log session')
path=Path('/var/lib/csi-powerup/presentation-pending.json')
info=path.lstat()
if not stat.S_ISREG(info.st_mode) or info.st_uid!=0 or info.st_mode&0o077 or info.st_nlink!=1:raise SystemExit('Unsafe recovery log record')
data=json.loads(path.read_text())
if data.get('session')!=name:
    data['session']=name
    fd,temp=tempfile.mkstemp(prefix='.presentation-',dir=path.parent)
    try:
        with os.fdopen(fd,'w') as out:json.dump(data,out);out.write('\n');out.flush();os.fsync(out.fileno())
        os.replace(temp,path)
    finally:
        if os.path.exists(temp):os.unlink(temp)
PY_RECOVERY_SESSION
then printf 'WARNING: Could not save recovery log association; root recovery output is retained.\n' >&2; fi
else
    printf 'WARNING: Shared user log folder is unavailable; protected settings recovery continues. Root log: %s\n' "$recovery_log" >&2
fi
status=0
package_lock_monitor 0 || status=$?
case $status in
    0|77) ;;
    *) printf 'Recovery deferred while package activity remains active or cannot be verified (status %s). Snapshot retained.\n' "$status"; exit "$status";;
esac
status=0
/usr/local/libexec/csi-powerup-desktop-guard finish || status=1
/usr/local/libexec/csi-powerup-desktop-guard restore-users || status=1
if (( status == 0 )); then
    /usr/local/libexec/csi-powerup-desktop-guard commit || status=1
fi
if [[ $recovery_style != recovery-inline && -x /usr/local/libexec/csi-powerup-login-guard ]]; then
    /usr/local/libexec/csi-powerup-login-guard finish || status=1
fi
printf 'Protected presentation recovery checked; status=%s. This does not complete the interrupted package upgrade.\n' "$status"
exit "$status"
PRESENTATION_RECOVERY
    } > "$staged" || return 1
    bash -n "$staged" || return 1
    install -o root -g root -m 755 "$staged" /usr/local/libexec/csi-powerup-presentation-recover || return 1
    cat > "$WORK/presentation.service" <<'PRESENTATION_SERVICE'
[Unit]
Description=Restore CSI Linux presentation after interrupted Powerup
After=local-fs.target
ConditionPathExists=/var/lib/csi-powerup/presentation-pending.json
[Service]
Type=oneshot
ExecStart=/usr/local/libexec/csi-powerup-presentation-recover
TimeoutStartSec=infinity
SuccessExitStatus=76
PRESENTATION_SERVICE
    cat > "$WORK/presentation.timer" <<'PRESENTATION_TIMER'
[Unit]
Description=Retry unfinished CSI Linux presentation restoration
[Timer]
OnBootSec=90s
OnUnitInactiveSec=5min
Unit=csi-powerup-presentation-recover.service
[Install]
WantedBy=timers.target
PRESENTATION_TIMER
    install -o root -g root -m 644 "$WORK/presentation.service" /etc/systemd/system/csi-powerup-presentation-recover.service || return 1
    install -o root -g root -m 644 "$WORK/presentation.timer" /etc/systemd/system/csi-powerup-presentation-recover.timer || return 1
    systemctl daemon-reload || return 1
    systemctl enable --now csi-powerup-presentation-recover.timer || return 1
}

