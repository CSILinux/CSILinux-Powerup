login_guard_program() {
    python3 - "$@" <<'PY_LOGIN_GUARD'
import json,os,shutil,stat,subprocess,sys,tempfile
from pathlib import Path
ROOT=Path('/')
OWNER=0
BASE=ROOT/'var/lib/csi-powerup/login-session'
POLICY=ROOT/'usr/sbin/policy-rc.d'
MARKER=ROOT/'run/csi-powerup/login-guard-active'
MILTER=MARKER.with_name('defer-milter')
DROP=ROOT/'run/systemd/system/slim.service.d/zz-csi-powerup-session.conf'
NEED=ROOT/'etc/needrestart/conf.d/zz-csi-powerup-session.conf'
UNIT=b'# CSI Powerup temporary live-login protection\n[Unit]\nRefuseManualStop=yes\n'
NEED_TEXT=b"# CSI Powerup live-login protection; inactive after cleanup or reboot.\nif (-f '/run/csi-powerup/login-guard-active') {\n    push @{$nrconf{blacklist_rc}}, qr(^(?:slim|display-manager|dbus|systemd-logind)(?:\\.service)?$), qr(^user@);\n}\n1;\n"
WRAPPER=b'''#!/bin/sh
# CSI Powerup temporary login-session policy, original policy chained below.
service=${1##*/}; service=${service%.service}
action=${2:-}; action=${action#(}; action=${action%)}
if [ -f /run/csi-powerup/login-guard-active ]; then
    case "$service:$action" in
        slim:start|slim:stop|slim:restart|slim:try-restart|slim:force-reload|slim:reload|slim:force-stop|display-manager:*) exit 101 ;;
    esac
    if [ "$service" = clamav-milter ] && [ -f /run/csi-powerup/defer-milter ]; then
        case "$action" in start|restart|try-restart|force-reload) exit 101 ;; esac
    fi
fi
if [ -x /var/lib/csi-powerup/login-session/original-policy ]; then
    exec /var/lib/csi-powerup/login-session/original-policy "$@"
fi
exit 0
'''
def trusted(path,directory=False):
    info=path.lstat()
    if info.st_uid!=OWNER or info.st_mode&0o022 or (not stat.S_ISDIR(info.st_mode) if directory else not stat.S_ISREG(info.st_mode) or info.st_nlink!=1):
        raise RuntimeError('Untrusted login protection path: '+str(path))
    return info

def directory(path,mode=0o755):
    if path==ROOT:return
    directory(path.parent)
    if not path.exists() and not path.is_symlink():path.mkdir(mode=mode)
    trusted(path,True)

def write(path,data,mode):
    directory(path.parent)
    if path.exists() or path.is_symlink():trusted(path)
    fd,name=tempfile.mkstemp(prefix='.powerup-login-',dir=path.parent)
    try:
        with os.fdopen(fd,'wb') as out:out.write(data);out.flush();os.fsync(out.fileno());os.fchmod(out.fileno(),mode)
        os.replace(name,path)
        fd=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY)
        try:os.fsync(fd)
        finally:os.close(fd)
    finally:
        if os.path.exists(name):os.unlink(name)

def matches(path,data):
    if not path.exists() and not path.is_symlink():return False
    trusted(path);return path.read_bytes()==data

def saved():
    trusted(BASE,True);trusted(BASE/'manifest.json')
    data=json.loads((BASE/'manifest.json').read_text())
    if type(data.get('policy_existed')) is not bool:raise RuntimeError('Invalid saved login policy')
    return data

def finish():
    if not BASE.exists() and not BASE.is_symlink():return
    data=saved()
    # Do not overwrite an administrator change made during maintenance.
    if POLICY.exists() or POLICY.is_symlink():
        restored=False
        if data['policy_existed']:
            original=BASE/'original-policy';info=trusted(original)
            restored=matches(POLICY,original.read_bytes()) and stat.S_IMODE(POLICY.stat().st_mode)==stat.S_IMODE(info.st_mode)
        if not matches(POLICY,WRAPPER) and not restored:raise RuntimeError('Service policy changed during maintenance; retained backups')
    for path,expected in ((DROP,UNIT),(NEED,NEED_TEXT)):
        if path.exists() or path.is_symlink():
            if not matches(path,expected):raise RuntimeError('Login guard changed externally: '+str(path))
    if data['policy_existed']:
        original=BASE/'original-policy';info=trusted(original)
        write(POLICY,original.read_bytes(),stat.S_IMODE(info.st_mode))
    elif POLICY.exists():POLICY.unlink()
    for path in (MARKER,MILTER,DROP,NEED):
        if path.exists() or path.is_symlink():trusted(path);path.unlink()
    subprocess.run(['systemctl','daemon-reload'],check=True)
    shutil.rmtree(BASE)
    print('Restored original service policy; SLiM was not stopped or restarted.')

def prepare():
    if BASE.exists() or BASE.is_symlink():finish()
    for path in (DROP,NEED,MARKER,MILTER):
        if path.exists() or path.is_symlink():raise RuntimeError('Unclaimed login protection file: '+str(path))
    existed=POLICY.exists() or POLICY.is_symlink()
    if existed:trusted(POLICY)
    directory(BASE,0o700)
    if existed:write(BASE/'original-policy',POLICY.read_bytes(),stat.S_IMODE(POLICY.stat().st_mode))
    write(BASE/'manifest.json',json.dumps(dict(policy_existed=existed)).encode()+b'\n',0o600)
    write(POLICY,WRAPPER,0o755)
    write(MARKER,b'Preserve the active login until package work is idle.\n',0o600)
    write(DROP,UNIT,0o644);write(NEED,NEED_TEXT,0o644)
    subprocess.run(['systemctl','daemon-reload'],check=True)
    state=subprocess.run(['systemctl','show','--property=RefuseManualStop','--value','slim.service'],capture_output=True,text=True,check=True).stdout.strip()
    if state!='yes':raise RuntimeError('SLiM live-session restart protection could not be verified')
    print('SLiM live login protected: package restarts deferred until maintenance finishes; no session restart.')

try:
    if os.geteuid()!=OWNER:raise RuntimeError('Login protection requires administrator access')
    action=sys.argv[1]
    if action=='prepare':prepare()
    elif action=='finish':finish()
    elif action in ('defer-milter','allow-milter'):
        saved()
        if not matches(POLICY,WRAPPER):raise RuntimeError('Unexpected service policy during milter deferral')
        if action=='defer-milter':write(MILTER,b'deferred\n',0o600)
        elif MILTER.exists():trusted(MILTER);MILTER.unlink()
    else:raise RuntimeError('Unknown login protection operation')
except (OSError,ValueError,RuntimeError,subprocess.CalledProcessError) as error:
    print('ERROR: Login session protection: '+str(error),file=sys.stderr);raise SystemExit(1)
PY_LOGIN_GUARD
}

login_session_prepare() {
    local helper=$WORK/login-guard
    { printf '#!/bin/bash\nset -Eeuo pipefail\n'; declare -f login_guard_program; printf 'login_guard_program "$@"\n'; } > "$helper" || return 1
    bash -n "$helper" || return 1
    install -o root -g root -m 755 "$helper" /usr/local/libexec/csi-powerup-login-guard || return 1
    LOGIN_GUARD_ACTIVE=1
    login_guard_program prepare
}

login_session_finish() {
    [[ ${LOGIN_GUARD_ACTIVE:-0} == 1 ]] || return 0
    # Keep protection while another package process may still restart SLiM.
    [[ ${PACKAGE_BUSY:-0} != 1 ]] || return 0
    login_guard_program finish || return 1
    LOGIN_GUARD_ACTIVE=0
}

configuration_preservation_prepare() {
    # The files are intentionally persistent: direct dpkg repair and Ubuntu's
    # native release frontend must see the same keep-local policy as APT.
    export UCF_FORCE_CONFFOLD=1
    unset UCF_FORCE_CONFFNEW
    local staging=$WORK/configuration-policy
    install -d -m 755 /etc/dpkg/dpkg.cfg.d /etc/apt/apt.conf.d || return 1
    cat > "$staging" <<'KEEP_DPKG'
# CSI Powerup: keep locally modified conffiles; save vendor versions separately.
no-force-confnew
no-force-confdef
force-confold
KEEP_DPKG
    install -o root -g root -m 644 "$staging" /etc/dpkg/dpkg.cfg.d/zz-csi-powerup-preserve || return 1
    cat > "$staging" <<'KEEP_APT'
// CSI Powerup: apply the same policy to ordinary APT and release upgrades.
DPkg::Options:: "--no-force-confnew";
DPkg::Options:: "--no-force-confdef";
DPkg::Options:: "--force-confold";
KEEP_APT
    install -o root -g root -m 644 "$staging" /etc/apt/apt.conf.d/zz-csi-powerup-preserve || return 1
    log 'Keep-local policy installed for dpkg/APT and inherited UCF operations'
}

remove_conflicting_lightdm() {
    local status active simulation hook=$WORK/lightdm-guard option
    status=$(dpkg-query -W -f='${db:Status-Status}' lightdm 2>/dev/null) || status='not-installed'
    [[ $status != installed && $status != unpacked && $status != half-configured ]] || {
        status=$(dpkg-query -W -f='${db:Status-Status}' slim) || return 1
        [[ $status == installed ]] || { log 'SLiM must be installed before removing LightDM'; return 1; }
        active=0
        systemctl is-active --quiet lightdm.service || active=$?
        if (( active == 0 )); then
            log 'LightDM is running the current login session; removal is deferred until the machine is using SLiM. No active session was terminated.'
            return 1
        fi
        (( active == 3 || active == 4 )) || { log 'Could not determine whether LightDM is active'; return 1; }
        check_and_repair_packages || return 1
        simulation=$(apt-get "${APT_OPTIONS[@]}" --simulate -o APT::Get::AutomaticRemove=false remove lightdm) || return 1
        printf '%s\n' "$simulation"
        printf '%s\n' "$simulation" | python3 -c 'import re,sys
allowed={"lightdm","lightdm-gtk-greeter","lightdm-gtk-greeter-settings","slick-greeter","unity-greeter"}
for line in sys.stdin:
 if line.startswith(("Inst ","Conf ")):raise SystemExit("LightDM removal would change other package installations")
 if line.startswith("Remv ") and line.split()[1].split(":")[0] not in allowed:raise SystemExit("LightDM removal would remove an unrelated package: "+line.split()[1])' || return 1
        cat > "$hook" <<'PY_LIGHTDM_GUARD'
#!/usr/bin/python3
import os,sys
allowed={'lightdm','lightdm-gtk-greeter','lightdm-gtk-greeter-settings','slick-greeter','unity-greeter'}
with os.fdopen(os.dup(int(os.environ.get('APT_HOOK_INFO_FD','0')))) as stream:lines=stream.read().splitlines()
if not lines or lines[0]!='VERSION 3' or '' not in lines:raise SystemExit('Invalid LightDM removal protocol')
for line in lines[lines.index('')+1:]:
 fields=line.split()
 if len(fields)!=9 or fields[-1]!='**REMOVE**' or fields[0].split(':')[0] not in allowed:raise SystemExit('Unexpected package action during LightDM removal: '+line)
print('Verified LightDM/greeter-only removal transaction')
PY_LIGHTDM_GUARD
        chmod 700 "$hook" || return 1
        option="DPkg::Tools::options::$hook::Version=3"
        BOOT_VERIFIED=0
        DEBIAN_FRONTEND=noninteractive package_command 'Remove LightDM and conflicting greeters, retaining configurations' \
            apt-get "${APT_OPTIONS[@]}" -o APT::Get::AutomaticRemove=false -o "DPkg::Pre-Install-Pkgs::=$hook" -o "$option" remove -y lightdm || return 1
    }
    status=$(dpkg-query -W -f='${db:Status-Status}' lightdm 2>/dev/null) || status='not-installed'
    [[ $status == not-installed || $status == config-files ]] || return 1
    log 'Verified LightDM is removed; retained configuration files remain available for recovery'
}

desktop_finish_upgrade() {
    [[ ${DESKTOP_ACTIVE:-0} == 1 ]] || return 0
    local result=0
    audit_step 'Remove conflicting LightDM packages' remove_conflicting_lightdm || result=1
    [[ ${PACKAGE_BUSY:-0} != 1 ]] || return 76
    audit_step 'Restore pre-upgrade GRUB, SLiM, Plymouth and XFCE system settings' /usr/local/libexec/csi-powerup-desktop-guard finish || result=1
    audit_step 'Restore and verify pre-upgrade XFCE user settings' /usr/local/libexec/csi-powerup-desktop-guard restore-users || result=1
    return "$result"
}

finish_upgrade_safely() {
    # A login-manager removal failure must not prevent the final boot checks.
    # Still return failure, so no completion/reboot checkpoint is falsely armed.
    local result=0
    audit_step 'Restore and verify pre-upgrade desktop settings' desktop_finish_upgrade || result=1
    [[ ${PACKAGE_BUSY:-0} != 1 ]] || return 76
    audit_step 'Verify final kernel and GRUB readiness' boot_ensure_ready || result=1
    return "$result"
}

boot_retain_preupgrade_kernel() {
    [[ ${DESKTOP_ACTIVE:-0} == 1 ]] || return 0
    local original package status
    local -a retained=()
    original=$(/usr/local/libexec/csi-powerup-desktop-guard kernel) || return 1
    for package in "linux-image-$original" "linux-image-unsigned-$original" "linux-modules-$original" "linux-modules-extra-$original"; do
        status=$(dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null) || status=''
        [[ $status != installed ]] || retained+=("$package")
    done
    if (( ${#retained[@]} )); then audit_step 'Keep pre-upgrade kernel packages out of automatic removal' apt-mark manual "${retained[@]}" || return 1; fi
}

boot_verify_preserved_kernels() {
    [[ ${DESKTOP_ACTIVE:-0} == 1 ]] || return 0
    local original newest versions
    original=$(/usr/local/libexec/csi-powerup-desktop-guard kernel) || return 1
    versions=$(boot_kernel_versions) || return 1
    newest=$(tail -n 1 <<< "$versions")
    if [[ -z $newest ]] || ! grep -Fxq "$original" <<< "$versions"; then boot_fail 'The pre-upgrade kernel is no longer installed'; return 1; fi
    if ! boot_initrd_valid "$original" || ! boot_initrd_valid "$newest"; then boot_fail 'Pre-upgrade/newest kernel initramfs validation failed'; return 1; fi
    # The complete menu validator has already required normal and recovery
    # entries for every installed kernel, including these two versions.
    log "Verified GRUB choices: pre-upgrade kernel $original; newest kernel $newest (normal and recovery entries)"
}

boot_fail() {
    printf 'ERROR: Boot readiness: %s\n' "$*" >&2
    printf 'POWERUP_RESULT=boot-attention\n'
    BOOT_VERIFIED=0
    return 1
}

boot_mounts() {
    python3 - "${1:-512}" <<'PY_BOOT_MOUNTS'
import json, os, subprocess, sys
from pathlib import Path

def run(*args):
    return subprocess.check_output(args, text=True).strip()
def mount(path):
    return json.loads(run('findmnt', '-J', '-T', path, '-o', 'TARGET,SOURCE,FSTYPE,OPTIONS'))['filesystems'][0]
# An absent separate /boot or ESP must never be mistaken for a directory on /.
for path in ('/', '/boot', '/boot/efi'):
    if path == '/boot/efi' and not Path('/sys/firmware/efi').exists(): continue
    declared = subprocess.run(['findmnt', '--fstab', '--evaluate', '-n', '-o', 'SOURCE', '--mountpoint', path], capture_output=True, text=True)
    actual = mount(path)
    if declared.returncode == 0 and declared.stdout.strip():
        if actual['target'] != path:
            raise SystemExit('Configured boot filesystem is not mounted: ' + path)
        sources = declared.stdout.strip().splitlines()
        if len(sources) != 1 or os.path.realpath(sources[0]) != os.path.realpath(actual['source']):
            raise SystemExit('Mounted filesystem does not match fstab: ' + path)
    if path == '/boot/efi' and (actual['target'] != path or actual['fstype'] not in ('vfat', 'fat', 'msdos')):
        raise SystemExit('UEFI requires the mounted FAT EFI System Partition at /boot/efi')
    if 'rw' not in actual['options'].split(','):
        raise SystemExit('Boot filesystem is read-only: ' + path)
    fs = os.statvfs(path)
    reserve_mb = int(sys.argv[1]) if len(sys.argv) > 1 else 512
    reserve = (min(64, reserve_mb) if path == '/boot/efi' else reserve_mb) * 1024**2
    if fs.f_bavail * fs.f_frsize < reserve:
        raise SystemExit('Insufficient free space at ' + path + '; retain kernels and free space before updating')
    if fs.f_files and fs.f_favail < 1000:
        raise SystemExit('Too few free filesystem inodes at ' + path)
print('Boot filesystems are mounted, writable, and have working space')
PY_BOOT_MOUNTS
}

# Read-only disk discovery. A stale VM disk alias is recoverable only when all
# current evidence identifies one physical disk. Never pick the first disk.
boot_resolve_bios_target() {
    python3 - "$WORK/boot-target.json" "${BIOS_TARGET:-}" <<'PY_BOOT_TARGET'
import json, os, re, stat, subprocess, sys
from pathlib import Path

def run(args, input=None, allowed=(0,)):
    try:
        result = subprocess.run(args, input=input, capture_output=True, text=True, timeout=30,
                                env=dict(os.environ, LC_ALL='C', DEBIAN_FRONTEND='noninteractive'))
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ValueError('Cannot run ' + args[0] + ': ' + str(error)) from error
    if result.returncode not in allowed:
        detail = (result.stderr.strip() + '\n' + result.stdout.strip()).strip()
        raise ValueError(' '.join(args) + ' failed (status ' + str(result.returncode) + '): ' + (detail or 'no diagnostic output'))
    if result.stderr.strip(): print(result.stderr.strip(), file=sys.stderr)
    return result

def record(question):
    result = run(['debconf-communicate', 'grub-pc'], 'GET ' + question + '\n', (0, 10))
    reply = result.stdout.rstrip('\n')
    match = re.fullmatch(r'(\d+)(?: (.*))?', reply)
    if not match: raise ValueError('Malformed debconf response for ' + question + ': ' + repr(reply))
    code, value = int(match[1]), match[2] or ''
    if code == 0 and result.returncode == 0: return value, reply
    if code == 10 and result.returncode == 10 and ("doesn't exist" in value or 'does not exist' in value):
        return None, reply
    raise ValueError('Cannot read ' + question + ': ' + reply)

def canonical(path):
    if not re.fullmatch(r'/dev/[A-Za-z0-9_./:+-]+', path):
        raise ValueError('Unexpected block-device path: ' + repr(path))
    real = os.path.realpath(path)
    if not stat.S_ISBLK(os.stat(real).st_mode):
        raise ValueError('Not a block device: ' + path)
    return real

def one_line(value, label):
    lines = value.strip().splitlines()
    if len(lines) != 1 or not lines[0]: raise ValueError(label + ' did not identify exactly one device')
    return lines[0]

try:
    stored, raw_record = record('grub-pc/install_devices')
    empty, raw_empty = record('grub-pc/install_devices_empty')
    print('Recorded BIOS GRUB target: ' + (stored or '<missing or empty>'), file=sys.stderr)
    raw_targets = [p for p in re.split(r'[,\s]+', stored or '') if p]
    if len(raw_targets) > 1:
        raise ValueError('Multiple BIOS GRUB targets are recorded; automatic target replacement is disabled')
    if empty and empty.lower() == 'true':
        raise ValueError('grub-pc/install_devices_empty is true; BIOS installation was explicitly disabled. Administrator review is required')
    # PATH does not enable JSON children. Request the tree explicitly; otherwise
    # a normal partition appears without its disk and looks falsely ambiguous.
    inventory = json.loads(run(['lsblk', '--json', '--tree', '--paths', '--bytes', '--output',
                                'PATH,TYPE,PTTYPE,PARTTYPE,SIZE,RO']).stdout)
    nodes, parents = {}, {}
    def visit(node, disks=()):
        path = os.path.realpath(node['path'])
        if node['type'] == 'disk': disks = (path,)
        nodes[path] = node
        parents.setdefault(path, set()).update(disks)
        for child in node.get('children', []): visit(child, disks)
    for node in inventory['blockdevices']: visit(node)
    source = canonical(one_line(run(['findmnt', '-n', '-o', 'SOURCE', '-T', '/boot']).stdout, 'findmnt /boot'))
    if source not in nodes or nodes[source]['type'] not in ('part', 'disk'):
        raise ValueError('/boot is not on a plain disk partition; automatic BIOS handling is disabled')
    disks = parents.get(source, set())
    print('Mounted /boot device: ' + source, file=sys.stderr)
    if not disks:
        raise ValueError('lsblk returned no parent-disk topology for /boot device ' + source + '; no BIOS target will be guessed')
    if len(disks) != 1:
        raise ValueError('The parent disk of /boot device ' + source + ' is ambiguous: ' + ', '.join(sorted(disks)))
    boot_disk = canonical(next(iter(disks)))
    # lsblk calls zram/ram devices 'disk' too. Only exclude known RAM/loop
    # classes: persistent VM disks (vd*, xvd*, sd*, nvme*) remain candidates.
    def excluded_boot_device(path):
        return re.fullmatch(r'(?:zram|ram|loop)[0-9]+', os.path.basename(path)) is not None
    if excluded_boot_device(boot_disk):
        raise ValueError('/boot is on a memory/loop device, not an eligible BIOS installation disk: ' + boot_disk)
    probed = canonical(one_line(run(['grub-probe', '--target=disk', '/boot']).stdout, 'GRUB disk probe'))
    if probed != boot_disk:
        raise ValueError('GRUB and the mounted /boot disagree about the parent disk')
    repair = False
    recorded = None
    if raw_targets:
        try: recorded = canonical(raw_targets[0])
        except FileNotFoundError:
            print('Recorded BIOS disk path no longer exists: ' + raw_targets[0], file=sys.stderr)
            repair = True
        if recorded is not None:
            if recorded not in nodes or nodes[recorded]['type'] != 'disk':
                raise ValueError('Recorded GRUB target is not a whole disk; refusing to convert a partition target')
            if recorded != boot_disk:
                raise ValueError('Recorded GRUB disk conflicts with the mounted /boot; refusing to retarget it')
    else:
        repair = True
    ignored = sorted(p for p,n in nodes.items() if excluded_boot_device(p))
    physical = {p for p,n in nodes.items() if n['type'] == 'disk' and not excluded_boot_device(p)}
    if ignored:
        print('Excluded memory/loop devices from BIOS disk candidates: ' + ', '.join(ignored), file=sys.stderr)
    confirmed = sys.argv[2] if len(sys.argv) > 2 else ''
    if confirmed and canonical(confirmed) != boot_disk:
        raise ValueError('The confirmed BIOS target is not the disk containing /boot; refusing to retarget GRUB')
    target = nodes[boot_disk]
    if target.get('ro') in (True, 1, '1', 'true'): raise ValueError('BIOS target disk is read-only')
    table = target.get('pttype')
    if table == 'gpt':
        bios = [n for p,n in nodes.items() if boot_disk in parents.get(p,set()) and n['type']=='part'
                and str(n.get('parttype','')).lower() == '21686148-6449-6e6f-744e-656564454649']
        if not bios or not any(int(n.get('size',0)) >= 1024*1024 for n in bios):
            raise ValueError('BIOS/GPT requires an existing BIOS Boot partition of at least 1 MiB; no partition changes will be made')
    elif table != 'dos':
        raise ValueError('Unsupported or missing BIOS partition table: ' + str(table))
    evidence = dict(target=boot_disk, source=source, grub_disk=probed, table=table,
                    repair_record=repair, old_record=raw_record, old_empty_record=raw_empty,
                    physical_disks=sorted(physical), excluded_devices=ignored, confirmed_target=confirmed)
    Path(sys.argv[1]).write_text(json.dumps(evidence, indent=2)+'\n')
    if repair and physical != {boot_disk} and not confirmed:
        print('BIOS destination confirmation required: /boot and GRUB identify ' + boot_disk +
              '; attached disks: ' + ', '.join(sorted(physical)), file=sys.stderr)
        print('Confirm the firmware startup disk before continuing. CLI: --bios-target=' + boot_disk, file=sys.stderr)
        sys.exit(78)
    print('BIOS target confirmed by mounted /boot and GRUB: ' + boot_disk, file=sys.stderr)
    if repair: print('The stale/missing GRUB disk record can be repaired after the boot backup.', file=sys.stderr)
    print(boot_disk + '\t' + ('1' if repair else '0'))
except (ValueError, OSError, KeyError, TypeError) as error:
    print('ERROR: Boot target discovery: ' + str(error), file=sys.stderr)
    sys.exit(1)
PY_BOOT_TARGET
}

boot_confirm_bios_target() {
    local disk source disks response status=0 details
    details=$(python3 - "$WORK/boot-target.json" <<'PY_BOOT_CONFIRM'
import json, sys
data=json.load(open(sys.argv[1]))
print(data['target']); print(data['source']); print(', '.join(data['physical_disks']))
PY_BOOT_CONFIRM
) || return 1
    { read -r disk; read -r source; read -r disks; } <<< "$details"
    if [[ ${BOOT_UI:-text} == gtk ]] && command -v yad >/dev/null && [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
        env LC_ALL=C.UTF-8 LANG=C.UTF-8 LANGUAGE=C GTK_THEME=Adwaita:dark yad --center --on-top --width=660 --height=340 \
            --title='CSI Linux — Confirm BIOS boot disk' --image=drive-harddisk \
            --text="<b>Confirm the disk this computer starts from</b>

GRUB has no valid saved destination. Several disks are attached.
Mounted /boot: $source
Validated parent disk: <b>$disk</b>
Attached disks: $disks

Continue only if $disk is the firmware startup disk.
Powerup will repair GRUB on that disk; other disks will not be targeted." \
            --button='Cancel Powerup:1' --button="Use $disk:0" >/dev/null 2>"$WORK/boot-confirm-errors" || status=$?
        cat "$WORK/boot-confirm-errors" >&2
        if (( status != 0 )) && { (( status != 1 && status != 252 )) || powerup_dialog_error "$WORK/boot-confirm-errors"; }; then
            boot_fail "The BIOS confirmation dialog failed (status $status); this was not a user cancellation. Check the display/session diagnostics above."
            return 1
        fi
    elif [[ -t 0 ]]; then
