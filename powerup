        return 1
    fi
    GUI_READ_ONLY=$CHECK_ONLY
    GUI_PROFILE=standard
    (( ! FULL_UPGRADE )) || GUI_PROFILE=full
    (( ! REFRESH_TOOLS )) || GUI_PROFILE=refresh
    [[ $BASE_CODENAME != noble ]] || GUI_PROFILE=release
    GUI_CATEGORIES=()
    for note in "${REQUESTED[@]}"; do
        if [[ $note == all ]]; then GUI_PROFILE=all
        elif [[ $note != os-update ]]; then GUI_PROFILE=selected; GUI_CATEGORIES+=("$note"); fi
    done
    (( ! CHECK_ONLY )) || GUI_PROFILE=preview
    while :; do
        if (( ! GUI_READ_ONLY )); then
            if ! gui_dashboard; then return 0; fi
        fi
        if [[ $GUI_PROFILE == selected ]]; then
            if gui_categories; then :; else code=$?; if (( code == 2 )); then continue; else return 0; fi; fi
            gui_build_plan
            if ! validate_options; then gui_message 'Check your choices' "$PLAN_ERROR"; continue; fi
            gui_run_plan "$self"; return
        fi
        gui_build_plan
        if ! validate_options; then gui_message 'Check your choices' "$PLAN_ERROR"; continue; fi
        gui_write_plan
        if (( CHECK_ONLY )); then
            gui_dialog --text="$(gui_header 'System preview' 'READ ONLY' 'No system changes or administrator access.')" --text-info --filename="$GUI_DIR/plan.txt" \
                --fontname='DejaVu Sans 11' --wrap --button='Close:0' >/dev/null || true
            (( ! GUI_READ_ONLY )) || return 0
            GUI_PROFILE=standard; [[ $BASE_CODENAME != noble ]] || GUI_PROFILE=release
            continue
        fi
        gui_capture --height=650 --text="$(gui_header 'Ready to start' '02  START' 'Your selected action is shown below.')" --text-info --filename="$GUI_DIR/plan.txt" \
            --fontname='DejaVu Sans 11' --wrap --button='Cancel:1' --button='Back:2' --button='Start updates:0'
        case $GUI_CODE in 2) continue;; 0) gui_run_plan "$self"; return;; *) return 0;; esac
    done
}

# ------------------------- Startup self-update -------------------------
# Metadata is read as text, never sourced. HTTPS authenticates the publisher;
# revision checks prevent downgrades. No user checksum or source selection.
self_revision() {
    sed -n 's/^readonly POWERUP_REV=//p' "$1"
}

self_update_program() {
    /usr/bin/python3 - "$@" <<'PY_SELF_UPDATE'
import datetime, fcntl, os, re, signal, stat, subprocess, sys, tempfile
import urllib.request
from pathlib import Path

URL = 'https://raw.githubusercontent.com/CSILinux/CSILinux-Powerup/refs/heads/main/powerup'
LIMIT = 2 * 1024 * 1024
END = 'if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi'

def revision(data):
    if not data or len(data) > LIMIT or b'\0' in data:
        raise ValueError('Powerup download is empty, oversized or contains NUL bytes')
    text = data.decode('utf-8')
    if not text.startswith('#!/bin/bash\n'):
        raise ValueError('Expected a Bash script, not an HTML/error response')
    assignments = re.findall(r'^(?:readonly )?POWERUP_REV=.*$', text, re.M)
    if len(assignments) != 1:
        raise ValueError('Expected exactly one literal POWERUP_REV assignment')
    match = re.fullmatch(r'(?:readonly )?POWERUP_REV=(\d{4}-\d{2}-\d{2})-([1-9]\d{0,8})', assignments[0])
    if not match:
        raise ValueError('POWERUP_REV must use YYYY-MM-DD-N with a positive sequence')
    date = datetime.date.fromisoformat(match[1])
    return (date, int(match[2])), match[1] + '-' + match[2], text

def validate(data, require_protocol=False):
    key, label, text = revision(data)
    env = {k: v for k, v in os.environ.items() if k not in ('BASH_ENV', 'ENV', 'SHELLOPTS', 'BASHOPTS')}
    result = subprocess.run(['/bin/bash', '-n'], input=data, capture_output=True, env=env, timeout=15)
    if result.returncode:
        raise ValueError('Downloaded Powerup failed Bash syntax validation: ' + result.stderr.decode(errors='replace')[:500])
    if require_protocol and ('\nreadonly POWERUP_SELF_UPDATE_PROTOCOL=1\n' not in text or text.rstrip().splitlines()[-1] != END):
        raise ValueError('Newer Powerup lacks the supported restart protocol or complete entry point')
    return key, label

def read_regular(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as handle:
        info = os.fstat(handle.fileno())
        if not stat.S_ISREG(info.st_mode):
            raise ValueError('Powerup must be a regular file')
        data = handle.read(LIMIT + 1)
    return data, info

def download(path):
    # No redirected host, cleartext transport, unverified TLS or stale fallback.
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            raise ValueError('Unexpected redirect from the fixed Powerup URL')
    def expired(_signum, _frame):
        raise TimeoutError('Powerup download exceeded 45 seconds')
    signal.signal(signal.SIGALRM, expired)
    signal.alarm(45)
    try:
        req = urllib.request.Request(URL, headers={'User-Agent': 'CSI-Linux-Powerup', 'Cache-Control': 'no-cache', 'Accept': 'text/plain'})
        with urllib.request.build_opener(NoRedirect).open(req, timeout=20) as response:
            if response.status != 200:
                raise ValueError('Powerup download returned HTTP ' + str(response.status))
            data = response.read(LIMIT + 1)
        key, label = validate(data)
        # Caller creates a private directory. Exclusive creation refuses links.
        with open(path, 'xb') as handle:
            os.chmod(path, 0o600)
            handle.write(data)
        return key, label, data
    finally:
        signal.alarm(0)

def install(target, candidate, old_revision, new_revision):
    old, info = read_regular(target)
    new, _ = read_regular(candidate)
    old_key, old_label = validate(old)
    new_key, new_label = validate(new, require_protocol=True)
    if (old_label, new_label) != (old_revision, new_revision):
        raise ValueError('Powerup revision changed during the check; reopen it')
    if new_key <= old_key:
        raise ValueError('Refusing to install a revision that is not newer')
    parent = Path(target).parent
    # Keep a stable lock inode; unlinking locks can let competing writers enter.
    lock = os.open(str(target) + '.update.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    temp = None
    try:
        if not stat.S_ISREG(os.fstat(lock).st_mode):
            raise ValueError('Self-update lock is not a regular file')
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        current, now = read_regular(target)
        if current != old or (now.st_dev, now.st_ino) != (info.st_dev, info.st_ino):
            raise ValueError('Installed Powerup changed while waiting to replace it')
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%d-%H%M%S')
        fd, backup = tempfile.mkstemp(prefix=Path(target).name + '.backup-' + stamp + '-', dir=parent)
        with os.fdopen(fd, 'wb') as handle:
            handle.write(old)
            handle.flush()
            os.fsync(handle.fileno())
        fd, temp = tempfile.mkstemp(prefix='.powerup-new-', dir=parent)
        with os.fdopen(fd, 'wb') as handle:
            handle.write(new)
            handle.flush()
            os.fchown(handle.fileno(), info.st_uid, info.st_gid)
            os.fchmod(handle.fileno(), (stat.S_IMODE(info.st_mode) & 0o777) | 0o100)
            os.fsync(handle.fileno())
        current, now = read_regular(target)
        if current != old or (now.st_dev, now.st_ino) != (info.st_dev, info.st_ino):
            raise ValueError('Installed Powerup changed before replacement')
        os.replace(temp, target)
        temp = None
        directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
        print('Previous Powerup saved to: ' + backup)
    finally:
        if temp is not None:
            os.unlink(temp)
        os.close(lock)

try:
    action, *args = sys.argv[1:]
    if action == 'inspect':
        data, _ = read_regular(args[0])
        _, label = validate(data)
        print(label)
    elif action == 'download':
        _, label, data = download(args[0])
        print(label)
    elif action == 'newer':
        new, _ = read_regular(args[0])
        old, _ = read_regular(args[1])
        new_key, _ = validate(new)
        old_key, _ = validate(old)
        if new_key > old_key:
            validate(new, require_protocol=True)
            print('yes')
        else:
            print('no')
    elif action == 'install':
        install(*args)
    else:
        raise ValueError('Unknown self-update operation')
except Exception as error:
    print('ERROR: Self-update: ' + str(error), file=sys.stderr)
    sys.exit(1)
PY_SELF_UPDATE
}

self_update_root_install() (
    (( EUID == 0 )) || die 'Internal Powerup installation requires administrator access.'
    [[ $# == 2 && $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[1-9][0-9]*$ && $2 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[1-9][0-9]*$ ]] || die 'Invalid internal update parameters.'
    export PATH=/usr/sbin:/usr/bin:/sbin:/bin
    umask 077
    local self staging meta
    self=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 1
    install -d -m 700 /run/csi-powerup || exit 1
    if (( ! POWERUP_LOCK_HELD )); then
        powerup_locked_call "$self" self_update_root_install /run/csi-powerup/lock "$@"
        return $?
    fi
    staging=$(mktemp -d /var/tmp/powerup-self-update.XXXXXXXX) || exit 1
    trap 'rm -rf -- "$staging"' EXIT
    # Never run or install a candidate supplied from a user's staging directory.
    meta=$(self_update_program download "$staging/powerup") || exit 1
    [[ $meta == "$2" ]] || die 'GitHub changed during authentication. Reopen Powerup to check the new revision.'
    self_update_program install "$self" "$staging/powerup" "$1" "$2"
)

self_update_prepare() (
    local self=$1 cli=$2 staging meta old_revision new_revision newer status
    local GUI_PROGRESS_PID='' GUI_PROGRESS_FD='' GUI_LOG_FEEDER='' GUI_DIR=''
    umask 077
    staging=$(mktemp -d "${TMPDIR:-/tmp}/powerup-startup.XXXXXXXX") || return 1
    trap 'gui_progress_close; rm -rf -- "$staging"' EXIT
    if (( ! cli )) && command -v yad >/dev/null && [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
        GUI_DIR=$staging
        gui_assets || return 1
        gui_progress_open --height=300 --text="$(gui_header 'Checking for Powerup updates' 'STARTUP / GITHUB' 'Checking the latest published revision before opening the control center.')" \
            --progress --pulsate --progress-text='Checking GitHub — validating the published revision' \
            --auto-close --no-buttons --no-escape || return 1
    fi
    printf 'Checking Powerup: %s\n' "$POWERUP_SELF_UPDATE_URL"
    if meta=$(self_update_program inspect "$self" 2>"$staging/error") &&
        read -r old_revision <<< "$meta" &&
        meta=$(self_update_program download "$staging/powerup" 2>"$staging/error") &&
        read -r new_revision <<< "$meta" &&
        newer=$(self_update_program newer "$staging/powerup" "$self" 2>"$staging/error"); then
        if [[ $newer == no ]]; then
            [[ $(self_revision "$self") == "$old_revision" ]] || { printf 'Powerup changed during startup. Reopen it.\n' > "$staging/error"; newer=error; }
        fi
        if [[ $newer == no ]]; then
            printf 'Installed Powerup %s is current (GitHub: %s).\n' "$old_revision" "$new_revision"
            return 0
        elif [[ $newer == yes ]]; then
            printf 'New Powerup %s found; installed revision is %s.\n' "$new_revision" "$old_revision"
            gui_progress_close
            status=0
            if (( EUID == 0 )); then
                self_update_root_install "$old_revision" "$new_revision" >"$staging/install.log" 2>&1 || status=$?
            elif [[ $self != /opt/csitools/powerup && -w $self && -w ${self%/*} ]]; then
                self_update_program install "$self" "$staging/powerup" "$old_revision" "$new_revision" >"$staging/install.log" 2>&1 || status=$?
            elif [[ -n $GUI_DIR ]]; then
                {
                    printf '#!/bin/bash\n'
                    printf 'exec env GTK_THEME=Adwaita:dark XDG_CONFIG_HOME=%q %q --entry --hide-text --center --on-top --width=480 --title=%q --text=%q --button=%q --button=%q\n' \
                        "$GUI_DIR/config" "$(command -v yad)" 'CSI Linux — Update Powerup' \
                        "Powerup $new_revision is available. Enter your administrator password to replace the installed script and restart." 'Cancel:1' 'Update Powerup:0'
                } > "$staging/askpass"
                chmod 700 "$staging/askpass"
                # Intentionally capture output in the invoking user's private log.
                # shellcheck disable=SC2024
                SUDO_ASKPASS="$staging/askpass" sudo -A -- /bin/bash "$self" --internal-self-update-install "$old_revision" "$new_revision" >"$staging/install.log" 2>&1 || status=$?
            else
                # shellcheck disable=SC2024
                sudo -- /bin/bash "$self" --internal-self-update-install "$old_revision" "$new_revision" >"$staging/install.log" 2>&1 || status=$?
            fi
            cat "$staging/install.log"
            if (( status == 0 )); then
                [[ $(self_revision "$self") == "$new_revision" ]] || { printf 'Installed revision changed during the update. Reopen Powerup.\n' > "$staging/error"; status=1; }
                if (( status == 0 )); then return 20; fi
            else cp -- "$staging/install.log" "$staging/error"; fi
        fi
    fi
    gui_progress_close
    cat "$staging/error" >&2
    if [[ -n $GUI_DIR ]]; then
        gui_message 'Powerup update check stopped' "$(cat "$staging/error")

No package maintenance was started. Check connectivity or the published script, then reopen Powerup."
    fi
    return 1
)

startup_self_update() {
    local self=$1 cli=$2 status=0; shift 2
    self_update_prepare "$self" "$cli" || status=$?
    case $status in
        0) SELF_CHECKED_REV=$(self_revision "$self") ;;
        20)
            SELF_CHECKED_REV=$(self_revision "$self")
            printf 'Restarting the updated Powerup with the original options.\n'
            exec /bin/bash "$self" "--internal-self-update-revision=$SELF_CHECKED_REV" "$@" ;;
        *) return "$status" ;;
    esac
}

main() {
    local cli=0 gui=0 arg read_only=0 self checked=''
    self=$(readlink -f -- "${BASH_SOURCE[0]}") || return 1
    if [[ ${1:-} == --internal-self-update-install ]]; then shift; self_update_root_install "$@"; return; fi
    # Older revisions pass this marker when restarting an updated script.
    # Accept it as a loop marker only; checksum verification has been removed.
    if [[ ${1:-} == --internal-self-update-checked=* ]]; then
        shift; checked=$POWERUP_REV; SELF_CHECKED_REV=$POWERUP_REV
    elif [[ ${1:-} == --internal-self-update-revision=* ]]; then
        checked=${1#*=}; shift
        [[ $checked == "$POWERUP_REV" ]] || die 'Powerup changed since startup. Reopen it before continuing.'
        SELF_CHECKED_REV=$checked
    fi
    local -a args=()
    GUI_DEMO=0 GUI_DEMO_BASE=resolute
    if (( $# == 1 )); then
        case $1 in --help|-h) usage; return;; --version) printf 'POWERUP_REV=%s\n' "$POWERUP_REV"; return;; esac
    fi
    for arg in "$@"; do
        case $arg in
            --cli) cli=1 ;;
            --gui) gui=1 ;;
            --check) read_only=1; args+=("$arg") ;;
            --demo|--demo=resolute) GUI_DEMO=1 ;;
            --demo=noble) GUI_DEMO=1; GUI_DEMO_BASE=noble ;;
            *) args+=("$arg") ;;
        esac
    done
    (( ! (cli && (gui || GUI_DEMO)) )) || die '--cli cannot be combined with --gui or --demo.'
    if (( ! GUI_DEMO && ! read_only )) && [[ -z $checked ]]; then
        startup_self_update "$self" "$cli" "$@" || return $?
    fi
    if (( cli )); then backend_main "${args[@]}"; else gui_main "${args[@]}"; fi
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
