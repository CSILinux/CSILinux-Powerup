            lock_status('busy',owners,active,time.monotonic()-start,held,'processes remain after termination grace')
            print('Package processes remain after the termination request; repair is deferred. No SIGKILL is used.',flush=True);return 76
        if elapsed>=timeout:
            lock_status('busy',owners,active,elapsed,held,'wait deadline reached')
            print('Package manager remains busy. Lock files were retained; review the recovery evidence.',flush=True);return 76
        time.sleep(min(POLL,timeout-elapsed))

# The normal maintenance path is persistent. Bounded wait_idle calls are kept
# for non-mutating readiness probes and final cleanup only.
PROGRESS_LOGS=('/var/log/dpkg.log','/var/log/apt/term.log',
               '/var/log/dist-upgrade/main.log','/var/lib/dpkg/status')
