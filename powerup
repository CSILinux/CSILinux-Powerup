            services_changed=link(path('/etc/systemd/system/'+name+'.service'),'/dev/null') or services_changed
        if services_changed and path('/run/systemd/system').is_dir():run(['systemctl','daemon-reload'])
    if component=='xfce':wallpaper_defaults()
    if grub_changed:atomic(GRUB_DIRTY,b'Original GRUB settings require menu regeneration.\n',0o600)
    if changed:atomic(DIRTY,b'Plymouth restoration requires startup image rebuild.\n',0o600)
    status=dict(timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(),baseline=str(BASE),
                selected_display_manager='slim',competitors_masked=list(COMPETITORS),
                plymouth_alternatives=load()['alternatives'],grub=manifest.get('grub',{}),component=component,
                grub_regeneration_pending=GRUB_DIRTY.exists(),initramfs_pending=DIRTY.exists())
    atomic(STATE/'desktop-status.json',(json.dumps(status,indent=2)+'\n').encode(),0o600)
    say('VERIFIED protected '+component+' settings; live login services were not restarted')
def finish():
    failures=[]
    try:restore()
    except Exception as error:failures.append('settings: '+str(error));say('FAILURE '+failures[-1])
    if DIRTY.exists():
        try:
            run(['update-initramfs','-u','-k','all'])
            DIRTY.unlink();say('SUCCESS original Plymouth theme rebuilt into existing startup images')
        except Exception as error:failures.append('initramfs: '+str(error));say('FAILURE '+failures[-1])
    try:
        run(['/usr/local/libexec/csi-powerup-grub-refresh'])
        if GRUB_DIRTY.exists():raise RuntimeError('GRUB refresh did not confirm completion')
    except Exception as error:failures.append('GRUB: '+str(error));say('FAILURE '+failures[-1])
    if failures:raise RuntimeError('; '.join(failures))
def guard():
    # Package upgrades remain allowed. Removal of protected login/splash packages does not.
    fd=int(os.environ.get('APT_HOOK_INFO_FD','0'))
    with os.fdopen(os.dup(fd)) as stream:lines=stream.read().splitlines()
    if not lines or lines[0]!='VERSION 3' or '' not in lines:raise RuntimeError('Expected APT package action protocol 3')
    for line in lines[lines.index('')+1:]:
        fields=line.split()
        if len(fields)!=9:raise RuntimeError('Invalid APT package action')
        name=fields[0].split(':')[0]
        original=load().get('pre_upgrade_kernel','') if (BASE/'manifest.json').exists() else ''
        if fields[-1]=='**REMOVE**' and original and name in tuple(prefix+original for prefix in ('linux-image-','linux-image-unsigned-','linux-modules-','linux-modules-extra-')):
            raise RuntimeError('Refusing removal of pre-upgrade kernel package: '+name)
        if fields[-1]=='**REMOVE**' and (name=='slim' or name=='plymouth' or name.startswith(('plymouth-','grub','shim'))):
            raise RuntimeError('Refusing removal of the protected login/splash package: '+name)
    say('SUCCESS protected SLiM/Plymouth package actions checked')
def pending_record():
    record=STATE/'presentation-pending.json'
    if not record.exists() and not record.is_symlink():return None
    info=record.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid!=os.geteuid() or info.st_mode&0o077 or info.st_nlink!=1:
        raise RuntimeError('Unsafe presentation recovery record')
    data=json.loads(record.read_text())
    if data.get('schema')!=1 or not re.fullmatch(r'[0-9a-f-]{36}',data.get('snapshot','')):
        raise RuntimeError('Invalid presentation recovery record')
    account=pwd.getpwuid(data['uid'])
    if account.pw_name!=data['user']:raise RuntimeError('Recovery account identity changed')
    if selected_base()!=STATE/'desktop-snapshots'/data['snapshot']:
        raise RuntimeError('Pending presentation snapshot differs from active snapshot; originals retained')
    return data

def adopt_pending():
    # Attach the saved transaction before package repair. Never capture the
    # half-upgraded desktop as a replacement for the pre-upgrade originals.
    record=pending_record()
    if record is None:raise RuntimeError('Pending presentation record disappeared')
    uid=int(os.environ.get('SUDO_UID',os.getuid()))
    if record['uid']!=uid:raise RuntimeError('Pending presentation belongs to another desktop account')
    for candidate,directory in ((BASE,True),(BASE/'manifest.json',False)):
        info=candidate.lstat()
        if info.st_uid!=os.geteuid() or info.st_mode&0o022 or (not stat.S_ISDIR(info.st_mode) if directory else not stat.S_ISREG(info.st_mode)):
            raise RuntimeError('Untrusted pending snapshot: '+str(candidate))
    load()
    say('REUSED unfinished pre-upgrade snapshot: '+str(BASE)+'; final boot verification remains pending')

def arm_recovery():
    existing=pending_record()
    if existing:raise RuntimeError('An unfinished presentation restoration must complete before another backup')
    uid=int(os.environ.get('SUDO_UID',os.getuid()));account=pwd.getpwuid(uid)
    data=dict(schema=1,snapshot=BASE.name,uid=uid,user=account.pw_name,
              created=datetime.datetime.now(datetime.timezone.utc).isoformat(),session=os.environ.get('POWERUP_SESSION_NAME',''))
    if data['session'] and not re.fullmatch(r'run-[0-9]{8}-[0-9]{6}-[a-z0-9_]{8}',data['session']):raise RuntimeError('Invalid presentation log session')
    if not re.fullmatch(r'[0-9a-f-]{36}',BASE.name):raise RuntimeError('A transaction snapshot is required')
    atomic(STATE/'presentation-pending.json',(json.dumps(data)+'\n').encode(),0o600)
    say('ARMED durable GRUB/Plymouth/SLiM restoration record')

def commit_recovery():
    if pending_record() is None:return
    if DIRTY.exists() or GRUB_DIRTY.exists():raise RuntimeError('Startup files still require rebuilding')
    (STATE/'presentation-pending.json').unlink()
    fd=os.open(STATE,os.O_RDONLY|os.O_DIRECTORY)
    try:os.fsync(fd)
    finally:os.close(fd)
    say('VERIFIED protected presentation restoration completed')

def main():
    if len(sys.argv)==3 and sys.argv[1]=='wallpaper-user':
        if os.geteuid()==0:raise RuntimeError('Run wallpaper repair as the desktop user, without sudo')
        account=pwd.getpwuid(os.getuid())
        result=xfce_user_call(account,'wallpaper',dict(backup=sys.argv[2]))
        say('VERIFIED CSI wallpaper '+json.dumps(result));return
    if os.geteuid()!=0:raise RuntimeError('Desktop protection requires root')
    global BASE
    action=sys.argv[1] if len(sys.argv)>1 else ''
    if action=='snapshot' and len(sys.argv) in (3,4):
        snapshot(sys.argv[2],len(sys.argv)==4 and sys.argv[3]=='resume');return
    if len(sys.argv)!=2 or action not in ('capture','restore','finish','guard','restore-users','kernel','arm','commit','pending','adopt-pending'):raise RuntimeError('Unknown desktop guard action')
    if action!='capture':BASE=selected_base()
    if action=='pending':
        record=pending_record()
        if record:print(str(record['uid'])+'\t'+record['user']+'\t'+record.get('session',''))
        return
    if action=='adopt-pending':adopt_pending();return
    if action=='arm':arm_recovery();return
    if action=='commit':commit_recovery();return
    if action=='kernel':print(preserved_kernel());return
    {'capture':capture,'restore':restore,'finish':finish,'guard':guard,'restore-users':restore_users}[action]()
if __name__=='__main__':
    try:main()
    except (OSError,ValueError,KeyError,RuntimeError,subprocess.SubprocessError) as error:
        say('FAILURE '+str(error));sys.exit(1)
PY_DESKTOP_GUARD
}

