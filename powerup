gui_cleanup() {
    gui_progress_close
    # A detached runner may still be finishing APT if this frontend is closed.
    # Never kill it, remove its files, or show a false completion status.
    if [[ -n ${GUI_JOB:-} && ! -f ${GUI_STATUS:-/nonexistent} ]]; then return; fi
    [[ -z ${GUI_DIR:-} ]] || rm -rf -- "$GUI_DIR"
}

gui_feed_log() {
    # Called only in its own background subshell. Exec gives us the actual
    # feeder PID, so cleanup cannot leave an orphan holding the pipe open.
    exec python3 -u - "$GUI_LOG" "$GUI_STATUS" "$GUI_JOB" <<'PY_GUI_LOG'
import os, sys, time
log, status, pid = sys.argv[1:]
def running():
    try:
        os.kill(int(pid), 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
try:
    with open(log, errors='replace') as stream:
        while True:
            line = stream.readline()
            if line:
                print('# ' + line.rstrip('\r\n'), flush=True)
            elif os.path.exists(status) or not running():
                print('100', flush=True)
                break
            else:
                time.sleep(0.15)
except BrokenPipeError:
    pass
PY_GUI_LOG
}

gui_run_plan() {
    local self=$1 state_dir exit_code outcome response
    local -a command=()
    state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/csi-linux/powerup
    install -d -m 700 "$state_dir"
    GUI_LOG=$(mktemp "$state_dir/powerup-$(date +%Y%m%d-%H%M%S).XXXXXX.log")
    GUI_STATUS=$GUI_DIR/worker.status
    cat > "$GUI_DIR/runner.sh" <<'RUNNER'
#!/bin/bash
set -u
trap '' HUP
status=$1; logfile=$2; shift 2
"$@" </dev/null > "$logfile" 2>&1
result=$?
printf '%s\n' "$result" > "$status.tmp"
mv -- "$status.tmp" "$status"
exit "$result"
RUNNER
    if (( GUI_DEMO )); then
