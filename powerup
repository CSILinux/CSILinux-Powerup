set -Eeuo pipefail

readonly TOR_FINGERPRINT=A3C4F0F979CAA22CDBA8F512EE8CBC9E886DDD89
readonly UPDATER_URL=https://raw.githubusercontent.com/CSILinux/CSILinux-Powerup/main/csitoolsupdate.sh
readonly -a CATEGORIES=(csi-linux-base csi-linux-themes os-update encryption osint
    incident-response computer-forensics malware-analysis sigint virtualization security Navi-AI)
