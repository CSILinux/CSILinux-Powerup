read_platform() {
    local release_file=${1:-/etc/os-release}
    local ID='' ID_LIKE='' VERSION_ID='' VERSION_CODENAME='' UBUNTU_CODENAME=''
    [[ -r $release_file ]] || die "$release_file is missing."
    # shellcheck disable=SC1090
    . "$release_file"
    BASE_CODENAME=${UBUNTU_CODENAME:-${VERSION_CODENAME:-}}
    case $BASE_CODENAME in
        noble|resolute) ;;
        *) die "Supported bases: noble (upgrade to 26.04 LTS), resolute (maintain). Detected '${BASE_CODENAME:-unknown}'." ;;
    esac
    [[ $ID == ubuntu || " $ID_LIKE " == *' ubuntu '* || -n $UBUNTU_CODENAME ]] ||
        die 'Cannot verify an Ubuntu base.'
    if [[ $ID == ubuntu ]]; then
        [[ $BASE_CODENAME:$VERSION_ID == noble:24.04 || $BASE_CODENAME:$VERSION_ID == resolute:26.04 ]] ||
            die "Inconsistent Ubuntu version: $VERSION_ID / $BASE_CODENAME."
    fi
}

validate_platform() {
    read_platform
    ARCH=$(dpkg --print-architecture)
    case $ARCH in
        amd64|arm64) ;;
        *) die "Tor Project's repository supplies amd64 and arm64; architecture '$ARCH' is unsupported by this updater." ;;
    esac
    command -v python3 >/dev/null || die 'python3 is required (normally included with CSI Linux).'
    [[ -s /usr/share/keyrings/ubuntu-archive-keyring.gpg ]] || die 'Ubuntu archive keyring is missing; repair ubuntu-keyring first.'
}

normalize_categories() {
    local requested category found all_requested=0
    SELECTED=()
    for requested in "${REQUESTED[@]}"; do
        if [[ $requested == all ]]; then all_requested=1; continue; fi
        found=0
        for category in "${CATEGORIES[@]}"; do
            if [[ $requested == "$category" ]]; then found=1; break; fi
        done
        (( found )) || { PLAN_ERROR="Unknown category: $requested"; return 1; }
        if [[ " ${SELECTED[*]} " != *" $requested "* ]]; then SELECTED+=("$requested"); fi
    done
    if (( all_requested )); then
        (( ${#REQUESTED[@]} == 1 )) || { PLAN_ERROR="Choose all OR individual categories; these choices cannot be combined."; return 1; }
        SELECTED=("${CATEGORIES[@]}")
    fi
}

validate_options() {
    PLAN_ERROR=''
    normalize_categories || return 1
    local category tool_count=0
    for category in "${SELECTED[@]}"; do [[ $category == os-update ]] || tool_count=$((tool_count+1)); done
    if (( CHECK_ONLY && (FULL_UPGRADE || REFRESH_TOOLS || tool_count) )) ||
        { (( CHECK_ONLY )) && [[ -n $TOOLS_SHA256$UPDATER_FILE$UPDATER_SHA256 ]]; }; then
        PLAN_ERROR='Preview is a read-only mode. Choose it without update, restore, or tool-category options.'; return 1
    fi
    if [[ -n $TOOLS_SHA256 ]] && (( ! REFRESH_TOOLS )); then
        PLAN_ERROR='An archive SHA-256 requires Refresh CSI tool archive.'; return 1
    fi
    if [[ -n $UPDATER_FILE$UPDATER_SHA256 ]] && (( ! tool_count )); then
        PLAN_ERROR='Updater files and updater hashes require at least one CSI tool category.'; return 1
    fi
    if [[ $BASE_CODENAME == noble ]] &&
        { (( FULL_UPGRADE || REFRESH_TOOLS || tool_count )) || [[ -n $TOOLS_SHA256$UPDATER_FILE$UPDATER_SHA256 ]]; }; then
        PLAN_ERROR='Noble requires the release-upgrade workflow first. Full package upgrade is already included; CSI tool options become available after reboot into Resolute.'; return 1
    fi
    if [[ -n $TOOLS_SHA256 && ! $TOOLS_SHA256 =~ ^[0-9a-fA-F]{64}$ ]] ||
        [[ -n $UPDATER_SHA256 && ! $UPDATER_SHA256 =~ ^[0-9a-fA-F]{64}$ ]]; then
        PLAN_ERROR='A SHA-256 must contain exactly 64 hexadecimal characters.'; return 1
    fi
    if [[ -n $UPDATER_FILE ]]; then
        if [[ ! -f $UPDATER_FILE || ! -r $UPDATER_FILE ]]; then
            PLAN_ERROR='Select a readable production updater file.'; return 1
        fi
        if ! bash -n "$UPDATER_FILE" 2>/dev/null; then
            PLAN_ERROR='The selected updater does not pass Bash syntax validation.'; return 1
        fi
    fi
}

elevate() {
    local self=$1; shift
    local askdir status
    if [[ -t 0 && -t 2 ]]; then
        exec sudo -- /bin/bash "$self" "$@"
    elif command -v zenity >/dev/null && [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
        # sudo obtains the password directly from askpass. No password variable,
        # command-line argument, log entry, or long-running credential keepalive.
        askdir=$(mktemp -d "${TMPDIR:-/tmp}/powerup-askpass.XXXXXXXX")
        chmod 700 "$askdir"
        printf '#!/bin/sh\nexec zenity --password --title="CSI Linux Powerup" --text="Enter your sudo password."\n' > "$askdir/askpass"
        chmod 700 "$askdir/askpass"
        status=0
        SUDO_ASKPASS="$askdir/askpass" sudo -A -- /bin/bash "$self" "$@" || status=$?
        rm -rf -- "$askdir"
        exit "$status"
    elif command -v pkexec >/dev/null; then
        exec pkexec /bin/bash "$self" "$@"
    else
        die 'Open a terminal and run this script with sudo.'
    fi
}

# Parse both APT formats. Touch only identified Ubuntu/Tor sources, preserving
# unrelated repositories and comments. A transaction manifest supports rollback.
repository_config() {
    python3 - "$@" <<'PY_REPOSITORIES'
import json, os, re, shlex, shutil, sys, tempfile
from pathlib import Path
from urllib.parse import urlsplit

mode, root_s, backup_s, tor_enabled, arch = sys.argv[1:]
release_prep = mode == 'prepare-release'
series = 'noble' if release_prep else 'resolute'
root, backup = Path(root_s), Path(backup_s)
manifest = backup / 'manifest.json'
ubuntu_target = root / 'sources.list.d/csi-powerup-ubuntu.sources'
tor_target = root / 'sources.list.d/csi-powerup-tor.sources'

def atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    fd, temp = tempfile.mkstemp(prefix='.powerup-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(text)
        os.chmod(temp, 0o644)
        os.replace(temp, path)
    finally:
        if os.path.exists(temp): os.unlink(temp)

if mode == 'rollback':
    if manifest.exists():
        for relative, existed in json.loads(manifest.read_text()).items():
            path = root / relative
            if existed:
                shutil.copy2(backup / 'files' / relative, path)
            else:
                path.unlink(missing_ok=True)
        print('Restored APT source files from', backup)
    sys.exit(0)
if mode not in ('configure', 'prepare-release'): raise SystemExit('Unknown repository operation')

def kind(uri, signed=''):
    host = (urlsplit(uri).hostname or '').lower()
    if host == 'deb.torproject.org': return 'tor'
    if (host in ('archive.ubuntu.com', 'security.ubuntu.com', 'ports.ubuntu.com',
                 'old-releases.ubuntu.com') or host.endswith('.archive.ubuntu.com')
            or 'ubuntu-archive-keyring.gpg' in signed): return 'ubuntu'
    return 'other'

# Do not rewrite a PPA's distribution. Refuse recognizable mismatched Ubuntu
# release suites rather than quietly leave a mixed-release package source active.
old_series = set('precise trusty xenial bionic focal jammy kinetic lunar mantic noble oracular plucky questing stonking devel'.split())
def check_other(suites, path):
    for suite in suites:
        if suite.split('-')[0] in old_series:
            raise ValueError(f'{path}: unrelated repository uses {suite}; disable it or verify its Resolute support first')

def stanza_fields(block):
    fields, last = {}, None
    for line in block.splitlines():
        if not line.strip() or line.lstrip().startswith('#'): continue
        if line[:1].isspace() and last:
            fields[last] += ' ' + line.strip()
        else:
            key, sep, value = line.partition(':')
            if not sep: raise ValueError('Malformed deb822 line: ' + line)
            last = key.lower()
            if last in fields: raise ValueError('Duplicate deb822 field: ' + key)
            fields[last] = value.strip()
    return fields

changes = {}
paths = sorted(set([root / 'sources.list', *root.glob('sources.list.d/*.list'),
                    *root.glob('sources.list.d/*.sources')]))
for path in paths:
    if not path.exists(): continue
    if path.is_symlink(): raise ValueError(f'{path}: symlinked source files require manual review')
    original = path.read_text()
    pieces = []
    has_other = False
    if path.suffix == '.sources':
        for block in re.split(r'\n[ \t]*\n', original):
            fields = stanza_fields(block)
            if not fields or fields.get('enabled', 'yes').lower() == 'no':
                pieces.append(block); continue
            uris = fields.get('uris', '').split()
            if not uris: raise ValueError(f'{path}: active stanza has no URIs')
            kinds = {kind(u, fields.get('signed-by', '')) for u in uris}
            if not release_prep and 'other' in kinds and len(kinds) > 1:
                raise ValueError(f'{path}: mixed Ubuntu/Tor and unrelated URIs in one stanza')
            if release_prep or kinds <= {'ubuntu', 'tor'}:
                reason = 'Disabled for Ubuntu release upgrade; original in Powerup backup.' if release_prep else 'Source replaced by CSI Powerup managed deb822 sources.'
                pieces.append('# ' + reason)
            else:
                has_other = True
                check_other(fields.get('suites', '').split(), path)
                pieces.append(block)
        updated = '\n\n'.join(pieces).rstrip() + '\n'
    else:
        for line in original.splitlines(keepends=True):
            if not re.match(r'^\s*deb(?:-src)?\s', line): pieces.append(line); continue
            tokens = shlex.split(line, comments=True)
            i, options = 1, []
            if tokens[i].startswith('['):
                while i < len(tokens):
                    options.append(tokens[i]); i += 1
                    if options[-1].endswith(']'): break
            if len(tokens) <= i + 1: raise ValueError(f'{path}: malformed deb source')
            uri, suite = tokens[i:i+2]
            if release_prep or kind(uri, ' '.join(options)) != 'other':
                pieces.append('# Disabled by CSI Powerup: ' + line.lstrip())
            else:
                has_other = True; check_other([suite], path); pieces.append(line)
        updated = ''.join(pieces)
    if path in (ubuntu_target, tor_target):
        if has_other: raise ValueError(f'{path}: managed filename contains unrelated sources')
        continue
    if updated != original: changes[path] = updated

# Signed HTTP is used only for dependency bootstrap, allowing CA certificates
# themselves to be installed. Final configuration always uses HTTPS.
scheme = 'https' if tor_enabled == '1' else 'http'
archive = f'{scheme}://archive.ubuntu.com/ubuntu' if arch == 'amd64' else f'{scheme}://ports.ubuntu.com/ubuntu-ports'
security = f'{scheme}://security.ubuntu.com/ubuntu' if arch == 'amd64' else archive
changes[ubuntu_target] = f'''# Managed by CSI Linux Powerup. Original sources are backed up.
Types: deb
URIs: {archive}
Suites: {series} {series}-updates {series}-backports
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: {security}
Suites: {series}-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
'''
changes[tor_target] = f'''# Managed by CSI Linux Powerup. Stable Tor packages only.
Types: deb
URIs: https://deb.torproject.org/torproject.org/
Suites: resolute
Components: main
Architectures: {arch}
Signed-By: /etc/apt/keyrings/csi-torproject.gpg
''' if tor_enabled == '1' else '# Tor repository temporarily disabled during dependency bootstrap.\n'
changes = {p: data for p, data in changes.items() if not p.exists() or p.read_text() != data}
backup.mkdir(parents=True, exist_ok=True, mode=0o700)
entries = json.loads(manifest.read_text()) if manifest.exists() else {}
# Save the complete rollback manifest before the first mutation.
for path in changes:
    relative = str(path.relative_to(root))
    if relative not in entries:
        entries[relative] = path.exists()
        if path.exists():
            dest = backup / 'files' / relative
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, dest)
atomic(manifest, json.dumps(entries, indent=2) + '\n')
for path, data in changes.items():
    atomic(path, data)
    print('Configured', path)
if not changes: print('APT source files already match the requested configuration.')
print(f'Ubuntu suites: {series} {series}-updates {series}-security {series}-backports')
print('Ubuntu components: main restricted universe multiverse')
if release_prep: print('Third-party sources disabled for the release upgrade; original files retained in backup.')
if tor_enabled == '1':
    print(f'Tor repository: https://deb.torproject.org/torproject.org/ resolute main ({arch})')
PY_REPOSITORIES
}

apt_execute() {
    local result token mutable=0
    for token in "$@"; do
        case $token in install|upgrade|dist-upgrade|full-upgrade|remove) mutable=1;; esac
    done
    if DEBIAN_FRONTEND=noninteractive "$@"; then return 0; else result=$?; fi
    # Do not retry signature/source errors, diagnostics, or recursively repair.
    if (( ! mutable )) || [[ -z ${WORK:-} || ${REPAIR_ACTIVE:-0} == 1 ]]; then return "$result"; fi
    log "Package operation failed ($result); attempting one automatic repair"
    repair_packages || return "$result"
    log 'Retrying the original package operation once'
    DEBIAN_FRONTEND=noninteractive "$@"
}

apt_run() { apt_execute apt-get "${APT_OPTIONS[@]}" "$@"; }
# Use the specifically requested apt commands for routine OS maintenance.
# Retain apt-get for dependency installation and explicit full-upgrade mode.
apt_maintenance() { apt_execute apt "${APT_OPTIONS[@]}" "$@"; }

restore_service_policy() {
    local path=${1:-/usr/sbin/policy-rc.d}
    if [[ ${SERVICE_POLICY_ACTIVE:-0} == 1 ]]; then
        if cmp -s -- "$path" "$WORK/repair-policy.sh"; then
            rm -- "$path" || return 1
            if [[ $path == /usr/sbin/policy-rc.d ]]; then rm -f /var/lib/csi-powerup/temporary-service-policy; fi
            SERVICE_POLICY_ACTIVE=0
        else
            log 'ERROR: Temporary service policy changed externally; manual review is required.'
            return 1
        fi
    fi
}

restore_interrupted_policy() {
    local path=${1:-/usr/sbin/policy-rc.d} saved=${2:-/var/lib/csi-powerup/temporary-service-policy}
    [[ -f $saved ]] || return 0
    if [[ ! -e $path && ! -L $path ]]; then rm -- "$saved"; return; fi
    if cmp -s -- "$path" "$saved"; then
        rm -- "$path" "$saved" || return 1
        log 'Removed the temporary service policy left by an interrupted Powerup run'
    else
        die 'Service policy changed since an interrupted repair; review /usr/sbin/policy-rc.d before proceeding.'
    fi
}

defer_failed_milter() {
    local status path=${1:-/usr/sbin/policy-rc.d}
    status=$(dpkg-query -W -f='${db:Status-Status}' clamav-milter 2>/dev/null) || return 0
    [[ $status == half-configured || $status == unpacked ]] || return 0
    systemctl is-failed --quiet clamav-milter.service || return 0
    # Preserve administrator service policies. Never overwrite an existing file.
    if [[ -e $path || -L $path ]]; then
        log 'Existing service policy retained; no temporary milter deferral installed.'
        return 0
    fi
    cat > "$WORK/repair-policy.sh" <<'POLICY'
#!/bin/sh
# CSI Powerup: temporary deferral of a failed milter restart during dpkg repair.
service=${1##*/}
service=${service%.service}
case "$service:${2:-}" in
    clamav-milter:start|clamav-milter:restart|clamav-milter:try-restart|clamav-milter:force-reload) exit 101 ;;
esac
exit 0
POLICY
    if [[ $path == /usr/sbin/policy-rc.d ]]; then
        install -d -m 700 /var/lib/csi-powerup || return 1
        cp -- "$WORK/repair-policy.sh" /var/lib/csi-powerup/temporary-service-policy || return 1
    fi
    # Noclobber uses exclusive creation, including protection from symlinks.
    (set -C; cat "$WORK/repair-policy.sh" > "$path") || return 1
    SERVICE_POLICY_ACTIVE=1
    chmod 755 "$path" || return 1
    MILTER_DEFERRED=1
    log 'Temporarily deferring the failed clamav-milter restart while package configuration is repaired'
}

retry_deferred_service() {
    [[ ${MILTER_DEFERRED:-0} == 1 ]] || return 0
    MILTER_DEFERRED=0
    log 'Retrying clamav-milter after package repair; service configuration is preserved'
    systemctl reset-failed clamav-milter.service || true
    if timeout 90 systemctl restart clamav-milter.service && systemctl is-active --quiet clamav-milter.service; then
        log 'clamav-milter restarted successfully'
    else
        SERVICE_WARNINGS=1
        log 'WARNING: Package configuration was repaired, but clamav-milter is not confirmed active. Mail filtering needs attention.'
        systemctl status clamav-milter.service --no-pager -l || true
        journalctl -u clamav-milter.service -n 40 --no-pager || true
    fi
}

repair_packages() {
    local repaired=0 audit
    local package flag
    local -a removal_guard=(--no-remove)
    local -a reinstall=()
    [[ ${FULL_UPGRADE:-0} == 1 || ${BASE_CODENAME:-} == noble ]] && removal_guard=()
    REPAIR_ACTIVE=1
    log 'Automatic repair: configure pending packages, fix dependencies, verify package state'
    if [[ ! -e $BACKUP/dpkg-status.before-repair ]]; then
        cp -a /var/lib/dpkg/status "$BACKUP/dpkg-status.before-repair" || { REPAIR_ACTIVE=0; return 1; }
    fi
    if ! defer_failed_milter; then
        restore_service_policy || true
        REPAIR_ACTIVE=0; return 1
    fi
    if ! DEBIAN_FRONTEND=noninteractive dpkg --force-confdef --force-confold --configure -a; then
        log 'Pending configuration still needs dependencies or service recovery'
        if ! defer_failed_milter; then restore_service_policy || true; REPAIR_ACTIVE=0; return 1; fi
    fi
    while IFS=$'\t' read -r package flag; do
        if [[ $flag == reinstreq && $package =~ ^[a-z0-9][a-z0-9.+:-]+$ ]]; then reinstall+=("$package"); fi
    done < <(dpkg-query -W -f='${binary:Package}\t${db:Status-Eflag}\n')
    if (( ${#reinstall[@]} )); then
        log "Reinstalling packages marked as requiring reinstallation: ${reinstall[*]}"
        DEBIAN_FRONTEND=noninteractive apt-get "${APT_OPTIONS[@]}" install --reinstall --no-remove -y "${reinstall[@]}" ||
            log 'Targeted reinstall failed; continuing to the bounded dependency-repair attempt'
    fi
    if DEBIAN_FRONTEND=noninteractive apt-get "${APT_OPTIONS[@]}" --fix-broken install -y "${removal_guard[@]}" &&
       DEBIAN_FRONTEND=noninteractive dpkg --force-confdef --force-confold --configure -a &&
       DEBIAN_FRONTEND=noninteractive apt-get "${APT_OPTIONS[@]}" check; then
        audit=$(dpkg --audit) || audit='Package audit failed'
        if [[ -z $audit ]]; then repaired=1; else printf '%s\n' "$audit"; fi
    fi
    restore_service_policy || { REPAIR_ACTIVE=0; return 1; }
    retry_deferred_service
    REPAIR_ACTIVE=0
    if (( repaired )); then log 'Automatic package repair completed'; return 0; fi
    log 'ERROR: Automatic repair could not produce a consistent package state. See the operation log.'
    return 1
}

check_and_repair_packages() {
    local audit
    audit=$(dpkg --audit) || audit='Package audit failed'
    if [[ -n $audit ]]; then
        printf '%s\n' "$audit"
        repair_packages || die 'Package repair was unsuccessful; upgrade stopped before further changes.'
    elif ! apt_run check; then
        repair_packages || die 'Dependency repair was unsuccessful; upgrade stopped.'
    fi
}
apt_refresh() {
    log 'Running apt update (signature checks enabled; repository errors are fatal)'
    apt_maintenance update
    log 'apt update completed successfully'
}

download() {
    local url=$1 destination=$2
    curl --fail --show-error --location --proto '=https' --proto-redir '=https' \
        --connect-timeout 20 --retry 3 --retry-delay 2 --speed-limit 1024 --speed-time 60 \
        --output "$destination" "$url"
}

verify_sha256() {
    local path=$1 expected=$2 actual
    [[ -n $expected ]] || return 0
    actual=$(sha256sum -- "$path"); actual=${actual%% *}
    [[ $actual == "${expected,,}" ]] || die "SHA-256 mismatch: $path"
}

install_tor_key() {
    log 'Validating the Tor Project repository signing key'
    # Refresh the certificate so renewed expiry/subkey data is not hidden by a
    # stale local copy. Verify the primary fingerprint before trusting its bytes.
    download "https://deb.torproject.org/torproject.org/$TOR_FINGERPRINT.asc" "$WORK/tor.asc"
    mkdir -m 700 "$WORK/gnupg"
    local listing fingerprint
    listing=$(gpg --homedir "$WORK/gnupg" --batch --with-colons --show-keys "$WORK/tor.asc")
    fingerprint=$(awk -F: '$1=="pub"{p=1;next} p && $1=="fpr"{print $10;p=0}' <<< "$listing")
    [[ $fingerprint == "$TOR_FINGERPRINT" ]] || die 'Downloaded Tor key has an unexpected primary fingerprint.'
    gpg --homedir "$WORK/gnupg" --batch --yes --dearmor --output "$WORK/tor.gpg" "$WORK/tor.asc"
    install -d -m 755 /etc/apt/keyrings
    if ! cmp -s "$WORK/tor.gpg" /etc/apt/keyrings/csi-torproject.gpg; then
        [[ ! -e /etc/apt/keyrings/csi-torproject.gpg ]] ||
            cp -p /etc/apt/keyrings/csi-torproject.gpg "$BACKUP/previous-tor-key.gpg"
        install -m 644 "$WORK/tor.gpg" /etc/apt/keyrings/.csi-torproject.gpg.new
        mv -f /etc/apt/keyrings/.csi-torproject.gpg.new /etc/apt/keyrings/csi-torproject.gpg
    fi
}

prepare_repositories() {
    local package status
    local -a missing=()
    for package in ca-certificates curl gnupg; do
        status=$(dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null) || status=''
        [[ $status == installed ]] || missing+=("$package")
    done
    SOURCES_PENDING=1
    if (( ${#missing[@]} )); then
        log "Bootstrapping dependencies in one transaction: ${missing[*]}"
        repository_config configure /etc/apt "$BACKUP" 0 "$ARCH"
        apt_refresh
        apt_run install --no-install-recommends -y "${missing[@]}"
    fi
    install_tor_key
    repository_config configure /etc/apt "$BACKUP" 1 "$ARCH"
    apt_refresh
    SOURCES_PENDING=0
}

update_os() {
    local policy
    local -a packages=(tor)
    # OS maintenance is independent of the starter-program list, bootstrap flag,
    # and optional CSI category updater. Never gate this on missing packages.
    if (( FULL_UPGRADE )); then
        log 'Running apt-get dist-upgrade -y (explicit --full-upgrade selection)'
        apt_run dist-upgrade -y
        log 'Full package upgrade completed successfully'
    else
        log 'Running apt upgrade -y'
        apt_maintenance upgrade -y
        log 'apt upgrade -y completed successfully'
    fi
    # Some Resolute repository snapshots have lacked this optional rollover
    # package. Do not fail the entire update, or substitute a different suite.
    policy=$(apt-cache policy deb.torproject.org-keyring)
    if awk '/Candidate:/ {if ($2 != "(none)") found=1} END {exit !found}' <<< "$policy"; then
        packages+=(deb.torproject.org-keyring)
    else
        log 'Tor rollover keyring package unavailable; using the fingerprint-verified local key. It is refreshed each run.'
    fi
    log 'Installing/updating Tor'
    apt_run install --no-install-recommends --no-remove -y "${packages[@]}"
    apt_run check
    log 'Held packages (if any)'
    apt-mark showhold
    log 'Remaining upgrades, including held or phased packages (if any)'
    apt list --upgradable 2>/dev/null
    if [[ -f /var/run/reboot-required ]]; then log 'A reboot is required to finish applying some updates.'; fi
}

maintain_system() {
    log 'Mandatory phase 1/2: configure Ubuntu Resolute and Tor repositories; run apt update'
    prepare_repositories
    log 'Mandatory phase 2/2: upgrade installed packages'
    update_os
}

set_lts_prompt() {
    python3 - "${1:-/etc/update-manager/release-upgrades}" "$BACKUP" <<'PY_LTS'
import configparser, io, os, shutil, sys, tempfile
from pathlib import Path
path, backup = Path(sys.argv[1]), Path(sys.argv[2])
if path.is_symlink(): raise ValueError('release-upgrades must not be a symlink')
config = configparser.ConfigParser()
if path.exists():
    config.read(path)
    shutil.copy2(path, backup / 'release-upgrades.before')
config['DEFAULT']['Prompt'] = 'lts'
stream = io.StringIO()
config.write(stream)
path.parent.mkdir(parents=True, exist_ok=True)
fd, temp = tempfile.mkstemp(prefix='.powerup-', dir=path.parent)
try:
    with os.fdopen(fd, 'w') as f: f.write(stream.getvalue())
    os.chmod(temp, 0o644)
    os.replace(temp, path)
finally:
    if os.path.exists(temp): os.unlink(temp)
print('Release upgrade track: LTS (Prompt=lts)')
PY_LTS
}

boot_id() { cat /proc/sys/kernel/random/boot_id; }
reboot_required() { [[ -f /var/run/reboot-required ]]; }
require_release_terminal() {
    if [[ ${RELEASE_UI:-text} == gtk ]]; then
        [[ -n ${DISPLAY:-} ]] || die 'Ubuntu graphical release upgrade needs an X11/XWayland display. Start Powerup from your desktop session.'
        return
    fi
    [[ -t 0 ]] || die 'The Ubuntu release upgrade needs a terminal. Run: sudo /opt/csitools/powerup --cli os-update'
}

run_release_upgrader() {
    if [[ ${RELEASE_UI:-text} == gtk ]]; then
        env -u DEBIAN_FRONTEND GDK_BACKEND=x11 do-release-upgrade -f DistUpgradeViewGtk3
        return
    fi
    # Keep the Ubuntu text frontend attached to its controlling terminal even
    # while Powerup's own output is logged through tee. Ubuntu records its own
    # detailed logs in /var/log/dist-upgrade/.
    env -u DEBIAN_FRONTEND do-release-upgrade -f DistUpgradeViewText </dev/tty >/dev/tty 2>&1
}

upgrade_release_if_needed() {
    STOP_AFTER_RELEASE=0
    local marker=$RELEASE_STATE_DIR/upgrade-boot-id current_boot audit check_output
    current_boot=$(boot_id)
    if [[ $BASE_CODENAME == resolute ]]; then
        if [[ -f $marker && $(cat "$marker") == "$current_boot" ]]; then
            log 'Release packages are installed, but this boot predates the release upgrade.'
            log 'Reboot, then run: /opt/csitools/powerup'
            STOP_AFTER_RELEASE=1
        fi
        return
    fi
    [[ $BASE_CODENAME == noble ]] || die 'Unexpected release upgrade source.'
    require_release_terminal
    if reboot_required; then
        log 'A reboot is already pending on Noble. Reboot before starting the release upgrade.'
        log 'After reboot, run: /opt/csitools/powerup'
        STOP_AFTER_RELEASE=1
        return
    fi
    log 'Preparing Ubuntu 24.04 (Noble) for Ubuntu 26.04 LTS (Resolute)'
    log 'Take a VM snapshot or complete backup before proceeding with a major OS upgrade.'
    audit=$(dpkg --audit)
    [[ -z $audit ]] || die "dpkg reports unfinished package work. Repair it first: $audit"
    cp -a /etc/apt "$BACKUP/apt-before-release"
    cp /etc/os-release "$BACKUP/os-release.before"
    dpkg-query -W -f='${binary:Package}\t${Version}\n' > "$BACKUP/packages-before-release.tsv"
    SOURCES_PENDING=1
    # Keep Noble suites until Ubuntu's own release upgrader performs the
    # distribution transition. Disable third-party sources with backups.
    repository_config prepare-release /etc/apt "$BACKUP" 0 "$ARCH"
    apt_refresh
    SOURCES_PENDING=0
    local -a release_dependencies=(ca-certificates update-manager-core ubuntu-release-upgrader-core)
    if [[ ${RELEASE_UI:-text} == gtk ]]; then release_dependencies+=(ubuntu-release-upgrader-gtk); fi
    apt_run install --no-install-recommends --no-remove -y "${release_dependencies[@]}"
    log 'Fully updating Noble, including phased updates, before the release upgrade'
    apt_run -o APT::Get::Always-Include-Phased-Updates=true dist-upgrade -y
    apt_run check
    if reboot_required; then
        log 'Noble prerequisites are updated. Reboot before the distribution upgrade.'
        log 'After reboot, run: /opt/csitools/powerup'
        STOP_AFTER_RELEASE=1
        return
    fi
    set_lts_prompt
    if check_output=$(env -u DEBIAN_FRONTEND do-release-upgrade --check-dist-upgrade-only 2>&1); then
        printf '%s\n' "$check_output"
    else
        printf '%s\n' "$check_output" >&2
        die 'Ubuntu is not currently offering a supported LTS upgrade, or its availability check failed. Resolute repositories have not been enabled.'
    fi
    [[ $check_output =~ 26\.04([.][0-9]+)? ]] ||
        die 'Ubuntu did not advertise the requested 26.04 LTS target. Refusing to guess another release.'
    install -d -m 700 "$RELEASE_STATE_DIR"
    boot_id > "$marker"
    log 'Starting do-release-upgrade. Review Ubuntu prompts for package removals and configuration files.'
    log 'After the required reboot, rerun: /opt/csitools/powerup'
    log 'Release upgrader logs: /var/log/dist-upgrade/'
    if run_release_upgrader; then
        read_platform
    else
        die 'Ubuntu release upgrade failed or was cancelled. See /var/log/dist-upgrade/. No forced repository substitution was performed.'
    fi
    [[ $BASE_CODENAME == resolute ]] ||
        die 'The release upgrader returned without reaching Resolute. Review /var/log/dist-upgrade/; optional tool updates were not started.'
    # Do not finalize repositories or run CSI categories in the old boot, even
    # if the user declines the release upgrader's restart prompt.
    log 'Ubuntu 26.04 release packages are installed. A reboot is still required.'
    log 'After reboot, run: /opt/csitools/powerup to finish Resolute/Tor maintenance.'
    STOP_AFTER_RELEASE=1
}

prepare_updater() {
    if [[ -n $UPDATER_FILE ]]; then
        cp -- "$UPDATER_FILE" "$WORK/csitoolsupdate.sh"
    else
        log 'Downloading the CSI category updater'
        download "$UPDATER_URL" "$WORK/csitoolsupdate.sh"
    fi
    [[ -s $WORK/csitoolsupdate.sh ]] || die 'CSI category updater is empty.'
    verify_sha256 "$WORK/csitoolsupdate.sh" "$UPDATER_SHA256"
    bash -n "$WORK/csitoolsupdate.sh"
    # The public URL was this placeholder on 2026-11-08. Do not mistake it for
    # a working tool updater, even if an environment happens to define print.
    local body
    body=$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$WORK/csitoolsupdate.sh")
    if [[ $body == 'print "Updating..."' || $body == 'echo "Updating..."' || -z $body ]]; then
        die 'OS/Tor maintenance completed, but csitoolsupdate.sh is a placeholder. Supply the production updater with --updater FILE. Selected CSI categories were NOT updated.'
    fi
    log "Category updater SHA-256: $(sha256sum "$WORK/csitoolsupdate.sh" | cut -d' ' -f1)"
}

install_csi_tools() {
    if (( ! REFRESH_TOOLS )) && [[ -d /opt/csitools ]] &&
        [[ -n $(find /opt/csitools -mindepth 1 -maxdepth 1 -print -quit) ]]; then
        log 'CSI tools are present; skipping the large bootstrap archive.'
        return
    fi
    local sevenzip url success=0
    if command -v 7zz >/dev/null; then sevenzip=7zz
    elif command -v 7z >/dev/null; then sevenzip=7z
    else
        apt_run install --no-install-recommends --no-remove -y 7zip
        if command -v 7zz >/dev/null; then sevenzip=7zz
        elif command -v 7z >/dev/null; then sevenzip=7z
        else die '7zip installed, but neither 7zz nor 7z is available.'
        fi
    fi
    log 'Downloading CSI tools into a private staging directory'
    for url in https://csilinux.com/downloads/csitools.7z \
        https://echothislabs.com/downloads/csitools.7z \
        https://informationwarfarecenter.com/downloads/csitools.7z; do
        if download "$url" "$WORK/csitools.7z"; then success=1; break; fi
    done
    (( success )) || die 'All CSI tools download mirrors failed.'
    verify_sha256 "$WORK/csitools.7z" "$TOOLS_SHA256"
    log "CSI archive SHA-256: $(sha256sum "$WORK/csitools.7z" | cut -d' ' -f1)"
    "$sevenzip" x -so "$WORK/csitools.7z" csitools.tar > "$WORK/csitools.tar"
    [[ -s $WORK/csitools.tar ]] || die 'Archive does not contain csitools.tar.'
    # Restore only the tool tree, not arbitrary /etc, /usr, or root-home files.
    # Preserve supplied executable bits; do not chmod every file or dos2unix binaries.
    python3 - "$WORK/csitools.tar" "$WORK/payload" <<'PY_ARCHIVE'
import copy, posixpath, sys, tarfile
from pathlib import Path
archive, destination = sys.argv[1:]
prefix = 'opt/csitools'
def within(name): return name == prefix or name.startswith(prefix + '/')
with tarfile.open(archive) as tar:
    selected = []
    for original in tar.getmembers():
        name = original.name
        while name.startswith('./'): name = name[2:]
        name = name.lstrip('/')
        if not within(name): continue
        if '..' in name.split('/') or '\\' in name:
            raise ValueError('Unsafe archive member: ' + original.name)
        member = copy.copy(original)
        member.name = name
        if member.issym() or member.islnk():
            link = member.linkname
            if link.startswith('/') or '\\' in link: raise ValueError('Unsafe archive link: ' + name)
            target = posixpath.normpath(posixpath.join(posixpath.dirname(name), link) if member.issym() else link)
            if not within(target): raise ValueError('Archive link leaves /opt/csitools: ' + name)
        if not (member.isfile() or member.isdir() or member.issym() or member.islnk()):
            raise ValueError('Special file in tool archive: ' + name)
        selected.append(member)
    if not any(m.isfile() for m in selected): raise ValueError('No tool files under opt/csitools in archive')
    Path(destination).mkdir(mode=0o700)
    tar.extractall(destination, members=selected, filter='data')
PY_ARCHIVE
    if [[ -d /opt/csitools ]]; then
        log "Backing up the existing tool tree to $BACKUP/csitools.tar"
        tar -cpf "$BACKUP/csitools.tar" -C /opt csitools
    fi
    [[ ! -L /opt/csitools ]] || die '/opt/csitools must not be a symlink.'
    install -d -m 755 /opt/csitools
    cp -a --remove-destination -- "$WORK/payload/opt/csitools/." /opt/csitools/
    if id csi >/dev/null 2>&1; then chown -R csi:"$(id -gn csi)" /opt/csitools; fi
    log 'CSI tools restored. Existing executable modes preserved.'
}

cleanup() {
    local status=$?
    trap - EXIT ERR
    restore_service_policy || printf 'ERROR: Review /usr/sbin/policy-rc.d before another update.\n' >&2
    if (( SOURCES_PENDING )); then
        printf '\nRepository setup failed; restoring previous source files.\n' >&2
        repository_config rollback /etc/apt "$BACKUP" 0 "$ARCH" ||
            printf 'Automatic source rollback failed. Backup: %s\n' "$BACKUP" >&2
        if [[ -f $BACKUP/previous-tor-key.gpg ]]; then
            install -m 644 "$BACKUP/previous-tor-key.gpg" /etc/apt/keyrings/csi-torproject.gpg || true
        fi
    fi
    [[ -z ${WORK:-} ]] || rm -rf -- "$WORK"
    printf '\nPowerup exit status: %s\nLog: %s\nBackup: %s\n' "$status" "$LOG_FILE" "$BACKUP"
    exit "$status"
}

parse_options() {
    local option
    local -A seen=()
    FORWARD=()
    CHECK_ONLY=0 RELEASE_UI=text
    FULL_UPGRADE=0 REFRESH_TOOLS=0 UPDATER_FILE='' TOOLS_SHA256='' UPDATER_SHA256=''
    REQUESTED=() SELECTED=()
    while (( $# )); do
        case $1 in
            --check) CHECK_ONLY=1 ;;
            --release-ui=gtk) RELEASE_UI=gtk; FORWARD+=("$1") ;;
            --full-upgrade) FULL_UPGRADE=1; FORWARD+=("$1") ;;
            --refresh-tools) REFRESH_TOOLS=1; FORWARD+=("$1") ;;
            --tools-sha256|--updater-sha256|--updater)
                option=$1
                [[ -z ${seen[$option]:-} ]] || { PLAN_ERROR="Duplicate option: $option"; return 1; }
                seen[$option]=1
                (( $# >= 2 )) || { PLAN_ERROR="$option requires a value"; return 1; }; shift
                if [[ $option == --updater ]]; then
                    [[ -f $1 && -r $1 ]] || { PLAN_ERROR="Cannot read updater: $1"; return 1; }
                    UPDATER_FILE=$(readlink -f -- "$1") || return 1
                    FORWARD+=("$option" "$UPDATER_FILE")
                else
                    [[ $1 =~ ^[0-9a-fA-F]{64}$ ]] || { PLAN_ERROR="$option requires 64 hexadecimal characters"; return 1; }
                    if [[ $option == --tools-sha256 ]]; then TOOLS_SHA256=$1; else UPDATER_SHA256=$1; fi
                    FORWARD+=("$option" "$1")
                fi ;;
            --*) PLAN_ERROR="Unknown or incompatible option: $1"; return 1 ;;
            *) REQUESTED+=("$1") ;;
        esac
        shift
    done
    if (( ! ${#REQUESTED[@]} )); then REQUESTED=(os-update); fi
}

backend_main() {
    local self option
    local -a tool_categories=()
    parse_options "$@" || die "$PLAN_ERROR"
    printf '\n========================================\nPOWERUP_REV=%s\n========================================\n' "$POWERUP_REV"
    printf 'Running powerup script: %s\n' "$(readlink -f -- "${BASH_SOURCE[0]}")"
    validate_platform
    validate_options || die "$PLAN_ERROR"
    if (( CHECK_ONLY )); then
        printf 'Platform: Ubuntu base %s (%s)\n' "$BASE_CODENAME" "$ARCH"
        if [[ $BASE_CODENAME == noble ]]; then
            printf 'Plan: fully update Noble, run do-release-upgrade to 26.04 LTS, reboot, rerun to finalize.\n'
        fi
        printf 'Ubuntu: resolute, resolute-updates, resolute-security, resolute-backports\n'
        printf 'Components: main restricted universe multiverse\nTor: stable resolute / %s\n' "$ARCH"
        printf 'Categories: %s\nFull upgrade: %s\nNo changes made.\n' "${SELECTED[*]}" "$FULL_UPGRADE"
        return
    fi
    if (( EUID != 0 )); then
        self=$(readlink -f -- "${BASH_SOURCE[0]}")
        elevate "$self" --cli "${FORWARD[@]}" "${REQUESTED[@]}"
    fi
    export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
    umask 077
    install -d -m 700 /run/csi-powerup /var/log/csi-powerup /var/backups/csi-powerup
    exec 9>/run/csi-powerup/lock
    flock -n 9 || die 'Another Powerup instance is running.'
    local run_id
    run_id=$(date '+%Y%m%d-%H%M%S')-$$
    LOG_FILE=/var/log/csi-powerup/powerup-$run_id.log
    BACKUP=/var/backups/csi-powerup/$run_id
    install -d -m 700 "$BACKUP"
    WORK=$(mktemp -d /var/tmp/csi-powerup.XXXXXXXX)
    RELEASE_STATE_DIR=/var/lib/csi-powerup
    SOURCES_PENDING=0 SERVICE_POLICY_ACTIVE=0 MILTER_DEFERRED=0 SERVICE_WARNINGS=0 REPAIR_ACTIVE=0
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'printf "ERROR: command failed at line %s (status %s).\n" "$LINENO" "$?" >&2' ERR
    exec > >(tee -a "$LOG_FILE") 2>&1
    printf 'POWERUP_REV=%s\n' "$POWERUP_REV"
    log "CSI Linux Powerup — current base $BASE_CODENAME / $ARCH; target Ubuntu 26.04 LTS"
    log "Selected: ${SELECTED[*]}"
    restore_interrupted_policy
    check_and_repair_packages
    upgrade_release_if_needed
    if (( STOP_AFTER_RELEASE )); then
        if (( SERVICE_WARNINGS )); then printf 'POWERUP_RESULT=reboot-with-warnings\n'; else printf 'POWERUP_RESULT=reboot-required\n'; fi
        return
    fi
    maintain_system
    rm -f -- "$RELEASE_STATE_DIR/upgrade-boot-id"
    for option in "${SELECTED[@]}"; do
        [[ $option == os-update ]] || tool_categories+=("$option")
    done
    if (( ${#tool_categories[@]} )); then prepare_updater; fi
    if (( ${#tool_categories[@]} || REFRESH_TOOLS )); then install_csi_tools; fi
    if (( ${#tool_categories[@]} )); then
        log "Running CSI category updater: ${tool_categories[*]}"
        # Retain the original positional API: $1 was the sudo password. It is
        # now EMPTY because the child already runs as root. Categories start $2.
        # Production updaters must accept root execution without a real password.
        local child_status=0
        POWERUP_APT_UPDATED=1 POWERUP_OS_UPDATED=1 \
            bash "$WORK/csitoolsupdate.sh" '' "${tool_categories[@]}" || child_status=$?
        check_and_repair_packages
        (( child_status == 0 )) || die "CSI category updater failed ($child_status). Package health was checked; the unknown child workflow was not automatically repeated."
    fi
    log 'Requested maintenance completed. Review remaining upgrades and reboot status above.'
    if (( SERVICE_WARNINGS )); then
        if reboot_required; then printf 'POWERUP_RESULT=reboot-with-warnings\n'; else printf 'POWERUP_RESULT=service-attention\n'; fi
    elif reboot_required; then printf 'POWERUP_RESULT=reboot-required\n'; else printf 'POWERUP_RESULT=complete\n'; fi
}

