# ------------------------- Kernel and GRUB readiness -------------------------
# These checks validate the installed boot files, not an actual firmware reboot.
# No guessed disk, --force installation, kernel purge, or automatic reboot.
boot_fail() {
    printf 'ERROR: Boot readiness: %s\n' "$*" >&2
    printf 'POWERUP_RESULT=boot-attention\n'
    BOOT_VERIFIED=0
    return 1
}

boot_mounts() {
    python3 - "${1:-512}" <<'PY_BOOT_MOUNTS'
import json, os, subprocess, sys
from pathlib import Path

def run(*args):
    return subprocess.check_output(args, text=True).strip()
def mount(path):
    return json.loads(run('findmnt', '-J', '-T', path, '-o', 'TARGET,SOURCE,FSTYPE,OPTIONS'))['filesystems'][0]
# An absent separate /boot or ESP must never be mistaken for a directory on /.
for path in ('/', '/boot', '/boot/efi'):
    if path == '/boot/efi' and not Path('/sys/firmware/efi').exists(): continue
    declared = subprocess.run(['findmnt', '--fstab', '--evaluate', '-n', '-o', 'SOURCE', '--mountpoint', path], capture_output=True, text=True)
    actual = mount(path)
    if declared.returncode == 0 and declared.stdout.strip():
        if actual['target'] != path:
            raise SystemExit('Configured boot filesystem is not mounted: ' + path)
        sources = declared.stdout.strip().splitlines()
        if len(sources) != 1 or os.path.realpath(sources[0]) != os.path.realpath(actual['source']):
            raise SystemExit('Mounted filesystem does not match fstab: ' + path)
    if path == '/boot/efi' and (actual['target'] != path or actual['fstype'] not in ('vfat', 'fat', 'msdos')):
        raise SystemExit('UEFI requires the mounted FAT EFI System Partition at /boot/efi')
    if 'rw' not in actual['options'].split(','):
        raise SystemExit('Boot filesystem is read-only: ' + path)
    fs = os.statvfs(path)
    reserve_mb = int(sys.argv[1]) if len(sys.argv) > 1 else 512
    reserve = (min(64, reserve_mb) if path == '/boot/efi' else reserve_mb) * 1024**2
    if fs.f_bavail * fs.f_frsize < reserve:
        raise SystemExit('Insufficient free space at ' + path + '; retain kernels and free space before updating')
    if fs.f_files and fs.f_favail < 1000:
        raise SystemExit('Too few free filesystem inodes at ' + path)
print('Boot filesystems are mounted, writable, and have working space')
PY_BOOT_MOUNTS
}

boot_loader_target() {
    local response target real source ancestry type table parttype found=0
    BOOT_MODE=bios BOOT_DISK=''
    if [[ -d /sys/firmware/efi ]]; then
        BOOT_MODE=uefi
        case $ARCH in
            amd64) BOOT_EFI_SUFFIX=x64; BOOT_GRUB_TARGET=x86_64-efi ;;
            arm64) BOOT_EFI_SUFFIX=aa64; BOOT_GRUB_TARGET=arm64-efi ;;
            *) boot_fail 'Unsupported UEFI architecture.'; return 1 ;;
        esac
        [[ -d /boot/efi/EFI/ubuntu ]] || { boot_fail 'Ubuntu EFI loader directory is absent; an administrator must confirm the firmware boot path.'; return 1; }
    else
        [[ $ARCH == amd64 ]] || { boot_fail 'Only amd64 BIOS or amd64/arm64 UEFI GRUB is supported.'; return 1; }
        BOOT_GRUB_TARGET=i386-pc
        response=$(printf 'GET grub-pc/install_devices\n' | debconf-communicate grub-pc) || return 1
        [[ $response == '0 '* ]] || { boot_fail 'Cannot read the existing BIOS GRUB installation target.'; return 1; }
        target=${response#0 }; target=${target//,/ }
        local -a targets=()
        read -r -a targets <<< "$target"
        (( ${#targets[@]} == 1 )) || { boot_fail 'BIOS GRUB needs one confirmed installation disk; multi-disk or unset targets need administrator review.'; return 1; }
        real=$(readlink -e -- "${targets[0]}") || return 1
        [[ -b $real ]] || { boot_fail 'Recorded BIOS target is not a block device.'; return 1; }
        type=$(lsblk -dn -o TYPE "$real") || return 1
        [[ $type == disk ]] || { boot_fail 'Recorded BIOS target is not a whole disk; refusing a partition install.'; return 1; }
        source=$(findmnt -n -o SOURCE -T /boot) || return 1
        ancestry=$(lsblk -snr -o PATH "$source") || return 1
        if ! grep -Fxq -- "$real" <<< "$ancestry"; then
            boot_fail 'Recorded GRUB installation disk does not contain /boot; refusing to guess.'; return 1
        fi
        table=$(lsblk -dn -o PTTYPE "$real") || return 1
        if [[ $table == gpt ]]; then
            while read -r parttype; do
                [[ ${parttype,,} != 21686148-6449-6e6f-744e-656564454649 ]] || found=1
            done < <(lsblk -nr -o PARTTYPE "$real")
            (( found )) || { boot_fail 'BIOS on GPT requires an existing BIOS Boot partition. No partition changes will be attempted.'; return 1; }
        elif [[ $table != dos ]]; then
            boot_fail 'Unrecognized BIOS partition table; refusing to reinstall GRUB.'; return 1
        fi
        BOOT_DISK=$real
    fi
    [[ -s /usr/lib/grub/$BOOT_GRUB_TARGET/normal.mod ]] || { boot_fail "Missing GRUB platform modules: $BOOT_GRUB_TARGET. Repair the installed GRUB package first."; return 1; }
    local fs abstraction
    fs=$(grub-probe --target=fs /boot) || return 1
    abstraction=$(grub-probe --target=abstraction /boot) || return 1
    case $fs in ext2|xfs|fat) ;; *) boot_fail "Boot filesystem $fs needs a layout-specific review before an OS update."; return 1;; esac
    [[ -z $abstraction ]] || { boot_fail "Complex /boot layout ($abstraction) needs administrator review; no automatic bootloader replacement."; return 1; }
    log "Confirmed GRUB platform: $BOOT_GRUB_TARGET ${BOOT_DISK:+on $BOOT_DISK}"
}

boot_required_modules() {
    python3 - <<'PY_BOOT_MODULES'
from pathlib import Path
import subprocess
modules = set()
# Walk each current block device's driver ancestry, including its host controller.
for link in Path('/sys/class/block').glob('*'):
    device = link.resolve()
    while str(device).startswith('/sys/devices/'):
        module = device / 'driver/module'
        if module.exists(): modules.add(module.resolve().name)
        device = device.parent
fs = subprocess.check_output(['findmnt', '-n', '-o', 'FSTYPE', '/'], text=True).strip()
if fs not in ('ext2', 'ext3', 'ext4', 'xfs', 'btrfs'):
    raise SystemExit('Root filesystem needs a specific initramfs check: ' + fs)
modules.add('ext4' if fs in ('ext2', 'ext3') else fs)
print('\n'.join(sorted(modules)))
PY_BOOT_MODULES
}

boot_preflight() {
    BOOT_VERIFIED=0 BOOT_ACTIVE=0
    local command kernel required space
    for command in findmnt lsblk grub-probe grub-mkconfig grub-script-check grub-install \
        update-initramfs lsinitramfs depmod modprobe modinfo; do
        command -v "$command" >/dev/null || { boot_fail "Missing boot maintenance tool: $command. Repair boot packages before updating."; return 1; }
    done
    boot_mounts || { boot_fail 'Boot mount or free-space checks failed. No package changes started.'; return 1; }
    boot_loader_target || return 1
    kernel=$(uname -r)
    [[ $kernel =~ ^[0-9][A-Za-z0-9.+_-]+$ && -s /boot/vmlinuz-$kernel && -d /lib/modules/$kernel ]] || {
        boot_fail 'The running kernel image or modules are missing. Restore that fallback before an upgrade.'; return 1;
    }
    BOOT_FALLBACK=$kernel
    boot_required_modules > "$WORK/boot-required-modules" || return 1
    # Keep an on-disk recovery copy of the running kernel, modules and GRUB files.
    # This is not a VM snapshot and cannot repair a disk or firmware failure.
    required=$(du -sb /lib/modules/"$kernel" /boot/grub /boot/vmlinuz-"$kernel" | awk '{n+=$1} END{print n+536870912}') || return 1
    space=$(df -B1 --output=avail "$BACKUP" | tail -n 1) || return 1
    (( space > required )) || { boot_fail 'Insufficient backup space for the running kernel and GRUB.'; return 1; }
    install -d -m 700 "$BACKUP/boot" "$BACKUP/modules"
    cp -a --reflink=auto /boot/grub "$BACKUP/boot/" || return 1
    cp -a --reflink=auto /lib/modules/"$kernel" "$BACKUP/modules/" || return 1
    local file
    for file in /boot/vmlinuz-"$kernel" /boot/initrd.img-"$kernel" /boot/config-"$kernel" /boot/System.map-"$kernel"; do
        [[ ! -e $file ]] || cp -L --preserve=mode,timestamps --reflink=auto "$file" "$BACKUP/boot/" || return 1
    done
    [[ ! -e /etc/default/grub ]] || cp -a /etc/default/grub "$BACKUP/grub.defaults" || return 1
    [[ ! -d /etc/default/grub.d ]] || cp -a /etc/default/grub.d "$BACKUP/grub.defaults.d" || return 1
    BOOT_ACTIVE=1
    log "Fallback kernel $kernel and GRUB files backed up to $BACKUP"
}

boot_kernel_versions() {
    local path package status
    {
        for path in /boot/vmlinuz-[0-9]*; do [[ ! -e $path ]] || printf '%s\n' "${path##*/vmlinuz-}"; done
        while IFS=$'\t' read -r status package; do
            [[ $status == installed ]] || continue
            package=${package%%:*}; package=${package#linux-image-}; package=${package#unsigned-}
            [[ $package =~ ^[0-9][A-Za-z0-9.+_-]+$ ]] && printf '%s\n' "$package"
        done < <(dpkg-query -W -f='${db:Status-Status}\t${binary:Package}\n' 'linux-image-[0-9]*' 'linux-image-unsigned-[0-9]*' 2>/dev/null || true)
    } | sort -Vu
}

boot_initrd_valid() {
    local kernel=$1 listing=$WORK/initrd-contents module path dependencies
    [[ -r $WORK/boot-required-modules && -s /boot/initrd.img-$kernel ]] || return 1
    lsinitramfs /boot/initrd.img-"$kernel" > "$listing" || return 1
    grep -Eq '^(\./)?(usr/)?init$' "$listing" || return 1
    while read -r module; do
        [[ -n $module ]] || continue
        dependencies=$(modprobe --show-depends --set-version "$kernel" "$module") || return 1
        while read -r path; do
            [[ -n $path ]] || continue
            [[ -s $path ]] || return 1
            path=${path#/}; path=${path#usr/}
            # usrmerge paths are both accepted; module suffix compression retained.
            if ! grep -Fxq -- "$path" "$listing" && ! grep -Fxq -- "usr/$path" "$listing"; then return 1; fi
        done < <(awk '$1=="insmod"{print $2}' <<< "$dependencies")
    done < "$WORK/boot-required-modules"
    if [[ -e /dev/mapper/control ]]; then
        local root_source types
        root_source=$(findmnt -n -o SOURCE /) || return 1
        types=$(lsblk -snr -o TYPE "$root_source") || return 1
        if grep -Fxq crypt <<< "$types"; then grep -Eq '(^|/)(cryptroot|systemd-cryptsetup)(/|$)' "$listing" || return 1; fi
        if grep -Fxq lvm <<< "$types"; then grep -Eq '(^|/)lvm$' "$listing" || return 1; fi
    fi
}

boot_repair_kernel() {
    local kernel=$1 package status candidate mode=-u module modules_ok=1
    local -a reinstall=()
    [[ $kernel =~ ^[0-9][A-Za-z0-9.+_-]+$ ]] || return 1
    [[ -r $WORK/boot-required-modules ]] || return 1
    while read -r module; do
        [[ -z $module ]] || modinfo -k "$kernel" -n "$module" >/dev/null 2>&1 || modules_ok=0
    done < "$WORK/boot-required-modules"
    if (( ! modules_ok )) || [[ ! -s /boot/vmlinuz-$kernel || ! -s /lib/modules/$kernel/modules.builtin || ! -s /lib/modules/$kernel/modules.order ]]; then
        for package in "linux-image-$kernel" "linux-image-unsigned-$kernel" "linux-modules-$kernel" "linux-modules-extra-$kernel"; do
            status=$(dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null) || status=''
            candidate=$(apt-cache policy "$package" | awk '/Candidate:/ {print $2}') || return 1
            if [[ -n $candidate && $candidate != '(none)' ]] && { [[ $status == installed || $package == linux-modules-* ]]; }; then reinstall+=("$package"); fi
        done
        (( ${#reinstall[@]} )) || { boot_fail "Kernel $kernel is incomplete and its installed packages are unavailable for repair."; return 1; }
        apt_run install --reinstall --no-remove -y "${reinstall[@]}" || return 1
    fi
    [[ -s /boot/vmlinuz-$kernel && -s /lib/modules/$kernel/modules.builtin && -s /lib/modules/$kernel/modules.order ]] || return 1
    depmod -a "$kernel" || return 1
    if boot_initrd_valid "$kernel"; then return 0; fi
    [[ -e /boot/initrd.img-$kernel ]] || mode=-c
    log "Rebuilding the startup image for kernel $kernel ($mode)"
    update-initramfs "$mode" -k "$kernel" || return 1
    boot_initrd_valid "$kernel" || { boot_fail "Startup image for $kernel is still incomplete after rebuilding."; return 1; }
}

boot_validate_menu() {
    local require_newest=1
    if [[ ${1:-} == --kernel-hook ]]; then require_newest=0; shift; fi
    local menu=$1; shift
    grub-script-check "$menu" || return 1
    local root_uuid
    root_uuid=$(findmnt -n -o UUID /) || return 1
    [[ -n $root_uuid ]] || return 1
    python3 - "$menu" "$root_uuid" "$require_newest" "$@" <<'PY_BOOT_MENU'
import re, sys
from pathlib import Path
text = Path(sys.argv[1]).read_text()
entries = re.split(r'(?m)^\s*menuentry\s+', text)[1:]
kernels = sys.argv[4:]
for kernel in kernels:
    valid = False
    for entry in entries:
        # Do not count lines from a later submenu or custom sourced script.
        linux = re.search(r'(?m)^\s*linux(?:efi)?\s+(\S*vmlinuz-' + re.escape(kernel) + r')\s+([^\n]+)', entry)
        initrd = re.search(r'(?m)^\s*initrd(?:efi)?\s+([^\n]+)', entry)
        if linux and initrd and ('root=UUID=' + sys.argv[2]) in linux[2].split():
            if any(p.endswith('/initrd.img-' + kernel) for p in initrd[1].split()):
                valid = True
                break
    if not valid:
        raise SystemExit('No matching kernel + initrd + root entry in GRUB for ' + kernel)
if not kernels: raise SystemExit('No bootable kernels were validated')
first_linux = re.search(r'(?m)^\s*linux(?:efi)?\s+\S*vmlinuz-' + re.escape(kernels[-1]) + r'\s+', entries[0])
if sys.argv[3] == '1' and not first_linux: raise SystemExit('The first GRUB entry is not the newest validated Ubuntu kernel')
print('GRUB contains matching kernel and startup-image entries')
PY_BOOT_MENU
}

boot_update_loader() {
    if [[ $BOOT_MODE == bios ]]; then
        # BOOT_DISK came from debconf AND /boot ancestry. Never infer /dev/sda.
        grub-install --target=i386-pc --recheck "$BOOT_DISK" || return 1
        [[ -s /boot/grub/i386-pc/normal.mod ]] || return 1
    else
        # Ubuntu's signed package scripts maintain shim and the signed EFI loader.
        # A generic grub-install may break Secure Boot, so do not substitute one.
        local package status
        for package in "grub-efi-$ARCH-signed" shim-signed; do
            status=$(dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null) || return 1
            [[ $status == installed ]] || { boot_fail "Required signed EFI package is missing: $package"; return 1; }
        done
        DEBIAN_FRONTEND=noninteractive dpkg-reconfigure "grub-efi-$ARCH-signed" || return 1
        DEBIAN_FRONTEND=noninteractive dpkg-reconfigure shim-signed || return 1
        [[ -s /boot/efi/EFI/ubuntu/shim$BOOT_EFI_SUFFIX.efi && -s /boot/efi/EFI/ubuntu/grub$BOOT_EFI_SUFFIX.efi && -s /boot/efi/EFI/ubuntu/grub.cfg ]] || {
            boot_fail 'Ubuntu signed EFI loader or its GRUB configuration is missing.'; return 1;
        }
        local uuid
        uuid=$(grub-probe --target=fs_uuid /boot/grub) || return 1
        grep -Fq -- "$uuid" /boot/efi/EFI/ubuntu/grub.cfg || { boot_fail 'EFI GRUB configuration does not identify the current boot filesystem.'; return 1; }
    fi
}

boot_restore_validated_menu() {
    local restored
    [[ -s $WORK/grub.cfg.validated ]] || return 1
    restored=$(mktemp /boot/grub/.powerup-recovery.XXXXXXXX) || return 1
    if ! cp -p "$WORK/grub.cfg.validated" "$restored" || ! mv -f "$restored" /boot/grub/grub.cfg; then
        rm -f -- "$restored"; return 1
    fi
    sync -f /boot/grub/grub.cfg || return 1
    log 'Restored the menu that passed the current kernel checks; loader repair still needs attention'
}

boot_ensure_ready() {
    BOOT_VERIFIED=0
    log 'Checking installed kernels, startup images and GRUB before completion'
    boot_mounts || { boot_fail 'Boot filesystems are no longer ready.'; return 1; }
    boot_loader_target || return 1
    local kernel menu phase=${1:-final}
    local -a kernels=()
    if [[ ! -s /boot/vmlinuz-$BOOT_FALLBACK || ! -s /lib/modules/$BOOT_FALLBACK/modules.builtin || ! -s /lib/modules/$BOOT_FALLBACK/modules.order ]]; then
        log "Restoring the running fallback kernel $BOOT_FALLBACK from the private backup"
        [[ -s $BACKUP/boot/vmlinuz-$BOOT_FALLBACK && -s $BACKUP/boot/initrd.img-$BOOT_FALLBACK && -d $BACKUP/modules/$BOOT_FALLBACK ]] || {
            boot_fail 'Fallback recovery files are incomplete.'; return 1;
        }
        cp -a --reflink=auto "$BACKUP/modules/$BOOT_FALLBACK" /lib/modules/ || return 1
        local saved
        for saved in "$BACKUP/boot/"*-"$BOOT_FALLBACK"; do
            [[ ! -f $saved ]] || cp -a --reflink=auto "$saved" /boot/ || return 1
        done
    fi
    mapfile -t kernels < <(boot_kernel_versions)
    (( ${#kernels[@]} )) || { boot_fail 'No installed kernels found.'; return 1; }
    for kernel in "${kernels[@]}"; do
        boot_repair_kernel "$kernel" || { boot_fail "Could not prepare kernel $kernel. Keep this system running; review the log."; return 1; }
    done
    [[ -s /boot/vmlinuz-$BOOT_FALLBACK && -s /boot/initrd.img-$BOOT_FALLBACK && -d /lib/modules/$BOOT_FALLBACK ]] || {
        boot_fail "The running fallback kernel $BOOT_FALLBACK was removed. Recovery files are in $BACKUP; restore it before reboot."; return 1;
    }
    install -d -m 755 /etc/default/grub.d
    # Predictable visible menu, latest validated Ubuntu kernel first, fallback in
    # Advanced options. Avoid stale saved entries and incompatible custom themes.
    cat > /etc/default/grub.d/99-csi-powerup-boot.cfg <<'GRUB_DEFAULTS'
# Maintained by CSI Linux Powerup; prior settings are saved with each run.
GRUB_DEFAULT=0
GRUB_SAVEDEFAULT=false
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=5
GRUB_TERMINAL_OUTPUT=console
GRUB_THEME=
GRUB_DEFAULTS
    chmod 644 /etc/default/grub.d/99-csi-powerup-boot.cfg
    menu=$(mktemp /boot/grub/.powerup-menu.XXXXXXXX) || return 1
    if ! grub-mkconfig -o "$menu" || ! boot_validate_menu "$menu" "${kernels[@]}"; then
        rm -f -- "$menu"
        boot_fail 'Generated GRUB menu failed validation; it was not installed.'; return 1
    fi
    chmod 600 "$menu"
    cp -p -- "$menu" "$WORK/grub.cfg.validated" || return 1
    mv -f -- "$menu" /boot/grub/grub.cfg || return 1
    if [[ $phase != baseline ]]; then
        if ! boot_update_loader; then
            boot_restore_validated_menu || true
            boot_fail 'GRUB loader refresh failed. Keep the system running and review the log.'; return 1
        fi
    fi
    if ! boot_validate_menu /boot/grub/grub.cfg "${kernels[@]}"; then
        boot_restore_validated_menu || true
        boot_fail 'The loader changed the GRUB menu and its final validation failed.'; return 1
    fi
    sync -f /boot/grub/grub.cfg || return 1
    if [[ $BOOT_MODE == uefi && $phase != baseline ]]; then sync -f /boot/efi/EFI/ubuntu/grub.cfg || return 1; fi
    BOOT_VERIFIED=1
    if [[ $phase == baseline ]]; then
        cp -L --preserve=mode,timestamps --reflink=auto /boot/initrd.img-"$BOOT_FALLBACK" "$BACKUP/boot/" || return 1
        cp -au --reflink=auto /lib/modules/"$BOOT_FALLBACK" "$BACKUP/modules/" || return 1
        log 'Baseline kernel and menu checks passed; proceeding with maintenance'
    else
        log 'Installed boot-file checks passed. The actual firmware boot still requires verification after restart.'
    fi
}

install_kernel_guard() {
    local target=${1:-/etc/kernel/postinst.d/zzzz-csi-powerup-boot} staged=$WORK/kernel-guard
    [[ ! -L $target ]] || { boot_fail 'Kernel guard path is a symbolic link.'; return 1; }
    if [[ -e $target ]] && ! grep -Fq '# CSI Linux Powerup kernel boot guard' "$target"; then
        boot_fail 'An unrelated kernel hook occupies the Powerup guard path.'; return 1
    fi
    {
        printf '#!/bin/bash\n# CSI Linux Powerup kernel boot guard\n# Self-contained; never sources the user-owned CSI tools directory.\nset -Eeuo pipefail\nexport PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C\n'
        declare -f boot_mounts boot_required_modules boot_initrd_valid boot_validate_menu
        cat <<'KERNEL_GUARD'
(( EUID == 0 )) || exit 1
kernel=${1:-}
[[ $kernel =~ ^[0-9][A-Za-z0-9.+_-]+$ ]] || exit 1
umask 077
WORK=$(mktemp -d /var/tmp/csi-kernel-check.XXXXXXXX)
menu=''
trap 'status=$?; [[ -z $menu ]] || rm -f -- "$menu"; rm -rf -- "$WORK"; if (( status )); then printf "ERROR: CSI kernel boot guard failed for %s. Do not reboot until repaired.\n" "$kernel" >&2; fi; exit "$status"' EXIT
boot_mounts 0
boot_required_modules > "$WORK/boot-required-modules"
[[ -s /boot/vmlinuz-$kernel && -s /lib/modules/$kernel/modules.builtin && -s /lib/modules/$kernel/modules.order ]]
depmod -a "$kernel"
if ! boot_initrd_valid "$kernel"; then
    mode=-u; [[ -e /boot/initrd.img-$kernel ]] || mode=-c
    update-initramfs "$mode" -k "$kernel"
fi
boot_initrd_valid "$kernel"
menu=$(mktemp /boot/grub/.csi-kernel-menu.XXXXXXXX)
grub-mkconfig -o "$menu"
boot_validate_menu --kernel-hook "$menu" "$kernel"
chmod 600 "$menu"
mv -f -- "$menu" /boot/grub/grub.cfg
menu=''
sync -f /boot/grub/grub.cfg
printf 'CSI kernel boot guard: %s startup image and GRUB menu checked.\n' "$kernel"
KERNEL_GUARD
    } > "$staged" || return 1
    bash -n "$staged" || return 1
    if ! cmp -s "$staged" "$target"; then
        [[ ! -e $target ]] || cp -a "$target" "$BACKUP/kernel-guard.before" || return 1
        install -o root -g root -m 755 "$staged" "$target" || return 1
    fi
    log 'Kernel installation guard is active; kernel setup cannot succeed with a missing startup image'
}

boot_id() { cat /proc/sys/kernel/random/boot_id; }
reboot_required() { [[ -f /var/run/reboot-required ]]; }
require_release_terminal() {
    if [[ ${RELEASE_UI:-text} == gtk ]]; then
        [[ -n ${DISPLAY:-} ]] || die 'Ubuntu graphical release upgrade needs an X11/XWayland display. Start Powerup from your desktop session.'
        return
    fi
    [[ -t 0 ]] || die 'The Ubuntu release upgrade needs a terminal. Run: sudo /opt/csitools/powerup --cli os-update'
}

run_release_upgrader() {
    check_and_repair_packages || return 1
    log 'Choose Restart Later at the Ubuntu final prompt. Powerup must finish boot checks before you reboot.'
    BOOT_VERIFIED=0
    if [[ ${RELEASE_UI:-text} == gtk ]]; then
        env -u DEBIAN_FRONTEND GDK_BACKEND=x11 do-release-upgrade -f DistUpgradeViewGtk3
        return
    fi
    # Keep the Ubuntu text frontend attached to its controlling terminal even
    # while Powerup's own output is logged through tee. Ubuntu records its own
    # detailed logs in /var/log/dist-upgrade/.
    env -u DEBIAN_FRONTEND do-release-upgrade -f DistUpgradeViewText </dev/tty >/dev/tty 2>&1
}

upgrade_release_if_needed() {
    STOP_AFTER_RELEASE=0
    local marker=$RELEASE_STATE_DIR/upgrade-boot-id current_boot audit check_output
    current_boot=$(boot_id)
    if [[ $BASE_CODENAME == resolute ]]; then
        if [[ -f $marker && $(cat "$marker") == "$current_boot" ]]; then
            log 'Release packages are installed, but this boot predates the release upgrade.'
            log 'A reboot is pending; Powerup will check boot readiness before reporting completion.'
            STOP_AFTER_RELEASE=1
        fi
        return
    fi
    [[ $BASE_CODENAME == noble ]] || die 'Unexpected release upgrade source.'
    require_release_terminal
    if reboot_required; then
        log 'A reboot is pending on Noble. Boot checks will run before restart advice.'
        log 'After reboot, run: /opt/csitools/powerup'
        STOP_AFTER_RELEASE=1
        return
    fi
    log 'Preparing Ubuntu 24.04 (Noble) for Ubuntu 26.04 LTS (Resolute)'
    log 'Take a VM snapshot or complete backup before proceeding with a major OS upgrade.'
    audit=$(dpkg --audit)
    [[ -z $audit ]] || die "dpkg reports unfinished package work. Repair it first: $audit"
    cp -a /etc/apt "$BACKUP/apt-before-release"
    cp /etc/os-release "$BACKUP/os-release.before"
    dpkg-query -W -f='${binary:Package}\t${Version}\n' > "$BACKUP/packages-before-release.tsv"
    SOURCES_PENDING=1
    # Keep Noble suites until Ubuntu's own release upgrader performs the
    # distribution transition. Disable third-party sources with backups.
    repository_config prepare-release /etc/apt "$BACKUP" 0 "$ARCH"
    apt_refresh
    SOURCES_PENDING=0
    local -a release_dependencies=(ca-certificates update-manager-core ubuntu-release-upgrader-core)
    if [[ ${RELEASE_UI:-text} == gtk ]]; then release_dependencies+=(ubuntu-release-upgrader-gtk); fi
    apt_run install --no-install-recommends --no-remove -y "${release_dependencies[@]}"
    log 'Fully updating Noble, including phased updates, before the release upgrade'
    apt_run -o APT::Get::Always-Include-Phased-Updates=true dist-upgrade -y
    apt_run check
    if reboot_required; then
        log 'Noble prerequisites are updated. Boot checks will run before restart advice.'
        log 'After reboot, run: /opt/csitools/powerup'
        STOP_AFTER_RELEASE=1
        return
    fi
    set_lts_prompt
    if check_output=$(env -u DEBIAN_FRONTEND do-release-upgrade --check-dist-upgrade-only 2>&1); then
        printf '%s\n' "$check_output"
    else
        printf '%s\n' "$check_output" >&2
        die 'Ubuntu is not currently offering a supported LTS upgrade, or its availability check failed. Resolute repositories have not been enabled.'
    fi
    [[ $check_output =~ 26\.04([.][0-9]+)? ]] ||
        die 'Ubuntu did not advertise the requested 26.04 LTS target. Refusing to guess another release.'
    install -d -m 700 "$RELEASE_STATE_DIR"
    boot_id > "$marker"
    log 'Starting do-release-upgrade. Review Ubuntu prompts for package removals and configuration files.'
    log 'After the required reboot, rerun: /opt/csitools/powerup'
    log 'Release upgrader logs: /var/log/dist-upgrade/'
    if run_release_upgrader; then
        read_platform
    else
        die 'Ubuntu release upgrade failed or was cancelled. See /var/log/dist-upgrade/. No forced repository substitution was performed.'
    fi
    [[ $BASE_CODENAME == resolute ]] ||
        die 'The release upgrader returned without reaching Resolute. Review /var/log/dist-upgrade/; optional tool updates were not started.'
    # Do not finalize repositories or run CSI categories in the old boot, even
    # if the user declines the release upgrader's restart prompt.
    log 'Ubuntu 26.04 release packages are installed. A reboot is still required.'
    log 'After reboot, run: /opt/csitools/powerup to finish Resolute/Tor maintenance.'
    STOP_AFTER_RELEASE=1
}

prepare_updater() {
    log 'Downloading the CSI category updater from its configured resource'
    download "$UPDATER_URL" "$WORK/csitoolsupdate.sh"
    [[ -s $WORK/csitoolsupdate.sh ]] || die 'CSI category updater is empty.'
    bash -n "$WORK/csitoolsupdate.sh"
    local body
    body=$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$WORK/csitoolsupdate.sh")
    if [[ $body == 'print "Updating..."' || $body == 'echo "Updating..."' || -z $body ]]; then
        die 'The configured csitoolsupdate.sh resource is a placeholder. Publish the production updater at the CSI GitHub resource. Selected CSI categories were NOT updated.'
    fi
}

install_csi_tools() {
    if (( ! REFRESH_TOOLS )) && [[ -d /opt/csitools ]] &&
        [[ -n $(find /opt/csitools -mindepth 1 -maxdepth 1 -print -quit) ]]; then
        log 'CSI tools are present; skipping the large bootstrap archive.'
        return
    fi
    check_and_repair_packages || return 1
    local sevenzip url success=0
    if command -v 7zz >/dev/null; then sevenzip=7zz
    elif command -v 7z >/dev/null; then sevenzip=7z
    else
        apt_run install --no-install-recommends --no-remove -y 7zip
        if command -v 7zz >/dev/null; then sevenzip=7zz
        elif command -v 7z >/dev/null; then sevenzip=7z
        else die '7zip installed, but neither 7zz nor 7z is available.'
        fi
    fi
    log 'Downloading CSI tools into a private staging directory'
    for url in https://csilinux.com/downloads/csitools.7z \
        https://echothislabs.com/downloads/csitools.7z \
        https://informationwarfarecenter.com/downloads/csitools.7z; do
        if download "$url" "$WORK/csitools.7z"; then success=1; break; fi
    done
    (( success )) || die 'All CSI tools download mirrors failed.'
    "$sevenzip" x -so "$WORK/csitools.7z" csitools.tar > "$WORK/csitools.tar"
    [[ -s $WORK/csitools.tar ]] || die 'Archive does not contain csitools.tar.'
    # Restore only the tool tree, not arbitrary /etc, /usr, or root-home files.
    # Preserve supplied executable bits; do not chmod every file or dos2unix binaries.
    python3 - "$WORK/csitools.tar" "$WORK/payload" <<'PY_ARCHIVE'
import copy, posixpath, sys, tarfile
from pathlib import Path
archive, destination = sys.argv[1:]
prefix = 'opt/csitools'
def within(name): return name == prefix or name.startswith(prefix + '/')
with tarfile.open(archive) as tar:
    selected = []
    for original in tar.getmembers():
        name = original.name
        while name.startswith('./'): name = name[2:]
        name = name.lstrip('/')
        if not within(name): continue
        top = name[len(prefix) + 1:].split('/')[0]
        # Powerup is maintained from GitHub, never downgraded by a tool archive.
        if top in ('powerup', 'powerup.update.lock') or top.startswith('powerup.backup-'): continue
        if '..' in name.split('/') or '\\' in name:
            raise ValueError('Unsafe archive member: ' + original.name)
        member = copy.copy(original)
        member.name = name
        if member.issym() or member.islnk():
            link = member.linkname
            if link.startswith('/') or '\\' in link: raise ValueError('Unsafe archive link: ' + name)
            target = posixpath.normpath(posixpath.join(posixpath.dirname(name), link) if member.issym() else link)
            if not within(target): raise ValueError('Archive link leaves /opt/csitools: ' + name)
        if not (member.isfile() or member.isdir() or member.issym() or member.islnk()):
            raise ValueError('Special file in tool archive: ' + name)
        selected.append(member)
    if not any(m.isfile() for m in selected): raise ValueError('No tool files under opt/csitools in archive')
    Path(destination).mkdir(mode=0o700)
    tar.extractall(destination, members=selected, filter='data')
PY_ARCHIVE
    if [[ -d /opt/csitools ]]; then
        log "Backing up the existing tool tree to $BACKUP/csitools.tar"
        tar -cpf "$BACKUP/csitools.tar" -C /opt csitools
    fi
    [[ ! -L /opt/csitools ]] || die '/opt/csitools must not be a symlink.'
    install -d -m 755 /opt/csitools
    cp -a --remove-destination -- "$WORK/payload/opt/csitools/." /opt/csitools/
    if id csi >/dev/null 2>&1; then chown -R csi:"$(id -gn csi)" /opt/csitools; fi
    log 'CSI tools restored. Existing executable modes preserved.'
}

run_category_updater() {
    check_and_repair_packages || return 1
    log "Running CSI category updater: $*"
    local child_status=0
    # Keep the original positional API: empty password at $1; categories at $2.
    POWERUP_APT_UPDATED=1 POWERUP_OS_UPDATED=1 \
        bash "$WORK/csitoolsupdate.sh" '' "$@" || child_status=$?
    check_and_repair_packages || return 1
    (( child_status == 0 )) || die "CSI category updater failed ($child_status). Package health was checked; the unknown child workflow was not automatically repeated."
}

cleanup() {
    local status=$?
    trap - EXIT ERR
    restore_service_policy || printf 'ERROR: Review /usr/sbin/policy-rc.d before another update.\n' >&2
    if (( SOURCES_PENDING )); then
        printf '\nRepository setup failed; restoring previous source files.\n' >&2
        repository_config rollback /etc/apt "$BACKUP" 0 "$ARCH" ||
            printf 'Automatic source rollback failed. Backup: %s\n' "$BACKUP" >&2
        if [[ -f $BACKUP/previous-tor-key.gpg ]]; then
            install -m 644 "$BACKUP/previous-tor-key.gpg" /etc/apt/keyrings/csi-torproject.gpg || true
        fi
    fi
    if (( status != 0 )) && [[ ${BOOT_ACTIVE:-0} == 1 && ${BOOT_VERIFIED:-0} != 1 ]]; then
        printf "ERROR: Boot readiness has not been confirmed. Keep this system running and review the log before reboot.\nPOWERUP_RESULT=boot-attention\n" >&2
    fi
    [[ -z ${WORK:-} ]] || rm -rf -- "$WORK"
    printf '\nPowerup exit status: %s\nLog: %s\nBackup: %s\n' "$status" "$LOG_FILE" "$BACKUP"
    exit "$status"
}

parse_options() {
    FORWARD=()
    CHECK_ONLY=0 RELEASE_UI=text
    FULL_UPGRADE=0 REFRESH_TOOLS=0
    REQUESTED=() SELECTED=()
    while (( $# )); do
        case $1 in
            --check) CHECK_ONLY=1 ;;
            --release-ui=gtk) RELEASE_UI=gtk; FORWARD+=("$1") ;;
            --full-upgrade) FULL_UPGRADE=1; FORWARD+=("$1") ;;
            --refresh-tools) REFRESH_TOOLS=1; FORWARD+=("$1") ;;
            --tools-sha256|--updater-sha256|--updater)
                PLAN_ERROR='Custom updater and checksum options were removed. Powerup uses the configured CSI resources automatically.'; return 1 ;;
            --*) PLAN_ERROR="Unknown or incompatible option: $1"; return 1 ;;
            *) REQUESTED+=("$1") ;;
        esac
        shift
    done
    if (( ! ${#REQUESTED[@]} )); then REQUESTED=(os-update); fi
}

powerup_lock_busy() {
    printf 'ERROR: The Powerup lock is still held; no second update was started.\n' >&2
    python3 - "$1" <<'PY_LOCK_HOLDERS' >&2
import os, sys
from pathlib import Path
try:
    target = os.stat(sys.argv[1])
    found = False
    for process in Path('/proc').iterdir():
        if not process.name.isdigit():
            continue
        try:
            for fd in (process / 'fd').iterdir():
                info = fd.stat()
                if (info.st_dev, info.st_ino) == (target.st_dev, target.st_ino):
                    # Do not expose command-line arguments or credentials.
                    name = (process / 'comm').read_text().strip()
                    print('Lock holder: PID ' + process.name + ' (' + name + ')')
                    found = True
                    break
        except (OSError, PermissionError):
            continue
    if not found:
        print('The lock changed during inspection; retry after the earlier run finishes.')
except OSError as error:
    print('Could not inspect lock holders: ' + str(error))
PY_LOCK_HOLDERS
    printf 'Use the existing Powerup window or inspect the listed processes. Closing a monitor does not stop its worker.\nDo not delete the lock file while an update may still be running.\n' >&2
}

powerup_locked_call() {
    local self=$1 entry=$2 lock_file=$3 status=0 checked
    shift 3
    case $entry in backend_main|self_update_root_install) ;; *) die 'Invalid internal lock operation.';; esac
    checked=$(self_revision "$self") || return 1
    [[ -z $SELF_CHECKED_REV || $checked == "$SELF_CHECKED_REV" ]] || die 'Powerup changed since review. Reopen it.'
    # flock owns the descriptor in its waiting parent. --close removes it from
    # the worker and ALL descendants (including tee, package scripts and daemons).
    # Keep the same lock inode/protocol so older Powerup runs still exclude us.
    # Variables in this program belong to the fresh Bash worker.
    # shellcheck disable=SC2016
    flock --nonblock --conflict-exit-code 75 --close "$lock_file" /bin/bash -c '
        locked_source=$1; locked_revision=$2; locked_entry=$3; shift 3
        source "$locked_source"
        [[ $POWERUP_REV == "$locked_revision" ]] || exit 1
        SELF_CHECKED_REV=$locked_revision
        POWERUP_LOCK_HELD=1
        "$locked_entry" "$@"
    ' powerup-locked "$self" "$checked" "$entry" "$@" || status=$?
    if (( status == 75 )); then powerup_lock_busy "$lock_file"; fi
    return "$status"
}

backend_main() {
    local self option
    local -a tool_categories=()
    parse_options "$@" || die "$PLAN_ERROR"
    validate_platform
    validate_options || die "$PLAN_ERROR"
    if (( CHECK_ONLY )); then
        printf 'POWERUP_REV=%s\n' "$POWERUP_REV"
        printf 'Platform: Ubuntu base %s (%s)\n' "$BASE_CODENAME" "$ARCH"
        if [[ $BASE_CODENAME == noble ]]; then
            printf 'Plan: fully update Noble, run do-release-upgrade to 26.04 LTS, reboot, rerun to finalize.\n'
        fi
        printf 'Ubuntu: resolute, resolute-updates, resolute-security, resolute-backports\n'
        printf 'Components: main restricted universe multiverse\nTor: stable resolute / %s\n' "$ARCH"
        printf 'Categories: %s\nFull upgrade: %s\nNo changes made.\n' "${SELECTED[*]}" "$FULL_UPGRADE"
        return
    fi
    if (( EUID != 0 )); then
        self=$(readlink -f -- "${BASH_SOURCE[0]}")
        elevate "$self" "--internal-self-update-revision=$SELF_CHECKED_REV" --cli "${FORWARD[@]}" "${REQUESTED[@]}"
    fi
    export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
    umask 077
    install -d -m 700 /run/csi-powerup
    if (( ! POWERUP_LOCK_HELD )); then
        self=$(readlink -f -- "${BASH_SOURCE[0]}")
        powerup_locked_call "$self" backend_main /run/csi-powerup/lock "$@"
        return $?
    fi
    install -d -m 700 /var/log/csi-powerup /var/backups/csi-powerup
    local run_id
    run_id=$(date '+%Y%m%d-%H%M%S')-$$
    LOG_FILE=/var/log/csi-powerup/powerup-$run_id.log
    BACKUP=/var/backups/csi-powerup/$run_id
    install -d -m 700 "$BACKUP"
    WORK=$(mktemp -d /var/tmp/csi-powerup.XXXXXXXX)
    RELEASE_STATE_DIR=/var/lib/csi-powerup
    SOURCES_PENDING=0 SERVICE_POLICY_ACTIVE=0 MILTER_DEFERRED=0 SERVICE_WARNINGS=0 REPAIR_ACTIVE=0
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'printf "ERROR: command failed at line %s (status %s).\n" "$LINENO" "$?" >&2' ERR
    exec > >(tee -a "$LOG_FILE") 2>&1
    printf '\n========================================\nPOWERUP_REV=%s\n========================================\n' "$POWERUP_REV"
    printf 'Running powerup script: %s\n' "$(readlink -f -- "${BASH_SOURCE[0]}")"
    log "CSI Linux Powerup — current base $BASE_CODENAME / $ARCH; target Ubuntu 26.04 LTS"
    log "Selected: ${SELECTED[*]}"
    restore_interrupted_policy
    boot_preflight
    check_and_repair_packages
    boot_ensure_ready baseline
    install_kernel_guard
    upgrade_release_if_needed
    if (( STOP_AFTER_RELEASE )); then
        check_and_repair_packages
        boot_ensure_ready
        if (( SERVICE_WARNINGS )); then printf 'POWERUP_RESULT=reboot-with-warnings\n'; else printf 'POWERUP_RESULT=reboot-required\n'; fi
        return
    fi
    BOOT_VERIFIED=0
    maintain_system
    check_and_repair_packages
    boot_ensure_ready
    rm -f -- "$RELEASE_STATE_DIR/upgrade-boot-id"
    for option in "${SELECTED[@]}"; do
        [[ $option == os-update ]] || tool_categories+=("$option")
    done
    if (( ${#tool_categories[@]} )); then prepare_updater; fi
    if (( ${#tool_categories[@]} || REFRESH_TOOLS )); then install_csi_tools; fi
    if (( ${#tool_categories[@]} )); then
        BOOT_VERIFIED=0
        run_category_updater "${tool_categories[@]}"
    fi
    if (( ${#tool_categories[@]} || REFRESH_TOOLS )); then
        check_and_repair_packages
        boot_ensure_ready
    fi
    log 'Requested maintenance completed. Review remaining upgrades and reboot status above.'
    if (( SERVICE_WARNINGS )); then
        if reboot_required; then printf 'POWERUP_RESULT=reboot-with-warnings\n'; else printf 'POWERUP_RESULT=service-attention\n'; fi
    elif reboot_required; then printf 'POWERUP_RESULT=reboot-required\n'; else printf 'POWERUP_RESULT=complete\n'; fi
}

