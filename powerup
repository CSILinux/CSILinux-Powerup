                    current=os.stat(entry.name,dir_fd=fd,follow_symlinks=False)
                    if (current.st_dev,current.st_ino)==(info.st_dev,info.st_ino) and stat.S_ISREG(current.st_mode):
                        if link_signature(current)!=wanted:raise RuntimeError('hard-link metadata changed during inventory')
                        result['paths'].append('/'.join((*parts,entry.name)))
                        if len(result['paths'])==info.st_nlink:break
                    elif stat.S_ISDIR(current.st_mode):children.append((entry.name,current.st_dev,current.st_ino))
