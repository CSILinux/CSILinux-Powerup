def request_stop(owners):
    if os.geteuid()!=ROOT_UID:raise RuntimeError('Package termination requires root')
    if not hasattr(os,'pidfd_open') or not hasattr(signal,'pidfd_send_signal'):
        raise RuntimeError('Safe process signaling is unavailable')
    pids={row['pid'] for row in owners}
    if any(pid<=1 for pid in pids) or pids&ancestors():raise RuntimeError('Cannot stop an unknown owner or Powerup ancestor')
    rows=tree(pids)
    if not pids<={row['pid'] for row in rows}:raise RuntimeError('Lock ownership changed before recovery')
    handles={}
    try:
        for row in rows:
            details=process_details(row)
            if protected(details):raise RuntimeError('Automatic termination deferred: '+protected(details))
            if row['pid'] in pids and not trusted(details):raise RuntimeError('Lock owner is not a verified package manager')
            handles[row['pid']]=os.pidfd_open(row['pid'],0)
            if not live(row):raise RuntimeError('Package process exited during verification')
        # Re-read both ownership and tree immediately before signaling.
        if blockers()!=owners or {(x['pid'],x['start_ticks']) for x in tree(pids)}!={(x['pid'],x['start_ticks']) for x in rows}:
            raise RuntimeError('Package ownership/tree changed before signaling')
        for row in rows:
            details=process_details(row)
            if protected(details):raise RuntimeError('Boot activity appeared before signaling')
            if row['pid'] in pids and not trusted(details):raise RuntimeError('Package executable changed before signaling')
