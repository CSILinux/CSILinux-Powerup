    } > "$GUI_DIR/plan.txt"
}

gui_cleanup() {
    gui_progress_close
    # A detached runner may still be finishing APT if this frontend is closed.
    # Never kill it, remove its files, or show a false completion status.
    if [[ -n ${GUI_JOB:-} && ! -f ${GUI_STATUS:-/nonexistent} ]]; then return; fi
    [[ -z ${GUI_DIR:-} ]] || rm -rf -- "$GUI_DIR"
}

gui_feed_log() {
    # Called only in its own background subshell. Exec gives us the actual
    # feeder PID, so cleanup cannot leave an orphan holding the pipe open.
    exec python3 -u - "$GUI_LOG" "$GUI_STATUS" "$GUI_JOB" "${GUI_LOG_OFFSET:-0}" <<'PY_GUI_LOG'
import json, os, sys, time
log, status, pid = sys.argv[1:4]
offset=int(sys.argv[4]) if len(sys.argv)>4 else 0
seen=set()
def running():
    try:
        os.kill(int(pid), 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
try:
    with open(log, errors='replace') as stream:
        stream.seek(offset)
        while True:
            line = stream.readline()
            if line:
                if line.startswith('POWERUP_LOCK_STATUS='):
                    try:notice=json.loads(line.partition('=')[2])
                    except (ValueError,TypeError):continue
                    if not isinstance(notice,dict) or notice.get('schema')!=1 or notice.get('phase') not in ('waiting','stopping','attempt','deferred','released','busy') or not isinstance(notice.get('message'),str):continue
                    print('# '+''.join(c for c in notice['message'] if c.isprintable())[:1600],flush=True)
                    continue
                # Positive whitelist plus lock status: raw errors stay in the log.
                if not line.startswith('POWERUP_EVENT='):continue
                try:event=json.loads(line[len('POWERUP_EVENT='):])
                except (ValueError,TypeError):continue
                if not isinstance(event,dict) or event.get('schema')!=1:continue
                label=event.get('label')
                if event.get('kind')!='success' or event.get('status')!=0 or not isinstance(label,str):continue
                if label in seen:continue
                seen.add(label)
                label=''.join(c for c in label if c.isprintable())[:240]
                print('# Completed: ' + label, flush=True)
            elif os.path.exists(status) or not running():
                print('100', flush=True)
                break
            else:
                time.sleep(0.15)
except BrokenPipeError:
    pass
PY_GUI_LOG
}

gui_verify_release_plan() (
    # Parse a copy: do not reset the real wizard's variables while verifying
    # that its highlighted/reviewed action reaches the privileged worker.
    local profile=${GUI_PROFILE:-}
    parse_options "${GUI_ARGS[@]}" || die "$PLAN_ERROR"
    case $profile in
        release) (( RELEASE_UPGRADE && ! RESUME_RELEASE )) || die 'The approved release action was lost before worker launch.' ;;
        resume|recover) (( RESUME_RELEASE && ! RELEASE_UPGRADE )) || die 'The saved release action was lost before worker launch.' ;;
        standard|categories-install|categories-remove|test-packages) (( ! RELEASE_UPGRADE && ! RESUME_RELEASE )) || die 'A current-release action must not launch a distribution upgrade.' ;;
    esac
)

gui_write_runner() {
    cat > "$GUI_DIR/runner.sh" <<'RUNNER'
#!/bin/bash
set -u
trap '' HUP
status=$1; logfile=$2; source_file=$3; shift 3
(
    "$@" </dev/null
    result=$?
    printf '%s\n' "$result" > "$status.command-done"
    exit "$result"
) 2>&1 | /bin/bash "$source_file" --internal-log-stream "$logfile" "$status.command-done" quiet
codes=("${PIPESTATUS[@]}")
result=${codes[0]}
if (( codes[1] != 0 )); then
    printf 'ERROR: Worker log writer failed (status %s).\n' "${codes[1]}" >&2
    (( result != 0 )) || result=74
fi
printf '%s\n' "$result" > "$status.tmp"
mv -- "$status.tmp" "$status"
exit "$result"
RUNNER
}

gui_run_plan() {
    local self=$1 exit_code outcome GUI_LOG_OFFSET
    local -a command=() worker_args=()
    if (( ! ${TEST_PACKAGES:-0} )); then gui_verify_release_plan || return 1; fi
    POWERUP_PHASE='launching the maintenance worker'
    if [[ -z ${POWERUP_SESSION_DIR:-} ]]; then POWERUP_SESSION_DIR=$(powerup_log_files init); fi
    POWERUP_SESSION_NAME=${POWERUP_SESSION_DIR##*/}
    POWERUP_SESSION_LOG=$POWERUP_SESSION_DIR/session.log
    export POWERUP_SESSION_NAME POWERUP_SESSION_DIR POWERUP_SESSION_LOG
    powerup_log_arguments
    GUI_LOG=$POWERUP_SESSION_LOG
    if [[ ! -e $GUI_LOG ]]; then powerup_log_files create "$GUI_LOG"; fi
    powerup_log_files validate "$GUI_LOG"
    GUI_LOG_OFFSET=$(stat -c %s -- "$GUI_LOG")
    printf 'Selected action: %s\nWorker log: %s\n' "${GUI_PROFILE:-command line}" "$GUI_LOG"
    audit_event plan '' '' '' 'User started the reviewed wizard plan' "profile=${GUI_PROFILE:-command-line}" "${GUI_ARGS[@]}"
    GUI_STATUS=$GUI_DIR/worker.status
    rm -f -- "$GUI_STATUS" "$GUI_STATUS.tmp" "$GUI_STATUS.command-done"
    worker_args=("--internal-self-update-revision=$SELF_CHECKED_REV" --cli "${GUI_ARGS[@]}")
    if (( ${GUI_INTERNAL_RESTART_REPAIR:-0} )); then worker_args=(--internal-restart-repair); fi
    gui_write_runner
    if (( GUI_DEMO )); then
        cat > "$GUI_DIR/demo.sh" <<'DEMO'
#!/bin/bash
printf 'DEMO — no system changes are being made.\n'
for step in 'Checking the selected plan' 'Simulating repository verification' 'Simulating package maintenance' 'Preparing the result'; do
    printf '%s…\n' "$step"
    sleep 1
done
printf 'POWERUP_RESULT=demo-complete\n'
DEMO
        command=(/bin/bash "$GUI_DIR/demo.sh")
    elif (( EUID == 0 || ${TEST_PACKAGES:-0} )); then
        command=(/bin/bash "$self" "${POWERUP_LOG_ARGS[@]}" "${worker_args[@]}")
    else
        # Some X11 sessions omit XAUTHORITY and rely on the user's home file.
        if [[ -z ${XAUTHORITY:-} && -f $HOME/.Xauthority ]]; then export XAUTHORITY=$HOME/.Xauthority; fi
        make_auth_helper "$GUI_DIR" 'Enter your administrator password to start the reviewed plan, or Cancel to close Powerup.'
        # The runner sources this script as the desktop user; only the reviewed
        # backend command is passed to sudo. No credential caching loop is used.
        # shellcheck disable=SC2016
        command=(/bin/bash -c 'source "$1"; shift; authenticated_run "$@"' powerup-gui-auth "$self" "$GUI_DIR" \
            /bin/bash "$self" "${POWERUP_LOG_ARGS[@]}" "${worker_args[@]}")
    fi
    SUDO_ASKPASS="$GUI_DIR/askpass.sh" setsid --wait /bin/bash "$GUI_DIR/runner.sh" "$GUI_STATUS" "$GUI_LOG" "$self" "${command[@]}" &
    GUI_JOB=$!
    POWERUP_PHASE='running the maintenance worker'
    if gui_progress_open --text="$(gui_header 'Maintenance in progress' 'EXECUTING YOUR REVIEWED PLAN' 'Completed steps and package-lock wait status appear below. Detailed diagnostics are saved automatically. Closing this monitor does not cancel package operations.')" \
        --progress --pulsate --progress-text='Working — duration depends on downloads and package changes' \
        --enable-log='Progress and completed steps' --log-expanded --log-height=300 --auto-close --no-buttons --no-escape; then
        (
            exec 1>&"$GUI_PROGRESS_FD"
            exec {GUI_PROGRESS_FD}>&-
            gui_feed_log
        ) &
        GUI_LOG_FEEDER=$!
    fi
    # Completion is tied to the worker, not to GTK handling "100" or EOF.
    # A manually closed monitor also leaves the worker running normally.
    wait "$GUI_JOB" || true
    gui_progress_close
    POWERUP_PHASE='displaying the maintenance result'
    if [[ -f $GUI_STATUS ]]; then read -r exit_code < "$GUI_STATUS"; else exit_code=125; fi
    [[ $exit_code =~ ^[0-9]+$ ]] || exit_code=125
    printf 'Worker exit status: %s\nWorker log saved: %s\n' "$exit_code" "$GUI_LOG"
    audit_event worker-exit '' "$exit_code" '' 'Detached maintenance worker returned' "log=$GUI_LOG"
    outcome=$(tail -c "+$((GUI_LOG_OFFSET+1))" -- "$GUI_LOG" | sed -n 's/^POWERUP_RESULT=//p' | tail -n 1)
    if [[ -e $GUI_DIR/auth.cancel || $outcome == cancelled ]]; then
        if [[ ${GUI_PROFILE:-} == resume ]]; then release_job_store defer || true; fi
        return 0
    fi
    if [[ $outcome == packages-tested && $exit_code == 0 ]]; then
        local report_path
        report_path=$(sed -n 's/^POWERUP_MISSING_FILE=//p' "$GUI_LOG" | tail -n 1)
        if [[ -f $report_path ]]; then
            gui_dialog --title='missingpackages.txt — CSI Linux Powerup' --text="$(gui_header 'Package test complete' 'MISSING PACKAGES' 'Names absent from the current APT candidates appear below. An empty file means no exact package names were missing; wildcard details are in diagnostics.zip.')" \
                --text-info --filename="$report_path" --fontname='DejaVu Sans Mono 11' --button='Close:0' >/dev/null || true
        fi
        return 0
    fi
    gui_show_result "$self" "$exit_code" "$outcome"
}

gui_show_result() {
    local self=$1 exit_code=$2 outcome=$3 title detail response restart_status default_button=0
    local -a buttons=()
    if [[ $outcome == category-partial ]]; then
        title='Available category packages processed'
        detail='Some entries in the published lists are unavailable from the configured repositories. The support log records the remaining items. Protected settings were restored; no automatic reboot was requested.'
    elif [[ $outcome == recovered-incomplete ]]; then
        title='Package health restored'
        detail='The final repair passed package and boot-file checks. The original maintenance plan did not finish. Reopen Powerup to complete the requested work; all diagnostic details are saved.'
    elif [[ $outcome == package-busy ]]; then
        title='Another package task is still active'
        detail='Powerup could not safely clear all package activity. Eligible lock owners receive a termination request after 300 seconds; protected boot work is allowed to finish. Let remaining activity finish, then reopen Powerup. Its process and lock details are saved in the support log. Keep the system running while package work is active.'
    elif [[ $exit_code == 75 ]]; then
        title='An earlier Powerup run holds the lock'
        detail='No second update was started. The earlier worker may still be running even if its window was closed. View the log for the process IDs holding the lock; let active package work finish before retrying.'
    elif [[ $outcome == boot-attention ]]; then
        title='Boot repair needs attention'
        detail='Keep this system running. Kernel or GRUB readiness was not confirmed. Review the saved log and backup path before rebooting; no successful completion is being reported.'
    elif [[ $exit_code != 0 ]]; then
        title='Maintenance not completed'
        detail='Completed steps have been saved. Diagnostic details are available in the support log. Keep this system running until the result has been reviewed.'
    else
        case $outcome in
            complete) title='Maintenance complete'; detail='The selected workflow completed. Review the activity log for any held or phased updates.' ;;
            tools-complete) title='Tool maintenance complete'; detail='The selected installed tool packages were processed using your existing repositories. Your Ubuntu release was retained. This tools-only result does not certify firmware boot readiness.' ;;
            reboot-required) title='Reboot required'; detail='A restart is needed. Save your work, reboot normally, then reopen Powerup to continue or verify the system.' ;;
            release-reboot-pending) title='Restart required to continue'; detail='The approved upgrade is already saved. This is the same boot that requested a restart. No new package work was started. Save your work, restart normally, and log into the same account. Powerup will continue automatically.' ;;
            noble-reboot-pending) title='Restart required to continue'; detail='Ubuntu already has a pending restart. Restart and log in. Powerup will continue the approved upgrade automatically. No release migration was started.' ;;
            noble-prepared-reboot) title='Preparation complete — restart required'; detail='Noble updates and boot-file checks completed. Restart and log in. Powerup will automatically continue this approved upgrade. The release migration has not started yet.' ;;
            resolute-installed-reboot) title='Ubuntu 26.04 installed — restart required'; detail='Release packages and boot-file checks completed. Restart and log in. Powerup will automatically finish Resolute and Tor setup.' ;;
            reboot-with-warnings) title='Reboot needed; service attention'; detail='Package work finished, but a deferred service restart did not recover. Review the log, save your work and reboot, then reopen Powerup. Mail filtering may be unavailable.' ;;
            service-attention) title='Packages updated; service attention'; detail='Package maintenance finished, but clamav-milter is not confirmed active after recovery. Mail filtering may be unavailable. Review the service details in the log.' ;;
            demo-complete) title='Demo complete'; detail='This was a simulated run. No system changes or authentication occurred.' ;;
            *) title='Review the operation log'; detail='The process exited, but no final completion marker was received. Check the log before starting another run.' ;;
        esac
    fi
    if gui_restart_allowed "$exit_code" "$outcome"; then detail+=' Save your work before choosing Restart now.'; fi
    while :; do
        buttons=(--button='Save support log…:4' --button='Close:0')
        if gui_restart_allowed "$exit_code" "$outcome"; then
            # Older YAD treats default response 0 as "unspecified". Use a
            # nonzero response and make Later the first focusable button too.
            buttons=(--button='Restart later:1' --button='Save support log…:4' --button='Restart now:2')
            default_button=1
        fi
        gui_capture --height=400 --text="$(gui_header "$title" 'RESULT' "$(gui_escape "$detail")")" \
            --form --field='Saved support log:RO' "$GUI_LOG" "${buttons[@]}" "--default-button=$default_button"
        response=$GUI_CODE
        case $response in
            2)
                gui_restart_allowed "$exit_code" "$outcome" || continue
                restart_status=0
                gui_request_restart "$self" || restart_status=$?
                case $restart_status in
                    0|130) return 0 ;;
                    78)
                        # Never reboot on the strength of checks made before
                        # package activity/recovery. Re-run protected repairs.
                        if (( ! ${GUI_INTERNAL_RESTART_REPAIR:-0} )); then
                            gui_restart_repair_plan "$self"
                            return
                        fi
                        title='Restart is waiting for maintenance'
                        detail='Package or startup checks still need attention. Keep this system running. Diagnostic details are saved; restarting has not been requested.' ;;
                    *)
                        title='Restart is not available yet'
                        detail='The system has not accepted the restart request. Package activity, shutdown inhibitors and command details are saved in the support log. Keep this system running while package work is active. You can try Restart now again, or choose Restart later.' ;;
                esac ;;
            4)
                gui_capture --file --save --confirm-overwrite --filename="$HOME/powerup-report.txt" --button='Cancel:1' --button='Save:0'
                if (( GUI_CODE == 0 )) && [[ -n $GUI_RESPONSE ]]; then cp -- "$GUI_LOG" "$GUI_RESPONSE" || gui_message 'Could not save log' 'Choose a writable destination.'; fi ;;
            *) break ;;
        esac
    done
}

gui_restart_allowed() {
    [[ $1 == 0 && ${GUI_DEMO:-0} == 0 ]] || return 1
    case $2 in
        reboot-required|release-reboot-pending|noble-reboot-pending|noble-prepared-reboot|resolute-installed-reboot|reboot-with-warnings) return 0 ;;
        *) return 1 ;;
    esac
}

restart_diagnostics() {
    log 'Record shutdown inhibitors and package coordinator evidence'
    SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 /usr/bin/timeout 15s /usr/bin/systemd-inhibit --list --no-pager ||
        printf 'Shutdown inhibitor listing was unavailable.\n' >&2
    package_lock_monitor diagnostics || printf 'Package process diagnostics were incomplete.\n' >&2
}

restart_systemctl_request() {
    # Keep privileged package checks in the root worker. Make the final desktop
    # request as the authenticated launcher account: systemctl otherwise treats
    # that user's own graphical session as another user's session. Explicit
    # inhibitor checks remain enabled; logind/polkit may still refuse restart.
    /usr/bin/python3 -I - <<'PY_RESTART_CALLER'
import json, os, pwd, re, sys

COMMAND=('/usr/bin/systemctl','--no-ask-password','--check-inhibitors=yes','reboot')
CLEAN_ENV={'PATH':'/usr/sbin:/usr/bin:/sbin:/bin','LC_ALL':'C',
           'SYSTEMD_PAGER':'cat','SYSTEMD_COLORS':'0'}

def restart():
    if os.geteuid()!=0:raise PermissionError('Restart dispatch requires the authenticated administrator worker')
    uid_text=os.environ.get('SUDO_UID')
    user=os.environ.get('SUDO_USER')
    if uid_text is None and user is None:
        account=pwd.getpwuid(0)
    else:
        if not uid_text or not re.fullmatch(r'[0-9]{1,10}',uid_text) or not user:
            raise ValueError('Incomplete or invalid authenticated restart account')
        account=pwd.getpwuid(int(uid_text))
        if account.pw_name!=user:raise ValueError('Authenticated restart account does not match its UID')
    print('POWERUP_RESTART_CALLER='+json.dumps(dict(uid=account.pw_uid,user=account.pw_name,
          command=list(COMMAND),inhibitor_checks=True)),flush=True)
    if account.pw_uid!=0:
        os.initgroups(account.pw_name,account.pw_gid)
        os.setresgid(account.pw_gid,account.pw_gid,account.pw_gid)
        os.setresuid(account.pw_uid,account.pw_uid,account.pw_uid)
        if os.getresuid()!=(account.pw_uid,)*3 or os.getresgid()!=(account.pw_gid,)*3:
            raise PermissionError('Could not verify the restart caller credentials')
    # No shell, inherited D-Bus destination, interactive terminal password
    # prompt, elevated retry, or inhibitor override on a denied request.
    os.execve(COMMAND[0],list(COMMAND),CLEAN_ENV)

if __name__=='__main__':
    try:restart()
    except (OSError,ValueError,KeyError,OverflowError) as error:
        print('ERROR: Restart dispatch: '+str(error),file=sys.stderr)
        raise SystemExit(77)
PY_RESTART_CALLER
}

restart_root_request() (
    (( EUID == 0 )) || { printf 'Restart requires administrator authentication.\n' >&2; return 77; }
    (( $# == 0 )) || return 64
    local self status=0 package_audit
    # shellcheck disable=SC2030,SC2031
    local -x PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
    umask 077
    self=$(readlink -f -- "${BASH_SOURCE[0]}") || return 1
    install -d -m 700 /run/csi-powerup || return 1
    if (( ! POWERUP_LOCK_HELD )); then
        powerup_locked_call "$self" restart_root_request /run/csi-powerup/lock
        return $?
    fi
    export POWERUP_AUDIT_ENABLED=1
    audit_init restart
    restart_diagnostics
    audit_begin 'Wait for package activity before restart'
    package_lock_monitor restart || status=$?
    audit_end "$status"
    case $status in
        77|78)
            audit_event recovery '' 78 '' 'Package activity changed; repair and boot verification must run before restart'
            return 78 ;;
        0) ;;
        *) return "$status" ;;
    esac
    # An outstanding restoration checkpoint must never be bypassed by reboot.
    if [[ -e /var/lib/csi-powerup/presentation-pending.json || -L /var/lib/csi-powerup/presentation-pending.json ]]; then
        audit_event deferred '' 78 '' 'Original presentation restoration is still pending'
        return 78
    fi
    if package_audit=$(/usr/bin/timeout 30s /usr/bin/dpkg --audit 2>&1); then status=0; else status=$?; fi
    printf '%s\n' "$package_audit"
    if (( status != 0 )) || [[ -n $package_audit ]]; then
        audit_event deferred '' 78 '' 'Package audit requires repair before restart' "status=$status"
        return 78
    fi
    if ! /usr/bin/timeout 60s /usr/bin/apt-get -s check; then
        audit_event deferred '' 78 '' 'Dependency check requires repair before restart'
        return 78
    fi
    audit_begin 'Request normal system restart with inhibitor checks'
    status=0
    # Explicit "yes" retains inhibitor checks in the noninteractive dispatcher.
    # Never retry with -i, --force, --check-inhibitors=no, or reboot.target.
    restart_systemctl_request || status=$?
    audit_end "$status"
    if (( status == 0 )); then
        audit_event restart-requested '' 0 '' 'Systemd accepted the restart request; shutdown completion is not yet observed'
    else
        restart_diagnostics
        audit_event restart-blocked '' "$status" '' 'Normal restart request was not accepted; no inhibitor override was attempted'
    fi
    return "$status"
)

restart_repair_backend() {
    (( EUID == 0 )) || die 'Restart recovery requires administrator access.'
    (( $# == 0 )) || die 'Unexpected restart recovery parameters.'
    local self RESTART_REPAIR_ONLY=1
    # shellcheck disable=SC2031
    local -x PATH=/usr/sbin:/usr/bin:/sbin:/bin
    self=$(readlink -f -- "${BASH_SOURCE[0]}") || return 1
    install -d -m 700 /run/csi-powerup || return 1
    if (( ! POWERUP_LOCK_HELD )); then
        powerup_locked_call "$self" restart_repair_backend /run/csi-powerup/lock
        return $?
    fi
    # Use the existing backup/repair/restore/boot pipeline. Preserve any saved
    # release reboot checkpoint and do not start another release upgrade.
    backend_main os-update
}

gui_restart_repair_plan() {
    local GUI_INTERNAL_RESTART_REPAIR=1 GUI_PROFILE=standard
    local -a GUI_ARGS=(os-update)
    audit_event recovery '' '' '' 'Recheck protected startup files and repair packages before offering restart again'
    gui_run_plan "$1"
}

gui_request_restart() {
    local self=$1 restart_dir status=0
    restart_dir=$(mktemp -d "$GUI_DIR/restart.XXXXXXXX") || return 1
    # A fresh auth directory prevents a previous Cancel/failed password marker
    # from leaking into this independent, user-requested action.
    local GUI_DIR=$restart_dir GUI_STATUS=$restart_dir/restart.status GUI_JOB='' GUI_LOG_OFFSET
    local GUI_PROGRESS_PID='' GUI_PROGRESS_FD='' GUI_LOG_FEEDER=''
    local -a command=()
    gui_assets
    make_auth_helper "$GUI_DIR" 'Save your work before continuing. Enter your administrator password to restart after package checks, or Cancel to close Powerup.'
    if (( EUID == 0 )); then
        command=(/bin/bash "$self" --internal-request-restart)
    else
        # shellcheck disable=SC2016
        command=(/bin/bash -c 'source "$1"; shift; authenticated_run "$@"' powerup-restart-auth "$self" "$GUI_DIR" \
            /bin/bash "$self" --internal-request-restart)
    fi
    audit_event restart-selected '' '' '' 'User selected Restart now'
    GUI_LOG_OFFSET=$(stat -c %s -- "$GUI_LOG") || return 1
    # Reuse the detached runner and the current session's single log stream.
    setsid --wait /bin/bash "$restart_dir/../runner.sh" "$GUI_STATUS" "$GUI_LOG" "$self" "${command[@]}" &
    GUI_JOB=$!
    if gui_progress_open --text="$(gui_header 'Preparing to restart' 'PACKAGE AND SHUTDOWN CHECKS' 'Please wait. Active package work is monitored; eligible stalled work is recovered before repairs. Shutdown inhibitors remain in force. Closing this monitor does not stop the request.')" \
        --progress --pulsate --progress-text='Checking package activity and restart readiness' \
        --enable-log='Progress and completed steps' --log-expanded --log-height=300 --auto-close --no-buttons --no-escape; then
        ( exec 1>&"$GUI_PROGRESS_FD"; exec {GUI_PROGRESS_FD}>&-; gui_feed_log ) &
        GUI_LOG_FEEDER=$!
    fi
    wait "$GUI_JOB" || true
    gui_progress_close
    if [[ -f $GUI_STATUS ]]; then read -r status < "$GUI_STATUS"; else status=125; fi
    [[ $status =~ ^[0-9]+$ ]] || status=125
    [[ ! -e $GUI_DIR/auth.cancel ]] || status=130
    audit_event restart-return '' "$status" '' 'Restart worker returned' "log=$GUI_LOG"
    rm -rf -- "$restart_dir"
    return "$status"
}

gui_prepare_resume_access() {
    local self=$1 status=0
    release_job_store status >/dev/null || status=$?
    (( status != 77 )) || {
        log 'The saved upgrade is private to root; repairing access before wizard review.'
        POWERUP_PHASE='restoring access to saved upgrade progress'
        status=0
        powerup_log_arguments
        if (( EUID == 0 )); then
            resume_access_root_repair || status=$?
        else
            make_auth_helper "$GUI_DIR" 'Powerup needs to restore access to its saved upgrade progress. Enter your administrator password, or Cancel to close Powerup.' || return $?
            authenticated_run "$GUI_DIR" /bin/bash "$self" "${POWERUP_LOG_ARGS[@]}" --internal-repair-resume-access || status=$?
        fi
        (( status == 0 )) || return "$status"
        # Verify as the desktop user, not just as root. ACL/parent-path problems
        # must not cause repeated prompts or silently turn an unread job into new.
        release_job_store status >/dev/null || return $?
        audit_event success '' 0 '' 'Saved upgrade progress is readable by the desktop user'
    }
    return "$status"
}

gui_main() {
    local self code note
    self=$(readlink -f -- "${BASH_SOURCE[0]}")
    command -v yad >/dev/null || die 'YAD is required. Install it with: sudo apt install yad'
    [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] || die 'Open Powerup from a desktop session, or use --cli for terminal execution.'
    command -v setsid >/dev/null || die 'setsid (util-linux) is required for the update worker.'
    umask 077
    GUI_DIR=$(mktemp -d "${TMPDIR:-/tmp}/csi-powerup-gui.XXXXXXXX")
    GUI_JOB='' GUI_STATUS='' GUI_PROGRESS_PID='' GUI_PROGRESS_FD='' GUI_LOG_FEEDER=''
    if [[ ${POWERUP_LOGGED:-0} != 1 ]]; then trap gui_cleanup EXIT; fi
    POWERUP_PHASE='opening the wizard'
    gui_assets
    GUI_HEALTH_REPORT=''
    GUI_REPOS_READY=0
    if (( GUI_DEMO )); then
        BASE_CODENAME=$GUI_DEMO_BASE; ARCH=amd64
        [[ $BASE_CODENAME != resolute ]] || GUI_REPOS_READY=1
    else
        # Platform errors are shown in a dialog; no privileged operation occurs.
        if ! note=$( (validate_platform) 2>&1); then printf '%s\n' "$note" >&2; gui_message 'Setup requires review' 'This platform needs a compatibility review. Details have been saved to the support log.'; return 1; fi
        validate_platform
        GUI_HEALTH_REPORT=$(dpkg --audit 2>&1) || GUI_HEALTH_REPORT="Could not inspect package state: $GUI_HEALTH_REPORT"
        gui_repository_state
    fi
    if ! parse_options "$@"; then gui_message 'Check your options' "$PLAN_ERROR"; return 1; fi
    if (( ! GUI_DEMO && ! CHECK_ONLY && ! TEST_PACKAGES )); then
        code=0
        gui_prepare_resume_access "$self" || code=$?
        (( code != 130 )) || return 0
        if (( code != 0 )); then
            gui_message 'Saved progress needs review' 'Powerup could not verify its saved upgrade progress. Details are saved in the support log. No package maintenance was started.'
            return "$code"
        fi
    fi
    # A prior Start+authentication already approved this job. On the next boot,
    # opening Powerup without a competing action continues it automatically.
    if (( ! GUI_DEMO && ! CHECK_ONLY && ! TEST_PACKAGES && $# == 0 )); then
        if release_job_store ready >/dev/null; then
            RESUME_RELEASE=1
        elif [[ $(release_job_store route) == wait ]]; then
            GUI_LOG=$POWERUP_SESSION_LOG
            powerup_log_files validate "$GUI_LOG"
            gui_write_runner
            audit_event checkpoint '' 0 '' 'Reopened the saved restart checkpoint without repeating package work'
            gui_show_result "$self" 0 release-reboot-pending
            return
        fi
    fi
    GUI_RECOVERABLE=0
    if (( ! GUI_DEMO && ! CHECK_ONLY && ! TEST_PACKAGES )) && release_job_store recoverable >/dev/null; then GUI_RECOVERABLE=1; fi
    if (( RESUME_RELEASE )); then
        if (( RECOVER_RELEASE )); then
            if ! release_job_store recoverable >/dev/null; then return 0; fi
        elif ! release_job_store ready >/dev/null; then return 0; fi
        release_apply_resume_plan
        validate_options || die "$PLAN_ERROR"
        GUI_PROFILE=resume; (( ! RECOVER_RELEASE )) || GUI_PROFILE=recover
        GUI_CATEGORIES=()
        gui_build_plan
        audit_event resume '' 0 '' 'Continuing the previously approved Ubuntu release upgrade'
        gui_run_plan "$self"
        return
    fi
    if ! validate_options; then gui_message 'Choose compatible options' "$PLAN_ERROR"; return 1; fi
    if (( GUI_REPOS_READY && FULL_UPGRADE )); then
        gui_message 'Maintenance is available' 'Ubuntu 26.04 and the repositories are already configured. Reopen Powerup without --full-upgrade to update installed packages and CSI tools.'
        return 1
    fi
    GUI_READ_ONLY=$CHECK_ONLY
    GUI_PROFILE=standard
    (( ! FULL_UPGRADE )) || GUI_PROFILE=full
    (( ! REFRESH_TOOLS )) || GUI_PROFILE=refresh
    (( ! RELEASE_UPGRADE )) || GUI_PROFILE=release
    GUI_CATEGORIES=()
    for note in "${REQUESTED[@]}"; do
        [[ -z $TOOL_ACTION ]] || continue
        if [[ $note == all ]]; then GUI_PROFILE=all
        elif [[ $note != os-update ]]; then GUI_PROFILE=selected; GUI_CATEGORIES+=("$note"); fi
    done
    [[ $TOOL_ACTION != update ]] || GUI_PROFILE="categories-install"
    [[ $TOOL_ACTION != remove ]] || GUI_PROFILE="categories-remove"
    [[ ${CATEGORY_ACTION:-} != install ]] || { GUI_PROFILE="categories-install"; GUI_CATEGORIES=("${PACKAGE_CATEGORIES[@]}"); }
    [[ ${CATEGORY_ACTION:-} != remove ]] || { GUI_PROFILE="categories-remove"; GUI_CATEGORIES=("${PACKAGE_CATEGORIES[@]}"); }
    case $GUI_PROFILE in full|refresh|all|selected) GUI_PROFILE=standard;; esac
    (( ! ${CSI_TOOLS_ONLY:-0} )) || GUI_PROFILE=csi-apps
    (( ! ${TEST_PACKAGES:-0} )) || GUI_PROFILE=test-packages
    (( ! CHECK_ONLY )) || GUI_PROFILE=preview
    while :; do
        if (( ! GUI_READ_ONLY )); then
            if ! gui_dashboard; then return 0; fi
        fi
        if [[ $GUI_PROFILE == categories-install || $GUI_PROFILE == categories-remove ]]; then
            code=0
            gui_package_categories || code=$?
            if (( code == 2 )); then continue; elif (( code != 0 )); then return 0; fi
            gui_build_plan
            if ! validate_options; then gui_message 'Check your choices' "$PLAN_ERROR"; continue; fi
            gui_run_plan "$self"; return
        fi
        gui_build_plan
        if ! validate_options; then gui_message 'Check your choices' "$PLAN_ERROR"; continue; fi
        POWERUP_PHASE='reviewing the selected plan'
        gui_write_plan
        if (( CHECK_ONLY )); then
            gui_dialog --text="$(gui_header 'System preview' 'READ ONLY' 'No system changes or administrator access.')" --text-info --filename="$GUI_DIR/plan.txt" \
                --fontname='DejaVu Sans 11' --wrap --button='Close:0' >/dev/null || true
            (( ! GUI_READ_ONLY )) || return 0
            GUI_PROFILE=standard
            continue
        fi
        gui_capture --height=650 --text="$(gui_header 'Ready to start' '02  START' 'Your selected action is shown below.')" --text-info --filename="$GUI_DIR/plan.txt" \
            --fontname='DejaVu Sans 11' --wrap --button='Cancel:1' --button='Back:2' --button='Start updates:0'
        case $GUI_CODE in 2) continue;; 0) gui_run_plan "$self"; return;; *) return 0;; esac
    done
}

# ------------------------- Startup self-update -------------------------
# Metadata is read as text, never sourced. HTTPS authenticates the publisher;
# revision checks prevent downgrades. No user checksum or source selection.
self_revision() {
    sed -n 's/^readonly POWERUP_REV=//p' "$1"
}

self_update_program() {
    /usr/bin/python3 - "$@" <<'PY_SELF_UPDATE'
import datetime, fcntl, os, re, signal, ssl, stat, subprocess, sys, tempfile, time
import urllib.error, urllib.request
from pathlib import Path

URL = 'https://raw.githubusercontent.com/CSILinux/CSILinux-Powerup/refs/heads/main/powerup'
LIMIT = 2 * 1024 * 1024
END = 'if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi'
CURRENT_END = '''if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    case ${1:-} in
        --internal-log-stream) [[ $# == 2 || $# == 3 || $# == 4 ]] || exit 64; shift; powerup_log_files stream "$@" ;;
        --help|-h|--version) main "$@" ;;
        *) powerup_launch "$@" ;;
    esac
fi'''

def revision(data):
    if not data or len(data) > LIMIT or b'\0' in data:
        raise ValueError('Powerup download is empty, oversized or contains NUL bytes')
    text = data.decode('utf-8')
    if not text.startswith('#!/bin/bash\n'):
        raise ValueError('Expected a Bash script, not an HTML/error response')
    assignments = re.findall(r'^(?:readonly )?POWERUP_REV=.*$', text, re.M)
    if len(assignments) != 1:
        raise ValueError('Expected exactly one literal POWERUP_REV assignment')
    match = re.fullmatch(r'(?:readonly )?POWERUP_REV=(\d{4}-\d{2}-\d{2})-([1-9]\d{0,8})', assignments[0])
    if not match:
        raise ValueError('POWERUP_REV must use YYYY-MM-DD-N with a positive sequence')
    date = datetime.date.fromisoformat(match[1])
    return (date, int(match[2])), match[1] + '-' + match[2], text

def validate(data, require_protocol=False):
    key, label, text = revision(data)
    env = {k: v for k, v in os.environ.items() if k not in ('BASH_ENV', 'ENV', 'SHELLOPTS', 'BASHOPTS')}
    result = subprocess.run(['/bin/bash', '-n'], input=data, capture_output=True, env=env, timeout=15)
    if result.returncode:
        raise ValueError('Downloaded Powerup failed Bash syntax validation: ' + result.stderr.decode(errors='replace')[:500])
    if require_protocol and ('\nreadonly POWERUP_SELF_UPDATE_PROTOCOL=1\n' not in text or not (text.rstrip().endswith(CURRENT_END) or text.rstrip().endswith(CURRENT_END.replace(' || $# == 4','')) or text.rstrip().splitlines()[-1] == END)):
        raise ValueError('Newer Powerup lacks the supported restart protocol or complete entry point')
    return key, label

def read_regular(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as handle:
        info = os.fstat(handle.fileno())
        if not stat.S_ISREG(info.st_mode):
            raise ValueError('Powerup must be a regular file')
        data = handle.read(LIMIT + 1)
    return data, info

def download(path):
    # No redirected host, cleartext transport, unverified TLS or stale fallback.
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            raise ValueError('Unexpected redirect from the fixed Powerup URL')
    class DownloadDeadline(Exception):pass
    def expired(_signum, _frame):
        raise DownloadDeadline('Powerup download exceeded 45 seconds')
    signal.signal(signal.SIGALRM, expired)
    signal.alarm(45)
    try:
        req = urllib.request.Request(URL, headers={'User-Agent': 'CSI-Linux-Powerup', 'Cache-Control': 'no-cache', 'Accept': 'text/plain'})
        opener=urllib.request.build_opener(NoRedirect)
        for attempt in range(1,4):
            try:
                with opener.open(req, timeout=10) as response:
                    if response.status != 200:raise ValueError('Powerup download returned HTTP '+str(response.status))
                    data=response.read(LIMIT+1)
                break
            except urllib.error.HTTPError as error:
                if error.code not in (408,429,500,502,503,504) or attempt==3:raise
                delay=attempt
            except urllib.error.URLError as error:
                if isinstance(error.reason,ssl.SSLError) or attempt==3:raise
                delay=attempt
            except TimeoutError:
                if attempt==3:raise
                delay=attempt
            print('Temporary Powerup download failure; retry '+str(attempt+1)+' of 3',file=sys.stderr,flush=True)
            time.sleep(delay)
        key, label = validate(data)
        # Caller creates a private directory. Exclusive creation refuses links.
        with open(path, 'xb') as handle:
            os.chmod(path, 0o600)
            handle.write(data)
        return key, label, data
    finally:
        signal.alarm(0)

def install(target, candidate, old_revision, new_revision):
    old, info = read_regular(target)
    new, _ = read_regular(candidate)
    old_key, old_label = validate(old)
    new_key, new_label = validate(new, require_protocol=True)
    if (old_label, new_label) != (old_revision, new_revision):
        raise ValueError('Powerup revision changed during the check; reopen it')
    if new_key <= old_key:
        raise ValueError('Refusing to install a revision that is not newer')
    parent = Path(target).parent
    # Keep a stable lock inode; unlinking locks can let competing writers enter.
    lock = os.open(str(target) + '.update.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    temp = None
    try:
        if not stat.S_ISREG(os.fstat(lock).st_mode):
            raise ValueError('Self-update lock is not a regular file')
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        current, now = read_regular(target)
        if current != old or (now.st_dev, now.st_ino) != (info.st_dev, info.st_ino):
            raise ValueError('Installed Powerup changed while waiting to replace it')
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%d-%H%M%S')
        fd, backup = tempfile.mkstemp(prefix=Path(target).name + '.backup-' + stamp + '-', dir=parent)
        with os.fdopen(fd, 'wb') as handle:
            handle.write(old)
            handle.flush()
            os.fsync(handle.fileno())
        fd, temp = tempfile.mkstemp(prefix='.powerup-new-', dir=parent)
        with os.fdopen(fd, 'wb') as handle:
            handle.write(new)
            handle.flush()
            os.fchown(handle.fileno(), info.st_uid, info.st_gid)
            os.fchmod(handle.fileno(), (stat.S_IMODE(info.st_mode) & 0o777) | 0o100)
            os.fsync(handle.fileno())
        current, now = read_regular(target)
        if current != old or (now.st_dev, now.st_ino) != (info.st_dev, info.st_ino):
            raise ValueError('Installed Powerup changed before replacement')
        os.replace(temp, target)
        temp = None
        directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
        print('Previous Powerup saved to: ' + backup)
    finally:
        if temp is not None:
            os.unlink(temp)
        os.close(lock)

try:
    action, *args = sys.argv[1:]
    if action == 'inspect':
        data, _ = read_regular(args[0])
        _, label = validate(data)
        print(label)
    elif action == 'download':
        _, label, data = download(args[0])
        print(label)
    elif action == 'newer':
        new, _ = read_regular(args[0])
        old, _ = read_regular(args[1])
        new_key, _ = validate(new)
        old_key, _ = validate(old)
        if new_key > old_key:
            validate(new, require_protocol=True)
            print('yes')
        else:
            print('no')
    elif action == 'install':
        install(*args)
    else:
        raise ValueError('Unknown self-update operation')
except Exception as error:
    print('ERROR: Self-update: ' + str(error), file=sys.stderr)
    sys.exit(1)
PY_SELF_UPDATE
}

self_update_root_install() (
    (( EUID == 0 )) || die 'Internal Powerup installation requires administrator access.'
    [[ $# == 2 && $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[1-9][0-9]*$ && $2 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[1-9][0-9]*$ ]] || die 'Invalid internal update parameters.'
    # Each privileged entrypoint intentionally resets PATH in its own subshell.
    # shellcheck disable=SC2030
    export PATH=/usr/sbin:/usr/bin:/sbin:/bin
    umask 077
    local self staging meta
    self=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 1
    install -d -m 700 /run/csi-powerup || exit 1
    if (( ! POWERUP_LOCK_HELD )); then
        powerup_locked_call "$self" self_update_root_install /run/csi-powerup/lock "$@"
        return $?
    fi
    staging=$(mktemp -d /var/tmp/powerup-self-update.XXXXXXXX) || exit 1
    trap 'rm -rf -- "$staging"' EXIT
    # Never run or install a candidate supplied from a user's staging directory.
    meta=$(self_update_program download "$staging/powerup") || exit 1
    [[ $meta == "$2" ]] || die 'GitHub changed during authentication. Reopen Powerup to check the new revision.'
    self_update_program install "$self" "$staging/powerup" "$1" "$2"
)

self_update_prepare() (
    local self=$1 cli=$2 staging meta old_revision new_revision newer status
    local GUI_PROGRESS_PID='' GUI_PROGRESS_FD='' GUI_LOG_FEEDER='' GUI_DIR=''
    powerup_log_arguments
    umask 077
    staging=$(mktemp -d "${TMPDIR:-/tmp}/powerup-startup.XXXXXXXX") || return 1
    trap 'gui_progress_close; rm -rf -- "$staging"' EXIT
    if (( ! cli )) && command -v yad >/dev/null && [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
        GUI_DIR=$staging
        gui_assets || return 1
        gui_progress_open --height=300 --text="$(gui_header 'Checking for Powerup updates' 'STARTUP / GITHUB' 'Checking the latest published revision before opening the control center.')" \
            --progress --pulsate --progress-text='Checking GitHub — validating the published revision' \
            --auto-close --no-buttons --no-escape || return 1
    fi
    printf 'Checking Powerup: %s\n' "$POWERUP_SELF_UPDATE_URL"
    if meta=$(self_update_program inspect "$self" 2>"$staging/error") &&
        read -r old_revision <<< "$meta" &&
        meta=$(self_update_program download "$staging/powerup" 2>"$staging/error") &&
        read -r new_revision <<< "$meta" &&
        newer=$(self_update_program newer "$staging/powerup" "$self" 2>"$staging/error"); then
        if [[ $newer == no ]]; then
            [[ $(self_revision "$self") == "$old_revision" ]] || { printf 'Powerup changed during startup. Reopen it.\n' > "$staging/error"; newer=error; }
        fi
        if [[ $newer == no ]]; then
            if [[ $old_revision == "$new_revision" ]]; then
                printf 'Installed Powerup %s is current (GitHub: %s).\n' "$old_revision" "$new_revision"
            else
                printf 'Keeping installed Powerup %s; GitHub publishes older %s. Downgrade skipped.\n' "$old_revision" "$new_revision"
            fi
            return 0
        elif [[ $newer == yes ]]; then
            printf 'New Powerup %s found; installed revision is %s.\n' "$new_revision" "$old_revision"
            gui_progress_close
            status=0
            if (( EUID == 0 )); then
                self_update_root_install "$old_revision" "$new_revision" >"$staging/install.log" 2>&1 || status=$?
            elif [[ $self != /opt/csitools/powerup && -w $self && -w ${self%/*} ]]; then
                self_update_program install "$self" "$staging/powerup" "$old_revision" "$new_revision" >"$staging/install.log" 2>&1 || status=$?
            elif [[ -n $GUI_DIR ]]; then
                make_auth_helper "$staging" "Powerup $new_revision is available. Enter your administrator password to replace the installed script and restart, or Cancel to close Powerup."
                # Intentionally capture output in the invoking user's private log.
                # shellcheck disable=SC2024
                authenticated_run "$staging" /bin/bash "$self" "${POWERUP_LOG_ARGS[@]}" --internal-self-update-install "$old_revision" "$new_revision" >"$staging/install.log" 2>&1 || status=$?
                if [[ -e $staging/auth.cancel ]]; then cat "$staging/install.log"; return 130; fi
            else
                # shellcheck disable=SC2024
                sudo -- /bin/bash "$self" "${POWERUP_LOG_ARGS[@]}" --internal-self-update-install "$old_revision" "$new_revision" >"$staging/install.log" 2>&1 || status=$?
            fi
            cat "$staging/install.log"
            if (( status == 0 )); then
                [[ $(self_revision "$self") == "$new_revision" ]] || { printf 'Installed revision changed during the update. Reopen Powerup.\n' > "$staging/error"; status=1; }
                if (( status == 0 )); then return 20; fi
            else cp -- "$staging/install.log" "$staging/error"; fi
        fi
    fi
    gui_progress_close
    cat "$staging/error" >&2
    if [[ -n $GUI_DIR ]]; then
        gui_message 'Powerup needs a version check' 'No package maintenance was started. Diagnostic details have been saved to the support log. Check connectivity or the published script, then reopen Powerup.'
    fi
    return 1
)

startup_self_update() {
    local self=$1 cli=$2 status=0; shift 2
    audit_begin 'Check Powerup version and update if newer'
    self_update_prepare "$self" "$cli" || status=$?
    case $status in
        0) audit_end 0; SELF_CHECKED_REV=$(self_revision "$self") ;;
        20)
            audit_end 20 restart
            SELF_CHECKED_REV=$(self_revision "$self")
            printf 'Restarting the updated Powerup with the original options.\n'
            powerup_log_arguments
            exec /bin/bash "$self" "${POWERUP_LOG_ARGS[@]}" "--internal-self-update-revision=$SELF_CHECKED_REV" "$@" ;;
        130) audit_end 130 cancelled; return 130 ;;
        *) audit_end "$status"; return "$status" ;;
    esac
}

resume_access_root_repair() (
    (( EUID == 0 )) || die 'Saved upgrade access repair requires administrator access.'
    (( $# == 0 )) || die 'Unexpected saved upgrade repair parameters.'
    local self WORK
    # Do not depend on another entrypoint's subshell-local PATH assignment.
    # shellcheck disable=SC2031
    local -x PATH=/usr/sbin:/usr/bin:/sbin:/bin
    umask 077
    self=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 1
    install -d -m 700 /run/csi-powerup || exit 1
    if (( ! POWERUP_LOCK_HELD )); then
        powerup_locked_call "$self" resume_access_root_repair /run/csi-powerup/lock
        return $?
    fi
    WORK=$(mktemp -d /var/tmp/csi-powerup-access.XXXXXXXX) || exit 1
    trap 'rm -rf -- "$WORK"' EXIT
    audit_step 'Repair saved upgrade access without resetting progress' release_job_store repair-access || exit $?
    audit_step 'Refresh automatic upgrade continuation' release_install_resume || exit $?
    audit_step 'Record repaired saved upgrade state' release_job_store explain
)

main() {
    local cli=0 gui=0 arg read_only=0 self checked=''
    self=$(readlink -f -- "${BASH_SOURCE[0]}") || return 1
    if [[ ${1:-} == --internal-restart-repair ]]; then shift; restart_repair_backend "$@"; return; fi
    if [[ ${1:-} == --internal-repair-resume-access ]]; then shift; resume_access_root_repair "$@"; return; fi
    if [[ ${1:-} == --internal-self-update-install ]]; then shift; self_update_root_install "$@"; return; fi
    # Older revisions pass this marker when restarting an updated script.
    # Accept it as a loop marker only; checksum verification has been removed.
    if [[ ${1:-} == --internal-self-update-checked=* ]]; then
        shift; checked=$POWERUP_REV; SELF_CHECKED_REV=$POWERUP_REV
    elif [[ ${1:-} == --internal-self-update-revision=* ]]; then
        checked=${1#*=}; shift
        [[ $checked == "$POWERUP_REV" ]] || die 'Powerup changed since startup. Reopen it before continuing.'
        SELF_CHECKED_REV=$checked
    fi
    local -a args=()
    GUI_DEMO=0 GUI_DEMO_BASE=resolute
    if (( $# == 1 )); then
        case $1 in --help|-h) usage; return;; --version) printf 'POWERUP_REV=%s\n' "$POWERUP_REV"; return;; --platform-report) platform_report; return;; esac
    fi
    for arg in "$@"; do
        case $arg in
            --cli) cli=1 ;;
            --gui) gui=1 ;;
            --check|--test-packages) read_only=1; args+=("$arg") ;;
            --repair-wallpaper) cli=1; args+=("$arg") ;;
            --demo|--demo=resolute) GUI_DEMO=1 ;;
            --demo=noble) GUI_DEMO=1; GUI_DEMO_BASE=noble ;;
            *) args+=("$arg") ;;
        esac
    done
    (( ! (cli && (gui || GUI_DEMO)) )) || die '--cli cannot be combined with --gui or --demo.'
    if [[ " ${args[*]} " == *' --repair-wallpaper '* ]]; then
        (( ${#args[@]} == 1 )) || die '--repair-wallpaper is a separate desktop repair action.'
    fi
    if (( ! GUI_DEMO && ! read_only )) && [[ -z $checked ]]; then
        local startup_status=0
        startup_self_update "$self" "$cli" "$@" || startup_status=$?
        if (( startup_status == 130 )); then
            for arg in "${args[@]}"; do
                case $arg in --resume-release|--recover-release) release_job_store defer || true ;; esac
            done
            return 0
        fi
        (( startup_status == 0 )) || return "$startup_status"
    fi
    if [[ ${args[0]:-} == --repair-wallpaper ]]; then wallpaper_repair_command "${args[@]:1}"; return; fi
    if (( cli )); then backend_main "${args[@]}"; else gui_main "${args[@]}"; fi
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    case ${1:-} in
        --internal-request-restart) [[ $# == 1 ]] || exit 64; shift; restart_root_request "$@" ;;
        --internal-repair-log-storage) [[ $# == 1 ]] || exit 64; (( EUID == 0 )) || exit 77; powerup_log_storage_prepare ;;
        --internal-log-stream) [[ $# == 2 || $# == 3 || $# == 4 ]] || exit 64; shift; powerup_log_files stream "$@" ;;
        --help|-h|--version) main "$@" ;;
        *) powerup_launch "$@" ;;
    esac
    exit "$?"
fi
# Compatibility footer for older self-update validators; execution exits above.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
