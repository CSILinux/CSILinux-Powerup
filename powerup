        for row in rows:
            detail=process_details(row);safe_member(detail)
            if (detail['exe'],detail['args'],detail['uid'])!=(details_by_pid[row['pid']]['exe'],details_by_pid[row['pid']]['args'],details_by_pid[row['pid']]['uid']):
                raise RuntimeError('Package executable changed before signaling')
            if row['pid'] in newly_verified and not verified_manager(detail):
                raise RuntimeError('Package manager source metadata changed before signaling')
