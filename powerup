                args=[part.decode(errors='replace') for part in (root/'cmdline').read_bytes().split(b'\0') if part])

def protected(details):
    if details['state']=='D':return 'uninterruptible I/O'
    for arg in [details['exe'],*details['args']]:
        name=Path(arg).name
        if name in BOOT_NAMES or arg.startswith(('/etc/kernel/','/usr/lib/kernel/')):
            return 'kernel or boot maintenance'
        if re.match(r'^(linux-image|linux-modules|linux-headers|grub|shim|initramfs-tools|plymouth)(?:[-.:]|$)',name):
            return 'kernel or boot package operation'
    return None

def python_script(args):
    # Interpreter flags precede the script in /proc/PID/cmdline. In particular,
    # Ubuntu invokes its extracted release frontend as python3 -s SCRIPT.
    # Never search later arguments for a plausible path: -c/-m/stdin and option
    # values can contain a path without executing that script.
    index=1
    while index<len(args):
        token=args[index]
        if token=='--':
            index+=1
            return args[index] if index<len(args) and args[index] not in ('','-') else None
        if token in ('','-') or token.startswith(('-c','-m')):return None
        if not token.startswith('-'):return token
        if re.fullmatch(r'-[bBEIOPqsSuv]+',token):
            index+=1;continue
        if token in ('-W','-X'):
            if index+1>=len(args):return None
            index+=2;continue
        if token.startswith(('-W','-X')) and len(token)>2:
            index+=1;continue
        if token=='--check-hash-based-pycs':
            if index+1>=len(args) or args[index+1] not in ('default','always','never'):return None
            index+=2;continue
        if token in ('--check-hash-based-pycs=default','--check-hash-based-pycs=always','--check-hash-based-pycs=never'):
            index+=1;continue
        return None
    return None

def trusted(details):
    if details['uid']!=ROOT_UID:return False
    exe=details['exe']
    if exe not in TRUSTED_BINARIES:
        if not re.fullmatch(r'/usr/bin/python3(?:\.[0-9]+)?',exe):return False
        script_name=python_script(details['args'])
        if script_name not in TRUSTED_SCRIPTS:
            return release_frontend_check(script_name)['accepted'] and executable_file(details)
        script=Path(script_name).stat()
        if not stat.S_ISREG(script.st_mode) or script.st_uid!=ROOT_UID or script.st_mode&0o022:return False
    st=Path(exe).stat()
    return stat.S_ISREG(st.st_mode) and st.st_uid==ROOT_UID and not st.st_mode&0o022

def ancestors():
    found=set();pid=os.getpid()
